+import { KNOWN_SESSION_EVENT_TYPES } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionHeader, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import { validateStoredEvents, SessionPersistenceRevision, SessionPageCapacityError, assertSessionPageRequest } from '@deepseek-ai/dsh-session-persistence'
+import type { SessionPageRequest, SessionPageResult, SessionReadIndex } from '@deepseek-ai/dsh-session-persistence'
+import { releasedV4SessionFormatCodec, decodeV4IndexedEvent, V4SessionStreamValidator, assertV4RowAdmission } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+import type { V4StreamCheckpoint } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+import type { SessionFormatEvent, SessionFormatHeader } from '@deepseek-ai/dsh-session-format'
+import { decompressZstdPrefix } from './zstd.ts'
+import type { ReadIndexRequest } from './read-index.ts'
+
+interface EntryRow { seq: number; start: number; end: number; lineStart: number; lineEnd: number; torn: number; type: string; turn: number | null; step: number | null; callId: string | null; calls: string; headerSeq: number | null }
+interface Metadata { format: 2; generation: string; identity: string; dev: string; ino: string; size: number; scanned: number; count: number; header: SessionHeader; state: V4StreamCheckpoint; safeState: V4StreamCheckpoint; safeCount: number }
+const request = workerData as ReadIndexRequest
+const fd = openSync(request.path, 'r')
+const db = new DatabaseSync(`${request.path}.read-index.sqlite`)
+db.exec('PRAGMA busy_timeout=30000; CREATE TABLE IF NOT EXISTS metadata(id INTEGER PRIMARY KEY CHECK(id=1), value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS entries(seq INTEGER PRIMARY KEY,start INTEGER NOT NULL,end INTEGER NOT NULL,lineStart INTEGER NOT NULL,lineEnd INTEGER NOT NULL,torn INTEGER NOT NULL,type TEXT NOT NULL,turn INTEGER,step INTEGER,callId TEXT,calls TEXT NOT NULL,headerSeq INTEGER); CREATE INDEX IF NOT EXISTS entry_types ON entries(type,turn,step,seq); CREATE INDEX IF NOT EXISTS entry_calls ON entries(callId,type);')
+const get = db.prepare('SELECT * FROM entries WHERE seq=?')
+const put = db.prepare('INSERT OR REPLACE INTO entries VALUES(?,?,?,?,?,?,?,?,?,?,?,?)')
+let header: SessionHeader
+let sourceBytesRead = 0, indexedEvents = 0
+function identity(stat: BigIntStats): string { return [stat.dev, stat.ino, stat.size, stat.mtimeNs, stat.ctimeNs].join(':') }
+function read(start: number, end: number): Buffer {
+  const buffer = Buffer.alloc(end - start)
+  sourceBytesRead += buffer.length
+  let offset = 0
+  while (offset < buffer.length) { const n = readSync(fd, buffer, offset, buffer.length - offset, start + offset); if (!n) throw new Error('Native Session source shrank during its fixed-prefix read'); offset += n }
+  return buffer
+}
+let frameCache: { start: number; end: number; plain: Buffer } | undefined
+function original(row: EntryRow): SessionEvent {
+  if (!frameCache || frameCache.start !== row.start || frameCache.end !== row.end) {
+    const bytes = read(row.start, row.end)
+    const plain = request.compression === 'none' ? bytes : row.torn ? zstdDecompressSync(bytes, { finishFlush: constants.ZSTD_e_flush }) : zstdDecompressSync(bytes)
+    frameCache = { start: row.start, end: row.end, plain }
+  }
+  const plain = frameCache.plain
+  const event = decodeV4IndexedEvent(JSON.parse(plain.subarray(row.lineStart, row.lineEnd).toString('utf8')))
+  return validateStoredEvents(header, [event as unknown as SessionEvent])[0]!
+}
+function eventAt(seq: number): SessionFormatEvent | undefined { const row = get.get(seq) as unknown as EntryRow | undefined; return row && original(row) as unknown as SessionFormatEvent }
+function number(data: Record<string, unknown>, key: string): number | null { const value = data[key]; return typeof value === 'number' && Number.isSafeInteger(value) ? value : null }
+function remember(event: SessionEvent, start: number, end: number, lineStart: number, lineEnd: number, torn: boolean): void {
+  const data = event.data as unknown as Record<string, unknown>, message = data['message'] as Record<string, unknown> | undefined
+  const calls = event.type === 'assistant/message' && Array.isArray(message?.['content']) ? message['content'].flatMap((block: unknown) => {
+    if (typeof block !== 'object' || block === null) return []
+    const value = block as Record<string, unknown>
+    return value['type'] === 'tool-call' && typeof value['id'] === 'string' ? [value['id']] : []
+  }) : []
