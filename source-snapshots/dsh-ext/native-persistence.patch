+/** Isolated sparse native log indexing and bounded original-frame reads. */
+import { randomUUID } from 'node:crypto'
+import { parentPort, workerData } from 'node:worker_threads'
+import { openSync, closeSync, readSync, fstatSync, type BigIntStats } from 'node:fs'
+import { DatabaseSync } from 'node:sqlite'
