+    if (end - offset < 3) return undefined
+    const block = read(offset, offset + 3).readUIntLE(0, 3), type = (block >>> 1) & 3
+    if (type === 3) throw new Error('Native Session has reserved Zstandard block type')
+    offset += 3 + (type === 1 ? 1 : block >>> 3)
+    if (offset > end) return undefined
+    if (block & 1) break
+  }
+  if (descriptor & 4) offset += 4
+  return offset <= end ? offset : undefined
+}
+
+async function ensureIndex(): Promise<Metadata> {
+  const stat = fstatSync(fd, { bigint: true }), revision = identity(stat), sourceSize = Number(stat.size)
+  const row = db.prepare('SELECT value FROM metadata WHERE id=1').get()
+  let prior = row ? JSON.parse(String(row.value)) as Metadata : undefined
+  if (prior?.format === 2 && prior.identity === revision && prior.header.id === request.id) { header = prior.header; return prior }
+  if (prior && (prior.format !== 2 || prior.dev !== String(stat.dev) || prior.ino !== String(stat.ino) || prior.size >= sourceSize || prior.header.id !== request.id)) prior = undefined
+  let offset = prior?.scanned ?? 0, count = prior?.safeCount ?? 0
+  let validator: V4SessionStreamValidator | undefined
+  if (prior) { header = prior.header; validator = new V4SessionStreamValidator(header as unknown as SessionFormatHeader, KNOWN_SESSION_EVENT_TYPES, eventAt, prior.safeState) }
+  db.exec('BEGIN IMMEDIATE')
+  try {
+    if (!prior) db.exec('DELETE FROM entries')
+    else db.prepare('DELETE FROM entries WHERE seq>=?').run(count)
+    let scanned = offset, issueStart: number | undefined
+    let issue: Error | undefined
+    const replayUntil = count
+    const consume = (plain: Buffer, frameStart: number, frameEnd: number, torn: boolean): void => {
+      let start = 0
+      for (let newline = plain.indexOf(10); newline !== -1; newline = plain.indexOf(10, start)) {
+        const raw = plain.subarray(start, newline)
+        const at = start; start = newline + 1
+        if (!validator) {
+          const physical = JSON.parse(raw.toString('utf8')) as unknown
+          const decoded = releasedV4SessionFormatCodec.decodeHeader(physical)
+          if (decoded.id !== request.id) throw new Error('Native Session index source identity mismatch')
+          if (request.compression === 'zstd' && start !== plain.length) throw new Error('The first Zstandard frame must contain exactly one Session header')
+          header = decoded as unknown as SessionHeader
+          validator = new V4SessionStreamValidator(decoded, KNOWN_SESSION_EVENT_TYPES, eventAt)
+          continue
+        }
+        let parsed: unknown
+        try { parsed = JSON.parse(raw.toString('utf8')) } catch (error) { issueStart ??= frameStart; issue ??= error instanceof Error ? error : new Error(String(error)); continue }
+        assertV4RowAdmission(parsed, KNOWN_SESSION_EVENT_TYPES)
+        let event: SessionEvent
+        try { event = validateStoredEvents(header, [decodeV4IndexedEvent(parsed) as unknown as SessionEvent])[0]! }
+        catch (error) { if (error instanceof Error && error.name === 'SessionFormatUnsupportedError') throw error; issueStart ??= frameStart; issue ??= error instanceof Error ? error : new Error(String(error)); if ((parsed as { type?: unknown }).type === 'turn/end') throw issue; continue }
+        if (issue) { if (event.type === 'turn/end') throw issue; continue }
+        if (prior && frameStart === prior.scanned && event.seq < replayUntil) { remember(event, frameStart, frameEnd, at, newline, torn); continue }
+        if (event.seq !== count) { issueStart ??= frameStart; issue = new Error(`Native Session event sequence gap: expected ${count}, got ${event.seq}`); if (event.type === 'turn/end') throw issue; continue }
+        // Insert before lifecycle checks so referenced earlier records share one lookup.
+        remember(event, frameStart, frameEnd, at, newline, torn)
+        validator.accept(event as unknown as SessionFormatEvent)
+        ++count; ++indexedEvents
+      }
+      if (!torn && start !== plain.length) throw new Error('A complete compressed Session frame contains a torn JSONL record')
+    }
+    if (request.compression === 'none') {
+      let fragments: Buffer[] = [], fragmentBytes = 0, lineStart = offset
+      while (offset < sourceSize) {
+        const end = Math.min(sourceSize, offset + 64 * 1024), part = read(offset, end)
+        let from = 0
+        for (let newline = part.indexOf(10); newline !== -1; newline = part.indexOf(10, from)) {
+          const slice = part.subarray(from, newline + 1)
+          const line = fragments.length ? Buffer.concat([...fragments, slice], fragmentBytes + slice.length) : slice
+          const lineEnd = offset + newline + 1
+          consume(line, lineStart, lineEnd, false)
+          fragments = []; fragmentBytes = 0; lineStart = lineEnd; from = newline + 1
+          if (!issue) scanned = lineEnd
+        }
+        if (from < part.length) { const fragment = part.subarray(from); fragments.push(fragment); fragmentBytes += fragment.length }
+        offset = end
+      }
+    } else {
+      while (offset < sourceSize) {
+        const end = frameEnd(offset, sourceSize)
+        if (end === undefined) {
+          let prefix: Buffer = Buffer.alloc(0)
+          try { prefix = await decompressZstdPrefix(read(offset, sourceSize)) } catch { /* An incomplete frame header contains no completed rows. */ }
+          if (validator) consume(prefix, offset, sourceSize, true)
+          break
+        }
+        consume(zstdDecompressSync(read(offset, end)), offset, end, false)
+        offset = end
+        if (!issue) scanned = offset
+      }
+    }
+    if (!validator) throw new Error('Native Session has no complete current header')
+    const inherited = validator.finish(), state = validator.checkpoint(), safeState = state, safeCount = count
+    if (issueStart !== undefined) scanned = issueStart
+    const metadata: Metadata = { format: 2, generation: prior?.generation ?? randomUUID(), identity: revision, dev: String(stat.dev), ino: String(stat.ino), size: sourceSize, scanned,
+      count, header, state, safeState, safeCount }
+    if (inherited > count) throw new Error('Native Session inherited count exceeds its indexed prefix')
+    db.prepare('INSERT OR REPLACE INTO metadata VALUES(1,?)').run(JSON.stringify(metadata))
+    db.exec('COMMIT')
+    return metadata
+  } catch (error) { db.exec('ROLLBACK'); throw error }
+}
+
+function page(metadata: Metadata, input: SessionPageRequest): SessionPageResult {
+  assertSessionPageRequest(input)
+  const count = metadata.count, limit = Math.min(input.limit, input.maxEvents)
+  const start = input.around !== undefined ? Math.max(0, Math.min(count, input.around) - Math.floor(limit / 2))
+    : input.after !== undefined ? Math.min(count, input.after + 1) : Math.max(0, Math.min(count, input.before ?? count) - input.limit)
+  const end = input.after !== undefined || input.around !== undefined ? Math.min(count, start + limit) : Math.min(count, input.before ?? count)
+  const body = db.prepare('SELECT * FROM entries WHERE seq>=? AND seq<? ORDER BY seq').all(start, end) as unknown as EntryRow[]
+  for (;;) {
+  const selected = new Map<number, EntryRow>(body.map(row => [row.seq, row])), context = new Set<number>(), pending = [...body]
+  const add = (row: EntryRow | undefined): void => { if (!row || selected.has(row.seq)) return; selected.set(row.seq, row); context.add(row.seq); pending.push(row) }
+  const byType = db.prepare('SELECT * FROM entries WHERE type=? AND turn=? AND (? IS NULL OR step=?) AND seq<? ORDER BY seq LIMIT 1')
+  const call = db.prepare("SELECT * FROM entries WHERE type='tool/call' AND callId=? AND (? IS NULL OR turn=?) AND (? IS NULL OR step=?) AND seq<? ORDER BY seq DESC LIMIT 1")
+  const findCall = (id: string, row: EntryRow): EntryRow | undefined => call.get(id, row.turn, row.turn, row.step, row.step, count) as unknown as EntryRow | undefined
+  while (pending.length) {
+    const row = pending.pop()!
+    if (row.turn !== null) add(byType.get('turn/start', row.turn, null, null, count) as unknown as EntryRow | undefined)
+    if (row.turn !== null && row.step !== null) add(byType.get('step/start', row.turn, row.step, row.step, count) as unknown as EntryRow | undefined)
+    if (row.type === 'tool/result' && row.callId) add(findCall(row.callId, row))
+    if ((row.type === 'tool/call' || row.type === 'tool/result') && row.turn !== null && row.step !== null) {
+      for (const assistant of db.prepare("SELECT * FROM entries WHERE type='assistant/message' AND turn=? AND step=? AND seq<?").all(row.turn, row.step, count)) add(assistant as unknown as EntryRow)
+    }
+    for (const id of JSON.parse(row.calls) as string[]) add(findCall(id, row))
+    if (row.headerSeq !== null) add(get.get(row.headerSeq) as unknown as EntryRow | undefined)
+    if (selected.size > input.maxEvents) break
+  }
+  const dimension = selected.size > input.maxEvents ? 'events' : 'bytes'
+  if (dimension !== 'events') {
+    const events = [...selected.values()].sort((a, b) => a.seq - b.seq).map(original)
+    const first = body[0]?.seq, last = body.at(-1)?.seq
+    const result: SessionPageResult = { ...snapshot(metadata), events, context: [...context].sort((a, b) => a - b),
+      before: first ?? null, after: last ?? null, hasBefore: first === undefined ? start > 0 : first > 0, hasAfter: last === undefined ? end < count : last + 1 < count }
+    if (Buffer.byteLength(JSON.stringify(result)) <= input.maxBytes) return result
+  }
+  if (body.length <= 1) throw new SessionPageCapacityError(dimension, dimension === 'events' ? input.maxEvents : input.maxBytes)
+  if (input.after !== undefined) body.pop()
+  else if (input.around === undefined) body.shift()
+  else {
+    const first = body[0]!.seq, last = body.at(-1)!.seq
+    if (input.around - first > last - input.around) body.shift()
+    else body.pop()
+  }
+  }
+}
+
+function snapshot(metadata: Metadata): SessionReadIndex {
+  return { generation: metadata.generation, header: metadata.header, inheritedEventCount: (metadata.state.inheritedEventCount ?? 0) as SessionLogOffset,
+    revision: SessionPersistenceRevision(metadata.identity), eventCount: metadata.count }
+}
+async function run(): Promise<void> {
+  try {
+    const metadata = await ensureIndex()
+    db.exec('BEGIN')
+    let result: SessionPageResult | SessionReadIndex
+    try {
+      const current = JSON.parse(String(db.prepare('SELECT value FROM metadata WHERE id=1').get()!.value)) as Metadata
+      if (current.generation !== metadata.generation) throw new Error('The native source generation changed before its page read.')
+      result = request.page ? page(metadata, request.page) : snapshot(metadata)
+      db.exec('COMMIT')
+    } catch (error) { db.exec('ROLLBACK'); throw error }
+    parentPort!.postMessage({ ok: true, result, diagnostics: { sourceBytesRead, indexedEvents } })
+  } catch (error) { const failure = error instanceof Error ? error : new Error(String(error)); parentPort!.postMessage({ ok: false, name: failure.name, message: failure.message,
+    ...failure instanceof SessionPageCapacityError ? { dimension: failure.dimension, maximum: failure.maximum } : {} }) }
+  finally { db.close(); closeSync(fd); parentPort!.close() }
+}
+void run()
