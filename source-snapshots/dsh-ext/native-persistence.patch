+it('admits budgets only after adding dependencies and complete response metadata', async () => {
+  const source = await fixture('none')
+  const reduced = await readIndexedSession({ ...source, page: { ...request, maxEvents: 2 } }) as SessionPageResult
+  expect(reduced.events.map(event => event.seq)).toEqual([0, 5]); expect(reduced.before).toBe(5)
