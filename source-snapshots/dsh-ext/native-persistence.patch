+  expect(result.context).toEqual([0, 2, 3, 4]); expect(result.before).toBe(5); expect(result.after).toBe(5)
+  await expect(readIndexedSession({ ...source, page: { ...request, around: 5, limit: 1, maxBytes: 100_000 } })).rejects.toThrow('maxBytes')
+})
+it('a torn compressed frame preserves complete events and repaired physical offsets without rereading old frames', async () => {
+  const source = await fixture('zstd')
+  const events = oneTurnLog().map(event => ({ ...event, seq: SessionSeq(event.seq + 6),
