+/** Native files and actual worker/index IO; no Session runtime or display projection is substituted. */
+import { afterEach, expect, it } from 'vitest'
+import { mkdtemp, rm, writeFile, appendFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session'
+import { meta, oneTurnLog } from '../../session-persistence/tests/contract.ts'
+import { readIndexedSession } from '../src/read-index.ts'
+import { eventLines, toHeaderLine } from '../src/format.ts'
+import { compressZstdFrame } from '../src/zstd.ts'
+import type { SessionPageResult } from '@deepseek-ai/dsh-session-persistence'
+const roots: string[] = []
+afterEach(async () => { for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true }) })
+const request = { limit: 2, maxEvents: 100, maxBytes: 1024 * 1024 }
+async function fixture(compression: 'none' | 'zstd', events = oneTurnLog()) {
+  const root = await mkdtemp('/mnt/cache/data-cache/dsh-read-index-'); roots.push(root)
+  const header = meta('indexed-session'), path = join(root, compression === 'none' ? 'log.v4.jsonl' : 'log.v4.jsonl.zstd')
+  const first = JSON.stringify(toHeaderLine(header)) + '\n', body = eventLines(events) + '\n'
+  await writeFile(path, compression === 'none' ? first + body : Buffer.concat([await compressZstdFrame(first), await compressZstdFrame(body)]))
+  return { path, id: header.id, compression }
+}
+it.each(['none', 'zstd'] as const)('reads exact native dependency context and extends only the appended %s prefix', async compression => {
+  const source = await fixture(compression)
+  const first = await readIndexedSession({ ...source, page: request }) as SessionPageResult
+  expect(first.eventCount).toBe(6)
+  expect(first.events.map(event => event.seq)).toEqual([0, 2, 4, 5])
+  expect(first.context).toEqual([0, 2]); expect(first.before).toBe(4); expect(first.after).toBe(5)
+  const next = oneTurnLog().map(event => ({ ...event, seq: SessionSeq(event.seq + 6), data: event.type === 'turn/start' || event.type === 'turn/end' ? { ...event.data, turn: 2 }
+    : event.type.startsWith('step/') || event.type === 'assistant/message' ? { ...event.data, turn: 2 } : event.data })) as SessionEvent[]
+  const body = eventLines(next) + '\n'
+  await appendFile(source.path, compression === 'none' ? body : await compressZstdFrame(body))
+  const second = await readIndexedSession({ ...source, page: request }) as SessionPageResult
+  expect(second.generation).toBe(first.generation)
+  expect(second.eventCount).toBe(12); expect(second.events.map(event => event.seq)).toEqual([6, 8, 10, 11])
+  const db = new DatabaseSync(`${source.path}.read-index.sqlite`)
+  try { expect(db.prepare('SELECT count(*) AS n FROM entries').get()?.n).toBe(12); expect(db.prepare('PRAGMA table_info(entries)').all().some(row => row.name === 'data')).toBe(false) }
+  finally { db.close() }
+})
+it('keeps a valid raw prefix before a torn row and refuses a complete invalid lifecycle', async () => {
+  const source = await fixture('none')
+  await appendFile(source.path, '{"type":"turn/start"')
+  expect((await readIndexedSession({ ...source, page: request })).eventCount).toBe(6)
+  const bad = [...oneTurnLog(), { type: 'step/start', seq: SessionSeq(6), time: 7, data: { turn: 2, step: 1 } }] as SessionEvent[]
+  await writeFile(source.path, JSON.stringify(toHeaderLine(meta(source.id))) + '\n' + eventLines(bad) + '\n')
