+
+
+it('source replacement changes the opaque generation even with the same count and creation time', async () => {
+  const source = await fixture('none'), original = await readIndexedSession({ ...source, page: request }) as SessionPageResult
+  expect(original.generation).toMatch(/^[0-9a-f-]{36}$/)
+  const fs = await import('node:fs/promises'), body = await fs.readFile(source.path, 'utf8')
+  await fs.writeFile(source.path, body.replace('"hi"', '"yo"'))
+  const rewritten = await readIndexedSession({ ...source, page: request }) as SessionPageResult
+  expect(rewritten.eventCount).toBe(original.eventCount); expect(rewritten.header.createdAt).toBe(original.header.createdAt)
+  expect(rewritten.generation).not.toBe(original.generation)
+  const replacement = source.path + '.replacement'
+  await fs.writeFile(replacement, body)
+  await fs.rename(replacement, source.path)
+  const replaced = await readIndexedSession({ ...source, page: request }) as SessionPageResult
+  expect(replaced.generation).not.toBe(rewritten.generation)
+})
