+/** Optional bounded, dependency-complete access to an existing native Session log. */
+import type { SessionEvent, SessionHeader, SessionId, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import type { SessionPersistenceRevision } from './revision.ts'
+
+/** Body range and complete-result admission budgets; dependencies never advance body cursors. */
+export interface SessionPageRequest {
+  readonly before?: number
+  readonly after?: number
+  readonly around?: number
+  readonly limit: number
+  readonly maxEvents: number
+  readonly maxBytes: number
+}
+/** Cancellation for source-side indexing and page reads. */
+export interface SessionPageOptions { readonly signal?: AbortSignal }
+/** One validated, fixed native prefix; a concurrent append does not invalidate its earlier events. */
+export interface SessionReadIndex {
+  /** Append-stable source generation, changed when an existing prefix is replaced. */
+  readonly generation: string
+  readonly header: SessionHeader
+  readonly inheritedEventCount: SessionLogOffset
+  readonly revision: SessionPersistenceRevision
+  readonly eventCount: number
+}
+/** A contiguous native body range plus its exact display dependencies in native sequence order. */
+export interface SessionPageResult extends SessionReadIndex {
+  readonly events: readonly SessionEvent[]
+  readonly context: readonly number[]
+  readonly before: number | null
+  readonly after: number | null
+  readonly hasBefore: boolean
+  readonly hasAfter: boolean
+}
+/** Optional provider capability; never obtains execution or write ownership. */
+export type SessionPageReader = (id: SessionId, request: SessionPageRequest, options?: SessionPageOptions) => Promise<SessionPageResult>
+/** Explicit indexing preparation for operators and consumers that need bounded subsequent pages. */
+export type SessionReadIndexPreparer = (id: SessionId, options?: SessionPageOptions) => Promise<SessionReadIndex>
+
+/** One atomic native event and its dependencies exceed the caller's complete-page budget. */
+export class SessionPageCapacityError extends Error {
+  readonly code = 'CAPACITY_EXCEEDED' as const
+  /**
+   * @param dimension - complete result dimension that could not be admitted.
+   * @param maximum - caller-supplied maximum in events or UTF-8 bytes.
+   */
+  constructor(readonly dimension: 'events' | 'bytes', readonly maximum: number) {
+    super(`One native history item and its dependencies exceed ${dimension === 'events' ? 'maxEvents' : 'maxBytes'} (${maximum}).`)
+    this.name = 'SessionPageCapacityError'
+  }
+}
+
+/**
+ * Validate a native body range and complete-result budgets before source IO.
+ * @param request - source page selection and caller-supplied admission limits.
+ * @returns nothing after a valid single-cursor request.
+ */
+export function assertSessionPageRequest(request: SessionPageRequest): void {
+  for (const key of ['limit', 'maxEvents', 'maxBytes'] as const) {
+    if (!Number.isSafeInteger(request[key]) || request[key] < 1) throw new TypeError(`Invalid native page ${key}`)
+  }
+  for (const key of ['before', 'after', 'around'] as const) {
+    const value = request[key]
+    if (value !== undefined && (!Number.isSafeInteger(value) || value < 0)) throw new TypeError(`Invalid native page ${key}`)
+  }
+  if ([request.before, request.after, request.around].filter(value => value !== undefined).length > 1) throw new TypeError('A native page accepts one cursor')
+}
