+/** Native full and sparse validation share one lifecycle implementation and retain open transactions. */
+import { expect, it } from 'vitest'
+import type { SessionFormatEvent, SessionFormatHeader } from '@deepseek-ai/dsh-session-format'
+import { V4SessionStreamValidator, decodeV4IndexedEvent, releasedV4SessionFormatCodec, restoreReleasedV4Artifact } from '../src/index.ts'
+const header: SessionFormatHeader = { version: 4, id: 'stream', createdAt: 1, isSeeded: false, delegationDepth: 0 }
+const known = new Set(['turn/start', 'step/start', 'assistant/message', 'tool/call', 'tool/result', 'step/end', 'turn/end', 'feedback/record', 'session/end-seed', 'session-log-deepseek/delivery-accepted', 'subagent/catalog'])
+const events: SessionFormatEvent[] = [
+  { type: 'turn/start', seq: 0, time: 1, data: { turn: 1 } },
+  { type: 'step/start', seq: 1, time: 1, data: { turn: 1, step: 1 } },
+  { type: 'assistant/message', seq: 2, time: 1, surfaceOp: 'append', data: { turn: 1, step: 1, message: { id: 'assistant', role: 'assistant', source: { kind: 'model', provider: 'mock', model: 'mock' }, content: [{ type: 'tool-call', id: 'call', name: 'bash', arguments: '{}' }] } } },
+  { type: 'tool/call', seq: 3, time: 1, data: { turn: 1, step: 1, callId: 'call', name: 'bash', arguments: '{}' } },
+  { type: 'tool/result', seq: 4, time: 1, surfaceOp: 'append', data: { turn: 1, step: 1, message: { id: 'result', role: 'tool', source: { kind: 'tool', callId: 'call' }, toolCallId: 'call', isError: false, content: [{ type: 'text', text: 'ok' }] } } },
+  { type: 'step/end', seq: 5, time: 1, data: { turn: 1, step: 1 } },
+  { type: 'turn/end', seq: 6, time: 1, data: { turn: 1, reason: { kind: 'completed' } } },
+]
+it('resumes each native tool lifecycle checkpoint without retaining closed transcript bodies', () => {
+  restoreReleasedV4Artifact({ header, events, inheritedEventCount: 0 }, known)
+  for (let split = 1; split < events.length; ++split) {
+    const first = new V4SessionStreamValidator(header, known, seq => events[seq])
+    for (const event of events.slice(0, split)) first.accept(event)
+    const checkpoint = JSON.parse(JSON.stringify(first.checkpoint()))
+    const second = new V4SessionStreamValidator(header, known, seq => events[seq], checkpoint)
+    for (const event of events.slice(split)) second.accept(event)
+    expect(second.finish()).toBe(0)
+    expect(JSON.stringify(second.checkpoint())).not.toContain('assistant')
+  }
+  const first = new V4SessionStreamValidator(header, known, seq => events[seq])
+  for (const event of events.slice(0, 3)) first.accept(event)
+  const resumed = new V4SessionStreamValidator(header, known, seq => events[seq], first.checkpoint())
+  expect(() => resumed.accept({ ...events[3]!, data: { ...events[3]!.data as object, name: 'wrong-tool' } })).toThrow('advertised')
+})
+it('keeps inherited delivery and catalog exemptions until the last inherited marker', () => {
+  const h = { ...header, isSeeded: true, parentSession: 'parent' }
+  const inherited: SessionFormatEvent[] = [
+    { type: 'feedback/record', seq: 0, time: 1, data: { text: 'seed' } },
+    { type: 'session-log-deepseek/delivery-accepted', seq: 1, time: 1, data: { sessionId: 'parent', throughSeq: 0, sessionFormatVersion: 4 } },
+    { type: 'session/end-seed', seq: 2, time: 1, data: { inherited: true } },
+  ]
+  const first = new V4SessionStreamValidator(h, known, seq => inherited[seq])
+  first.accept(inherited[0]!); first.accept(inherited[1]!)
+  const resumed = new V4SessionStreamValidator(h, known, seq => inherited[seq], JSON.parse(JSON.stringify(first.checkpoint(false))))
+  resumed.accept(inherited[2]!); expect(resumed.finish()).toBe(2)
+  const ownBad = { ...inherited[1]!, seq: 3, data: { sessionId: 'another', throughSeq: 0, sessionFormatVersion: 4 } }
+  resumed.accept(ownBad); expect(() => resumed.finish()).toThrow('wrong Session')
+})
+it('independently addressed physical rows preserve native compressed provenance ranges', () => {
+  const event: SessionFormatEvent = { type: 'feedback/record', seq: 5, time: 1, data: { text: 'reference' }, sourceEventSeqs: [0, 1, 2, 4] }
+  expect(decodeV4IndexedEvent(releasedV4SessionFormatCodec.encodeEvent(event))).toEqual(event)
+  expect(() => decodeV4IndexedEvent({ ...event, sourceEventSeqs: [[0, 6]] })).toThrow('range')
+  expect(() => decodeV4IndexedEvent({ ...event, sourceEventSeqs: [[0, 2], 2] })).toThrow('unique')
+})
