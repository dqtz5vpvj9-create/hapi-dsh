+import { expect, it, vi } from 'vitest'
+import { UiWorkspaceService } from '../src/client/navigation.ts'
+
+async function fixture(restoreSelection?: boolean) {
+  const ctx = new Context(), workspaceId = 'fixture-workspace' as WorkspaceId
+  const list = createSnapshotStore<SessionListState>({ phase: 'ready', ids: [], byId: {}, projectionsBySession: {} })
+  const workspace = createSnapshotStore<WorkspaceSnapshot>({ phase: 'ready', state: 'idle', error: null,
+    items: [{ workspaceId, path: '/fixture', title: 'Fixture', sessionIds: [], createdAt: '2026-01-01T00:00:00.000Z', updatedAt: '2026-01-01T00:00:00.000Z' }],
+    archivedSessionIds: [], pinnedSessionIds: [] })
+  const create = vi.fn(async () => 'created' as SessionId), release = vi.fn()
+  const retain = vi.fn((target: SessionId) => ({ sessionId: target, release }))
+  const sessions = { list, create, retain, subagentAddress: () => undefined } as unknown as ISessions
+  const workspaces = { list: workspace } as unknown as IWorkspaces
+  ctx.provide('layout', { beginNavigation: () => new AbortController().signal, selectPanel: vi.fn() } as never)
+  await ctx.plugin({ apply(owner: Context) {
+    new UiWorkspaceService(owner, {} as never, workspaces, sessions, { pinSessionOrder() {} }, () => {}, restoreSelection)
+  } }).await()
+  return { ctx, workspaceId, list, workspace, create, retain, release }
+}
+
+it('default Workspace navigation still restores a blank through the ordinary Session owner', async () => {
+  const f = await fixture()
+  try { await vi.waitFor(() => expect(f.create).toHaveBeenCalledExactlyOnceWith({ workspaceId: f.workspaceId })) }
