+// @vitest-environment jsdom
+
+import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { ChatFlowVirtualization, ChatFlowVirtualRows } from '../src/client/contract/slots.ts'
+import { VirtualChatRows, type VirtualChatRow } from '../src/client/chat/VirtualChatRows.tsx'
+
+const observers = new Map<Element, Set<ResizeObserverCallback>>()
+
+class ResizeObserverStub implements ResizeObserver {
+  private readonly targets = new Set<Element>()
+  constructor(private readonly callback: ResizeObserverCallback) {}
+  observe(target: Element): void {
+    this.targets.add(target)
+    const callbacks = observers.get(target) ?? new Set<ResizeObserverCallback>()
+    callbacks.add(this.callback)
+    observers.set(target, callbacks)
+  }
+  unobserve(target: Element): void {
+    observers.get(target)?.delete(this.callback)
+    this.targets.delete(target)
+  }
+  disconnect(): void { for (const target of this.targets) this.unobserve(target) }
+}
+
+function notify(target: Element, width: number, height: number): void {
+  const size = [{ inlineSize: width, blockSize: height }]
+  const entry = {
+    target,
+    borderBoxSize: size,
+    contentBoxSize: size,
+    devicePixelContentBoxSize: size,
+    contentRect: new DOMRectReadOnly(0, 0, width, height),
+  } as ResizeObserverEntry
+  for (const callback of [...(observers.get(target) ?? [])]) callback([entry], {} as ResizeObserver)
+}
+
+afterEach(() => {
+  cleanup()
+  observers.clear()
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+it('keeps a small reading window mounted while a long transcript scrolls without dropping loaded rows', async () => {
+  vi.stubGlobal('ResizeObserver', ResizeObserverStub)
+  const scroller = document.createElement('div')
+  const mount = document.createElement('div')
+  scroller.append(mount)
+  document.body.append(scroller)
+  Object.defineProperties(scroller, {
+    clientHeight: { configurable: true, value: 400 },
+    clientWidth: { configurable: true, value: 800 },
+    scrollHeight: { configurable: true, value: 30_000 },
+  })
+  let rowReads = 0, listReads = 0, hidden = false, width = 800
+  scroller.getBoundingClientRect = () => new DOMRect(0, 0, hidden ? 0 : width, hidden ? 0 : 400)
+
+  const heights = new Map<number, number>()
+  const originalRects = HTMLElement.prototype.getClientRects
+  vi.spyOn(HTMLElement.prototype, 'getClientRects').mockImplementation(function (this: HTMLElement) {
+    if (this.hasAttribute('data-chat-virtual-rows') || this.hasAttribute('data-chat-virtual-row')) {
+      if (hidden) return [] as unknown as DOMRectList
+      return [this.getBoundingClientRect()] as unknown as DOMRectList
+    }
+    return originalRects.call(this)
+  })
+  vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockImplementation(function (this: HTMLElement) {
+    if (this === scroller) return new DOMRect(0, 0, hidden ? 0 : width, hidden ? 0 : 400)
