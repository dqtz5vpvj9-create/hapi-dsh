+// @vitest-environment jsdom
+
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { useLayoutEffect, useMemo } from 'react'
+import { ChatViewport } from '../src/client/chat/use-chat-viewport.ts'
+import { useChatScroll, type ChatScrollInput } from '../src/client/chat/use-chat-scroll.ts'
+import { afterEach, expect, it, vi } from 'vitest'
+import { SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { ChatFlowVirtualRows, ChatScrollPosition } from '../src/client/contract/slots.ts'
+import { VirtualChatRows, type VirtualChatRow } from '../src/client/chat/VirtualChatRows.tsx'
+
+const observers = new Map<Element, Set<ResizeObserverCallback>>()
+const pendingObservations = new Set<Element>()
+
+class ResizeObserverStub implements ResizeObserver {
+  private readonly targets = new Set<Element>()
+  constructor(private readonly callback: ResizeObserverCallback) {}
