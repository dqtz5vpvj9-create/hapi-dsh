+/** Resource-owned user terminals with explicit execution providers and detachable physical streams. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { SubprocessRuntime } from '@deepseek-ai/dsh-subprocess'
+import { RemoteError, type RemoteUplinkWindow } from '@deepseek-ai/dsh-typert-protocol'
+import { discoverShells, resolveShell } from './shells.ts'
+import { BrowserTerminal } from './terminal.ts'
+import { TerminalRetention } from './retention.ts'
+import type { Config } from './index.ts'
+import type { TerminalCreateRequest, TerminalEnvironment, TerminalFrame, TerminalInput, TerminalRetentionFrame,
+  TerminalShell, WebTerminalId, WebTerminalInfo } from './types.ts'
+
+/** Execution-world services and the Session address carried into a user shell's environment. */
+export interface TerminalOwnerSpec {
+  readonly id: SessionId
+  readonly subprocess: SubprocessRuntime
+  readonly cwd: {
+    /** @returns the effective directory without filesystem I/O. */
+    get(): string
+    /**
+     * Validate the directory before a new allocation; existing terminals keep their directories.
+     * @param signal - allocation cancellation.
+     * @returns the validated source directory.
+     */
+    ensure(signal: AbortSignal): Promise<string>
+  }
+}
+
+/** One owner retains its processes independently of browser views and physical attachments. */
+export interface TerminalOwnerController {
+  /**
+   * Read current directory and limits without shell discovery or directory validation.
+   * @param signal - request cancellation.
+   * @returns the effective directory and validated deployment limits.
+   */
+  environment(signal: AbortSignal): TerminalEnvironment
+  /**
+   * Discover verified shells in this owner's execution environment.
+   * @param signal - discovery cancellation.
+   * @returns the configured or system default followed by available candidates.
+   */
+  shells(signal: AbortSignal): Promise<TerminalShell[]>
+  /** @returns this owner's retained terminals and failed allocations, without creating a process. */
+  list(): WebTerminalInfo[]
+  /**
+   * Allocate once per open identity; closed identities cannot be reused.
+   * @param request - caller-generated identity and initial dimensions.
+   * @param signal - allocation cancellation; committed processes survive disconnection.
+   * @returns the existing or newly committed terminal.
+   */
+  create(request: TerminalCreateRequest, signal: AbortSignal): Promise<WebTerminalInfo>
+  /**
+   * Keep an existing process for one window without acquiring input control.
+   * @param id - retained terminal identity.
+   * @param signal - physical hold lifetime.
+   * @returns a hold acknowledgement followed by an open lifetime stream.
+   */
+  retain(id: WebTerminalId, signal: AbortSignal): AsyncIterable<TerminalRetentionFrame>
+  /**
+   * Attach one physical input/output stream; newer attachments acquire input control.
+   * @param id - retained terminal identity.
+   * @param input - decoded commands; iterator return must interrupt pending reads.
+   * @param signal - attachment cancellation; never terminates the process.
+   * @param inputWindow - carrier frame capacity; omit for carriers without an encoded-frame inbox limit.
+   * @returns screen recovery, ordered output, control state and provider-acceptance acknowledgements.
+   */
+  attach(id: WebTerminalId, input: AsyncIterable<TerminalInput>, signal: AbortSignal,
+    inputWindow?: RemoteUplinkWindow): AsyncIterable<TerminalFrame>
+  /**
+   * Rename without changing the process.
+   * @param id - retained terminal identity.
+   * @param title - nonempty display name, at most 120 characters.
+   */
+  rename(id: WebTerminalId, title: string): void
+  /**
+   * Exclude an identity from future creation and await its process cleanup.
+   * @param id - terminal identity, including a pending or not-yet-created identity.
+   * @returns after successful cleanup; failure retains the resource for explicit retry.
+   */
+  close(id: WebTerminalId): Promise<void>
+  /** @returns after pending allocation, process and stream cleanup; concurrent calls share cleanup and failures remain retryable. */
+  dispose(): Promise<void>
+}
+
+/**
+ * Bind user terminal resources to an actual plugin scope without creating an execution Agent.
+ * Call once per owner and retain the returned controller across view and connection lifetimes.
+ * User shells keep the subprocess provider's system-user permissions and credential-environment scrub.
+ * @param scope - actual resource-owner scope; disposal awaits owned process cleanup.
+ * @param owner - Session address, same-world subprocess provider and current/validated directory callbacks.
+ * @param config - deployment limits normalized through TerminalController.Config.
+ * @returns the owner controller; explicit dispose and scope disposal share retryable cleanup.
+ */
+export function createTerminalOwner(scope: Context, owner: TerminalOwnerSpec, config: Config): TerminalOwnerController {
+  const terminals = new OwnedTerminals(scope, owner, config)
+  scope.effect(() => async () => { await terminals.dispose() }, 'terminal-controller.owner')
+  return terminals
+}
+
+interface TerminalAllocation {
+  info: WebTerminalInfo
+  readonly cleanup: TerminalRetention
+}
+
+/** Shared implementation for the Agent facade and explicit resource-owner factory. */
+export class OwnedTerminals implements TerminalOwnerController {
+  private readonly lifetime = new AbortController()
+  private readonly closedIds = new Set<WebTerminalId>()
+  private readonly terminals = new Map<WebTerminalId, BrowserTerminal>()
+  private readonly pending = new Map<WebTerminalId, Promise<BrowserTerminal>>()
+  private readonly allocations = new Map<WebTerminalId, TerminalAllocation>()
+  private cleanup?: Promise<void>
+
+  /**
+   * @param ctx - source resource scope supplying diagnostics.
+   * @param spec - explicit execution services and Session address.
+   * @param config - normalized deployment limits.
+   */
+  constructor(private readonly ctx: Context, private readonly spec: TerminalOwnerSpec, private readonly config: Config) {}
+
+  environment(signal: AbortSignal): TerminalEnvironment { return terminalEnvironment(this.spec, this.config, signal) }
+
+  shells(signal: AbortSignal): Promise<TerminalShell[]> {
+    signal.throwIfAborted()
+    return discoverShells(this.spec.subprocess, this.config.shell, this.config.shellCandidates, signal)
+  }
+
+  list(): WebTerminalInfo[] {
+    return [...this.terminals.values(), ...this.allocations.values()].map(terminal => terminal.info)
+  }
+
+  async create(request: TerminalCreateRequest, signal: AbortSignal): Promise<WebTerminalInfo> {
+    this.lifetime.signal.throwIfAborted()
+    validateTerminalCreate(request, this.config)
+    this.requireOpen(request.id)
+    const existing = this.terminals.get(request.id)
+    if (existing !== undefined) return existing.info
+    const pending = this.pending.get(request.id)
+    if (pending !== undefined) {
+      const terminal = await pending
+      this.requireOpen(request.id)
+      return terminal.info
+    }
+    if (new Set([...this.terminals.keys(), ...this.pending.keys(), ...this.allocations.keys()]).size >= this.config.maxTerminals) throw new RemoteError('terminal/limit-reached', 'Session terminal limit reached', { limit: this.config.maxTerminals })
+    const allocation = this.spawn(request, AbortSignal.any([signal, this.lifetime.signal]))
+    this.pending.set(request.id, allocation)
+    try {
+      const terminal = await allocation
+      this.terminals.set(request.id, terminal)
+      this.allocations.delete(request.id)
+      terminal.monitor(this.config, () => { this.closedIds.add(request.id) }, () => {
+        this.terminals.delete(request.id)
+      }, (error) => { this.ctx.logger.error('Browser terminal cleanup failed', error) })
+      this.requireOpen(request.id)
+      return terminal.info
+    } finally {
+      this.pending.delete(request.id)
+    }
+  }
+
+  retain(id: WebTerminalId, signal: AbortSignal): AsyncIterable<TerminalRetentionFrame> {
+    const terminal = this.terminals.get(id)
+    if (terminal === undefined || this.closedIds.has(id) || this.lifetime.signal.aborted) {
+      throw new RemoteError('terminal/unavailable', 'Terminal is closing or unavailable', {})
+    }
+    return terminal.retain(signal)
+  }
+
+  attach(id: WebTerminalId, input: AsyncIterable<TerminalInput>, signal: AbortSignal,
+    inputWindow?: RemoteUplinkWindow): AsyncIterable<TerminalFrame> {
+    return this.terminal(id).attach(input, this.config, signal, inputWindow)
+  }
+
+  rename(id: WebTerminalId, title: string): void {
+    if (title.trim().length === 0 || title.length > 120) throw new Error('Terminal title must contain 1–120 characters')
+    this.terminal(id).rename(title.trim())
+  }
+
+  async close(id: WebTerminalId): Promise<void> {
+    this.closedIds.add(id)
+    // create publishes the allocation before this wait settles; close owns it even if create then rejects.
+    await this.pending.get(id)?.catch(() => { /* Creation reports its failure; close still owns any allocated process. */ })
+    const terminal = this.terminals.get(id)
+    if (terminal !== undefined) {
+      await terminal.close()
+      this.terminals.delete(id)
+    } else {
+      const allocation = this.allocations.get(id)
+      if (allocation === undefined) return
+      await allocation.cleanup.close()
+      this.allocations.delete(id)
+    }
+  }
+
+  dispose(): Promise<void> {
+    if (this.cleanup !== undefined) return this.cleanup
+    this.lifetime.abort(new Error('Terminal Session owner disposed'))
+    this.cleanup = (async () => {
+      await Promise.allSettled(this.pending.values())
+      const results = await Promise.allSettled([
+        ...[...this.terminals.values()].map(terminal => terminal.dispose()),
+        ...[...this.allocations.values()].map(allocation => allocation.cleanup.dispose()),
+      ])
+      const errors = results.filter(result => result.status === 'rejected').map(result => result.reason as unknown)
+      if (errors.length > 0) throw new AggregateError(errors, 'Session terminal cleanup failed')
+      this.terminals.clear()
+      this.allocations.clear()
+    })().catch((error: unknown) => { delete this.cleanup; throw error })
+    return this.cleanup
+  }
+
+  private terminal(id: WebTerminalId): BrowserTerminal {
+    const terminal = this.terminals.get(id)
+    if (terminal === undefined) throw new RemoteError('terminal/unavailable', 'Terminal no longer exists in this Session', {})
+    this.requireOpen(id)
+    return terminal
+  }
+
+  private requireOpen(id: WebTerminalId): void {
+    if (this.closedIds.has(id)) throw new RemoteError('terminal/unavailable', 'Terminal was closed in this Session', {})
+  }
+
+  private async spawn(request: TerminalCreateRequest, signal: AbortSignal): Promise<BrowserTerminal> {
+    const { subprocess } = this.spec
+    const cwd = await this.spec.cwd.ensure(signal)
+    const shell = request.shellPath === undefined
+      ? await resolveShell(subprocess, this.config.shell, signal)
+      : (await this.shells(signal)).find(candidate => candidate.path === request.shellPath)
+    if (shell === undefined) throw new Error('Selected shell is not available in this execution environment')
+    const handle = await subprocess.spawnTerminal({
+      argv: [shell.path, ...shell.args], cwd, cols: request.cols, rows: request.rows,
+      terminalType: 'xterm-256color', env: { DSH_SESSION_ID: this.spec.id },
+      shellActivity: true,
+      graceMs: this.config.disposeGraceMs, signal,
+    })
+    const info: WebTerminalInfo = {
+      id: request.id, shell, title: shell.name, cwd,
+      cols: request.cols, rows: request.rows, state: 'running', exitCode: null,
+    }
+    try {
+      signal.throwIfAborted()
+      return new BrowserTerminal(handle, info, this.config.scrollback, this.config.maxBufferedBytes)
+    } catch (error) {
+      const cleanup = new TerminalRetention(this.config, handle.inspectActivity.bind(handle), async () => {
+        this.closedIds.add(request.id)
+        await handle.terminate()
+        this.allocations.delete(request.id)
+      }, (cleanupError) => { this.ctx.logger.error('Browser terminal allocation cleanup failed', cleanupError) })
+      this.allocations.set(request.id, {
+        info: { ...info, state: 'failed', error: error instanceof Error ? error.message : String(error) }, cleanup,
+      })
+      try {
+        await cleanup.close()
+      } catch (cleanupError) {
+        throw new AggregateError([error, cleanupError], 'Terminal allocation cleanup failed')
+      }
+      throw error
+    }
+  }
+}
+
+/**
+ * Read directory and limits without allocating an owner or validating its directory.
+ * @param owner - selected execution world.
+ * @param config - validated deployment limits.
+ * @param signal - request cancellation.
+ * @returns directory and terminal limits.
+ */
+export function terminalEnvironment(owner: TerminalOwnerSpec, config: Config, signal: AbortSignal): TerminalEnvironment {
+  signal.throwIfAborted()
+  return { cwd: owner.cwd.get(), maxInputBytes: config.maxInputBytes, maxBufferedBytes: config.maxBufferedBytes,
+    maxCols: config.maxCols, maxRows: config.maxRows, scrollback: config.scrollback }
+}
+
+/**
+ * Validate a caller-generated identity and initial dimensions before acquiring its owner.
+ * @param request - initial allocation request.
+ * @param config - validated terminal limits.
+ */
+export function validateTerminalCreate(request: TerminalCreateRequest, config: Config): void {
+  if (!/^[\w-]{1,128}$/u.test(request.id)) throw new Error('Invalid terminal identity')
+  if (!Number.isSafeInteger(request.cols) || request.cols < 2 || request.cols > config.maxCols
+    || !Number.isSafeInteger(request.rows) || request.rows < 1 || request.rows > config.maxRows) throw new Error('Terminal dimensions exceed the configured limits')
+}
