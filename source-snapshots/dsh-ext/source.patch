+  /** Stable window (Pane) identity this coordinator is bound to. */
+  readonly windowId: string
+  /** Revision of the window currently published. */
+  readonly revision: number
+  /**
+   * Build and validate the candidate derived state for one snapshot.
+   * @param snapshot - validated provider snapshot.
+   * @returns the candidate and its derived node count.
+   */
+  buildCandidate(snapshot: HistorySnapshotV1): WindowCandidateV1<Candidate>
+  /**
+   * Perform the official layout commit of one candidate.
+   * @param candidate - state returned by `buildCandidate`.
+   * @param layout - revision and reader measurement of this commit.
