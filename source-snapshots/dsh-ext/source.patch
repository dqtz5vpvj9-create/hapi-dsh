diff --git a/packages/api/session-controller/src/client/contract/window-commit.ts b/packages/api/session-controller/src/client/contract/window-commit.ts
new file mode 100644
index 00000000..539bfd14
--- /dev/null
+++ b/packages/api/session-controller/src/client/contract/window-commit.ts
@@ -0,0 +1,292 @@
+/**
+ * Optional window-commit extension: prepare one bounded history window off the
+ * critical path, then publish it atomically against the official reader.
+ *
+ * A window owner (the official Pane history scope) creates one coordinator per
+ * reading window through {@link WindowCommitFactoryV1}. `prepare()` validates
+ * the provider snapshot and builds the candidate derived state; the returned
+ * token is created by this coordinator, bound to that window, and consumed by
+ * exactly one {@link WindowCommitV1.commitWindow} call. A caller can neither
+ * construct a valid token nor replay a spent one.
+ *
+ * `commitWindow()` opens one synchronous critical section: it measures the
+ * official reader, publishes the prepared candidate through the owner's layout
+ * commit, and lets the measured readers correct their own position in the same
+ * task, before the browser paints. No promise is awaited between the final
+ * cancellation check and the end of the correction, so no request can be
+ * started or settled inside the commit. Cancellation before that checkpoint
+ * rejects with an `AbortError` and leaves the old window published; once the
+ * checkpoint passed, cancellation no longer rolls the commit back.
+ *
+ * Completion has two facts, and they are never merged: whether the layout
+ * publish happened (`committed`, with `revision`) and whether every measured
+ * reader applied its correction (`correction`). A reader correction that throws
+ * after the publish is reported as `correction: 'failed'` — the commit is not
+ * rolled back, but it is also never reported as a clean success. A measurement
+ * failure happens before the publish and therefore still rejects the commit,
+ * keeping the old window.
+ *
+ * Failures use the shared V1 codes from the history-source extension and always
+ * keep the current published window: `STALE_VERSION`, `INVALID_WINDOW`,
+ * `CAPACITY_EXCEEDED`, `TARGET_UNAVAILABLE`, `DISPOSED`. Cancellation rejects
+ * with an `AbortError` instead.
+ */
+import type {
+  Budget,
+  HistorySnapshotV1,
+  HistorySourceFailureCode,
+  Stop,
+} from './history-source.ts'
+
+export type {
+  Budget as WindowCommitBudget,
+  HistorySnapshotV1,
+  Stop as WindowCommitStop,
+} from './history-source.ts'
+
+/** One prepared transaction token created by the official coordinator. */
+export interface PreparedWindowV1 {
+  /** Revision of the window when the candidate was built. */
+  readonly baseRevision: number
+  /** Revision the window takes when this candidate publishes. */
+  readonly nextRevision: number
+  /** Coordinator-created, window-bound, single-use transaction token. */
+  readonly token: symbol
+}
+
+/**
+ * Outcome of the post-publish reader corrections of one commit. `applied` means
+ * every measured reader re-applied its own position; `failed` carries the first
+ * rejection and means the layout stands while the reading position may be off.
+ */
+export type WindowCommitCorrectionV1 =
+  | { readonly correction: 'applied' }
+  | { readonly correction: 'failed'; readonly correctionError: Error }
+
+/**
+ * Result of one linearized window commit. `committed: true` and `revision`
+ * state that the layout publish already happened: the previous window is gone
+ * and cannot be rolled back, even when the correction failed. Callers use
+ * `correction` to decide whether to retry the reader correction; a failed
+ * correction is a committed-but-uncorrected window, never a successful commit.
+ */
+export type WindowCommitResultV1 = {
+  readonly committed: true
+  readonly revision: number
+} & WindowCommitCorrectionV1
+
+/** Transactional window publisher used by one reading window. */
+export interface WindowCommitV1 {
+  readonly version: 1
+  /**
+   * Validate one provider snapshot and build its candidate derived state.
+   * @param snapshot - provider snapshot to publish, current at `snapshot.version`.
+   * @param signal - caller cancellation; rejects with an AbortError.
+   * @returns the transaction token for one later commit or discard.
+   */
+  prepare(snapshot: HistorySnapshotV1, signal: AbortSignal): Promise<PreparedWindowV1>
+  /**
+   * Measure the official reader, publish the prepared candidate, and correct the
+   * measured readers in the same synchronous section before paint. A reader
+   * correction failure resolves with `committed: true` and
+   * `correction: 'failed'`; it never rejects after the publish and never reports
+   * a clean success.
+   * @param prepared - token returned by `prepare` for this window, used once.
+   * @param signal - cancellation before the commit checkpoint; afterwards the commit finishes.
+   * @returns the published revision plus the correction outcome.
+   */
+  commitWindow(
+    prepared: PreparedWindowV1,
+    signal: AbortSignal,
+  ): Promise<WindowCommitResultV1>
+  /**
+   * Drop one prepared candidate without touching the published window.
+   * @param prepared - token returned by `prepare`; unknown or spent tokens are ignored.
+   */
+  discard(prepared: PreparedWindowV1): void
+}
+
+/** Reader measurement taken immediately before the layout commit of one window. */
+export interface WindowReaderMeasurementV1 {
+  /** Reader-owned monotonic sample revision. */
+  readonly revision: number
+  /** Visible reading anchor, or null while the reader follows the tail (or has no pin). */
+  readonly anchor: {
+    /** Semantic node/group owning a more precise DOM anchor; correction still uses key. */
+    readonly ownerKey?: string;
+ readonly key: string; readonly top: number } | null
+  /** Whether the reader follows the live tail; false when no pin fixed the position. */
+  readonly following: boolean
+  /** Scrollport scroll offset in CSS px at measurement time. */
+  readonly scrollTop: number
+  /** Scrollport viewport height in CSS px, 0 when no reader is attached. */
+  readonly clientHeight: number
+  /** Scrollport content height in CSS px, 0 when no reader is attached. */
+  readonly scrollHeight: number
+  /** Retained derived rows the reader currently displays. */
+  readonly nodes: number
+  /** Whether a live reader produced this measurement; false means no correction is possible. */
+  readonly available: boolean
+}
+
+/** Published layout facts handed back to the measured readers for correction. */
+export interface WindowLayoutV1 {
+  /** Stable window (Pane) identity. */
+  readonly windowId: string
+  /** Revision the window held before this commit. */
+  readonly baseRevision: number
+  /** Revision this layout commits. */
+  readonly revision: number
+  /** Official reader measurement taken before the publish. */
+  readonly measurement: WindowReaderMeasurementV1
+}
+
+/** One official reader participating in window commits. */
+export interface WindowReaderParticipantV1 {
+  /** Stable participant identity; re-registering the same id replaces it. */
+  readonly id: string
+  /** @returns the reader position at commit time; must be synchronous. */
+  measure(): WindowReaderMeasurementV1
+  /**
+   * Correct the reader's own position after the layout commit.
+   * @param measurement - this participant's own measurement, taken before publish.
+   * @param layout - facts of the window that was just published.
+   */
+  correct(measurement: WindowReaderMeasurementV1, layout: WindowLayoutV1): void
+}
+
+/** Registration face for official reader participants of one window. */
+export interface WindowReaderParticipationV1 {
+  readonly version: 1
+  /**
+   * Register one reader participant.
+   * @param participant - participant measured at every commit of this window.
+   * @returns idempotent unregistration.
+   */
+  register(participant: WindowReaderParticipantV1): Stop
+}
+
+/** Candidate derived state built by a window owner for one snapshot. */
+export interface WindowCandidateV1<Candidate> {
+  /** Owner-defined candidate; passed back to `publish` unchanged. */
+  readonly candidate: Candidate
+  /** Derived nodes the candidate built, for the capacity envelope. */
+  readonly nodes: number
+
+  /** Stable derived Context identities, used for growth admission when supplied. */
+  readonly nodeKeys?: readonly string[]
+}
+
+/**
+ * One reading window's commit owner. `buildCandidate` and `publish` are the
+ * official assembler hooks: the candidate is built and validated away from the
+ * published window, and `publish` performs the official layout commit
+ * synchronously. `publish` must not throw; a throwing implementation leaves the
+ * documented "failure keeps the current window" guarantee to the owner.
+ */
+export interface WindowCommitHostV1<Candidate> {
+  /** Stable window (Pane) identity this coordinator is bound to. */
+  readonly windowId: string
+  /** Revision of the window currently published. */
+  readonly revision: number
+  /**
+   * Build and validate the candidate derived state for one snapshot.
+   * @param snapshot - validated provider snapshot.
+   * @returns the candidate and its derived node count.
+   */
+  buildCandidate(snapshot: HistorySnapshotV1): WindowCandidateV1<Candidate>
+  /**
+   * Perform the official layout commit of one candidate.
+   * @param candidate - state returned by `buildCandidate`.
+   * @param layout - revision and reader measurement of this commit.
+   */
+  publish(candidate: Candidate, layout: WindowLayoutV1): void
+  /**
+   * Release one candidate that will not be published.
+   * @param candidate - state returned by `buildCandidate`.
+   */
+  discard(candidate: Candidate): void
+
+  /** Opt-in: apply admission budgets to growth retaining all accepted source identities. */
+  capacityScope?(): 'window' | 'growth'
+
+  /** Validate all commit-time readers before publishing; absent for legacy hosts. */
+  validate?(candidate: Candidate, measurements: readonly WindowReaderMeasurementV1[]): void
+}
+
+/**
+ * Coordinator face owned by one window; created only by the official factory.
+ * The owner's candidate type stays internal to the factory's `create` call.
+ */
+export interface WindowCommitCoordinatorV1 extends WindowCommitV1, WindowReaderParticipationV1 {
+  /** Stable window (Pane) identity. */
+  readonly windowId: string
+  /** Whether the synchronous measure/publish/correct section is open. */
+  readonly inCommitCriticalSection: boolean
+  /** Discard every pending candidate and reject later transactions with DISPOSED. */
+  dispose(): void
+}
+
+/** Official coordinator factory carried by the sessions service. */
+export interface WindowCommitFactoryV1 {
+  readonly version: 1
+  /**
+   * Bind one coordinator to a window owner.
+   * @param host - candidate builder, layout commit, and window identity.
+   * @returns the window's coordinator.
+   */
+  create<Candidate>(host: WindowCommitHostV1<Candidate>): WindowCommitCoordinatorV1
+
+  /** Installed together with optional complete-window publication and reader validation. */
+  readonly completeWindowHistory?: 1
+
+
+  /** Installed as one set with scope-aware renderer, Session, Conversation and Chat. */
+  readonly readingOccurrences?: 1
+
+}
+
+/** Read-only capability declaration; feature plugins probe it instead of private fields. */
+export interface WindowCommitCapabilitiesV1 {
+  /** Present with value 1 when this build carries the window-commit extension. */
+  readonly windowCommit?: 1
+}
+
+/** Failure codes are the shared V1 codes of the history-source extension. */
+export type WindowCommitFailureCode = HistorySourceFailureCode
+
+/** Typed window-commit failure with a stable code. */
+export class WindowCommitError extends Error {
+  /**
+   * @param code - structured failure code.
+   * @param message - human-readable detail for logs.
+   */
+  constructor(readonly code: WindowCommitFailureCode, message: string) {
+    super(message)
+    this.name = 'WindowCommitError'
+  }
+}
+
+/**
+ * Build-time switch. Unset keeps the capability on; `off` removes the sessions
+ * factory, so every reading window publishes through its original path.
+ * @returns whether this build carries the window-commit extension.
+ */
+function windowCommitEnabled(): boolean {
+  try {
+    if (Reflect.get(globalThis, '__DSH_CLIENT_WINDOW_COMMIT') === 'off') return false
+  } catch { /* non-global hosts keep the default */ }
+  return process.env.DSH_CLIENT_WINDOW_COMMIT !== 'off'
+}
+
+/** Read-only capability set announced by this package. */
+export const capabilities: Readonly<WindowCommitCapabilitiesV1> = Object.freeze(
+  windowCommitEnabled() ? { windowCommit: 1 as const } : {},
+)
+
+/** Default candidate envelope for one window commit (events ≤ 5000, body ≤ 12MiB, nodes ≤ B=2000). */
+export const DEFAULT_WINDOW_COMMIT_BUDGET: Budget = Object.freeze({
+  events: 5_000,
+  bytes: 12 * 1024 * 1024,
+  nodes: 2_000,
+})
