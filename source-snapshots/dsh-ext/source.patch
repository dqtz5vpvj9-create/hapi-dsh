+  readonly scrollTop: number
+  /** Scrollport viewport height in CSS px, 0 when no reader is attached. */
+  readonly clientHeight: number
+  /** Scrollport content height in CSS px, 0 when no reader is attached. */
+  readonly scrollHeight: number
