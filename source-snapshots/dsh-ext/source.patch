+ * The owner's candidate type stays internal to the factory's `create` call.
+ */
+export interface WindowCommitCoordinatorV1 extends WindowCommitV1, WindowReaderParticipationV1 {
+  /** Stable window (Pane) identity. */
+  readonly windowId: string
+  /** Whether the synchronous measure/publish/correct section is open. */
+  readonly inCommitCriticalSection: boolean
+  /** Discard every pending candidate and reject later transactions with DISPOSED. */
+  dispose(): void
+}
+
+/** Official coordinator factory carried by the sessions service. */
+export interface WindowCommitFactoryV1 {
+  readonly version: 1
+  /**
+   * Bind one coordinator to a window owner.
+   * @param host - candidate builder, layout commit, and window identity.
+   * @returns the window's coordinator.
+   */
+  create<Candidate>(host: WindowCommitHostV1<Candidate>): WindowCommitCoordinatorV1
