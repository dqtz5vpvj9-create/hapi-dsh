+/** Optional native page IO; full validation and sparse metadata live in an isolated worker. */
+import { Worker } from 'node:worker_threads'
+import { SessionPageCapacityError } from '@deepseek-ai/dsh-session-persistence'
+import type { SessionPageRequest, SessionPageResult, SessionReadIndex } from '@deepseek-ai/dsh-session-persistence'
+import type { JsonlCompression } from './format.ts'
+
+/** One worker request for an immutable source prefix. */
+export interface ReadIndexDiagnostics { readonly sourceBytesRead: number; readonly indexedEvents: number }
+
+/** One worker request for an immutable source prefix. */
+export interface ReadIndexRequest { readonly path: string; readonly id: string; readonly compression: JsonlCompression; readonly page?: SessionPageRequest }
+
+/**
+ * Prepare or query a native index without transferring the complete log to Host.
+ * @param request - original source path, identity, and optional bounded page.
+ * @param signal - cancellation for the entire worker operation.
+ * @param observe - optional source IO observations for bounded-read validation.
+ * @returns the accepted prefix metadata or one dependency-complete page.
+ */
+export function readIndexedSession(request: ReadIndexRequest, signal?: AbortSignal, observe?: (diagnostics: ReadIndexDiagnostics) => void): Promise<SessionPageResult | SessionReadIndex> {
+  signal?.throwIfAborted()
+  const source = import.meta.url.endsWith('.ts')
+  const bootstrap = source ? [
+    `import { register as registerEsm } from ${JSON.stringify(import.meta.resolve('tsx/esm/api'))}`,
+    `import { register as registerCjs } from ${JSON.stringify(import.meta.resolve('tsx/cjs/api'))}`,
+    'registerCjs()', 'registerEsm()',
+    `await import(${JSON.stringify(new URL('./read-index-worker.ts', import.meta.url).href)})`,
+  ].join('\n') : undefined
+  const worker = new Worker(bootstrap ? new URL(`data:text/javascript,${encodeURIComponent(bootstrap)}`) : new URL('./read-index-worker.mjs', import.meta.url),
+    { workerData: request, execArgv: [] })
+  return new Promise((resolve, reject) => {
+    let result: SessionPageResult | SessionReadIndex | undefined, failure: Error | undefined
+    const abort = (): void => { failure = signal?.reason instanceof Error ? signal.reason : new Error('Native page read cancelled'); void worker.terminate() }
+    worker.once('message', (message: { ok: boolean; result?: SessionPageResult | SessionReadIndex; message?: string; name?: string; dimension?: 'events' | 'bytes'; maximum?: number; diagnostics?: ReadIndexDiagnostics }) => {
+      if (message.ok) { result = message.result; if (message.diagnostics) observe?.(message.diagnostics) }
+      else {
+        failure = message.name === 'SessionPageCapacityError' && message.dimension && message.maximum !== undefined
+          ? new SessionPageCapacityError(message.dimension, message.maximum) : new Error(message.message)
+        failure.name = message.name ?? 'Error'
+      }
+    })
+    worker.once('error', error => { failure = error })
+    worker.once('exit', code => {
+      signal?.removeEventListener('abort', abort)
+      if (failure) reject(failure)
+      else if (code !== 0 || result === undefined) reject(new Error(`Native page index worker exited without a result (${code})`))
+      else resolve(result)
+    })
+    signal?.addEventListener('abort', abort, { once: true })
+    if (signal?.aborted) abort()
+  })
+}
