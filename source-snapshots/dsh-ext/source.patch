+/** Window only the mounted Chat flow rows; ChatViewport remains the scroll owner. */
+import { Component, Fragment, memo, useCallback, useLayoutEffect, useMemo, useRef, useState, type ReactNode } from 'react'
+import {
+  defaultRangeExtractor, observeElementOffset, observeElementRect, useVirtualizer,
+  type VirtualizerOptions,
+} from '@tanstack/react-virtual'
+import type { ChatFlowVirtualRows } from '../contract/slots.ts'
+import type { ChatFlowVirtualization } from '../contract/slots.ts'
+import css from './VirtualChatRows.module.css'
+
+type OffsetObserver = VirtualizerOptions<HTMLDivElement, HTMLDivElement>['observeElementOffset']
+type RectObserver = VirtualizerOptions<HTMLDivElement, HTMLDivElement>['observeElementRect']
+
+/** Bracket virtual DOM mutations so the viewport can preserve its own reading seat. */
+interface VirtualLayoutProps {
+  readonly model: readonly VirtualChatRow[]
+  readonly revision: number
+  readonly margin: number
+  readonly geometry: string
+  readonly before: () => void
+  readonly after: (changed: boolean, revision: number) => void
+  readonly children: ReactNode
+}
+class VirtualLayoutCommit extends Component<VirtualLayoutProps> {
+  override getSnapshotBeforeUpdate(previous: VirtualLayoutProps): { changed: boolean; revision: number } {
+    this.props.before()
+    return { changed: previous.model !== this.props.model || previous.revision !== this.props.revision
+      || previous.margin !== this.props.margin || previous.geometry !== this.props.geometry, revision: this.props.revision }
+  }
+  override componentDidUpdate(_previous: VirtualLayoutProps, _state: unknown, snapshot: { changed: boolean; revision: number }): void {
+    this.props.after(snapshot.changed, snapshot.revision)
+  }
+  override render(): ReactNode { return this.props.children }
+}
+
+/** Publish viewport-owned scroll landings before the browser's scroll event arrives. */
+function createProgrammaticScrollObserver(onLanding: (programmatic: boolean) => void) {
+  let activeInstance: Parameters<OffsetObserver>[0] | null = null
+  let activeRect: object | null = null
+  let publishLanding: ((offset: number) => void) | null = null
+  const observeOffset: OffsetObserver = (instance, callback) => {
+    let latestOffset: number | undefined
+    const publish = (offset: number, scrolling: boolean, programmatic = false) => {
+      if (latestOffset !== undefined && offset !== latestOffset) onLanding(programmatic)
+      latestOffset = offset
+      callback(offset, scrolling)
