+    loadOlder: vi.fn(), loadThrough: vi.fn(async () => {}), revealKey: () => false, toLatest: vi.fn() })
+  control.publish()
+  return control
+}
+
+it('keeps the old acknowledgement until a same-key Node seat really commits its replacement', () => {
+  const control = controller(), builder = new ChatSnapshotBuilder(), first = node('old body'), second = node('new body')
+  const timeline = { turnOrder: [], turns: new Map() }
+  const snapshot = builder.replace({ nodes: [first], timeline }); builder.publish()
+  const useNode = bindSnapshotSelector(snapshot.nodes.source(first.key))
+  const props = {
+    nodeKey: first.key, nodeStore: snapshot.nodes,
+    useChatNode: (_key: string, select?: (value: ChatConversationViewNode | undefined) => unknown) => useNode(select ?? ((value: ChatConversationViewNode | undefined) => value)),
+    useChatNodeBottom: () => true, useChatNodeProcess: () => undefined,
+    usePresentation: (select: (value: unknown) => unknown) => select({ foldCompletedTurns: false, foldedReplies: 'all' }),
+    useStore: (select: (value: unknown) => unknown) => select({}), useGroupAction: () => useRef<HTMLDivElement>(null),
+    actions: {}, deferCollapse: false, openFile: vi.fn(), inspectCall: undefined, forkAt: vi.fn(), loadImage: vi.fn(), t: (key: string) => key,
+    renderSlot: (_key: string, owner: { node: { data: { content: Array<{ text: string }> } } }) => <span>{owner.node.data.content[0]!.text}</span>,
+  } as unknown as ComponentProps<typeof ChatNodeSeat>
+  const changed = vi.fn(); control.subscribe(changed)
+  let parentRenders = 0
+  function Parent() {
+    parentRenders += 1
+    return <RenderedNodeCommitContext.Provider value={control.recordRenderedNode}><ChatNodeSeat {...props}/></RenderedNodeCommitContext.Provider>
+  }
+  const view = render(<Parent/>), revision = control.read().renderRevision!
+  expect(control.renderedNode(first.key)).toBe(first); expect(screen.getByText('old body')).toBeTruthy()
+  builder.apply({ upserts: [second], timeline })
+  expect(snapshot.nodes.get(first.key)).toBe(second)
+  expect(control.renderedNode(first.key)).toBe(first)
+  expect(screen.queryByText('new body')).toBeNull()
+  const before = changed.mock.calls.length
+  act(() => { builder.publish() })
+  expect(screen.getByText('new body')).toBeTruthy(); expect(control.renderedNode(first.key)).toBe(second)
+  expect(control.read().renderRevision).toBeGreaterThan(revision); expect(changed.mock.calls.length).toBeGreaterThan(before)
+  expect(parentRenders).toBe(1)
+  view.unmount(); expect(control.renderedNode(first.key)).toBeUndefined()
+  control.dispose()
+})
+
+it('counts multiple seats and rejects an old seat cleanup after a same-key replacement', () => {
+  const control = controller(), first = node('old body'), next = node('new body')
+  const removeFirst = control.recordRenderedNode(first), removeOtherPart = control.recordRenderedNode(first)
+  removeFirst(); expect(control.renderedNode(first.key)).toBe(first)
+  const removeNext = control.recordRenderedNode(next)
+  removeOtherPart(); expect(control.renderedNode(next.key)).toBe(next)
+  removeNext(); removeNext(); expect(control.renderedNode(next.key)).toBeUndefined()
+  control.dispose(); expect(() => control.renderedNode(next.key)).toThrow(/no longer attached/)
+  expect(() => control.recordRenderedNode(next)()).not.toThrow()
+})
+
+it('does not add render facts until a consumer has registered an actual mounted seat', () => {
+  const control = controller(), initial = control.read(), changed = vi.fn(); control.subscribe(changed)
+  expect(initial.renderRevision).toBeUndefined(); expect(control.renderedNode('same-key')).toBeUndefined()
+  control.publish(); expect(changed).not.toHaveBeenCalled(); expect(control.read()).toBe(initial)
+  control.dispose()
+})
