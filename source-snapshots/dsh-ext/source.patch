+
+function entry(seq: number): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: { type: 'turn/start', seq: SessionSeq(seq), time: seq, data: { turn: seq } },
+  }
+}
+
+function snapshot(
+  version: string,
+  entries: readonly SessionEventLikeEntry[],
+  hasBefore = false,
+  hasAfter = false,
+): HistorySnapshotV1 {
+  return { version, entries, before: `before-${version}`, after: `after-${version}`, hasBefore, hasAfter }
+}
+
+interface FeedControl {
+  readonly feed: HistoryFeedV1
+  readonly reads: HistoryReadV1[]
+  readonly changesFrom: string[]
+  readonly releases: () => number
+  push(delta: HistoryDeltaV1): void
+}
+
+/** One provider window whose deltas are pushed by the test after the consumer subscribes. */
+function createFeed(
+  initial: HistorySnapshotV1,
+  latest: () => HistorySnapshotV1,
+): FeedControl {
+  const reads: HistoryReadV1[] = []
+  const changesFrom: string[] = []
+  const buffered: HistoryDeltaV1[] = []
+  let waiter: ((delta: HistoryDeltaV1 | undefined) => void) | undefined
+  let releaseCount = 0
+  const next = async (signal: AbortSignal): Promise<HistoryDeltaV1 | undefined> => {
+    const ready = buffered.shift()
+    if (ready !== undefined) return ready
+    if (signal.aborted) return undefined
+    return new Promise(resolve => {
+      const settle = (delta: HistoryDeltaV1 | undefined): void => {
+        signal.removeEventListener('abort', cancel)
+        if (waiter === settle) waiter = undefined
+        resolve(delta)
+      }
+      const cancel = (): void => { settle(undefined) }
+      waiter = settle
+      signal.addEventListener('abort', cancel, { once: true })
+    })
+  }
+  const feed: HistoryFeedV1 = {
+    initial,
+    read: (request: HistoryReadV1) => {
+      reads.push(request)
+      return Promise.resolve(request.kind === 'latest' ? latest() : initial)
+    },
+    changes: async function* (after: string, signal: AbortSignal): AsyncIterable<HistoryDeltaV1> {
+      changesFrom.push(after)
+      for (;;) {
+        const delta = await next(signal)
+        if (delta === undefined) return
+        yield delta
+      }
+    },
+    release: () => { releaseCount += 1; waiter?.(undefined) },
+  }
+  return {
+    feed,
+    reads,
+    changesFrom,
+    releases: () => releaseCount,
+    push: (delta) => {
+      if (waiter !== undefined) {
+        const resolve = waiter
+        waiter = undefined
+        resolve(delta)
+      } else {
+        buffered.push(delta)
+      }
+    },
+  }
+}
+
+/** Complete snapshots are candidates until the public consumer acknowledges them. */
+function createCompleteFeed(
+  initial: HistorySnapshotV1,
+  answer: (request: HistoryReadV1) => HistorySnapshotV1 | Promise<HistorySnapshotV1>,
+  refreshAnswer: () => HistorySnapshotV1 | Promise<HistorySnapshotV1>,
+) {
+  const control = createFeed(initial, () => initial)
+  const candidates = new Map([[initial.version, initial]])
+  let accepted: HistorySnapshotV1 | undefined
+  const acceptedVersions: string[] = [], discarded: string[] = []
+  const propose = (value: HistorySnapshotV1): HistorySnapshotV1 => { candidates.set(value.version, value); return value }
+  const publication = {
+    validate: vi.fn((version: string) => {
+      if (!candidates.has(version) && accepted?.version !== version) {
+        throw new HistorySourceError('STALE_VERSION', 'Candidate no longer belongs to this window')
+      }
+    }),
+    accept: vi.fn((version: string) => {
+      publication.validate(version)
+      accepted = candidates.get(version) ?? accepted
+      candidates.delete(version)
+      acceptedVersions.push(version)
+    }),
+    discard: vi.fn((version: string) => { discarded.push(version); candidates.delete(version) }),
+  }
+  const read = vi.fn(async function(this: HistoryFeedV1, request: HistoryReadV1) {
+    expect(this).toBe(control.feed)
+    if (accepted === undefined) throw new Error('initial snapshot was not accepted')
+    control.reads.push(request)
+    return propose(await answer(request))
+  })
+  const refresh = vi.fn(async function(this: HistoryFeedV1) {
+    expect(this).toBe(control.feed)
+    if (accepted === undefined) throw new Error('initial snapshot was not accepted')
+    return propose(await refreshAnswer())
+  })
+  Object.assign(control.feed, { mode: 'complete-window', publication, read, refresh })
+  return { ...control, publication, read, refresh, accepted: () => accepted, acceptedVersions, discarded,
+    push: (delta: HistoryDeltaV1) => { if (delta.snapshot) propose(delta.snapshot); control.push(delta) } }
+}
+
+interface ProviderProbe {
+  readonly provider: HistoryProviderV1
+  readonly open: ReturnType<typeof vi.fn>
+}
+
+/** One provider over a fixed source; matches decides ownership. */
+function createProvider(
+  id: string,
+  matches: (sessionId: SessionId) => boolean,
+  source: HistorySourceV1,
+): ProviderProbe {
+  const open = vi.fn(() => Promise.resolve(source))
+  return { provider: { id, matches, open }, open }
+}
+
+/** One provider connection whose window opens are recorded. */
+function createSource(feed: HistoryFeedV1, opened: string[]): HistorySourceV1 {
+  return {
+    openWindow: (viewId: string) => {
+      opened.push(viewId)
+      return Promise.resolve(feed)
+    },
+    release: () => {},
+  }
+}
