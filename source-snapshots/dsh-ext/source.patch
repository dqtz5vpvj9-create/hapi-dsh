+async function outputUntil(iterator: AsyncIterator<TerminalFrame>, pattern: RegExp): Promise<RegExpMatchArray> {
+  let output = ''
+  for (;;) {
+    const next = await iterator.next()
+    if (next.done) throw new Error('Terminal output ended before the shell result')
+    if (next.value.type === 'output') output += next.value.data
+    const match = output.match(pattern)
+    if (match) return match
+  }
+}
