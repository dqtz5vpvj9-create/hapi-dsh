@@ -0,0 +1,83 @@
+/** Public production checkpoint over real local storage; Win32 calls are explicit OS-boundary fixtures. */
+import { afterEach, beforeEach, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { LocalFileSystem } from '@deepseek-ai/dsh-fs-local'
+import { mkdtemp, readFile, readdir, rename, rm, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+
+let directory: string
+let ctx: Context
+let fs: LocalFileSystem
+beforeEach(async () => {
+  directory = await mkdtemp(join(process.platform === 'win32' ? tmpdir() : '/mnt/cache/data-cache', 'dsh-write-checkpoint-'))
+  ctx = new Context()
+  await ctx.plugin(LocalFileSystem, { cwd: directory })
+  fs = ctx.fs as LocalFileSystem
+})
+afterEach(async () => {
+  await ctx.fiber.dispose()
+  await rm(directory, { recursive: true, force: true })
+})
+
+it('awaits current authority after staging and before replacing the original file', async () => {
+  const path = join(directory, 'file'), entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>()
+  await writeFile(path, 'original')
+  const target = await fs.resolve(path), info = (await fs.stat(target))!
+  const pending = fs.writeText(target, 'replacement', { kind: 'replaceIfVersion', version: info.version }, undefined, undefined, async () => {
+    entered.resolve()
+    await release.promise
+  })
+  try {
+    await entered.promise
+    expect(await readFile(path, 'utf8')).toBe('original')
+  } finally { release.resolve() }
+  await pending
+  expect(await readFile(path, 'utf8')).toBe('replacement')
+})
+
+it('preserves checkpoint refusal identity and removes private staging without publishing', async () => {
+  const path = join(directory, 'file'), refusal = Object.assign(new Error('Current account no longer has access'), { code: 'account/denied' })
+  await writeFile(path, 'original')
+  await expect(fs.writeText(await fs.resolve(path), 'never', undefined, undefined, undefined, () => { throw refusal })).rejects.toBe(refusal)
+  expect(await readFile(path, 'utf8')).toBe('original')
+  expect(await readdir(directory)).toEqual(['file'])
+})
+
+it('rechecks an opted-in version guard after staging and does not overwrite an external edit', async () => {
+  const path = join(directory, 'file')
+  await writeFile(path, 'original')
+  const target = await fs.resolve(path), info = (await fs.stat(target))!
+  fs.internals.inspectTemp = async () => { await writeFile(path, 'external editor') }
+  let called = false
+  await expect(fs.writeText(target, 'never', { kind: 'replaceIfVersion', version: info.version }, undefined, undefined, () => { called = true }))
+    .rejects.toMatchObject({ code: 'FS_STALE_VERSION' })
+  expect(called).toBe(false)
+  expect(await readFile(path, 'utf8')).toBe('external editor')
+})
+
+it('retains hard-link no-replace creation when another writer appears during the checkpoint', async () => {
+  const path = join(directory, 'file')
+  await expect(fs.writeText(await fs.resolve(path), 'never', { kind: 'createIfAbsent' }, undefined, undefined,
+    async () => { await writeFile(path, 'external creator') })).rejects.toMatchObject({ code: 'FS_NOT_OBSERVED' })
+  expect(await readFile(path, 'utf8')).toBe('external creator')
+})
+
+it('checks cancellation again after an asynchronous checkpoint', async () => {
+  const path = join(directory, 'file'), controller = new AbortController()
+  await writeFile(path, 'original')
+  await expect(fs.writeText(await fs.resolve(path), 'never', undefined, controller.signal, undefined, () => { controller.abort() }))
+    .rejects.toMatchObject({ code: 'FS_ABORTED' })
+  expect(await readFile(path, 'utf8')).toBe('original')
+})
+
+it('keeps Windows DACL preparation and protected replacement around the same production checkpoint', async () => {
+  const path = join(directory, 'file'), order: string[] = []
+  await writeFile(path, 'original')
+  fs.internals.platform = 'win32'
+  fs.internals.copyFileDacl = async () => { order.push('copy-dacl') }
+  fs.internals.replaceFile = async (replaced, replacement) => { order.push('replace-file'); await rename(replacement, replaced) }
+  await fs.writeText(await fs.resolve(path), 'replacement', undefined, undefined, undefined, () => { order.push('current-authority') })
+  expect(order).toEqual(['copy-dacl', 'current-authority', 'replace-file'])
+  expect(await readFile(path, 'utf8')).toBe('replacement')
+})
