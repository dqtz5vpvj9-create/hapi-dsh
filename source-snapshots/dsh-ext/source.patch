+/**
+ * Decode one independently addressed current physical row after its prefix has
+ * established dense sequence order. Sparse persistence readers validate that
+ * order with V4SessionStreamValidator rather than replaying synthetic events.
+ * @param value - one parsed V4 physical event row.
+ * @returns the same logical event accepted by the released physical codec.
+ */
+export function decodeV4IndexedEvent(value: unknown): SessionFormatEvent {
+  if (!isSessionFormatJsonObject(value)) throw new SessionFormatError('format v4 event row must be an object')
+  const required = ['type', 'seq', 'time', 'data']
+  const allowed = new Set([...required, 'ignorable', 'sourceEventSeqs', 'surfaceOp'])
+  if (required.some(key => !Object.hasOwn(value, key)) || Object.keys(value).some(key => !allowed.has(key))) {
+    throw new SessionFormatError('format v4 event row has invalid fields')
+  }
+  const seq = value['seq']
+  if (!Number.isSafeInteger(seq) || (seq as number) < 0 || !Number.isSafeInteger(value['time']) || typeof value['type'] !== 'string'
+    || value['ignorable'] !== undefined && value['ignorable'] !== true) throw new SessionFormatError('format v4 event row has an invalid envelope')
+  assertV4RowAdmission(value)
+  if (value['sourceEventSeqs'] === undefined) return value as unknown as SessionFormatEvent
+  const encoded = value['sourceEventSeqs']
+  if (!Array.isArray(encoded)) throw new SessionFormatError('sourceEventSeqs must be an array')
+  const sources: number[] = [], seen = new Set<number>()
+  let ranged = false
+  for (const member of encoded) {
+    const range = Array.isArray(member) ? member : [member, member]
+    if (range.length !== 2 || !range.every(coordinate => Number.isSafeInteger(coordinate) && (coordinate as number) >= 0)
+      || (range[0] as number) > (range[1] as number) || (range[1] as number) >= (seq as number)
+      || (range[1] as number) - (range[0] as number) + 1 > (seq as number) - sources.length) throw new SessionFormatError('sourceEventSeqs range exceeds its event seq')
+    if (Array.isArray(member)) ranged = true
+    for (let current = range[0] as number; current <= (range[1] as number); ++current) {
+      if (seen.has(current)) throw new SessionFormatError('sourceEventSeqs ranges must contain unique earlier seqs')
+      sources.push(current); seen.add(current)
+    }
+  }
+  if (ranged && sources.some((source, index) => index > 0 && source <= sources[index - 1]!)) throw new SessionFormatError('sourceEventSeqs ranges must be strictly increasing')
+  return { ...value, sourceEventSeqs: sources } as unknown as SessionFormatEvent
+}
