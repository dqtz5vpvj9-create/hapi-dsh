+/** Adapter references remain typed through the real composer transaction; ordinary text codecs retain their path. */
+import { describe, expect, it, vi } from 'vitest'
+import type { Context } from '@deepseek-ai/cordis'
+import type { InputTriggerController, SubmitOutcome, DraftAttachmentId } from '../src/client/contract/input.ts'
+import { SessionInputShell } from '../src/client/input/facade.ts'
+import { serializeDraftPrompt } from '../src/client/input/prompt.ts'
+const part = { type: 'reference' as const, source: 'adapter:skill', ref: '/skills/review/SKILL.md', label: 'Review' }
+const attachments = { serialize: async () => [], release: () => {}, unsupportedNotice: () => 'unsupported' }
+describe('opt-in structured references', () => {
+  it('preserves text order and quote formatting around typed references without interpreting quoted references', async () => {
+    const serialize = vi.fn(async () => part)
+    expect(await serializeDraftPrompt({ text: 'Use @review now', references: [{ source: 'skills', ref: part.ref, label: 'Review', clipboardText: '@review', offset: 4, length: 7 }] }, serialize)).toEqual([
+      { type: 'text', text: 'Use ' }, part, { type: 'text', text: ' now' },
+    ])
+    expect(await serializeDraftPrompt({ text: '  ordinary  ', references: [] }, serialize)).toBe('ordinary')
+    expect(await serializeDraftPrompt({ text: '@review', references: [{ source: 'skills', ref: part.ref, label: 'Review', clipboardText: '@review', offset: 0, length: 7 }] }, async () => 'expanded text')).toBe('expanded text')
+  })
+  it('retains the structured chip and attachment after failed admission, then clears both only on acceptance', async () => {
+    const sink = vi.fn().mockResolvedValueOnce({ kind: 'error', text: 'source receipt unavailable' }).mockResolvedValueOnce({ kind: 'success' })
+    const triggers = { serializeReference: async () => part, track: () => {}, lexicon: { getSnapshot: () => new Map(), subscribe: () => () => {} } } as unknown as InputTriggerController
+    const shell = new SessionInputShell({ actx: {} as Context, commandAttachments: attachments, inputTriggers: () => triggers, defaultSink: sink })
+    try {
+      shell.setDraft('@review')
+      expect(shell.insertReference({ source: 'skills', ref: part.ref, label: 'Review', clipboardText: '@review' }, { start: 0, end: 7, draftRev: shell.snapshot.draftRev })).toBe(true)
+      shell.addAttachments(['image' as DraftAttachmentId])
+      shell.submit('queue')
+      await vi.waitFor(() => expect(shell.snapshot.phase).toBe('plain'))
+      expect(sink.mock.calls[0]?.[0]).toEqual([part])
+      expect(shell.snapshot.draft).toBe('@review ')
+      expect(shell.snapshot.occurrences).toHaveLength(1)
+      expect(shell.snapshot.attachmentIds).toEqual(['image'])
+      shell.submit('queue')
+      await vi.waitFor(() => expect(shell.snapshot.draft).toBe(''))
+      expect(shell.snapshot.attachmentIds).toEqual([])
+    } finally { shell.dispose() }
+  })
+})
