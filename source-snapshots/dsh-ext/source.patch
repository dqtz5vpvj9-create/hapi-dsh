+
+/** @returns whether two window reads request the same page. */
+function sameRead(left: HistoryReadV1, right: HistoryReadV1): boolean {
+  if (left.kind !== right.kind) return false
+  switch (left.kind) {
+    case 'latest': return true
+    case 'before': return right.kind === 'before' && right.cursor === left.cursor
+    case 'after': return right.kind === 'after' && right.cursor === left.cursor
