+/** Public resource-owner factory tests; only the subprocess boundary is a fixture. */
+import { PassThrough } from 'node:stream'
+import { Context } from '@deepseek-ai/cordis'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { SubprocessRuntime, type SubprocessHandle, type SubprocessSpawnSpec, type SubprocessTerminalHandle,
+  type SubprocessTerminalSpawnSpec } from '@deepseek-ai/dsh-subprocess'
+import { afterEach, expect, it, vi } from 'vitest'
+import { createTerminalOwner, TerminalController, type TerminalOwnerController } from '../src/index.ts'
+import type { TerminalFrame, TerminalInput, WebTerminalId } from '../src/types.ts'
+import { inputChannel } from './input.ts'
+
+class FixtureSubprocess extends SubprocessRuntime {
+  readonly specs: SubprocessTerminalSpawnSpec[] = []
+  readonly handles: ReturnType<typeof terminalHandle>[] = []
+  allocate: ((spec: SubprocessTerminalSpawnSpec) => Promise<SubprocessTerminalHandle>) | undefined
+  async resolveExecutable(command: string): Promise<string> { return command }
+  async terminalEnvironment() { return { platform: 'posix' as const, defaultShell: '/bin/sh' } }
+  spawn(_spec: SubprocessSpawnSpec): SubprocessHandle { throw new Error('Only PTY allocation belongs to this fixture') }
+  async spawnTerminal(spec: SubprocessTerminalSpawnSpec): Promise<SubprocessTerminalHandle> {
+    this.specs.push(spec)
+    if (this.allocate !== undefined) return this.allocate(spec)
+    const handle = terminalHandle()
+    this.handles.push(handle)
+    return handle
+  }
+}
+function terminalHandle() {
+  const output = new PassThrough()
+  const done = Promise.withResolvers<{ exitCode: number; signal: null }>()
+  return {
+    pid: 123, output, done: done.promise,
+    write: vi.fn(async (_data: string) => {}), resize: vi.fn(async (_cols: number, _rows: number) => {}),
+    inspectActivity: async () => ({ state: 'unknown' as const, revision: 0 }),
+    inspectForeground: async () => undefined, signalForeground: async () => 123,
+    terminate: vi.fn(async () => { output.end(); done.resolve({ exitCode: 0, signal: null }) }),
+  } satisfies SubprocessTerminalHandle
+}
+const roots: Context[] = []
+afterEach(async () => { await Promise.all(roots.splice(0).map(root => root.fiber.dispose())) })
+const signal = () => new AbortController().signal
+const id = 'workspace-terminal' as WebTerminalId
+const request = { id, cols: 80, rows: 24 }
+const config = { ...TerminalController.Config(), unattendedTimeoutMs: 0 }
+async function fixture(cwd = '/source/workspace') {
+  const root = new Context()
+  roots.push(root)
+  const subprocess = new FixtureSubprocess(root)
+  const ensure = vi.fn(async () => cwd)
+  let owner: TerminalOwnerController | undefined
+  const fiber = await root.plugin((scope) => {
+    owner = createTerminalOwner(scope, { id: SessionId('workspace-source-session'), subprocess, cwd: { get: () => cwd, ensure } }, config)
+  })
+  if (owner === undefined) throw new Error('Resource owner did not load')
+  return { root, subprocess, ensure, owner, fiber }
+}
+async function nextFrame(iterator: AsyncIterator<TerminalFrame>, type: TerminalFrame['type']): Promise<TerminalFrame> {
+  for (;;) {
+    const result = await iterator.next()
+    if (result.done) throw new Error(`Terminal ended before ${type}`)
+    if (result.value.type === type) return result.value
+  }
+}
+
+it('uses explicit source services without Agent, sandbox policy or directory-validation services', async () => {
+  const f = await fixture()
+  expect(f.root.get('agents')).toBeUndefined()
+  expect(f.root.get('sandboxPolicy')).toBeUndefined()
+  expect(f.owner.environment(signal()).cwd).toBe('/source/workspace')
+  expect(f.ensure).not.toHaveBeenCalled()
+  await f.owner.create(request, signal())
+  expect(f.ensure).toHaveBeenCalledOnce()
+  expect(f.subprocess.specs[0]).toMatchObject({ cwd: '/source/workspace', env: { DSH_SESSION_ID: 'workspace-source-session' }, shellActivity: true })
+  await f.fiber.dispose()
+  expect(f.subprocess.handles[0]!.terminate).toHaveBeenCalledOnce()
+  expect(f.owner.list()).toEqual([])
+  await expect(f.owner.create(request, signal())).rejects.toThrow('owner disposed')
+})
+
+it('keeps the same terminal identity independent across source owner instances', async () => {
+  const a = await fixture('/machine-a/workspace'), b = await fixture('/machine-b/workspace')
+  await Promise.all([a.owner.create(request, signal()), b.owner.create(request, signal())])
+  await a.owner.close(id)
+  expect(a.owner.list()).toEqual([])
+  expect(b.owner.list()).toMatchObject([{ id, cwd: '/machine-b/workspace', state: 'running' }])
+  expect(b.subprocess.handles[0]!.terminate).not.toHaveBeenCalled()
+})
+
+it('deduplicates pending creation and excludes its closed identity before allocation settles', async () => {
+  const f = await fixture(), allocation = Promise.withResolvers<SubprocessTerminalHandle>(), started = Promise.withResolvers<void>()
+  const handle = terminalHandle()
+  f.subprocess.allocate = () => { started.resolve(); return allocation.promise }
+  const first = f.owner.create(request, signal()), duplicate = f.owner.create(request, signal())
+  const firstFailure = expect(first).rejects.toThrow('closed in this Session')
+  const duplicateFailure = expect(duplicate).rejects.toThrow('closed in this Session')
+  await started.promise
+  const closing = f.owner.close(id)
+  allocation.resolve(handle)
+  await Promise.all([firstFailure, duplicateFailure, closing])
+  expect(f.subprocess.specs).toHaveLength(1)
+  expect(handle.terminate).toHaveBeenCalledOnce()
+  await expect(f.owner.create(request, signal())).rejects.toThrow('closed in this Session')
+})
+
+it('preserves input windows, provider acknowledgements and the original process across detach', async () => {
+  const f = await fixture()
+  await f.owner.create(request, signal())
+  const handle = f.subprocess.handles[0]!, firstInput = inputChannel<TerminalInput>(), abort = new AbortController()
+  const window = { maxBytes: 2048, frameOverheadBytes: 9 }
+  const first = f.owner.attach(id, firstInput.source, abort.signal, window)[Symbol.asyncIterator]()
+  expect(await nextFrame(first, 'snapshot')).toMatchObject({ inputWindow: window, writable: true })
+  firstInput.push({ type: 'write', sequence: 1, data: 'one' })
+  expect(await nextFrame(first, 'ack')).toMatchObject({ sequence: 1 })
+  abort.abort()
+  await first.return?.()
+  expect(handle.terminate).not.toHaveBeenCalled()
+  const secondInput = inputChannel<TerminalInput>(), reconnect = new AbortController()
+  const second = f.owner.attach(id, secondInput.source, reconnect.signal)[Symbol.asyncIterator]()
+  expect(await nextFrame(second, 'snapshot')).toMatchObject({ writable: true })
+  expect(handle.write.mock.calls).toEqual([['one']])
+  expect(f.subprocess.specs).toHaveLength(1)
+  reconnect.abort()
+  await second.return?.()
+})
