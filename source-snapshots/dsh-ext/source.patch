@@ -0,0 +1,292 @@
+/**
+ * Optional window-commit extension: prepare one bounded history window off the
+ * critical path, then publish it atomically against the official reader.
+ *
+ * A window owner (the official Pane history scope) creates one coordinator per
+ * reading window through {@link WindowCommitFactoryV1}. `prepare()` validates
+ * the provider snapshot and builds the candidate derived state; the returned
+ * token is created by this coordinator, bound to that window, and consumed by
+ * exactly one {@link WindowCommitV1.commitWindow} call. A caller can neither
+ * construct a valid token nor replay a spent one.
+ *
+ * `commitWindow()` opens one synchronous critical section: it measures the
+ * official reader, publishes the prepared candidate through the owner's layout
+ * commit, and lets the measured readers correct their own position in the same
+ * task, before the browser paints. No promise is awaited between the final
+ * cancellation check and the end of the correction, so no request can be
+ * started or settled inside the commit. Cancellation before that checkpoint
+ * rejects with an `AbortError` and leaves the old window published; once the
+ * checkpoint passed, cancellation no longer rolls the commit back.
+ *
+ * Completion has two facts, and they are never merged: whether the layout
+ * publish happened (`committed`, with `revision`) and whether every measured
+ * reader applied its correction (`correction`). A reader correction that throws
+ * after the publish is reported as `correction: 'failed'` — the commit is not
+ * rolled back, but it is also never reported as a clean success. A measurement
+ * failure happens before the publish and therefore still rejects the commit,
+ * keeping the old window.
+ *
+ * Failures use the shared V1 codes from the history-source extension and always
+ * keep the current published window: `STALE_VERSION`, `INVALID_WINDOW`,
+ * `CAPACITY_EXCEEDED`, `TARGET_UNAVAILABLE`, `DISPOSED`. Cancellation rejects
+ * with an `AbortError` instead.
+ */
+import type {
+  Budget,
+  HistorySnapshotV1,
+  HistorySourceFailureCode,
+  Stop,
+} from './history-source.ts'
+
+export type {
+  Budget as WindowCommitBudget,
+  HistorySnapshotV1,
+  Stop as WindowCommitStop,
+} from './history-source.ts'
+
+/** One prepared transaction token created by the official coordinator. */
+export interface PreparedWindowV1 {
+  /** Revision of the window when the candidate was built. */
+  readonly baseRevision: number
+  /** Revision the window takes when this candidate publishes. */
+  readonly nextRevision: number
+  /** Coordinator-created, window-bound, single-use transaction token. */
+  readonly token: symbol
+}
+
+/**
+ * Outcome of the post-publish reader corrections of one commit. `applied` means
+ * every measured reader re-applied its own position; `failed` carries the first
+ * rejection and means the layout stands while the reading position may be off.
+ */
+export type WindowCommitCorrectionV1 =
+  | { readonly correction: 'applied' }
+  | { readonly correction: 'failed'; readonly correctionError: Error }
+
+/**
+ * Result of one linearized window commit. `committed: true` and `revision`
+ * state that the layout publish already happened: the previous window is gone
+ * and cannot be rolled back, even when the correction failed. Callers use
+ * `correction` to decide whether to retry the reader correction; a failed
+ * correction is a committed-but-uncorrected window, never a successful commit.
+ */
+export type WindowCommitResultV1 = {
+  readonly committed: true
+  readonly revision: number
+} & WindowCommitCorrectionV1
+
+/** Transactional window publisher used by one reading window. */
