+  readonly hasBefore: boolean
+  /** Whether newer history exists after the window. */
+  readonly hasAfter: boolean
+  /** Source version the candidate is current at. */
+  readonly version: SourceVersion
+  /** Candidate derived state built off the published window; validation evidence only. */
+  readonly assembled: ConversationNodeAssembler
