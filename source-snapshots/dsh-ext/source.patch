+  it('measurement-failure-keeps-old-window', async () => {
+    const h = harness()
+    h.coordinator.register({
+      id: 'reader',
+      measure: () => { throw new Error('reader detached') },
+      correct: vi.fn(),
+    })
+    const prepared = await h.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    // Measurement precedes the publish, so this failure still rejects the commit
+    // and the old window stays current.
+    await expect(h.coordinator.commitWindow(prepared, new AbortController().signal))
+      .rejects.toMatchObject({ code: 'TARGET_UNAVAILABLE' })
+    expect(h.state.version).toBe('old')
+    expect(h.state.publishes).toBe(0)
+    expect(h.discarded).toEqual(['v1'])
+  })
+
+  it('stale-token-rejected', async () => {
+    const h = harness()
+    const signal = new AbortController().signal
+
+    // A token the coordinator never issued cannot name a transaction.
+    await expect(h.coordinator.commitWindow({
+      baseRevision: 0, nextRevision: 1, token: Symbol('forged'),
+    }, signal)).rejects.toMatchObject({ code: 'INVALID_WINDOW' })
+    expect(h.state.publishes).toBe(0)
+
+    // A copy of a valid prepared object is rejected; the original stays usable.
+    const prepared = await h.coordinator.prepare(snapshot('v1'), signal)
+    const copy: PreparedWindowV1 = { ...prepared }
+    await expect(h.coordinator.commitWindow(copy, signal)).rejects.toMatchObject({ code: 'INVALID_WINDOW' })
+    await h.coordinator.commitWindow(prepared, signal)
+    expect(h.state.version).toBe('v1')
+
+    // A spent token is stale, and so is a token dropped through discard().
+    await expect(h.coordinator.commitWindow(prepared, signal)).rejects.toMatchObject({ code: 'STALE_VERSION' })
+    const dropped = await h.coordinator.prepare(snapshot('v2'), signal)
+    h.coordinator.discard(dropped)
+    await expect(h.coordinator.commitWindow(dropped, signal)).rejects.toMatchObject({ code: 'STALE_VERSION' })
+    expect(h.state.version).toBe('v1')
+  })
