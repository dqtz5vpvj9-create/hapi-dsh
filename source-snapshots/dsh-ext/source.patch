+++ b/packages/client/ui-chat/tests/live-edge-follow.client.spec.ts
@@ -0,0 +1,61 @@
+// @vitest-environment jsdom
+/** ADR 0004: programmatic live-edge landings may re-enter tail following (opt-in). */
+import { afterEach, expect, it, vi } from 'vitest'
+import { ChatViewport } from '../src/client/chat/use-chat-viewport.ts'
+import { ChatReading, setFollowOnProgrammaticEdge } from '../src/client/chat/use-chat-reading.ts'
+import { ScrollFollow } from '../src/client/chat/use-scroll-follow.ts'
+
+afterEach(() => {
+  setFollowOnProgrammaticEdge(false)
+  Reflect.deleteProperty(globalThis, '__dshFollowProgrammaticEdge')
+  delete document.documentElement.dataset.dshFollowEdge
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+function reading(following: boolean): ChatReading {
+  const viewport = new ChatViewport()
+  return new ChatReading(viewport, { read: () => null, save: vi.fn() }, {
+    initialized: true, followingTail: following, activeTurn: 1,
+  }, vi.fn(), new ScrollFollow(following, 0))
+}
+
+it('stock behavior ignores a non-reader landing on the live edge', () => {
+  const target = reading(false)
+  const follow = vi.spyOn(target, 'followTail')
+  target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+  expect(follow).not.toHaveBeenCalled()
+})
+
+it('the opt-in re-enters following when a programmatic landing reaches the edge', () => {
+  setFollowOnProgrammaticEdge(true)
+  const target = reading(false)
+  const follow = vi.spyOn(target, 'followTail')
+  target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+  expect(follow).toHaveBeenCalled()
+})
+
+it('a global composition flag enables the opt-in without a setter call', () => {
+  Reflect.set(globalThis, '__dshFollowProgrammaticEdge', true)
+  try {
+    const target = reading(false)
+    const follow = vi.spyOn(target, 'followTail')
+    target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+    expect(follow).toHaveBeenCalled()
+  } finally { Reflect.deleteProperty(globalThis, '__dshFollowProgrammaticEdge') }
+})
+
+it('a document-root composition marker enables the opt-in without a setter call', () => {
+  document.documentElement.dataset.dshFollowEdge = '1'
+  const target = reading(false)
+  const follow = vi.spyOn(target, 'followTail')
+  target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+  expect(follow).toHaveBeenCalled()
+})
+
+it('a reader away from the edge stays unfollowed even with the opt-in', () => {
+  setFollowOnProgrammaticEdge(true)
+  const target = reading(false)
+  target.onScroll({ metrics: { top: 900, floor: 1_600, height: 400 }, movedByReader: true })
+  expect(target.followingTail).toBe(false)
+})
