+/** Optional per-occurrence queue action availability supplied by a Session source. */
+import type {} from '@deepseek-ai/dsh-session-projection/types'
+
+export interface QueueActionAvailability {
+  /** Source-owned transfer state; actions return when that exact item is queued again. */
+  readonly delivery?: 'sending' | 'confirming' | 'failed'
+  /** Optional source-owned text buffer; the source preserves non-text input parts. */
+  readonly editText?: string
+  readonly edit: boolean
+  readonly remove: boolean
+  readonly steer: boolean
+}
+
+/** Missing projection or missing row preserves the ordinary DSH queue actions. */
+export type QueueActionsProjection = Readonly<Record<string, QueueActionAvailability>>
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionMap {
+    /** Optional source restrictions; an absent row leaves native defaults intact. */
+    queueActions: QueueActionsProjection
+  }
+}
