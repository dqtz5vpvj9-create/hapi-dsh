@@ -0,0 +1,99 @@
+/**
+ * Optional windowed history reading scope on the official Conversation binding.
+ *
+ * A Pane acquires one scope per stable view id; the scope opens its own bounded
+ * window on the Session generation's history connection and assembles that
+ * window through the official Conversation assembler. Window replacement reuses
+ * `ConversationNodeAssembler.replaceWindow` (clear and rebuild); no arbitrary
+ * node withdrawal is exposed. Sending, queueing, and approvals keep resolving
+ * the original Session. With no provider there is no history connection, so the
+ * binding has no scope and the default Session event window is unchanged.
+ */
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type {
+  HistoryReadV1,
+  HistorySourceFailureCode,
+  SessionEventLikeEntry,
+  SourceVersion,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ConversationViewSnapshotStore } from './conversation.ts'
+
+/** Read-side facts of one reading window. */
+export interface HistoryViewSnapshotV1 {
+  /** Monotonic revision; advances once per published window change. */
+  readonly revision: number
+  /** Opening, ready, failed, or released. */
+  readonly phase: 'opening' | 'ready' | 'error' | 'closed'
+  /** Structured failure code while `phase` is error. */
+  readonly failure: HistorySourceFailureCode | null
+  /** Whether a page read or a resync is in flight. */
+  readonly busy: boolean
+  /** Whether older history remains before this window. */
+  readonly hasBefore: boolean
+  /** Whether newer history remains after this window (the window is detached from the head). */
+  readonly hasAfter: boolean
+  /** The source head moved while this window stayed detached. */
+  readonly headChanged: boolean
+  /** Version the window currently holds, or null before the opening snapshot lands. */
+  readonly version: SourceVersion | null
+  /** Current window entries in ascending sequence order. */
+  readonly entries: readonly SessionEventLikeEntry[]
+  /**
+   * Correction outcome of the last committed window replacement: `applied` when
+   * every measured reader re-applied its position, `failed` when the window is
+   * published but the reading position could not be corrected.
+   */
+  readonly correction: 'applied' | 'failed'
+  /** Failed correction detail, or null when the last committed replacement corrected cleanly. */
+  readonly correctionError: string | null
+
+
+  /** Opaque source boundaries; undefined preserves the legacy event-coordinate path. */
+  readonly before?: string | null | undefined
+  readonly after?: string | null | undefined
+
+}
+
+/** One releasable Pane reading scope; acquire and release as a pair. */
+export interface ConversationHistoryViewV1 {
+  readonly version: 1
+  /** Stable view (Pane) identity inside the Session generation. */
+  readonly viewId: string
+  /** Published reading facts. */
+  readonly snapshot: ObservableSnapshot<HistoryViewSnapshotV1>
+  /** Conversation view snapshots assembled from this window only. */
+  readonly reads: ConversationViewSnapshotStore
+  /**
+   * Move this window and read one bounded page.
+   * @param request - latest, cursor, or around-target navigation.
+   * @param signal - caller cancellation; rejects with an AbortError.
+   * @returns the published window after the page applied.
+   */
+  read(request: HistoryReadV1, signal?: AbortSignal): Promise<HistoryViewSnapshotV1>
+  /**
+   * Re-read the newest window after a version gap; reuses this window id.
+   * @param signal - caller cancellation; rejects with an AbortError.
+   * @returns the published window after the resync applied.
+   */
+  refresh(signal?: AbortSignal): Promise<HistoryViewSnapshotV1>
+  /** Release this acquisition; the window closes after the last release. */
+  release(): void
+}
+
+/** One feature plugin's installed reading-scope delivery for a Pane. */
+export interface HistoryViewInjectionV1 {
+  /** Receives one Pane scope, and null when that Pane releases it. */
+  onHistoryView?: (view: ConversationHistoryViewV1 | null) => void
+}
+
+/** Consumer-facing snapshot of the optional window paging state. */
+export interface HistoryPagingV1 {
+  /** Whether a page read or resync is in flight for this window. */
+  readonly busy: boolean
+  /** Whether older history remains in this window. */
+  readonly hasOlder: boolean
+  /** Whether the view is detached from the source head. */
+  readonly detached: boolean
+  /** Whether the source head moved while the view stayed detached. */
+  readonly headChanged: boolean
+}
