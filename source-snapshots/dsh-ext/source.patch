diff --git a/packages/client/ui-chat/tests/capability-matrix.client.spec.ts b/packages/client/ui-chat/tests/capability-matrix.client.spec.ts
new file mode 100644
index 00000000..ec49b745
--- /dev/null
+++ b/packages/client/ui-chat/tests/capability-matrix.client.spec.ts
@@ -0,0 +1,50 @@
+/**
+ * Capability declaration matrix (G4 static half).
+ *
+ * Each build-time switch must gate exactly its own capability, so a build with
+ * a feature off declares nothing and stays on the official path. Every
+ * combination is re-imported with fresh modules because the switches are read
+ * when the capability modules are evaluated.
+ */
+import { afterEach, describe, expect, test, vi } from 'vitest'
+
+const SWITCHES = [
+  ['mountedChat', 'DSH_CLIENT_MOUNTED_CHAT'],
+  ['historySource', 'DSH_CLIENT_HISTORY_SOURCE'],
+  ['windowCommit', 'DSH_CLIENT_WINDOW_COMMIT'],
+] as const
+
+const saved = new Map<string, string | undefined>()
+
+afterEach(() => {
+  for (const [name, value] of saved) {
+    if (value === undefined) delete process.env[name]
+    else process.env[name] = value
+  }
+  saved.clear()
+  vi.resetModules()
+})
+
+describe('capability declaration matrix', () => {
+  for (let mask = 0; mask < 8; mask++) {
+    const enabled = Object.fromEntries(SWITCHES.map(([capability], index) => [capability, (mask & (1 << index)) !== 0]))
+    test(`switch combination ${mask}: ${Object.entries(enabled).map(([name, on]) => `${name}=${on ? 'on' : 'off'}`).join(' ')}`, async () => {
+      for (const [index, [, variable]] of SWITCHES.entries()) {
+        if (!saved.has(variable)) saved.set(variable, process.env[variable])
+        if ((mask & (1 << index)) !== 0) delete process.env[variable]
+        else process.env[variable] = 'off'
+      }
+      vi.resetModules()
+      const chat = await import('../src/client/index.ts')
+      const sessions = await import('../../../api/session-controller/src/client/index.ts')
+      const declared = {
+        mountedChat: chat.capabilities.mountedChat,
+        historySource: sessions.historySourceCapabilities.historySource,
+        windowCommit: sessions.windowCommitCapabilities.windowCommit,
+      }
+      for (const [capability] of SWITCHES) {
+        expect(declared[capability], `${capability} declaration for combination ${mask}`).toBe(enabled[capability] ? 1 : undefined)
+      }
+    })
+  }
+})
