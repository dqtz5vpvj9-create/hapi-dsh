@@ -0,0 +1,28 @@
+/**
+ * Optional windowed-history pagination read for the Chat view.
+ *
+ * A feature plugin that owns per-Pane reading scopes installs a
+ * `historyPagingConsumer` service publishing the active window's paging facts
+ * per Session. With no consumer the Chat view reads the default Session
+ * snapshot, so the official pagination affordance is unchanged.
+ */
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import type { HistoryPagingV1 } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** One feature plugin's per-Session window paging source. */
+export interface HistoryPagingConsumerV1 {
+  /**
+   * Resolve the paging facts of the window attached to a Session's Chat view.
+   * @param sessionId - the Session whose Chat view is reading.
+   * @returns the paging source, or undefined when no window is attached.
+   */
+  paging(sessionId: SessionId): HostObservable<HistoryPagingV1 | undefined> | undefined
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Optional windowed-history pagination source installed by an extension plugin. */
+    historyPagingConsumer: HistoryPagingConsumerV1
+  }
+}
diff --git a/packages/client/ui-chat/src/client/contract/mounted-chat.ts b/packages/client/ui-chat/src/client/contract/mounted-chat.ts
new file mode 100644
index 00000000..9fe064f2
--- /dev/null
+++ b/packages/client/ui-chat/src/client/contract/mounted-chat.ts
@@ -0,0 +1,153 @@
+/**
+ * Mounted Chat control: the control face of one attached Chat view, the
+ * injection that delivers it, and the read-only capability it announces.
+ *
+ * A feature plugin consumes this extension by providing an optional
+ * `mountedChatConsumer` service; the Chat plugin installs the view-owned
+ * callback on its next mount and calls it with null when the view unmounts.
+ * With no consumer, the Chat view takes the unextended path: it creates no
+ * control, publishes no reading facts, and starts no extra history work.
+ */
+import type { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+
+/** Releases one subscription. */
+export type Stop = () => void
+
+/** Durable history target named by a stable Chat node key and its source sequence. */
+export interface HistoryTarget {
+  /** Stable Chat node key inside the committed window, or the key to load. */
+  readonly key: string
+  /** Durable Session event sequence that establishes the target's position. */
+  readonly seq: SessionSeq
+}
+
+/** Read-side facts of one mounted Chat view. */
+export interface ReadingSnapshotV1 {
+  /** Monotonic revision; advances once per committed change of a published fact. */
+  readonly revision: number
+  /** Visible reading anchor, or null while the view follows the live tail. */
+  readonly anchor: { readonly key: string; readonly top: number } | null
+  /** Whether the view follows the live tail. */
+  readonly following: boolean
+  /** Whether older history remains in the source. */
+  readonly hasOlder: boolean
+  /** Whether an older-page load or history navigation is in flight. */
+  readonly busy: boolean
+}
+
+/**
+ * Control face of one mounted Chat view. Every history method resolves after
+ * the committed window and its layout have been applied, never merely after a
+ * request is sent, and rejects after the view unmounts.
+ */
+export interface MountedChatV1 {
+  readonly version: 1
+  /** @returns the current reading facts, from the latest committed layout. */
+  read(): ReadingSnapshotV1
+  /**
+   * Observe committed reading changes.
+   * @param listener - called after a published reading fact changes.
+   * @returns a subscription disposer.
+   */
+  subscribe(listener: () => void): Stop
+  /**
+   * Load one older history page.
+   * @param signal - optional caller cancellation; rejects with an AbortError.
+   * @returns completion after the page's content and layout commit.
+   */
+  loadOlder(signal?: AbortSignal): Promise<void>
+  /** Sample this reader immediately before an external history window publishes. */
+  preparePageCommit?(): void
+  /**
+   * Reveal one durable history target, loading older history when needed.
+   * @param target - stable node key plus the sequence that positions it.
+   * @param signal - optional caller cancellation; rejects with an AbortError.
+   * @returns completion after the target's content and layout commit.
+   */
+  reveal(target: HistoryTarget, signal?: AbortSignal): Promise<void>
+  /**
+   * Read the source's newest window when one is supplied, then land on the tail.
+   * @param signal - optional caller cancellation; rejects with an AbortError.
+   * @returns completion after the tail landing commits.
+   */
+  toLatest(signal?: AbortSignal): Promise<void>
+}
+
+/** Injection a feature plugin consumes to receive mounted Chat controls. */
+export interface MountedChatInjectionV1 {
+  /** Receives the view's control and root element; unmount delivers null with the same element. */
+  onMountedChat?: (control: MountedChatV1 | null, element: HTMLElement) => void
+}
+
+/**
+ * Optional authoritative source operations. The default Session window always
+ * follows the source head, so its mounted control needs none; a windowed
+ * history source supplies `readLatest` so `toLatest` fetches the head instead
+ * of landing on an older retained window.
+ */
+export interface MountedChatSourceV1 {
+  /**
+   * Fetch and commit the source's newest window.
+   * @param signal - caller cancellation for the read.
+   */
+  readLatest?: (signal: AbortSignal) => Promise<void>
+}
+
+/** Read-only capability declaration; feature plugins probe it instead of private fields or version strings. */
+export interface MountedChatCapabilitiesV1 {
+  /** Present with value 1 when this build carries the mounted Chat control. */
+  readonly mountedChat?: 1
+}
+
+/**
+ * Build-time switch. Unset keeps the capability on; `off` removes it from the
+ * declaration and stops the Chat plugin from delivering any control.
+ * @returns whether this build carries the mounted Chat control.
+ */
+function mountedChatEnabled(): boolean {
+  try {
+    if (Reflect.get(globalThis, '__DSH_CLIENT_MOUNTED_CHAT') === 'off') return false
+  } catch { /* non-global hosts keep the default */ }
+  return process.env.DSH_CLIENT_MOUNTED_CHAT !== 'off'
+}
+
+/** Read-only capability set announced by this package. */
+export const capabilities: Readonly<MountedChatCapabilitiesV1> = Object.freeze(
+  mountedChatEnabled() ? { mountedChat: 1 as const } : {},
+)
+
+/** Structured failure codes shared by mounted Chat operations; cancellation rejects with an AbortError. */
+export type MountedChatFailureCode = 'DISPOSED' | 'TARGET_UNAVAILABLE'
+
+/** Typed mounted Chat failure with a stable code. */
+export class MountedChatError extends Error {
+  /**
+   * @param code - structured failure code.
+   * @param message - human-readable detail for logs.
+   */
+  constructor(readonly code: MountedChatFailureCode, message: string) {
+    super(message)
+    this.name = 'MountedChatError'
+  }
+}
+
+/**
+ * One feature plugin's installed position for mounted Chat controls. The
+ * optional head read lets a windowed history source satisfy `toLatest`'s
+ * freshness contract; the default live window omits it.
+ */
+export interface MountedChatConsumerV1 extends MountedChatInjectionV1 {
+  /**
+   * Fetch and commit the newest source window for one Session.
+   * @param sessionId - the Session whose mounted view is asking.
+   * @param signal - caller cancellation for the read.
+   */
+  readLatest?(sessionId: SessionId, signal: AbortSignal): Promise<void>
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Optional mounted Chat control consumer installed by an extension plugin. */
+    mountedChatConsumer: MountedChatConsumerV1
+  }
+}
