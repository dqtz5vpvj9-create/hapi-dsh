@@ -0,0 +1,36 @@
+/** Loader composition exercises a non-Agent consumer writing the original source's binary file. */
+import { expect, it, onTestFinished } from 'vitest'
+import { boot } from '@deepseek-ai/dsh-app-boot'
+import LocalFileSystem from '@deepseek-ai/dsh-fs-local'
+import { mkdtemp, readFile, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { fileURLToPath } from 'node:url'
+import type { Context } from '@deepseek-ai/cordis'
+
+it('loads a source filesystem and publishes exact bytes from an injected public consumer', async () => {
+  const directory = await mkdtemp(join(process.platform === 'win32' ? tmpdir() : '/mnt/cache/data-cache', 'dsh-byte-owner-'))
+  let ctx: Context | undefined
+  onTestFinished(async () => { await ctx?.fiber.dispose(); await rm(directory, { recursive: true, force: true }) })
+  let committed = false
+  const completed = Promise.withResolvers<void>()
+  const bytes = Uint8Array.from([0, 255, 195, 40, 13, 10])
+  ctx = await boot('byte-owner-test', fileURLToPath(new URL('./fixtures/byte-owner/cordis.yml', import.meta.url)), [], root => {
+    root.loader.builtins.sourceFilesystem = class SourceFileSystem extends LocalFileSystem {
+      constructor(scope: Context) { super(scope, LocalFileSystem.Config({ cwd: directory })) }
+    }
+    root.loader.builtins.byteConsumer = { name: 'byte-consumer', inject: ['fs'], apply(scope: Context) {
+      const writing = (async () => {
+        await scope.fs.writeBytes(await scope.fs.resolve('original.bin'), bytes, { kind: 'createIfAbsent' }, undefined, undefined,
+          () => { committed = true })
+      })()
+      writing.then(completed.resolve, completed.reject)
+      return writing
+    } }
+  })
+  await completed.promise
+  expect(committed).toBe(true)
+  expect(await readFile(join(directory, 'original.bin'))).toEqual(Buffer.from(bytes))
+  expect(ctx.get('agents')).toBeUndefined()
+  expect(ctx.get('agentLoop')).toBeUndefined()
+})
diff --git a/packages/fs/fs-local/tests/write-bytes.spec.ts b/packages/fs/fs-local/tests/write-bytes.spec.ts
