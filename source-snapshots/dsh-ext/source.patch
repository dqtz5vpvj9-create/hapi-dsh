+// @vitest-environment jsdom
+/** Explicit checkpoints sample the current official reader even without pending scroll work. */
+import { afterEach, expect, it, vi } from 'vitest'
+import type { ChatScrollPosition } from '../src/client/contract/slots.ts'
+import { ChatReading } from '../src/client/chat/use-chat-reading.ts'
+import { ChatViewport } from '../src/client/chat/use-chat-viewport.ts'
+import { ScrollFollow } from '../src/client/chat/use-scroll-follow.ts'
+import { MountedChatController } from '../src/client/chat/use-mounted-chat.ts'
+
+afterEach(() => { vi.restoreAllMocks() })
+
+function fixture(following = false, initialized = true) {
+  const position: ChatScrollPosition = { anchorKey: 'actual-node', anchorTop: 17, scrollTop: 100 }
+  const viewport = new ChatViewport(), follow = new ScrollFollow(following, 0)
+  const read = vi.fn(() => null), save = vi.fn<(value: ChatScrollPosition | null) => void>()
+  const capture = vi.spyOn(viewport, 'capturePosition').mockReturnValue(position)
+  const scroll = vi.spyOn(viewport, 'readScroll').mockReturnValue({ metrics: { top: 100, floor: 300, height: 200 }, movedByReader: false })
+  const target = new ChatReading(viewport, { read, save }, { initialized, followingTail: following, activeTurn: 1 }, vi.fn(), follow)
+  return { target, viewport, follow, position, capture, scroll, read, save }
+}
+
+it('captures and saves a stable reader without using old saved memory or moving the viewport', () => {
+  const value = fixture(), move = vi.spyOn(value.viewport, 'scrollToBottom'), restore = vi.spyOn(value.viewport, 'restore')
+  expect(value.target.pending).toBe(false)
+  value.target.checkpoint()
+  expect(value.capture).toHaveBeenCalledOnce(); expect(value.save).toHaveBeenCalledWith(value.position)
+  expect(value.read).not.toHaveBeenCalled(); expect(move).not.toHaveBeenCalled(); expect(restore).not.toHaveBeenCalled()
+})
+
+it('saves the real live-edge policy as null without inventing a body anchor', () => {
+  const value = fixture(true); value.target.checkpoint()
+  expect(value.save).toHaveBeenCalledWith(null); expect(value.capture).not.toHaveBeenCalled()
+})
+
+it('rejects an uninitialized, detached or unanchored reader without acknowledging a save', () => {
+  const initial = fixture(false, false); expect(() => initial.target.checkpoint()).toThrow(/stable viewport/); expect(initial.save).not.toHaveBeenCalled()
+  const detached = fixture(); detached.scroll.mockReturnValue(null)
+  expect(() => detached.target.checkpoint()).toThrow(/stable viewport/); expect(detached.save).not.toHaveBeenCalled()
+  const unanchored = fixture(); unanchored.capture.mockReturnValue(null)
+  expect(() => unanchored.target.checkpoint()).toThrow(/semantic position/); expect(unanchored.save).not.toHaveBeenCalled()
+})
+
+it('propagates the actual memory provider failure', () => {
+  const value = fixture(); value.save.mockImplementation(() => { throw new Error('save unavailable') })
+  expect(() => value.target.checkpoint()).toThrow('save unavailable')
+})
+
+it('the mounted control delegates only to its attached checkpoint owner and rejects after disposal', () => {
+  const control = new MountedChatController(), checkpoint = vi.fn()
+  const deps = { readFacts: () => ({ anchor: null, following: true, hasOlder: false, busy: false }), order: () => [], firstSeq: () => null,
+    hasOlder: () => false, busy: () => false, loadOlder: vi.fn(), loadThrough: vi.fn(async () => {}), revealKey: () => false, toLatest: vi.fn() }
+  control.bind(deps); expect(() => control.checkpointReading()).toThrow(/cannot capture/)
+  control.bind({ ...deps, checkpointReading: checkpoint }); control.checkpointReading(); expect(checkpoint).toHaveBeenCalledOnce()
+  control.bind({ ...deps, checkpointReading: () => { throw new Error('provider failed') } })
+  expect(() => control.checkpointReading()).toThrow('provider failed')
+  control.dispose(); expect(() => control.checkpointReading()).toThrow(/no longer attached/)
+})
