+/** Mounted Chat control: reading publication and settled history operations for one attached view. */
+import type { SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { ChatConversationViewNode } from '../contract/chat-nodes.ts'
+import {
+  MountedChatError, type HistoryTarget, type MountedChatV1, type ReadingSnapshotV1, type Stop,
+} from '../contract/mounted-chat.ts'
+
+/** Live mounted-view facts and operations the control reads at call time. */
+export interface MountedChatDependencies {
+  /** Sample the official viewport before externally owned history is published. */
+  preparePageCommit?: () => void
+  /** Capture and save the attached reader's current semantic position. */
+  checkpointReading?: () => void
+  /** @returns current committed reading facts, without the revision. */
+  readFacts: () => Omit<ReadingSnapshotV1, 'revision'>
+  /** @returns committed Chat node order. */
+  order: () => readonly string[]
+  /** @returns the window's first durable sequence, or null when no node anchors it. */
+  firstSeq: () => number | null
+  /** @returns whether older history remains in the source. */
+  hasOlder: () => boolean
+  /** @returns whether a history load or navigation is in flight. */
+  busy: () => boolean
+  /** Requests one older page; completion arrives with the following commits. */
+  loadOlder: () => void | Promise<void>
+  /** Pages history back until the committed window covers one sequence. */
+  loadThrough: (seq: SessionSeq) => Promise<void>
+  /** @returns whether one loaded node key was landed on. */
+  revealKey: (key: string) => boolean
+  /** Lands on the live tail. */
+  toLatest: () => void
+  /** Optional authoritative newest-window read; absent while the live window follows the head. */
+  readLatest?: (signal: AbortSignal) => Promise<void>
+}
+
+interface Operation {
+  readonly kind: 'older' | 'reveal' | 'latest'
+  settled: boolean
+  sawBusy?: boolean
+  awaitingLoad?: boolean
+  loadSettled?: boolean
+  resolve: () => void
+  reject: (error: unknown) => void
+  detach: () => void
+  /** Committed render count when the request started. */
+  readonly commit: number
+  /** Node order length when the request started. */
+  readonly orderLength: number
+  /** Window first sequence when the request started. */
+  readonly firstSeq: number | null
+  /** Reveal key this operation lands. */
+  readonly key: string
+  /** Whether the window load that precedes a reveal already settled. */
+  throughSettled: boolean
+}
+
+/** @returns whether the caller cancelled this operation. */
+function isAborted(signal: AbortSignal | undefined): boolean {
+  return signal?.aborted === true
+}
+
+/** Structured cancellation shared by every operation. */
+function abortError(): Error {
+  const message = 'the mounted Chat operation was aborted'
+  return typeof DOMException === 'function' ? new DOMException(message, 'AbortError') : Object.assign(new Error(message), { name: 'AbortError' })
+}
+
+/** @returns a typed target failure for one unavailable key. */
+function unavailable(key: string): MountedChatError {
+  return new MountedChatError('TARGET_UNAVAILABLE', `Chat target "${key}" is not available in the window`)
+}
+
+/** Compare published reading facts without the revision. */
+function sameFacts(left: ReadingSnapshotV1, right: Omit<ReadingSnapshotV1, 'revision'>): boolean {
+  return left.following === right.following && left.hasOlder === right.hasOlder && left.busy === right.busy
+    && left.renderRevision === right.renderRevision
+    && left.anchor?.key === right.anchor?.key && left.anchor?.top === right.anchor?.top
+}
+
+/**
+ * One mounted view's control face. Reading facts publish on committed layout;
+ * history operations settle only from a committed render, so a resolved
+ * promise means the window content and its layout are applied.
+ */
+export class MountedChatController implements MountedChatV1 {
+  readonly version = 1 as const
+  private dependencies: MountedChatDependencies | null = null
+  private disposed = false
+  private revision = 0
+  private current: ReadingSnapshotV1 | null = null
+  private commits = 0
+  private renderRevision = 0
+  private readonly rendered = new Map<string, { node: ChatConversationViewNode; seats: number }>()
+  private readonly listeners = new Set<() => void>()
+  private readonly operations = new Set<Operation>()
+
+  /**
+   * Adopt the mounted view's live facts for the next publication and operation.
+   * @param dependencies - live facts and operations, or null when the view detaches.
+   */
+  bind(dependencies: MountedChatDependencies | null): void {
+    this.dependencies = dependencies
+  }
+
+  /** @returns the reading facts from the latest committed layout. */
+  read(): ReadingSnapshotV1 {
+    const dependencies = this.active()
+    if (this.current !== null) return this.current
+    return { revision: this.revision, ...dependencies.readFacts(), ...this.renderRevision > 0 ? { renderRevision: this.renderRevision } : {} }
+  }
+
+  /** @inheritdoc */
+  renderedNode(key: string): ChatConversationViewNode | undefined {
+    this.active()
+    return this.rendered.get(key)?.node
+  }
+
+  /** Register one real Node seat's layout; cleanup cannot withdraw a newer payload with the same key. */
+  readonly recordRenderedNode = (node: ChatConversationViewNode): Stop => {
+    if (this.disposed) return () => {}
+    let current = this.rendered.get(node.key)
+    if (current?.node !== node) {
+      current = { node, seats: 0 }
+      this.rendered.set(node.key, current)
+    }
+    const seat = current
+    seat.seats += 1
+    this.renderRevision += 1
+    this.publish()
+    let live = true
+    return () => {
+      if (!live || this.disposed) return
+      live = false
+      if (this.rendered.get(node.key) !== seat) return
+      if (--seat.seats === 0) this.rendered.delete(node.key)
+      this.renderRevision += 1
+      this.publish()
+    }
+  }
+
+  /**
+   * Observe committed reading changes.
+   * @param listener - called after a published reading fact changes.
+   * @returns a subscription disposer.
+   */
+  subscribe(listener: () => void): Stop {
+    this.active()
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  /**
+   * Load one older history page.
+   * @param signal - optional caller cancellation.
+   * @returns completion after the page's content and layout commit.
+   */
+  async loadOlder(signal?: AbortSignal): Promise<void> {
+    this.active()
+    if (isAborted(signal)) throw abortError()
+    const dependencies = this.requireDependencies()
+    if (!dependencies.hasOlder()) return
+    return new Promise<void>((resolve, reject) => {
+      const operation = this.operation('older', resolve, reject)
+      operation.detach = this.watchAbort(signal, operation)
+      this.operations.add(operation)
+      const loading = dependencies.loadOlder()
+      if (loading !== undefined) {
+        operation.awaitingLoad = true
+        void loading.then(() => {
+          const afterLayout = (): void => {
+            if (operation.settled) return
+            operation.loadSettled = true
+            this.publish()
+            this.settleOlder()
+          }
+          if (typeof requestAnimationFrame === 'function') requestAnimationFrame(afterLayout)
+          else queueMicrotask(afterLayout)
+        }, error => { this.complete(operation, error) })
+      }
+    })
+  }
+
+  /** Sample the attached official reader before a history-window publication. */
+  preparePageCommit(): void {
+    this.requireDependencies().preparePageCommit?.()
+  }
+
+  /** Capture through the attached official reader; an unavailable callback cannot count as a saved checkpoint. */
+  checkpointReading(): void {
+    const checkpoint = this.active().checkpointReading
+    if (!checkpoint) throw new MountedChatError('TARGET_UNAVAILABLE', 'The mounted reader cannot capture a checkpoint.')
+    checkpoint()
+  }
+
+  /**
+   * Reveal one durable history target, loading older history when needed.
+   * @param target - stable node key plus the sequence that positions it.
+   * @param signal - optional caller cancellation.
+   * @returns completion after the target's content and layout commit.
+   */
+  async reveal(target: HistoryTarget, signal?: AbortSignal): Promise<void> {
+    this.active()
+    if (isAborted(signal)) throw abortError()
+    const dependencies = this.requireDependencies()
+    if (dependencies.order().includes(target.key)) {
+      if (dependencies.busy()) {
+        return new Promise<void>((resolve, reject) => {
+          const operation = this.operation('reveal', resolve, reject, target.key)
+          operation.throughSettled = true
+          operation.detach = this.watchAbort(signal, operation)
+          this.operations.add(operation)
+        })
+      }
+      if (!dependencies.revealKey(target.key)) return Promise.reject(unavailable(target.key))
+      return new Promise<void>((resolve) => { queueMicrotask(resolve) })
+    }
+    const firstSeq = dependencies.firstSeq()
+    if (!dependencies.hasOlder() || firstSeq !== null && target.seq >= firstSeq) {
+      return Promise.reject(unavailable(target.key))
+    }
+    return new Promise<void>((resolve, reject) => {
+      const operation = this.operation('reveal', resolve, reject, target.key)
+      operation.detach = this.watchAbort(signal, operation)
+      this.operations.add(operation)
+      void dependencies.loadThrough(target.seq).then(
+        () => {
+          if (operation.settled) return
+          operation.throughSettled = true
+          this.settleReveals()
+          this.scheduleRevealCheck(operation)
+        },
+        () => { this.complete(operation, unavailable(target.key)) },
+      )
+    })
+  }
+
+  /**
+   * Read the source's newest window when one is supplied, then land on the tail.
+   * @param signal - optional caller cancellation.
+   * @returns completion after the tail landing commits.
+   */
+  async toLatest(signal?: AbortSignal): Promise<void> {
+    this.active()
+    if (isAborted(signal)) throw abortError()
+    const dependencies = this.requireDependencies()
+    if (dependencies.readLatest !== undefined) {
+      await dependencies.readLatest(signal ?? new AbortController().signal)
+    }
+    this.active()
+    if (isAborted(signal)) throw abortError()
+    await new Promise<void>((resolve, reject) => {
+      const operation = this.operation('latest', resolve, reject)
+      operation.detach = this.watchAbort(signal, operation)
+      this.operations.add(operation)
+      dependencies.toLatest()
+      // A tail landing that changes no rendered fact still resolves here: the
+      // layout was already committed before the request.
+      queueMicrotask(() => {
+        if (operation.settled || this.disposed) return
+        if (this.dependencies?.readFacts().following === true && !this.dependencies.busy()) {
+          this.publish()
+          this.complete(operation)
+        }
+      })
+    })
+  }
+
+  /** Release listeners and reject outstanding operations; later calls reject as disposed. */
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    const error = new MountedChatError('DISPOSED', 'the mounted Chat view is no longer attached')
+    for (const operation of [...this.operations]) this.complete(operation, error)
+    this.listeners.clear()
+    this.rendered.clear()
+    this.dependencies = null
+  }
+
+  /** Publish reading facts after one committed render, then settle waiting operations. */
+  publish(): void {
+    if (this.disposed) return
+    const dependencies = this.dependencies
+    if (dependencies === null) return
+    this.commits += 1
+    const facts = { ...dependencies.readFacts(), ...this.renderRevision > 0 ? { renderRevision: this.renderRevision } : {} }
+    if (this.current !== null && sameFacts(this.current, facts)) return
+    this.revision += 1
+    this.current = { revision: this.revision, ...facts }
+    for (const listener of [...this.listeners]) listener()
+  }
+
+  /** Settle operations whose committed render satisfies their landing condition. */
+  settle(): void {
+    if (this.disposed) return
+    this.settleOlder()
+    this.settleReveals()
+    this.settleLatest()
+  }
+
+  private settleOlder(): void {
+    const dependencies = this.dependencies
+    if (dependencies === null) return
+    const order = dependencies.order()
+    const firstSeq = dependencies.firstSeq()
+    for (const operation of [...this.operations]) {
+      if (operation.kind !== 'older' || operation.settled) continue
+      if (dependencies.busy()) { operation.sawBusy = true; continue }
+      if (this.commits <= operation.commit) continue
+      if (operation.awaitingLoad) {
+        if (operation.loadSettled) this.complete(operation)
+        continue
+      }
+      if (order.length !== operation.orderLength || firstSeq !== operation.firstSeq) {
+        this.complete(operation)
+        continue
+      }
+      if (!dependencies.hasOlder()) {
+        this.complete(operation)
+        continue
+      }
+      // Releasing tail follow also commits a render. It is not the page result.
+      if (!operation.sawBusy) continue
+      this.complete(operation, new MountedChatError('TARGET_UNAVAILABLE', 'older history did not advance the window'))
+    }
+  }
+
+  private settleReveals(): void {
+    const dependencies = this.dependencies
+    if (dependencies === null || dependencies.busy()) return
+    const order = dependencies.order()
+    for (const operation of [...this.operations]) {
+      if (operation.kind !== 'reveal' || operation.settled || !order.includes(operation.key)) continue
+      if (dependencies.revealKey(operation.key)) this.complete(operation)
+      else this.complete(operation, unavailable(operation.key))
+    }
+  }
+
+  private settleLatest(): void {
+    const dependencies = this.dependencies
+    if (dependencies === null || dependencies.busy() || !dependencies.readFacts().following) return
+    for (const operation of [...this.operations]) {
+      if (operation.kind === 'latest' && !operation.settled) this.complete(operation)
+    }
+  }
+
+  /** Confirm a reveal failed only after a frame gave the loading window time to commit. */
+  private scheduleRevealCheck(operation: Operation): void {
+    const check = (): void => {
+      if (operation.settled) return
+      const dependencies = this.dependencies
+      if (dependencies !== null && dependencies.order().includes(operation.key)) {
+        this.settleReveals()
+        return
+      }
+      this.complete(operation, unavailable(operation.key))
+    }
+    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(check)
+    else queueMicrotask(check)
+  }
+
+  private operation(
+    kind: Operation['kind'], resolve: () => void, reject: (error: unknown) => void, key = '',
+  ): Operation {
+    const dependencies = this.requireDependencies()
+    return {
+      kind, resolve, reject, settled: false, detach: () => {},
+      commit: this.commits, orderLength: dependencies.order().length, firstSeq: dependencies.firstSeq(),
+      key, throughSettled: false,
+    }
+  }
+
+  private watchAbort(signal: AbortSignal | undefined, operation: Operation): () => void {
+    if (signal === undefined) return () => {}
+    const onAbort = (): void => { this.complete(operation, abortError()) }
+    signal.addEventListener('abort', onAbort, { once: true })
+    return () => { signal.removeEventListener('abort', onAbort) }
+  }
+
+  private complete(operation: Operation, error?: unknown): void {
+    if (operation.settled) return
+    operation.settled = true
+    operation.detach()
+    this.operations.delete(operation)
+    if (error === undefined) operation.resolve()
+    else operation.reject(error)
+  }
+
+  private active(): MountedChatDependencies {
+    if (this.disposed) throw new MountedChatError('DISPOSED', 'the mounted Chat view is no longer attached')
+    return this.requireDependencies()
+  }
+
+  private requireDependencies(): MountedChatDependencies {
+    if (this.dependencies === null) {
+      throw new MountedChatError('DISPOSED', 'the mounted Chat view is not attached yet')
+    }
+    return this.dependencies
+  }
+}
