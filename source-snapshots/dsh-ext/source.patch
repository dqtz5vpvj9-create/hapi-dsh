+import { chatSnapshotFixture } from './chat-snapshot-fixture.client.ts'
+
+const SID = 's1' as SessionId
+const useResource = (() => ({ status: 'none' as const, value: undefined, failure: undefined })) as GlobalStandardProps['useResource']
