+/** History-provider selection and one Session generation's provider connection. */
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  DEFAULT_HISTORY_BUDGET,
+  HistorySourceError,
+  type Budget,
+  type HistoryDeltaV1,
+  type HistoryFeedV1,
+  type HistoryProviderV1,
+  type HistoryReadV1,
+  type HistorySourceV1,
+  type SessionHistoryReadV1,
+} from '../contract/history-source.ts'
+
+/**
+ * Select the provider that owns one Session generation.
+ * @param providers - registered providers in registration order.
+ * @param sessionId - generation whose history is about to open.
+ * @returns the single matching provider, or undefined when none matches.
+ * @throws HistorySourceError with code `PROVIDER_CONFLICT` when several match.
+ */
+export function selectHistoryProvider(
+  providers: Iterable<HistoryProviderV1>,
+  sessionId: SessionId,
+): HistoryProviderV1 | undefined {
+  let matched: HistoryProviderV1 | undefined
+  for (const provider of providers) {
+    if (!provider.matches(sessionId)) continue
+    if (matched !== undefined) {
+      throw new HistorySourceError(
+        'PROVIDER_CONFLICT',
+        `history providers "${matched.id}" and "${provider.id}" both claim session "${sessionId}"`,
+      )
+    }
+    matched = provider
+  }
+  return matched
+}
+
+/** Delegate an opening feed and observe its release without exposing provider internals. */
+function observedFeed(feed: HistoryFeedV1, onRelease: () => void): HistoryFeedV1 {
+  let released = false
+  const observed: HistoryFeedV1 = {
+    initial: feed.initial,
+    ...(feed.mode === undefined ? {} : { mode: feed.mode }),
+    ...(feed.publication === undefined ? {} : { publication: feed.publication }),
+    ...(feed.refresh === undefined ? {} : {
+      refresh: (budget: Budget, signal: AbortSignal) => feed.refresh!(budget, signal),
+    }),
+    read: (request: HistoryReadV1, budget: Budget, signal: AbortSignal) => feed.read(request, budget, signal),
+    changes: (after: string, signal: AbortSignal): AsyncIterable<HistoryDeltaV1> => feed.changes(after, signal),
+    release: () => {
+      if (released) return
+      released = true
+      try {
+        feed.release()
+      } finally {
+        onRelease()
+      }
+    },
+  }
+  return observed
+}
+
+/**
+ * One Session generation's provider connection. Windows are keyed by view id:
+ * a repeated open for a live view returns the same feed, and a feed release
+ * frees its id for a later reopen. The connection owns no Session lifecycle, so
+ * releasing every window never stops execution.
+ */
+export class SessionHistoryConnection implements SessionHistoryReadV1 {
+  readonly version = 1
+  private readonly windows = new Map<string, HistoryFeedV1>()
+  private readonly openings = new Map<string, Promise<HistoryFeedV1>>()
+  private released = false
+
+  /** @param source - provider connection opened for this Session generation. */
+  constructor(private readonly source: HistorySourceV1) {}
+
+  /** @returns whether the connection has been released. */
+  get isReleased(): boolean {
+    return this.released
+  }
+
+  /** @inheritdoc */
+  async openView(
+    viewId: string,
+    budget: Budget = DEFAULT_HISTORY_BUDGET,
+    signal: AbortSignal = new AbortController().signal,
+  ): Promise<HistoryFeedV1> {
+    if (this.released) throw new HistorySourceError('DISPOSED', `history connection for view "${viewId}" is released`)
+    signal.throwIfAborted()
+    const existing = this.windows.get(viewId)
+    if (existing !== undefined) return existing
+    const opening = this.openings.get(viewId)
+    if (opening !== undefined) return opening
+    const pending = this.source.openWindow(viewId, budget, signal).then((feed): HistoryFeedV1 => {
+      this.openings.delete(viewId)
+      if (this.released || signal.aborted) {
+        feed.publication?.discard(feed.initial.version)
+        feed.release()
+        signal.throwIfAborted()
+        throw new HistorySourceError('DISPOSED', `history connection for view "${viewId}" is released`)
+      }
+      let observed: HistoryFeedV1
+      observed = observedFeed(feed, () => {
+        if (this.windows.get(viewId) === observed) this.windows.delete(viewId)
+      })
+      this.windows.set(viewId, observed)
+      return observed
+    }, (error: unknown) => {
+      this.openings.delete(viewId)
+      throw error
+    })
+    this.openings.set(viewId, pending)
+    return pending
+  }
+
+  /** Release every window this connection still owns, then the provider connection. */
+  release(): void {
+    if (this.released) return
+    this.released = true
+    for (const feed of this.windows.values()) {
+      try {
+        feed.release()
+      } catch (error) {
+        console.error('[session-controller] history window release failed:', error)
+      }
+    }
+    this.windows.clear()
+    this.source.release()
+  }
+}
