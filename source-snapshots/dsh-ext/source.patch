diff --git a/packages/client/ui-sidebar-files/tests/navigator-style.client.spec.ts b/packages/client/ui-sidebar-files/tests/navigator-style.client.spec.ts
new file mode 100644
index 00000000..03735fed
--- /dev/null
+++ b/packages/client/ui-sidebar-files/tests/navigator-style.client.spec.ts
@@ -0,0 +1,41 @@
+// @vitest-environment jsdom
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { transform } from 'lightningcss'
+
+// Compile the real stylesheet with the official Client preset's CSS Modules
+// options. jsdom checks selector scope; actual media/layout is checked in Chromium.
+const filename = resolve('packages/client/ui-sidebar-files/src/client/FilesBody.module.css')
+const result = transform({ filename, code: readFileSync(filename), cssModules: { pattern: '[hash]_[local]' }, minify: true })
+const classes = Object.fromEntries(Object.entries(result.exports ?? {}).map(([name, value]) => [name, value.name]))
+
+afterEach(() => { document.head.replaceChildren(); document.body.replaceChildren() })
+function draw(owner: string, mode: string): HTMLElement {
+  const style = document.createElement('style')
+  style.textContent = result.code.toString()
+  document.head.append(style)
+  const row = document.createElement('div')
+  if (owner === 'files') row.className = classes.content!
+  else if (owner === 'preview') row.setAttribute('data-textpreview-content', '')
+  if (owner !== 'unrelated' && mode !== 'wholePage') {
+    row.classList.add(classes.navigatorRow!)
+    if (mode === 'fill') row.classList.add(classes.navigatorFillsRow!)
+  }
+  row.innerHTML = `<article>Readable content</article><aside class="${classes.navigator} ${classes[mode]}">Files</aside>`
+  document.body.append(row)
+  return row.querySelector('article')!
+}
+
+describe('navigator cover styles stay inside their owner', () => {
+  it('covers a file row and a preview row while their navigator fills the row', () => {
+    expect(getComputedStyle(draw('files', 'fill')).visibility).toBe('hidden')
+    expect(getComputedStyle(draw('preview', 'fill')).visibility).toBe('hidden')
+  })
+  it('keeps the preview readable beside overlay, push and whole-page navigators', () => {
+    for (const mode of ['overlay', 'push', 'wholePage']) expect(getComputedStyle(draw('preview', mode)).visibility).toBe('visible')
+  })
+  it('does not claim arbitrary parents outside the file and preview rows', () => {
+    expect(getComputedStyle(draw('unrelated', 'fill')).visibility).toBe('visible')
+  })
+})
