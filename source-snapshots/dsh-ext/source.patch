diff --git a/packages/client/ui-conversation/tests/history-source.client.spec.ts b/packages/client/ui-conversation/tests/history-source.client.spec.ts
new file mode 100644
index 00000000..611b256b
--- /dev/null
+++ b/packages/client/ui-conversation/tests/history-source.client.spec.ts
@@ -0,0 +1,525 @@
+/** 0001-history-source Conversation-side contracts: per-Pane windows, replacement, release. */
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import {
+  createScope, createWindowCommitFactory, MutableSessionEventSource,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+import type {
+  HistoryDeltaV1, HistoryFeedV1, HistoryReadV1, HistorySnapshotV1,
+  ISessions, SessionBinding, SessionEventLikeEntry, SessionFace,
+  SessionHistoryReadV1, SessionListState, SessionSnapshot,
+  WindowCommitFactoryV1, WindowReaderMeasurementV1, WindowReaderParticipantV1,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+import {
+  UiConversation,
+} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type {
+  ConversationNodeDefinition, ConversationViewDefinition, ConversationViewNode,
+} from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+const SESSION_ID = 'resident' as SessionId
+
+afterEach(() => { vi.unstubAllGlobals() })
+
+function entry(seq: number, turn = seq): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: { type: 'turn/start', seq: SessionSeq(seq), time: seq, data: { turn } },
+  }
+}
+
+function snapshot(
+  version: string,
+  entries: readonly SessionEventLikeEntry[],
+  hasBefore = false,
+  hasAfter = false,
+): HistorySnapshotV1 {
+  return { version, entries, before: `before-${version}`, after: `after-${version}`, hasBefore, hasAfter }
+}
+
+interface FakeWindow {
+  readonly feed: HistoryFeedV1
+  readonly opens: string[]
+  readonly reads: HistoryReadV1[]
+  readonly changesFrom: string[]
+  readonly releases: () => number
+  readonly latestAnswer: () => HistorySnapshotV1
+  push(delta: HistoryDeltaV1): void
+}
+
+function createWindow(
+  viewId: string,
+  initial: HistorySnapshotV1,
+  latest: () => HistorySnapshotV1,
+  before?: HistorySnapshotV1,
+): FakeWindow {
+  const reads: HistoryReadV1[] = []
+  const changesFrom: string[] = []
+  const opens = [viewId]
+  const buffered: HistoryDeltaV1[] = []
+  let waiter: ((delta: HistoryDeltaV1 | undefined) => void) | undefined
+  let releaseCount = 0
+  const next = async (): Promise<HistoryDeltaV1 | undefined> => {
+    const ready = buffered.shift()
+    if (ready !== undefined) return ready
+    return new Promise(resolve => { waiter = resolve })
+  }
+  const feed: HistoryFeedV1 = {
+    initial,
+    read: (request: HistoryReadV1) => {
+      reads.push(request)
+      if (request.kind === 'latest' || request.kind === 'around') return Promise.resolve(latest())
+      if (request.kind === 'before' && before !== undefined) return Promise.resolve(before)
+      return Promise.resolve(initial)
+    },
+    changes: async function* (after: string): AsyncIterable<HistoryDeltaV1> {
+      changesFrom.push(after)
+      for (;;) {
+        const delta = await next()
+        if (delta === undefined) return
+        yield delta
+      }
+    },
+    release: () => { releaseCount += 1 },
+  }
+  return {
+    feed,
+    opens,
+    reads,
+    changesFrom,
+    releases: () => releaseCount,
+    latestAnswer: latest,
+    push: (delta) => {
+      if (waiter !== undefined) {
+        const resolve = waiter
+        waiter = undefined
+        resolve(delta)
+      } else {
+        buffered.push(delta)
+      }
+    },
+  }
+}
+
+interface FakeConnection extends SessionHistoryReadV1 {
+  readonly opened: string[]
+  release(): void
+}
+
+/** One provider connection serving one scripted window per view id. */
+function createConnection(windows: ReadonlyMap<string, FakeWindow>): FakeConnection {
+  const opened: string[] = []
+  return {
+    version: 1,
+    opened,
+    openView: (viewId: string) => {
+      opened.push(viewId)
+      const window = windows.get(viewId)
+      if (window === undefined) return Promise.reject(new Error(`no window for ${viewId}`))
+      return Promise.resolve(window.feed)
+    },
+    release: () => {},
+  }
+}
+
+interface ProbeSnapshot {
+  readonly order: readonly string[]
+  readonly nodes: ReadonlyMap<string, ConversationViewNode>
+}
+
+function probeEvent(): ConversationNodeDefinition<null> {
+  return {
+    kind: 'probe',
+    target: 'probe',
+    match: event => event.type === 'turn/start'
+      ? { id: `turn-${event.data.turn}`, role: 'start' }
+      : null,
+    start: () => null,
+    update: context => context.state,
+    buildViewNode: context => ({
+      key: context.key,
+      kind: 'probe',
+      id: context.id,
+      target: 'probe',
+      data: null,
+    }),
+  }
+}
+
+function probeView(): ConversationViewDefinition<ConversationViewNode, ProbeSnapshot> {
+  return {
+    target: 'probe',
+    create: () => {
+      let current: ProbeSnapshot = { order: [], nodes: new Map() }
+      return {
+        empty: current,
+        replace: ({ nodes }) => {
+          current = {
+            order: nodes.map(node => node.key),
+            nodes: new Map(nodes.map(node => [node.key, node])),
+          }
+          return current
+        },
+        apply: ({ upserts }) => {
+          const nodes = new Map(current.nodes)
+          const order = [...current.order]
+          for (const node of upserts) {
+            if (!nodes.has(node.key)) order.push(node.key)
+            nodes.set(node.key, node)
+          }
+          current = { order, nodes }
+          return current
+        },
+      }
+    },
+  }
+}
+
+function sessionSnapshot(): SessionSnapshot {
+  return {
+    sessionId: SESSION_ID,
+    pendingSubmissions: [],
+    running: false,
+    subagent: null,
+    removed: false,
+    openState: 'open',
+    openError: null,
+    hasMore: false,
+    loadingOlder: false,
+    promptError: null,
+    blank: true,
+    lastAgentError: null,
+    promptAttempted: false,
+    awaitingFirstTurn: false,
+  }
+}
+
+interface SessionProbe {
+  readonly session: SessionFace
+  readonly cancel: ReturnType<typeof vi.fn>
+}
+
+function fakeSession(historyRead: SessionHistoryReadV1 | undefined): SessionProbe {
+  const snapshotStore = createSnapshotStore(sessionSnapshot())
+  const cancel = vi.fn<SessionFace['cancel']>(() => Promise.resolve({ ok: true, value: { accepted: true } }))
+  const session: SessionFace = {
+    sessionId: SESSION_ID,
+    projections: { faceOf: () => createSnapshotStore<unknown>(undefined) },
+    getSnapshot: () => snapshotStore.getSnapshot(),
+    subscribe: listener => snapshotStore.subscribe(listener),
+    beginSubmission: () => ({ requestId: 'test-req' as never, abandon: () => {} }),
+    prompt: () => Promise.reject(new Error('unused fake Session operation')),
+    readAttachment: () => Promise.reject(new Error('unused fake Session operation')),
+    updateQueue: () => Promise.reject(new Error('unused fake Session operation')),
+    cancel,
+    rename: () => Promise.reject(new Error('unused fake Session operation')),
+    loadOlder: () => Promise.reject(new Error('unused fake Session operation')),
+    loadThrough: () => Promise.reject(new Error('unused fake Session operation')),
+    command: () => Promise.reject(new Error('unused fake Session operation')),
+    ...(historyRead === undefined ? {} : { historyRead }),
+  }
+  return { session, cancel }
+}
+
+interface ConversationBench {
+  readonly ctx: Context
+  readonly uiConversation: UiConversation
+  readonly binding: SessionBinding
+  readonly session: SessionProbe
+}
+
+async function bench(
+  historyRead: SessionHistoryReadV1,
+  windowCommit?: WindowCommitFactoryV1,
+): Promise<ConversationBench> {
+  const ctx = new Context()
+  onTestFinished(async () => { await ctx.fiber.dispose() })
+  const probe = fakeSession(historyRead)
+  const scope = createScope(ctx, SESSION_ID)
+  const binding: SessionBinding = {
+    sessionId: SESSION_ID,
+    session: probe.session,
+    eventSource: new MutableSessionEventSource(),
+    ctx: scope.ctx,
+  }
+  const list = createSnapshotStore<SessionListState>({
+    ids: [SESSION_ID],
+    byId: {
+      [SESSION_ID]: {
+        id: SESSION_ID, displayTitle: SESSION_ID, running: false, blank: true, updatedAt: 1,
+        retainedBy: {},
+      },
+    },
+    phase: 'ready',
+    projectionsBySession: {},
+  })
+  const reference = {
+    sessionId: SESSION_ID,
+    binding,
+    ready: Promise.resolve(binding),
+    release: () => {},
+    [Symbol.dispose]: () => {},
+  }
+  const sessions: ISessions = {
+    list,
+    retain: () => reference,
+    using: async (_target, _options, operation) => operation(reference),
+    retainInfo: () => createSnapshotStore({ referenceCount: 1, retainedBy: {} }),
+    searchResultLimit: 10,
+    create: () => Promise.reject(new Error('unused fake Sessions operation')),
+    subagentAddress: () => undefined,
+    refreshProjections: () => Promise.resolve(),
+    refresh: () => Promise.resolve(),
+    search: () => Promise.reject(new Error('unused fake Sessions operation')),
+    fork: () => Promise.reject(new Error('unused fake Sessions operation')),
+    scope: () => undefined,
+    scopeOf: () => undefined,
+    sessionOf: () => undefined,
+    binding: () => binding,
+    ...(windowCommit === undefined ? {} : { windowCommit }),
+  }
+  const uiConversation = new UiConversation(ctx, sessions)
+  uiConversation.events.register(probeEvent())
+  uiConversation.views.register(probeView())
+  return { ctx, uiConversation, binding, session: probe }
+}
+
+async function openView(
+  uiConversation: UiConversation,
+  binding: SessionBinding,
+  viewId: string,
+) {
+  const conversation = uiConversation.binding(binding)
+  const view = conversation.historyView?.(viewId)
+  if (view === undefined) throw new Error('expected a windowed reading scope')
+  if (view === undefined) throw new Error(`expected a history view for ${viewId}`)
+  await vi.waitFor(() => { expect(view.snapshot.getSnapshot().phase).toBe('ready') })
+  return { conversation, view }
+}
+
+function measurement(overrides: Partial<WindowReaderMeasurementV1> = {}): WindowReaderMeasurementV1 {
+  return {
+    revision: 1,
+    anchor: null,
+    following: true,
+    scrollTop: 0,
+    clientHeight: 600,
+    scrollHeight: 1_200,
+    nodes: 2,
+    available: true,
+    ...overrides,
+  }
+}
+
+describe('0001-history-source Conversation contracts', () => {
+  it('two-views-independent', async () => {
+    const first = createWindow('pane-a', snapshot('a1', [entry(1)]), () => snapshot('a1', [entry(1)]),
+      snapshot('a0', [entry(0)], true))
+    const second = createWindow('pane-b', snapshot('b1', [entry(10, 10)]), () => snapshot('b1', [entry(10, 10)]))
+    const connection = createConnection(new Map([['pane-a', first], ['pane-b', second]]))
+    const b = await bench(connection)
+    const viewA = await openView(b.uiConversation, b.binding, 'pane-a')
+    const viewB = await openView(b.uiConversation, b.binding, 'pane-b')
+
+    expect(connection.opened).toEqual(['pane-a', 'pane-b'])
+    expect(first.opens).toEqual(['pane-a'])
+    expect(second.opens).toEqual(['pane-b'])
+
+    // One in-flight navigation per window: moving the first Pane's window does
+    // not move or force the second Pane onto the same bounded window.
+    await viewA.view.read({ kind: 'before', cursor: 'cursor-a' })
+    expect(viewA.view.snapshot.getSnapshot().entries.map(item => item.event.seq)).toEqual([0, 1])
+    expect(viewA.view.snapshot.getSnapshot().hasBefore).toBe(true)
+    expect(viewB.view.snapshot.getSnapshot().entries.map(item => item.event.seq)).toEqual([10])
+
+    // Same Pane re-acquisition reuses the live window instead of opening another.
+    const again = viewA.conversation.historyView?.('pane-a')
+    if (again === undefined) throw new Error('expected the live window')
+    expect(connection.opened).toEqual(['pane-a', 'pane-b'])
+    again.release()
+    expect(viewA.view.snapshot.getSnapshot().phase).toBe('ready')
+    viewA.view.release()
+    expect(viewA.view.snapshot.getSnapshot().phase).toBe('closed')
+    expect(first.releases()).toBe(1)
+    viewB.view.release()
+    expect(second.releases()).toBe(1)
+  })
+
+  it('replace-releases-nodes', async () => {
+    const window = createWindow(
+      'pane',
+      snapshot('v1', [entry(1)]),
+      () => snapshot('v2', [entry(2, 2)]),
+    )
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection)
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    const before = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (before === undefined) throw new Error('expected the probe view snapshot')
+    expect(before.order).toHaveLength(1)
+    const oldKey = before.order[0]!
+    expect(before.nodes.has(oldKey)).toBe(true)
+
+    await opened.view.read({ kind: 'latest' })
+    const after = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (after === undefined) throw new Error('expected the probe view snapshot')
+    expect(after.order).toHaveLength(1)
+    expect(after.order[0]).not.toBe(oldKey)
+    // Window replacement cleared and rebuilt the official assembler: the
+    // previous window's derived Contexts and nodes are gone.
+    expect(after.nodes.has(oldKey)).toBe(false)
+    // No arbitrary incremental node withdrawal is opened by the scope.
+    expect('withdraw' in opened.view).toBe(false)
+    expect('removeNode' in opened.view).toBe(false)
+    opened.view.release()
+  })
+
+  it('release-keeps-execution', async () => {
+    const window = createWindow('pane', snapshot('v1', [entry(1)]), () => snapshot('v1', [entry(1)]))
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection)
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    const conversation = opened.conversation
+    opened.view.release()
+    expect(opened.view.snapshot.getSnapshot().phase).toBe('closed')
+    expect(window.releases()).toBe(1)
+    // Releasing the reading window never releases Session execution.
+    expect(b.session.cancel).not.toHaveBeenCalled()
+    expect(b.binding.session.getSnapshot().openState).toBe('open')
+    expect(b.uiConversation.binding(b.binding)).toBe(conversation)
+    expect(b.binding.session.historyRead).toBe(connection)
+  })
+})
+
+describe('0003-window-commit Conversation contracts', () => {
+  it('measure-before-publish', async () => {
+    const window = createWindow('pane', snapshot('v1', [entry(1)]), () => snapshot('v2', [entry(2, 2)]))
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection, createWindowCommitFactory())
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    const participation = opened.conversation.windowCommit
+    if (participation === undefined) throw new Error('expected window-commit participation')
+
+    const before = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (before === undefined) throw new Error('expected the opening probe snapshot')
+    let measuredOrder: readonly string[] = []
+    const correctedOrder: string[][] = []
+    const participant: WindowReaderParticipantV1 = {
+      id: 'reader',
+      // The measurement observes the live window the publish is about to replace,
+      // so the offset it reports belongs to the pre-commit layout.
+      measure: () => {
+        measuredOrder = (opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined)?.order ?? []
+        return measurement({ scrollTop: 33, nodes: measuredOrder.length })
+      },
+      correct: () => {
+        correctedOrder.push([...((opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined)?.order ?? [])])
+      },
+    }
+    participation.register('pane', participant)
+
+    await opened.view.read({ kind: 'latest' })
+    const after = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (after === undefined) throw new Error('expected the replaced probe snapshot')
+    expect(before.order).toHaveLength(1)
+    expect(after.order).toHaveLength(1)
+    expect(after.order[0]).not.toBe(before.order[0])
+    // Measured before the publish (old window), corrected after it (new window).
+    expect(measuredOrder).toEqual(before.order)
+    expect(correctedOrder).toEqual([after.order])
+    opened.view.release()
+  })
+
+  it('no-intermediate-paint', async () => {
+    const window = createWindow('pane', snapshot('v1', [entry(1)]), () => snapshot('v2', [entry(2, 2)]))
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection, createWindowCommitFactory())
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    const participation = opened.conversation.windowCommit
+    if (participation === undefined) throw new Error('expected window-commit participation')
+    const before = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (before === undefined) throw new Error('expected the opening probe snapshot')
+
+    let candidateVisibleEarly = true
+    participation.register('pane', {
+      id: 'reader',
+      measure: () => {
+        // Inside the commit, before the layout publish, the published assembler
+        // still holds the old window: no observer sees the candidate early.
+        candidateVisibleEarly = ((opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined)?.order ?? []).join() !== before.order.join()
+        return measurement()
+      },
+      correct: () => {},
+    })
+    await opened.view.read({ kind: 'latest' })
+    expect(candidateVisibleEarly).toBe(false)
+    const after = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    expect(after?.order ?? []).not.toEqual(before.order)
+    opened.view.release()
+  })
+
+  it('correction-failure-is-not-success', async () => {
+    const window = createWindow('pane', snapshot('v1', [entry(1)]), () => snapshot('v2', [entry(2, 2)]))
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection, createWindowCommitFactory())
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    const participation = opened.conversation.windowCommit
+    if (participation === undefined) throw new Error('expected window-commit participation')
+    const before = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (before === undefined) throw new Error('expected the opening probe snapshot')
+    participation.register('pane', {
+      id: 'reader',
+      measure: () => measurement(),
+      correct: () => { throw new Error('anchor write rejected') },
+    })
+
+    // The page read resolves and the replacement is published; the correction
+    // failure is published as its own window fact, not folded into success.
+    await opened.view.read({ kind: 'latest' })
+    const after = opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined
+    if (after === undefined) throw new Error('expected the replaced probe snapshot')
+    expect(after.order).toHaveLength(1)
+    expect(after.order[0]).not.toBe(before.order[0])
+    const facts = opened.view.snapshot.getSnapshot()
+    expect(facts.phase).toBe('ready')
+    expect(facts.correction).toBe('failed')
+    expect(facts.correctionError).toBe('anchor write rejected')
+    opened.view.release()
+  })
+
+  it('registers-reader-before-window', async () => {
+    const window = createWindow('pane', snapshot('v1', [entry(1)]), () => snapshot('v1', [entry(1)]))
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection, createWindowCommitFactory())
+    const conversation = b.uiConversation.binding(b.binding)
+    const participation = conversation.windowCommit
+    if (participation === undefined) throw new Error('expected window-commit participation')
+    let measured = 0
+    participation.register('pane', {
+      id: 'reader',
+      measure: () => { measured += 1; return measurement() },
+      correct: () => {},
+    })
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    // The opening snapshot committed through the coordinator, so the reader
+    // registered before the window opened was measured at that commit.
+    expect(measured).toBeGreaterThan(0)
+    opened.view.release()
+  })
+
+  it('extension-absent-keeps-original-publish', async () => {
+    const window = createWindow('pane', snapshot('v1', [entry(1)]), () => snapshot('v2', [entry(2, 2)]))
+    const connection = createConnection(new Map([['pane', window]]))
+    const b = await bench(connection)
+    const conversation = b.uiConversation.binding(b.binding)
+    expect(conversation.windowCommit).toBeUndefined()
+    const opened = await openView(b.uiConversation, b.binding, 'pane')
+    await opened.view.read({ kind: 'latest' })
+    expect((opened.view.reads.get('probe' as never) as ProbeSnapshot | undefined)?.order).toHaveLength(1)
+    expect(opened.view.snapshot.getSnapshot().phase).toBe('ready')
+    opened.view.release()
+  })
+})
