index 00000000..0b7ed2c5
--- /dev/null
+++ b/packages/fs/fs-local/tests/write-bytes.spec.ts
@@ -0,0 +1,94 @@
+/** Exact binary publication through the real local provider; only Win32 syscalls are fixtures. */
+import { afterEach, beforeEach, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { LocalFileSystem } from '@deepseek-ai/dsh-fs-local'
+import { mkdtemp, readFile, readdir, rename, rm, stat, writeFile, chmod } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+let directory: string
+let ctx: Context
+let fs: LocalFileSystem
+const bytes = Uint8Array.from([0, 255, 128, 13, 10, 195, 40, 0])
+beforeEach(async () => {
+  directory = await mkdtemp(join(process.platform === 'win32' ? tmpdir() : '/mnt/cache/data-cache', 'dsh-write-bytes-'))
+  ctx = new Context()
+  await ctx.plugin(LocalFileSystem, { cwd: directory })
+  fs = ctx.fs as LocalFileSystem
+})
+afterEach(async () => { await ctx.fiber.dispose(); await rm(directory, { recursive: true, force: true }) })
+
+it('publishes an exact byte view, truncates with an empty payload and returns no text diff', async () => {
+  const target = await fs.resolve('binary')
+  const created = await fs.writeBytes(target, bytes.subarray(1, 6), { kind: 'createIfAbsent' })
+  expect(created.operation).toBe('create')
+  expect(Object.keys(created).sort()).toEqual(['operation', 'version'])
+  expect(await readFile(join(directory, 'binary'))).toEqual(Buffer.from(bytes.subarray(1, 6)))
+  const replaced = await fs.writeBytes(target, new Uint8Array(), { kind: 'replaceIfVersion', version: created.version })
+  expect(replaced.operation).toBe('update')
+  expect(await readFile(join(directory, 'binary'))).toEqual(Buffer.alloc(0))
+})
+
+it('retains guarded no-replace creation and version checks for byte writes', async () => {
+  const path = join(directory, 'binary'), target = await fs.resolve(path)
+  const original = await fs.writeBytes(target, bytes, { kind: 'createIfAbsent' })
+  await expect(fs.writeBytes(target, Uint8Array.of(1), { kind: 'createIfAbsent' })).rejects.toMatchObject({ code: 'FS_NOT_OBSERVED' })
+  await writeFile(path, 'external writer')
+  await expect(fs.writeBytes(target, bytes, { kind: 'replaceIfVersion', version: original.version })).rejects.toMatchObject({ code: 'FS_STALE_VERSION' })
+  expect(await readFile(path, 'utf8')).toBe('external writer')
+})
+
+it('awaits current authority before publication and preserves refusal identity and staging cleanup', async () => {
+  const path = join(directory, 'binary'), entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>()
+  await writeFile(path, 'original')
+  const refusal = new Error('Source access was revoked')
+  const pending = fs.writeBytes(await fs.resolve(path), bytes, undefined, undefined, undefined, async () => {
+    entered.resolve(); await release.promise; throw refusal
+  })
+  const rejected = expect(pending).rejects.toBe(refusal)
+  try { await entered.promise; expect(await readFile(path, 'utf8')).toBe('original') } finally { release.resolve() }
+  await rejected
+  expect(await readFile(path, 'utf8')).toBe('original')
+  expect(await readdir(directory)).toEqual(['binary'])
+})
+
+it('serializes text and binary writes with the same target lock and stale guard', async () => {
+  const target = await fs.resolve('binary'), original = await fs.writeBytes(target, bytes)
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>()
+  const first = fs.writeBytes(target, Uint8Array.of(9), { kind: 'replaceIfVersion', version: original.version }, undefined, undefined,
+    async () => { entered.resolve(); await release.promise })
+  await entered.promise
+  const second = fs.writeText(target, 'must remain stale', { kind: 'replaceIfVersion', version: original.version })
+  const rejected = expect(second).rejects.toMatchObject({ code: 'FS_STALE_VERSION' })
+  release.resolve(); await first; await rejected
+  expect(await readFile(join(directory, 'binary'))).toEqual(Buffer.from([9]))
+})
+
+it('rechecks cancellation and guarded creation after the byte staging checkpoint', async () => {
+  const path = join(directory, 'binary'), target = await fs.resolve(path), controller = new AbortController()
+  await expect(fs.writeBytes(target, bytes, undefined, controller.signal, undefined, () => { controller.abort() }))
+    .rejects.toMatchObject({ code: 'FS_ABORTED' })
+  expect(await readdir(directory)).toEqual([])
+  await expect(fs.writeBytes(target, bytes, { kind: 'createIfAbsent' }, undefined, undefined, () => writeFile(path, 'external creator')))
+    .rejects.toMatchObject({ code: 'FS_NOT_OBSERVED' })
+  expect(await readFile(path, 'utf8')).toBe('external creator')
+})
+
+it.skipIf(process.platform === 'win32')('preserves existing POSIX permissions while replacing arbitrary bytes', async () => {
+  const path = join(directory, 'binary')
+  await writeFile(path, 'original'); await chmod(path, 0o640)
+  await fs.writeBytes(await fs.resolve(path), bytes)
+  expect((await stat(path)).mode & 0o777).toBe(0o640)
+  expect(await readFile(path)).toEqual(Buffer.from(bytes))
+})
+
+it('prepares Windows DACL before authority and protected byte replacement', async () => {
+  const path = join(directory, 'binary'), order: string[] = []
+  await writeFile(path, 'original')
+  fs.internals.platform = 'win32'
+  fs.internals.copyFileDacl = async () => { order.push('copy-dacl') }
+  fs.internals.replaceFile = async (replaced, replacement) => { order.push('replace-file'); await rename(replacement, replaced) }
+  await fs.writeBytes(await fs.resolve(path), bytes, undefined, undefined, undefined, () => { order.push('current-authority') })
+  expect(order).toEqual(['copy-dacl', 'current-authority', 'replace-file'])
+  expect(await readFile(path)).toEqual(Buffer.from(bytes))
+})
