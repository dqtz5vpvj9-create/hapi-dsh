@@ -0,0 +1,152 @@
+/**
+ * 0003-window-commit reader contracts for the mounted Chat: the participant
+ * measures the official scrollport before a window publish and re-applies its
+ * own anchor after the layout commit, without taking scroll ownership.
+ */
+import { describe, expect, it, vi } from 'vitest'
+import type { WindowLayoutV1, WindowReaderMeasurementV1 } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ViewportMetrics } from '../src/client/chat/use-chat-viewport.ts'
+import type { ChatScrollPosition } from '../src/client/contract/slots.ts'
+import {
+  createWindowCommitReader, type WindowCommitReaderSourceV1,
+} from '../src/client/chat/use-chat-scroll.ts'
+
+interface FakeReader {
+  readonly source: WindowCommitReaderSourceV1
+  readonly metrics: { value: ViewportMetrics | null }
+  readonly position: { value: ChatScrollPosition | null }
+  readonly following: { value: boolean }
+  readonly restored: ChatScrollPosition[]
+  readonly followedTail: () => number
+}
+
+function fakeReader(): FakeReader {
+  const metrics = { value: { top: 120, height: 600, floor: 900 } as ViewportMetrics | null }
+  const position = {
+    value: { anchorKey: 'turn-3', anchorTop: 16, scrollTop: 120 } as ChatScrollPosition | null,
+  }
+  const following = { value: false }
+  const restored: ChatScrollPosition[] = []
+  let tailLandings = 0
+  const source: WindowCommitReaderSourceV1 = {
+    readMetrics: () => metrics.value,
+    capturePosition: () => position.value,
+    restore: (next) => { restored.push(next) },
+    following: () => following.value,
+    followTail: () => { tailLandings += 1 },
+    rows: () => 12,
+  }
+  return { source, metrics, position, following, restored, followedTail: () => tailLandings }
+}
+
+/** Layout facts a coordinator hands to a measured participant. */
+function layout(measurement: WindowReaderMeasurementV1): WindowLayoutV1 {
+  return { windowId: 'pane-a', baseRevision: 0, revision: 1, measurement }
+}
+
+describe('0003-window-commit reader contracts', () => {
+  it('measure-reports-official-reader', () => {
+    const fake = fakeReader()
+    const participant = createWindowCommitReader(fake.source)
+    expect(participant.id).toBe('ui-chat')
+    const first = participant.measure()
+    expect(first).toMatchObject({
+      anchor: { key: 'turn-3', top: 16 },
+      following: false,
+      scrollTop: 120,
+      clientHeight: 600,
+      scrollHeight: 1_500,
+      nodes: 12,
+      available: true,
+      revision: 1,
+    })
+    // Each commit samples again, so movement between prepare and commit wins.
+    fake.metrics.value = { top: 220, height: 600, floor: 900 }
+    const second = participant.measure()
+    expect(second.revision).toBe(2)
+    expect(second.scrollTop).toBe(220)
+  })
+
+  it('measure-before-publish-order', () => {
+    const fake = fakeReader()
+    const participant = createWindowCommitReader(fake.source)
+    const events: string[] = []
+    const publish = (): void => { events.push('publish') }
+    // The coordinator measures, then publishes, then asks the participant to
+    // correct; the participant adds no step of its own in between.
+    const measured = participant.measure()
+    events.push('measure')
+    publish()
+    participant.correct(measured, layout(measured))
+    events.push('corrected')
+    expect(events).toEqual(['measure', 'publish', 'corrected'])
+    expect(fake.restored).toEqual([{ anchorKey: 'turn-3', anchorTop: 16, scrollTop: 120 }])
+  })
+
+  it('correct-reapplies-anchor-or-follow-tail', () => {
+    const fake = fakeReader()
+    const participant = createWindowCommitReader(fake.source)
+    const measured = participant.measure()
+    participant.correct(measured, layout(measured))
+    expect(fake.restored).toHaveLength(1)
+    expect(fake.followedTail()).toBe(0)
+
+    // With no pin, following is the only correction; without either, nothing is
+    // forced, because an unpinned reader must not be treated as following.
+    fake.position.value = null
+    fake.following.value = true
+    fake.metrics.value = { top: 900, height: 600, floor: 900 }
+    const tail = participant.measure()
+    expect(tail.anchor).toBeNull()
+    participant.correct(tail, layout(tail))
+    expect(fake.followedTail()).toBe(1)
+    expect(fake.restored).toHaveLength(1)
+
+    fake.following.value = false
+    const unpinned = participant.measure()
+    participant.correct(unpinned, layout(unpinned))
+    expect(fake.followedTail()).toBe(1)
+    expect(fake.restored).toHaveLength(1)
+  })
+
+  it('correct-unavailable-measurement-is-a-no-op', () => {
+    const fake = fakeReader()
+    fake.metrics.value = null
+    const participant = createWindowCommitReader(fake.source)
+    const unavailable = participant.measure()
+    expect(unavailable.available).toBe(false)
+    participant.correct(unavailable, layout(unavailable))
+    expect(fake.restored).toHaveLength(0)
+    expect(fake.followedTail()).toBe(0)
+  })
+
+  it('correction-failure-is-not-success', () => {
+    const fake = fakeReader()
+    const participant = createWindowCommitReader({
+      ...fake.source,
+      restore: () => { throw new Error('anchor write rejected') },
+    })
+    const measured = participant.measure()
+    // The reader does not swallow its own correction failure: the coordinator
+    // receives it and reports a committed-but-uncorrected window.
+    expect(() => participant.correct(measured, layout(measured)))
+      .toThrowError('anchor write rejected')
+  })
+
+  it('registration-is-reader-owned', () => {
+    const fake = fakeReader()
+    const participant = createWindowCommitReader(fake.source, 'pane-a/chat')
+    const registered: string[] = []
+    const unregister = vi.fn()
+    const registration = {
+      register: (candidate: typeof participant): (() => void) => {
+        registered.push(candidate.id)
+        return unregister
+      },
+    }
+    const stop = registration.register(participant)
+    expect(registered).toEqual(['pane-a/chat'])
+    stop()
+    expect(unregister).toHaveBeenCalledTimes(1)
+  })
+})
