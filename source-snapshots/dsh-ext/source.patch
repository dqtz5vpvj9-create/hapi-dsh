+import type { ConversationViewSnapshotStore } from '../contract/conversation.ts'
+import type {
+  ConversationHistoryViewV1, HistoryViewSnapshotV1,
+} from '../contract/history-view.ts'
+import type { ConversationNodeAssembler } from './assembler.ts'
+
+/** Opening envelope for one reading window (spec G3: events ≤ 5000, body ≤ 12MiB, nodes ≤ B=2000). */
+export const HISTORY_VIEW_BUDGET: Budget = Object.freeze({
+  events: 5_000,
+  bytes: 12 * 1024 * 1024,
+  nodes: 2_000,
+})
+
+/** Changes a window applies before it must resynchronize instead of deferring publication further. */
+export const HISTORY_VIEW_MAX_CHANGES = 256
+
+/** Bytes of changed entries a window applies before it must resynchronize. */
+export const HISTORY_VIEW_MAX_BYTES = 1024 * 1024
+
+const FAILURE_CODES: ReadonlySet<string> = new Set<HistorySourceFailureCode>([
+  'PROVIDER_CONFLICT', 'STALE_VERSION', 'INVALID_WINDOW',
+  'CAPACITY_EXCEEDED', 'TARGET_UNAVAILABLE', 'DISPOSED',
+])
+
+/** Read one structured failure code off a provider error without depending on its class identity. */
+function failureCodeOf(error: unknown): HistorySourceFailureCode {
+  const code = typeof error === 'object' && error !== null && 'code' in error ? error.code : undefined
+  if (typeof code === 'string' && FAILURE_CODES.has(code)) return code as HistorySourceFailureCode
+  return 'TARGET_UNAVAILABLE'
+}
+
+/** @returns whether an error is a caller cancellation. */
+function isAbort(error: unknown): boolean {
+  return typeof error === 'object' && error !== null && 'name' in error && error.name === 'AbortError'
+}
+
+/** @returns the UTF-8 byte length of one delta's durable payload. */
+function deltaBytes(changes: readonly SessionEventChange[]): number {
+  return new TextEncoder().encode(JSON.stringify(changes)).byteLength
+}
+
+/** @returns whether two window reads request the same page. */
+function sameRead(left: HistoryReadV1, right: HistoryReadV1): boolean {
+  if (left.kind !== right.kind) return false
+  switch (left.kind) {
+    case 'latest': return true
+    case 'before': return right.kind === 'before' && right.cursor === left.cursor
+    case 'after': return right.kind === 'after' && right.cursor === left.cursor
+    case 'around': return right.kind === 'around' && right.target.key === left.target.key
+      && right.target.seq === left.target.seq
+  }
