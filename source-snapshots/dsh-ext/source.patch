+// @vitest-environment jsdom
+/** ADR 0004: programmatic live-edge landings may re-enter tail following (opt-in). */
+import { afterEach, expect, it, vi } from 'vitest'
+import { createElement, useLayoutEffect } from 'react'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { ChatViewport } from '../src/client/chat/use-chat-viewport.ts'
+import { ChatReading, setFollowOnProgrammaticEdge, useChatReading } from '../src/client/chat/use-chat-reading.ts'
+import { ScrollFollow } from '../src/client/chat/use-scroll-follow.ts'
+import type { ChatScrollPosition } from '../src/client/contract/slots.ts'
+
+afterEach(() => {
+  cleanup()
+  setFollowOnProgrammaticEdge(false)
+  Reflect.deleteProperty(globalThis, '__dshFollowProgrammaticEdge')
+  delete document.documentElement.dataset.dshFollowEdge
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+})
+
+function reading(following: boolean): ChatReading {
+  const viewport = new ChatViewport()
+  return new ChatReading(viewport, { read: () => null, save: vi.fn() }, {
+    initialized: true, followingTail: following, activeTurn: 1,
+  }, vi.fn(), new ScrollFollow(following, 0))
+}
+
+it('stock behavior ignores a non-reader landing on the live edge', () => {
+  const target = reading(false)
+  const follow = vi.spyOn(target, 'followTail')
+  target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+  expect(follow).not.toHaveBeenCalled()
+})
+
+it('the opt-in re-enters following when a programmatic landing reaches the edge', () => {
+  setFollowOnProgrammaticEdge(true)
+  const target = reading(false)
+  const follow = vi.spyOn(target, 'followTail')
+  target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+  expect(follow).toHaveBeenCalled()
+})
+
+it('a global composition flag enables the opt-in without a setter call', () => {
+  Reflect.set(globalThis, '__dshFollowProgrammaticEdge', true)
+  try {
+    const target = reading(false)
+    const follow = vi.spyOn(target, 'followTail')
+    target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+    expect(follow).toHaveBeenCalled()
+  } finally { Reflect.deleteProperty(globalThis, '__dshFollowProgrammaticEdge') }
+})
+
+it('a document-root composition marker enables the opt-in without a setter call', () => {
+  document.documentElement.dataset.dshFollowEdge = '1'
+  const target = reading(false)
+  const follow = vi.spyOn(target, 'followTail')
+  target.onScroll({ metrics: { top: 1_600, floor: 1_600, height: 400 }, movedByReader: false })
+  expect(follow).toHaveBeenCalled()
+})
+
+it('a reader away from the edge stays unfollowed even with the opt-in', () => {
+  setFollowOnProgrammaticEdge(true)
+  const target = reading(false)
+  target.onScroll({ metrics: { top: 900, floor: 1_600, height: 400 }, movedByReader: true })
+  expect(target.followingTail).toBe(false)
+})
+
+/** Production hook, viewport and follow owner; only browser layout/RO delivery is supplied by the fixture. */
+function anchoredReader() {
+  const scroller = document.createElement('div')
+  const row = document.createElement('div')
+  row.dataset.chatAnchorKey = 'known-message'
+  row.dataset.chatNodeKey = 'known-message'
+  row.dataset.chatFlowKey = 'known-message'
+  row.dataset.chatTurn = '1'
+  row.textContent = 'known earlier message'
+  scroller.append(row)
+  document.body.append(scroller)
+  let width = 134, height = 769, content = 42_525, rawTop = 0, rowTop = 5_728
+  const floor = () => content - height
+  Object.defineProperties(scroller, {
+    clientHeight: { get: () => height },
+    scrollHeight: { get: () => content },
+    scrollTop: { get: () => Math.max(0, Math.min(floor(), rawTop)), set: (value: number) => { rawTop = Math.max(0, Math.min(floor(), value)) } },
+  })
+  scroller.getBoundingClientRect = () => new DOMRect(0, 0, width, height)
+  row.getBoundingClientRect = () => new DOMRect(0, rowTop - scroller.scrollTop, width, 80)
+  const callbacks = new Set<ResizeObserverCallback>()
+  vi.stubGlobal('ResizeObserver', class implements ResizeObserver {
+    constructor(callback: ResizeObserverCallback) { callbacks.add(callback) }
+    observe() {}
+    unobserve() {}
+    disconnect() { callbacks.clear() }
+  })
+  const viewport = new ChatViewport()
+  viewport.attach(scroller, scroller)
+  viewport.updateTurns([{ turn: 1, anchorKey: 'known-message', prompt: '', response: '' }])
+  let position: ChatScrollPosition | null = null
+  const store = { read: () => position, save: (value: ChatScrollPosition | null) => { position = value } }
+  let reader!: ChatReading
+  function MountedReader() {
+    const { reading, state } = useChatReading(viewport, store, 1)
+    reader = reading
+    useLayoutEffect(() => {
+      const disconnect = viewport.connect({ scroll: reading.onScroll, scrollEnd: reading.onScrollEnd,
+        resize: () => reading.onResize(), interact: () => {}, intent: () => reading.interruptFollow() })
+      reading.restore()
+      return () => { disconnect(); viewport.detach(); scroller.remove() }
+    }, [reading])
+    return createElement('button', { onClick: () => reading.followTail(), 'data-following': String(state.followingTail) }, 'Latest')
+  }
+  const mounted = render(createElement(MountedReader))
+  const resize = () => { for (const callback of callbacks) callback([], {} as ResizeObserver) }
+  return {
+    scroller, row, reader: () => reader, position: () => position, floor,
+    latest: mounted.getByRole('button', { name: 'Latest' }),
+    reveal: () => {
+      const landing = viewport.scrollToKey('known-message')
+      expect(landing).not.toBeNull()
+      reader.acceptNavigation(landing!)
+    },
+    clampForZoom: () => { width = 1_149; height = 822; content = 3_263; rowTop = 800; row.remove(); fireEvent.scroll(scroller) },
+    commitZoom: () => { scroller.append(row); resize() },
+    grow: () => { content += 500; resize() },
+  }
+}
+
+it.each([false, true])('keeps the revealed semantic anchor when Zoom clamps a former tail reader (opt-in=%s)', (enabled) => {
+  vi.useFakeTimers()
+  setFollowOnProgrammaticEdge(enabled)
+  const h = anchoredReader()
+  expect(h.reader().followingTail).toBe(true)
+  act(h.reveal)
+  expect(h.reader().followingTail).toBe(false)
+  expect(h.position()).toMatchObject({ anchorKey: 'known-message', anchorTop: 24 })
+
+  act(h.clampForZoom)
+  expect(h.scroller.scrollTop).toBe(h.floor())
+  expect(h.reader().followingTail).toBe(false)
+  expect(h.reader().pending).toBe(false)
+  expect(h.position()).toMatchObject({ anchorKey: 'known-message', anchorTop: 24 })
+  act(h.commitZoom)
+  act(() => { vi.advanceTimersByTime(500) })
+  expect(h.row.getBoundingClientRect().top).toBe(24)
+  expect(h.position()).toMatchObject({ anchorKey: 'known-message', anchorTop: 24 })
+  expect(h.reader().followingTail).toBe(false)
+})
+
+it.each(['reader', 'Latest'] as const)('allows %s to resume following after a layout clamp preserves an older anchor', (action) => {
+  setFollowOnProgrammaticEdge(true)
+  const h = anchoredReader()
+  act(h.reveal)
+  act(h.clampForZoom)
+  act(h.commitZoom)
+  act(() => {
+    if (action === 'Latest') fireEvent.click(h.latest)
+    else {
+      fireEvent.wheel(h.scroller)
+      h.scroller.scrollTop = h.floor()
+      fireEvent.scroll(h.scroller)
+      fireEvent(h.scroller, new Event('scrollend'))
+    }
+  })
+  expect(h.reader().followingTail).toBe(true)
+  expect(h.position()).toBeNull()
+  act(h.grow)
+  expect(h.scroller.scrollTop).toBe(h.floor())
+})
+
+it('does not replace pending reader movement with a non-reader layout sample', () => {
+  vi.useFakeTimers()
+  setFollowOnProgrammaticEdge(true)
+  const h = anchoredReader()
+  act(h.reveal)
+  act(() => {
+    h.scroller.scrollTop = 5_800
+    fireEvent.scroll(h.scroller)
+  })
+  expect(h.reader().pending).toBe(true)
+  act(() => { h.reader().onScroll({ metrics: { top: 5_800, floor: 41_756, height: 769 }, movedByReader: false }) })
+  expect(h.reader().pending).toBe(true)
+  act(() => { fireEvent(h.scroller, new Event('scrollend')) })
+  expect(h.reader().pending).toBe(false)
+  expect(h.position()).toMatchObject({ anchorKey: 'known-message', scrollTop: 5_800 })
+})
