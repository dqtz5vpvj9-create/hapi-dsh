+/**
+ * Window-commit coordinator: candidate preparation and the synchronous
+ * measure/publish/correct section for one reading window.
+ *
+ * One instance is created per reading window by
+ * {@link createWindowCommitFactory}. Tokens live in this instance's table, so a
+ * caller cannot fabricate a valid transaction and a copied token fails the
+ * identity check: the table stores the exact prepared object it handed out.
+ */
+import {
+  DEFAULT_WINDOW_COMMIT_BUDGET,
+  WindowCommitError,
+  type WindowCandidateV1,
+  type WindowCommitBudget,
+  type WindowCommitCoordinatorV1,
+  type WindowCommitFactoryV1,
+  type WindowCommitHostV1,
+  type WindowCommitResultV1,
+  type WindowCommitStop,
+  type HistorySnapshotV1,
+  type PreparedWindowV1,
+  type WindowLayoutV1,
+  type WindowReaderMeasurementV1,
+  type WindowReaderParticipantV1,
+} from '../contract/window-commit.ts'
+
+/** One consumed token's outcome, kept so a replay fails as stale rather than foreign. */
+interface PreparedRecord<Candidate> {
+  readonly prepared: PreparedWindowV1
+  readonly candidate: Candidate
+
+  readonly snapshot: HistorySnapshotV1
+  readonly nodeKeys?: readonly string[]
+}
+
+/** @returns whether a value is a non-null object. */
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null
+}
+
+/** @returns whether a provider snapshot entry list is an array. */
+function isEntryList(value: readonly unknown[]): boolean {
+  return Array.isArray(value)
+}
+
+/** @returns a reader measurement asserting that no live reader is attached. */
+function unavailableMeasurement(revision: number): WindowReaderMeasurementV1 {
+  return Object.freeze({
+    revision,
+    anchor: null,
+    following: false,
+    scrollTop: 0,
+    clientHeight: 0,
+    scrollHeight: 0,
+    nodes: 0,
+    available: false,
+  })
+}
+
+/** @returns a typed failure preserving an already structured code. */
+function failureOf(error: unknown, fallback: 'TARGET_UNAVAILABLE' | 'INVALID_WINDOW', message: string): WindowCommitError {
+  if (error instanceof WindowCommitError) return error
+  return new WindowCommitError(fallback, message)
+}
+
+/** @returns one error message without assuming an Error instance. */
+function messageOf(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
+
+/** @returns a stable Error for one thrown value. */
+function toError(error: unknown): Error {
+  return error instanceof Error ? error : new Error(String(error))
+}
+
+/** One reading window's transactional publisher. */
+class WindowCommitCoordinator<Candidate> implements WindowCommitCoordinatorV1 {
+  readonly version = 1
+  readonly windowId: string
+  private readonly budget: WindowCommitBudget
+  private readonly participants = new Map<string, WindowReaderParticipantV1>()
+  /** Prepared token table; the stored object identity is the provenance check. */
+  private readonly pending = new Map<symbol, PreparedRecord<Candidate>>()
+  /** Spent tokens, so a replay reports STALE_VERSION instead of INVALID_WINDOW. */
+  private readonly spent = new Set<symbol>()
+  private revisionValue: number
+  private criticalSection = false
+  private disposed = false
+
+  /** @param host - candidate builder, official layout commit, and window identity. */
+  constructor(private readonly host: WindowCommitHostV1<Candidate>) {
+    this.windowId = host.windowId
+    this.revisionValue = host.revision
+    this.budget = DEFAULT_WINDOW_COMMIT_BUDGET
+  }
+
+  /** @returns whether the synchronous measure/publish/correct section is open. */
+  get inCommitCriticalSection(): boolean {
+    return this.criticalSection
+  }
+
+  /** @inheritdoc */
+  register(participant: WindowReaderParticipantV1): WindowCommitStop {
+    this.assertLive()
+    this.participants.set(participant.id, participant)
+    return () => {
+      if (this.participants.get(participant.id) === participant) this.participants.delete(participant.id)
+    }
+  }
+
+  /** @inheritdoc */
+  async prepare(snapshot: HistorySnapshotV1, signal: AbortSignal): Promise<PreparedWindowV1> {
+    this.assertLive()
+    signal.throwIfAborted()
+    this.assertSnapshot(snapshot)
+    const resident = this.retainedEntries()
+    this.assertCapacity({ ...snapshot, entries: snapshot.entries.filter(entry => resident.get(entry.event.seq) !== entry) })
+    signal.throwIfAborted()
+    let built: WindowCandidateV1<Candidate>
+    try {
+      built = this.host.buildCandidate(snapshot)
+    } catch (error) {
+      // An assembler rejection keeps the old window and reports the source as
+      // unavailable rather than publishing a half-built candidate.
+      throw failureOf(error, 'TARGET_UNAVAILABLE', `window "${this.windowId}" candidate build failed: ${messageOf(error)}`)
+    }
+    try {
+      signal.throwIfAborted()
+    } catch (error) {
+      this.releaseCandidate(built.candidate)
+      throw error
+    }
+    if (built.nodeKeys !== undefined && (built.nodeKeys.length !== built.nodes || new Set(built.nodeKeys).size !== built.nodes)) {
+      this.releaseCandidate(built.candidate)
+      throw new WindowCommitError('INVALID_WINDOW', 'Candidate derived Context identities do not match its node count.')
+    }
+    const capacityNodes = this.host.capacityScope?.() === 'growth' && built.nodeKeys !== undefined
+      ? built.nodeKeys.filter(key => !this.retainedNodeKeys.has(key)).length : built.nodes
+    if (capacityNodes > this.budget.nodes) {
+      try {
+        this.host.discard(built.candidate)
+      } catch (error) {
+        console.error(`[session-controller] window "${this.windowId}" candidate discard failed:`, error)
+      }
+      throw new WindowCommitError(
+        'CAPACITY_EXCEEDED',
+        `window "${this.windowId}" candidate builds ${built.nodes} derived nodes, above ${this.budget.nodes}`,
+      )
+    }
+    const token = Symbol(`window-commit:${this.windowId}`)
+    const prepared: PreparedWindowV1 = Object.freeze({
+      baseRevision: this.revisionValue,
+      nextRevision: this.revisionValue + 1,
+      token,
+    })
+    this.pending.set(token, { snapshot, ...built.nodeKeys === undefined ? {} : { nodeKeys: built.nodeKeys }, prepared, candidate: built.candidate })
+    return prepared
+  }
+
+  /** @inheritdoc */
+  async commitWindow(
+    prepared: PreparedWindowV1,
+    signal: AbortSignal,
+  ): Promise<WindowCommitResultV1> {
+    const record = this.take(prepared)
+    let published = false
+    try {
+      // Cancellation before the checkpoint leaves the published window untouched.
+      signal.throwIfAborted()
+      if (this.revisionValue !== record.prepared.baseRevision) {
+        throw new WindowCommitError(
+          'STALE_VERSION',
+          `window "${this.windowId}" advanced from revision ${String(record.prepared.baseRevision)} to ${String(this.revisionValue)} before commit`,
+        )
+      }
+      signal.throwIfAborted()
+      const revision = record.prepared.nextRevision
+      // First correction rejection, reported after the publish. It is never
+      // folded into `committed`; the caller sees the commit and the failed
+      // correction as separate facts.
+      let correctionError: Error | undefined
+      this.criticalSection = true
+      try {
+        const measurements = new Map<string, WindowReaderMeasurementV1>()
+        let official: WindowReaderMeasurementV1 | undefined
+        for (const participant of this.participants.values()) {
+          // Measurement failure happens before the publish, so it still rejects
+          // the commit and keeps the old window; see measureParticipant.
+          const measurement = this.measureParticipant(participant)
+          measurements.set(participant.id, measurement)
+          official ??= measurement
+        }
+        const layout: WindowLayoutV1 = Object.freeze({
+          windowId: this.windowId,
+          baseRevision: record.prepared.baseRevision,
+          revision,
+          measurement: official ?? unavailableMeasurement(record.prepared.baseRevision),
+        })
+        try {
+          this.host.validate?.(record.candidate, [...measurements.values()])
+          this.host.publish(record.candidate, layout)
+        } catch (error) {
+          throw failureOf(error, 'TARGET_UNAVAILABLE', `window "${this.windowId}" layout commit failed: ${messageOf(error)}`)
+        }
+        this.revisionValue = revision
+        this.retainedSnapshot = record.snapshot
+        this.retainedNodeKeys = new Set(record.nodeKeys)
+        published = true
+        // Correction runs in the same synchronous section as the publish: a
+        // measured reader re-applies its own anchor before the browser paints.
+        for (const [id, measurement] of measurements) {
+          const participant = this.participants.get(id)
+          if (participant === undefined) continue
+          try {
+            participant.correct(measurement, layout)
+          } catch (error) {
+            console.error(`[session-controller] window "${this.windowId}" reader "${id}" correction failed:`, error)
+            correctionError ??= toError(error)
+          }
+        }
+      } finally {
+        this.criticalSection = false
+      }
+      return Object.freeze(correctionError === undefined
+        ? { revision, committed: true as const, correction: 'applied' as const }
+        : {
+          revision,
+          committed: true as const,
+          correction: 'failed' as const,
+          correctionError,
+        })
+    } catch (error) {
+      if (!published) this.releaseCandidate(record.candidate)
+      throw error
+    }
+  }
+
+  /** @inheritdoc */
+  discard(prepared: PreparedWindowV1): void {
+    if (this.disposed) return
+    const record = this.pending.get(prepared.token)
+    if (record === undefined || record.prepared !== prepared) return
+    this.pending.delete(prepared.token)
+    this.spent.add(prepared.token)
+    this.releaseCandidate(record.candidate)
+  }
+
+  /** Discard every pending candidate and reject later transactions. */
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    for (const record of this.pending.values()) this.releaseCandidate(record.candidate)
+    this.pending.clear()
+    this.participants.clear()
+  }
+
+  /** Consume one prepared token; provenance, single use, and identity are checked together. */
+  private take(prepared: PreparedWindowV1): PreparedRecord<Candidate> {
+    this.assertLive()
+    const record = this.pending.get(prepared.token)
+    if (record !== undefined) {
+      if (record.prepared !== prepared) {
+        throw new WindowCommitError(
+          'INVALID_WINDOW',
+          `window "${this.windowId}" received a copy of a prepared token, not the prepared transaction`,
+        )
+      }
+      this.pending.delete(prepared.token)
+      this.spent.add(prepared.token)
+      return record
+    }
+    if (this.spent.has(prepared.token)) {
+      throw new WindowCommitError(
+        'STALE_VERSION',
+        `window "${this.windowId}" prepared token was already consumed or discarded`,
+      )
+    }
+    throw new WindowCommitError(
+      'INVALID_WINDOW',
+      `window "${this.windowId}" prepared token was not created by this coordinator`,
+    )
+  }
+
+  /** @throws DISPOSED after this coordinator released its window. */
+  private assertLive(): void {
+    if (this.disposed) throw new WindowCommitError('DISPOSED', `window "${this.windowId}" commit coordinator is disposed`)
+  }
+
+  /** Validate the provider snapshot before any derived state is built. */
+  private assertSnapshot(snapshot: HistorySnapshotV1): void {
+    if (typeof snapshot.version !== 'string' || snapshot.version.length === 0) {
+      throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot has no source version`)
+    }
+    if (!isEntryList(snapshot.entries)) {
+      throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot has no entry list`)
+    }
+    if (snapshot.before !== null && typeof snapshot.before !== 'string') {
+      throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot has an invalid before cursor`)
+    }
+    if (snapshot.after !== null && typeof snapshot.after !== 'string') {
+      throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot has an invalid after cursor`)
+    }
+    if (typeof snapshot.hasBefore !== 'boolean' || typeof snapshot.hasAfter !== 'boolean') {
+      throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot has invalid range flags`)
+    }
+    let previous = Number.NEGATIVE_INFINITY
+    for (const entry of snapshot.entries) {
+      if (!isRecord(entry) || !isRecord(entry.event)) {
+        throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot contains a malformed entry`)
+      }
+      const seq = entry.event.seq
+      if (typeof seq !== 'number' || !Number.isFinite(seq)) {
+        throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot entry has no source sequence`)
+      }
+      if (seq < previous) {
+        throw new WindowCommitError(
+          'INVALID_WINDOW',
+          `window "${this.windowId}" snapshot entries are not in ascending source order`,
+        )
+      }
+      previous = seq
+    }
+  }
+
+  /** Enforce the event and byte envelope of the candidate source entries. */
+  private assertCapacity(snapshot: HistorySnapshotV1): void {
+    if (snapshot.entries.length > this.budget.events) {
+      throw new WindowCommitError(
+        'CAPACITY_EXCEEDED',
+        `window "${this.windowId}" snapshot carries ${String(snapshot.entries.length)} events, above ${String(this.budget.events)}`,
+      )
+    }
+    if (snapshot.entries.length === 0) return
+    let bytes: number
+    try {
+      bytes = new TextEncoder().encode(JSON.stringify(snapshot.entries)).byteLength
+    } catch (error) {
+      throw new WindowCommitError('INVALID_WINDOW', `window "${this.windowId}" snapshot cannot be sized: ${messageOf(error)}`)
+    }
+    if (bytes > this.budget.bytes) {
+      throw new WindowCommitError(
+        'CAPACITY_EXCEEDED',
+        `window "${this.windowId}" snapshot carries ${String(bytes)} bytes, above ${String(this.budget.bytes)}`,
+      )
+    }
+  }
+
+  /**
+   * Read one participant's position before the publish.
+   * @param participant - registered official reader.
+   * @returns its measurement at commit time.
+   * @throws WindowCommitError TARGET_UNAVAILABLE when the reader cannot measure;
+   * the commit then publishes nothing and the old window stays current.
+   */
+  private measureParticipant(participant: WindowReaderParticipantV1): WindowReaderMeasurementV1 {
+    try {
+      return participant.measure()
+    } catch (error) {
+      console.error(`[session-controller] window "${this.windowId}" reader "${participant.id}" measurement failed:`, error)
+      throw failureOf(
+        error,
+        'TARGET_UNAVAILABLE',
+        `window "${this.windowId}" reader "${participant.id}" measurement failed: ${messageOf(error)}`,
+      )
+    }
+  }
+
+  /** Release one candidate through the owner without letting cleanup mask the transaction result. */
+  private releaseCandidate(candidate: Candidate): void {
+    try {
+      this.host.discard(candidate)
+    } catch (error) {
+      console.error(`[session-controller] window "${this.windowId}" candidate discard failed:`, error)
+    }
+  }
+
+  private retainedSnapshot: HistorySnapshotV1 | undefined
+  private retainedNodeKeys = new Set<string>()
+  /** Only accepted entries with the same source identity can reuse admission. */
+  private retainedEntries(): Map<number, HistorySnapshotV1['entries'][number]> {
+    const previous = this.retainedSnapshot
+    if (this.host.capacityScope?.() !== 'growth' || previous === undefined) return new Map()
+    return new Map(previous.entries.map(entry => [entry.event.seq, entry]))
+  }
+}
+
+/** Official window-commit coordinator factory carried by the sessions service. */
+export function createWindowCommitFactory(): WindowCommitFactoryV1 {
+  return Object.freeze({
+    completeWindowHistory: 1 as const,
+    ...Reflect.get(globalThis, '__DSH_CLIENT_READING_OCCURRENCES') === 'off' ? {} : { readingOccurrences: 1 as const },
+    version: 1 as const,
+    create: <Candidate>(host: WindowCommitHostV1<Candidate>): WindowCommitCoordinatorV1 =>
+      new WindowCommitCoordinator(host),
+  })
+}
