index 00000000..b7864205
--- /dev/null
+++ b/packages/client/ui-theme/src/client/focus-modality.ts
@@ -0,0 +1,29 @@
+/** Keep pointer ring paint local to the control that actually owns focus. */
+export function installFocusModality(document: Document, view: NonNullable<Document['defaultView']>): () => void {
+  const root = document.documentElement
+  let marked: Element | null = null
+  const clear = (): void => {
+    marked?.removeAttribute('data-dsh-pointer-focus')
+    marked = null
+  }
+  const update = (): void => {
+    // ui-primitives owns the public modality and its keyboard/IME policy.
+    const active = root.getAttribute('data-input-modality') === 'pointer' ? document.activeElement : null
+    const next = active === document.body || active === root ? null : active
+    if (next === marked) return
+    clear()
+    marked = next
+    marked?.setAttribute('data-dsh-pointer-focus', '')
+  }
+  const observer = new view.MutationObserver(update)
+  observer.observe(root, { attributes: true, attributeFilter: ['data-input-modality'] })
+  document.addEventListener('focusin', update, true)
+  document.addEventListener('focusout', clear, true)
+  update()
+  return () => {
+    observer.disconnect()
+    document.removeEventListener('focusin', update, true)
+    document.removeEventListener('focusout', clear, true)
+    clear()
+  }
+}
