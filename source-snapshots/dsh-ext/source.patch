@@ -0,0 +1,393 @@
+/**
+ * 0003-window-commit Session-side contracts: prepared candidates publish only
+ * through one synchronous measure/publish/correct section, tokens are
+ * coordinator-created and single-use, and cancellation keeps or completes the
+ * window at the documented checkpoint.
+ */
+import { describe, expect, it, vi } from 'vitest'
+import { SessionSeq } from '@deepseek-ai/dsh-session/types'
+import {
+  createWindowCommitFactory,
+  DEFAULT_WINDOW_COMMIT_BUDGET,
+  WindowCommitError,
+  windowCommitCapabilities,
+  type HistorySnapshotV1,
+  type PreparedWindowV1,
+  type SessionEventLikeEntry,
+  type WindowCandidateV1,
+  type WindowCommitCoordinatorV1,
+  type WindowCommitHostV1,
+  type WindowLayoutV1,
+  type WindowReaderMeasurementV1,
+} from '../src/client/index.ts'
+
+const WINDOW = 'pane-a'
+
+function entry(seq: number): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: { type: 'turn/start', seq: SessionSeq(seq), time: seq, data: { turn: seq } },
+  }
+}
+
+function snapshot(version: string, entries: readonly SessionEventLikeEntry[] = [entry(1)]): HistorySnapshotV1 {
+  return { version, entries, before: null, after: null, hasBefore: false, hasAfter: false }
+}
+
+function measurement(overrides: Partial<WindowReaderMeasurementV1> = {}): WindowReaderMeasurementV1 {
+  return {
+    revision: 1,
+    anchor: null,
+    following: false,
+    scrollTop: 0,
+    clientHeight: 600,
+    scrollHeight: 1_200,
+    nodes: 2,
+    available: true,
+    ...overrides,
+  }
+}
+
+interface Candidate {
+  readonly version: string
+}
+
+interface HarnessOptions {
+  readonly revision?: number
+  readonly nodes?: (snapshot: HistorySnapshotV1) => number
+  readonly buildError?: unknown
+  readonly publishError?: unknown
+  readonly onPublish?: (candidate: Candidate, layout: WindowLayoutV1) => void
+}
+
+interface Harness {
+  readonly coordinator: WindowCommitCoordinatorV1
+  readonly order: string[]
+  readonly discarded: string[]
+  readonly state: { revision: number; version: string; publishes: number }
+}
+
+/** One window owner whose published state and candidate lifecycle the test can observe. */
+function harness(options: HarnessOptions = {}): Harness {
+  const order: string[] = []
+  const discarded: string[] = []
+  const state = { revision: options.revision ?? 0, version: 'old', publishes: 0 }
+  let coordinator: WindowCommitCoordinatorV1 | undefined
+  const host: WindowCommitHostV1<Candidate> = {
+    windowId: WINDOW,
+    revision: state.revision,
+    buildCandidate: (built): WindowCandidateV1<Candidate> => {
+      order.push(`build:${built.version}`)
+      if (options.buildError !== undefined) throw options.buildError
+      return {
+        candidate: { version: built.version },
+        nodes: options.nodes?.(built) ?? built.entries.length,
+      }
+    },
+    publish: (candidate, layout) => {
+      order.push(`publish:${candidate.version}`)
+      if (options.publishError !== undefined) throw options.publishError
+      if (coordinator?.inCommitCriticalSection !== true) throw new Error('publish outside the commit critical section')
+      state.publishes += 1
+      state.version = candidate.version
+      state.revision = layout.revision
+      options.onPublish?.(candidate, layout)
+    },
+    discard: (candidate) => {
+      order.push(`discard:${candidate.version}`)
+      discarded.push(candidate.version)
+    },
+  }
+  coordinator = createWindowCommitFactory().create(host)
+  return { coordinator, order, discarded, state }
+}
+
+/** @returns whether a rejection is the caller's AbortError, not a typed window failure. */
+function isAbort(error: unknown): boolean {
+  return typeof error === 'object' && error !== null && 'name' in error && error.name === 'AbortError'
+}
+
+describe('0003-window-commit Session contracts', () => {
+  it('capability-declaration', () => {
+    expect(windowCommitCapabilities).toEqual({ windowCommit: 1 })
+    expect(Object.isFrozen(windowCommitCapabilities)).toBe(true)
+    expect(createWindowCommitFactory().version).toBe(1)
+    expect(DEFAULT_WINDOW_COMMIT_BUDGET).toEqual({
+      events: 5_000, bytes: 12 * 1024 * 1024, nodes: 2_000,
+    })
+  })
+
+  it('measure-before-publish', async () => {
+    const events: string[] = []
+    const h = harness({
+      onPublish: (_candidate, layout) => {
+        events.push(`publish:${layout.measurement.scrollTop}`)
+      },
+    })
+    let measured = 0
+    const participant = {
+      id: 'reader',
+      measure: () => {
+        measured += 1
+        // The commit measures the live position, so movement between prepare and
+        // commit wins over whatever the reader held when the page was read.
+        return measurement({ revision: measured, scrollTop: 250, nodes: 7 })
+      },
+      correct: vi.fn<(measured: WindowReaderMeasurementV1, layout: WindowLayoutV1) => void>(() => {
+        events.push('correct')
+      }),
+    }
+    h.coordinator.register(participant)
+    const prepared = await h.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    expect(measured).toBe(0)
+    events.push('prepared')
+
+    const result = await h.coordinator.commitWindow(prepared, new AbortController().signal)
+    expect(result).toEqual({ revision: 1, committed: true, correction: 'applied' })
+    if (result.correction === 'failed') throw new Error('expected an applied correction')
+    expect(measured).toBe(1)
+    expect(events).toEqual(['prepared', 'publish:250', 'correct'])
+    expect(participant.correct).toHaveBeenCalledTimes(1)
+    const correction = participant.correct.mock.calls[0]
+    if (correction === undefined) throw new Error('expected one correction call')
+    expect(correction[0].scrollTop).toBe(250)
+    expect(correction[1]).toMatchObject({
+      windowId: WINDOW, baseRevision: 0, revision: 1,
+    })
+  })
+
+  it('no-intermediate-paint', async () => {
+    const h = harness()
+    const prepared = await h.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    // The candidate is built during prepare, but the published window does not
+    // move until the layout commit: no observer sees the prepared window early.
+    expect(h.order).toEqual(['build:v1'])
+    expect(h.state.version).toBe('old')
+    expect(h.state.publishes).toBe(0)
+    expect(h.coordinator.inCommitCriticalSection).toBe(false)
+
+    await h.coordinator.commitWindow(prepared, new AbortController().signal)
+    expect(h.order).toEqual(['build:v1', 'publish:v1'])
+    expect(h.state.version).toBe('v1')
+    expect(h.state.publishes).toBe(1)
+    expect(h.coordinator.inCommitCriticalSection).toBe(false)
+  })
+
+  it('cancel-before-commit', async () => {
+    const h = harness()
+    const abort = new AbortController()
+    const prepared = await h.coordinator.prepare(snapshot('v1'), abort.signal)
+    abort.abort()
+
+    await expect(h.coordinator.commitWindow(prepared, abort.signal)).rejects.toSatisfy(isAbort)
+    expect(h.state.version).toBe('old')
+    expect(h.state.publishes).toBe(0)
+    expect(h.discarded).toEqual(['v1'])
+    // The token was consumed by the cancelled attempt; a replay is stale, and a
+    // fresh prepare publishes normally.
+    await expect(h.coordinator.commitWindow(prepared, new AbortController().signal))
+      .rejects.toMatchObject({ code: 'STALE_VERSION' })
+    const again = await h.coordinator.prepare(snapshot('v2'), new AbortController().signal)
+    await h.coordinator.commitWindow(again, new AbortController().signal)
+    expect(h.state.version).toBe('v2')
+    expect(h.state.publishes).toBe(1)
+  })
+
+  it('cancel-before-prepare', async () => {
+    const h = harness()
+    const abort = new AbortController()
+    abort.abort()
+    await expect(h.coordinator.prepare(snapshot('v1'), abort.signal)).rejects.toSatisfy(isAbort)
+    expect(h.order).toEqual([])
+    expect(h.state.version).toBe('old')
+  })
+
+  it('cancel-after-commit', async () => {
+    const h = harness()
+    const abort = new AbortController()
+    const participant = {
+      id: 'reader',
+      // Cancellation arriving after the linearization checkpoint cannot roll a
+      // publish back; the reader's own measurement observes it first.
+      measure: () => {
+        abort.abort()
+        return measurement({ scrollTop: 12 })
+      },
+      correct: vi.fn(),
+    }
+    h.coordinator.register(participant)
+    const prepared = await h.coordinator.prepare(snapshot('v1'), abort.signal)
+    const result = await h.coordinator.commitWindow(prepared, abort.signal)
+
+    expect(result).toEqual({ revision: 1, committed: true, correction: 'applied' })
+    expect(abort.signal.aborted).toBe(true)
+    expect(h.state.version).toBe('v1')
+    expect(h.state.publishes).toBe(1)
+    expect(participant.correct).toHaveBeenCalledTimes(1)
+  })
+
+  it('correction-failure-is-not-success', async () => {
+    const h = harness()
+    const failure = new Error('anchor write rejected')
+    h.coordinator.register({
+      id: 'reader',
+      measure: () => measurement({ anchor: { key: 'turn-9', top: 4 }, following: false }),
+      correct: vi.fn(() => { throw failure }),
+    })
+    const signal = new AbortController().signal
+    const prepared = await h.coordinator.prepare(snapshot('v1'), signal)
+    const result = await h.coordinator.commitWindow(prepared, signal)
+
+    // The publish happened: the old window is gone and cannot be rolled back.
+    expect(h.state.version).toBe('v1')
+    expect(h.state.publishes).toBe(1)
+    expect(result.committed).toBe(true)
+    expect(result.revision).toBe(1)
+    // The failed correction is a separate, visible fact; it is never reported as
+    // a clean success. The caller can decide to retry the correction.
+    expect(result.correction).toBe('failed')
+    if (result.correction !== 'failed') throw new Error('expected a failed correction')
+    expect(result.correctionError).toBe(failure)
+    // The coordinator's revision advanced with the publish, so a later prepare
+    // builds on the linearized window.
+    const next = await h.coordinator.prepare(snapshot('v2'), signal)
+    expect(next.baseRevision).toBe(1)
+  })
