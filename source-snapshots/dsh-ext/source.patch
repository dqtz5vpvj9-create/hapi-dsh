+  { type: 'tool/call', seq: 3, time: 1, data: { turn: 1, step: 1, callId: 'call', name: 'bash', arguments: '{}' } },
+  { type: 'tool/result', seq: 4, time: 1, surfaceOp: 'append', data: { turn: 1, step: 1, message: { id: 'result', role: 'tool', source: { kind: 'tool', callId: 'call' }, toolCallId: 'call', isError: false, content: [{ type: 'text', text: 'ok' }] } } },
+  { type: 'step/end', seq: 5, time: 1, data: { turn: 1, step: 1 } },
