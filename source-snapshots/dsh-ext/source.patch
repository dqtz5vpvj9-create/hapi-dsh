+/** Native files and actual worker/index IO; no Session runtime or display projection is substituted. */
+import { afterEach, expect, it } from 'vitest'
+import { mkdtemp, rm, writeFile, appendFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session'
+import { meta, oneTurnLog } from '../../session-persistence/tests/contract.ts'
+import { readIndexedSession } from '../src/read-index.ts'
+import { eventLines, toHeaderLine } from '../src/format.ts'
+import { compressZstdFrame } from '../src/zstd.ts'
+import type { SessionPageResult } from '@deepseek-ai/dsh-session-persistence'
+const roots: string[] = []
+afterEach(async () => { for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true }) })
+const request = { limit: 2, maxEvents: 100, maxBytes: 1024 * 1024 }
+async function fixture(compression: 'none' | 'zstd', events = oneTurnLog()) {
+  const root = await mkdtemp('/mnt/cache/data-cache/dsh-read-index-'); roots.push(root)
+  const header = meta('indexed-session'), path = join(root, compression === 'none' ? 'log.v4.jsonl' : 'log.v4.jsonl.zstd')
+  const first = JSON.stringify(toHeaderLine(header)) + '\n', body = eventLines(events) + '\n'
+  await writeFile(path, compression === 'none' ? first + body : Buffer.concat([await compressZstdFrame(first), await compressZstdFrame(body)]))
+  return { path, id: header.id, compression }
+}
