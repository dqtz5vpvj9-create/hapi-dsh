+
+function sessionSnapshot(overrides: Partial<SessionSnapshot> = {}): SessionSnapshot {
+  return {
+    sessionId: SID,
+    pendingSubmissions: [],
+    running: false,
+    removed: false,
+    openState: 'open',
+    openError: null,
+    hasMore: false,
+    loadingOlder: false,
+    promptError: null,
+    blank: false,
+    subagent: null,
+    lastAgentError: null,
+    promptAttempted: true,
+    awaitingFirstTurn: false,
+    ...overrides,
+  }
+}
+
+function makeSessionSource(init: Partial<SessionSnapshot> = {}) {
+  let snap = sessionSnapshot(init)
+  const subs = new Set<() => void>()
+  return {
+    set: (next: Partial<SessionSnapshot>) => {
+      snap = { ...snap, ...next }
+      for (const fn of [...subs]) fn()
+    },
+    source: {
+      getSnapshot: () => snap,
+      subscribe: (fn: () => void) => {
+        subs.add(fn)
+        return () => subs.delete(fn)
+      },
+    },
+  }
+}
+
+function makeChatSource(nodes: readonly ConversationNode[]) {
+  let snap = chatSnapshotFixture({ nodes })
+  const subs = new Set<() => void>()
+  const replace = (next: readonly ConversationNode[]): void => {
+    snap = chatSnapshotFixture({ nodes: next }, snap)
+    for (const fn of [...subs]) fn()
+  }
+  return {
+    replace,
+    source: {
+      getSnapshot: () => snap,
+      subscribe: (fn: () => void) => {
+        subs.add(fn)
+        return () => subs.delete(fn)
+      },
+    },
+  }
+}
+
+function emptySessions(): SnapshotSelectorHook<SessionListState> {
+  return bindSnapshotSelector(createSnapshotStore<SessionListState>(
+    { ids: [], byId: {}, phase: 'ready', projectionsBySession: {} }))
+}
+
+function emptyWorkspaces(): SnapshotSelectorHook<WorkspaceSnapshot> {
+  return bindSnapshotSelector(createSnapshotStore<WorkspaceSnapshot>({
+    items: [], archivedSessionIds: [], pinnedSessionIds: [], state: 'idle', phase: 'ready', error: null,
+  }))
+}
+
+function bindKeyed<Value>(resolve: (key: string) => ObservableSnapshot<Value>): KeyedSnapshotSelectorHook<Value> {
+  const hooks = new WeakMap<object, SnapshotSelectorHook<Value>>()
+  return ((key: string, selector?: (value: Value) => unknown, equal?: (left: unknown, right: unknown) => boolean) => {
+    const source = resolve(key)
+    let hook = hooks.get(source)
+    if (hook === undefined) {
+      hook = bindSnapshotSelector(source)
+      hooks.set(source, hook)
+    }
+    return hook(selector ?? ((value: Value) => value), equal)
+  }) as KeyedSnapshotSelectorHook<Value>
+}
+
+const user = (seq: number, text: string): UserMessageNode => ({
+  kind: 'user', seq, time: seq * 1000, content: [{ type: 'text', text }] as never, source: null,
+})
+const userInTurn = (seq: number, text: string, turn: number): ConversationNode =>
+  ({ ...user(seq, text), turn } as unknown as ConversationNode)
+const assistant = (seq: number, text: string, turn = 1, step = 1): AssistantMessageNode => ({
+  kind: 'assistant', seq, time: seq * 1_000, turn, step, blocks: [{ kind: 'text', text }],
+})
+
+/** Flow stand-in: rows carry the stable anchor keys the viewport lands on. */
+function ChatFlowStub({ entries }: { entries: readonly RenderEntry[] }) {
+  return (
+    <div>
+      {entries.map(entry => entry.kind === 'node'
+        ? (
+            <div
+              key={entry.key}
+              data-chat-anchor-key={entry.key}
+              data-chat-flow-key={entry.key}
+              style={{ height: '40px' }}
+            >
+              {entry.key}
+            </div>
+          )
+        : null)}
+    </div>
+  )
+}
+
+interface HarnessOptions {
+  readonly nodes: readonly ConversationNode[]
+  readonly session?: Partial<SessionSnapshot>
+  readonly scrollMemory?: ChatScrollPosition | null
+}
+
+function makeHarness(options: HarnessOptions) {
+  const session = makeSessionSource(options.session ?? {})
+  const chatSource = makeChatSource(options.nodes)
+  const chat = createChatStore().create()
+  let savedScroll: ChatScrollPosition | null = options.scrollMemory ?? null
+  const chatScroll: ChatViewSlotProps['chatScroll'] = {
+    save: vi.fn((position: ChatScrollPosition | null) => { savedScroll = position }),
+    read: () => savedScroll,
+  }
+  const loadOlder = vi.fn()
+  const loadThrough = vi.fn<(seq: SessionSeq) => Promise<void>>().mockResolvedValue(undefined)
+  const conversation = createSnapshotStore<ConversationSnapshot>({
+    ...EMPTY_CONVERSATION_SNAPSHOT,
+    views: { ...EMPTY_CONVERSATION_SNAPSHOT.views, grouped: () => undefined },
+  })
+  const absentGroup = createSnapshotStore<unknown>(undefined)
+  const transcriptView = createSnapshotStore<TranscriptViewMode>('compact')
+  const collapseTiming = createSnapshotStore<CollapseTiming>('completion')
+  const props = {
+    renderFactorySlot: (() => null) as PropsRenderFactories['renderFactorySlot'],
+    usePanelInfo: (selector: (value: { readonly activePanelId: string | null }) => unknown) => selector({ activePanelId: null }),
+    sessionId: SID,
+    useSession: bindSnapshotSelector(session.source),
+    useChat: bindSnapshotSelector(chatSource.source),
+    useChatNode: bindKeyed(() => ({ getSnapshot: () => undefined, subscribe: () => () => {} })),
+    useChatNodeBottom: bindKeyed(() => createSnapshotStore<boolean>(false)),
+    useChatNodeProcess: bindKeyed(() => ({ getSnapshot: () => undefined, subscribe: () => () => {} })),
+    useChatGroup: bindKeyed(() => absentGroup as ObservableSnapshot<unknown>),
+    useConversation: bindSnapshotSelector(conversation),
+    useTrajectory: (() => { throw new Error('unused') }) as never,
+    useSessions: emptySessions(),
+    useSessionRetainInfo: () => undefined,
+    useResource,
+    useSessionStatus: bindSnapshotSelector(createSnapshotStore<SessionStatusSnapshot>(new Map())),
+    useWorkspaces: emptyWorkspaces(),
+    ...allowAllAccess,
+    useProjection: () => undefined,
+    useInput: (() => { throw new Error('unused') }) as never,
+    inputActions: {
+      captureInsertion: () => ({ start: 0, end: 0, draftRev: 0 }),
+      insertText: () => false,
+      setDraft: () => {},
+      persistDraft: () => {},
+      addAttachments: () => true,
+      removeAttachment: () => {},
+      pruneAttachments: () => {},
