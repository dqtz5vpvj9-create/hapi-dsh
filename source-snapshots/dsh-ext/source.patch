new file mode 100644
index 00000000..0be4afcc
--- /dev/null
+++ b/packages/api/session-controller/src/client/contract/history-source.ts
@@ -0,0 +1,253 @@
+/**
+ * Optional history-source extension: one provider connection per Session
+ * generation, one releasable reading window per view (Pane).
+ *
+ * A feature plugin registers a provider on the optional `ISessions` property
+ * read by {@link historyExtension}. The provider is selected before the Session
+ * generation is retained; a matching provider replaces the default
+ * `SessionEventStream` history for that generation, and no provider keeps the
+ * original stream untouched. Each reading view opens its own window on the
+ * generation's connection, so two Panes never share one bounded window.
+ *
+ * Snapshots and deltas join on {@link SourceVersion}. A consumer subscribes to
+ * `changes(initial.version)`; it never reads a snapshot first and subscribes
+ * afterwards, because the provider must replay every change committed after
+ * the snapshot version. The default error codes are the shared V1 codes below;
+ * cancellation rejects with an `AbortError`.
+ */
+import type { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { SessionEventChange, SessionEventLikeEntry } from './events.ts'
+import type { ISessions } from './sessions.ts'
+
+/** Releases one subscription or registration. */
+export type Stop = () => void
+
+/** Provider-allocated position inside one history window. */
+export type Cursor = string
+
+/** Provider-allocated identity of one snapshot/delta state. */
+export type SourceVersion = string
+
+/** Durable history target addressed by a stable view key and its event sequence. */
+export interface HistoryTarget {
+  /** Stable key inside the loaded window, or the key whose content must be loaded. */
+  readonly key: string
+  /** Durable Session event sequence that establishes the target's position. */
+  readonly seq: SessionSeq
+}
+
+/** Resource envelope for one window read or open. */
+export interface Budget {
+  /** Maximum retained event entries. */
+  readonly events: number
+  /** Maximum retained source bytes. */
+  readonly bytes: number
+  /** Maximum derived nodes built from the window. */
+  readonly nodes: number
+}
+
+/** Snapshot of one bounded contiguous history window. */
+export interface HistorySnapshotV1 {
+  /** Version this snapshot is current at; deltas start at `base === version`. */
+  readonly version: SourceVersion
+  /** Contiguous durable or transient entries in ascending sequence order. */
+  readonly entries: readonly SessionEventLikeEntry[]
+  /** Cursor immediately before `entries`, or null when the window starts at the beginning. */
+  readonly before: Cursor | null
+  /** Cursor immediately after `entries`, or null when the window ends at the head. */
+  readonly after: Cursor | null
+  /** Whether older history exists outside the window's start. */
+  readonly hasBefore: boolean
+  /** Whether newer history exists outside the window's end. */
+  readonly hasAfter: boolean
+}
+
+/** One bounded window read. */
+export type HistoryReadV1 =
+  | { readonly kind: 'latest' }
+  | { readonly kind: 'before'; readonly cursor: Cursor }
+  | { readonly kind: 'after'; readonly cursor: Cursor }
+  | { readonly kind: 'around'; readonly target: HistoryTarget }
+
+/** Changes committed between two adjacent source versions. */
+export interface HistoryDeltaV1 {
+  /** Version the consumer must already hold. */
+  readonly base: SourceVersion
+  /** Version after applying `changes`. */
+  readonly version: SourceVersion
+  /** Exact window mutations from `base` to `version`. */
+  readonly changes: readonly SessionEventChange[]
+  /** Whether the source head moved while this window stayed detached from it. */
+  readonly headChanged: boolean
+
+
+  /** Required by complete-window feeds, including authoritative cursors and gap state. */
+  readonly snapshot?: HistorySnapshotV1
+
+}
+
+/** One releasable reading window fed by a provider connection. */
+export interface HistoryFeedV1 {
+  /** Opening snapshot; subscribe to `changes(initial.version)` before applying any other read. */
+  readonly initial: HistorySnapshotV1
+  /**
+   * Read one bounded snapshot.
+   * @param request - latest, cursor, or around-target read.
+   * @param budget - resource envelope the provider must respect.
+   * @param signal - caller cancellation; rejects with an AbortError.
+   * @returns the window snapshot current at a version at or after the last applied version.
+   */
+  read(request: HistoryReadV1, budget: Budget, signal: AbortSignal): Promise<HistorySnapshotV1>
+  /**
+   * Follow changes committed after `after`; each delta's `base` is the previous
+   * delta's `version`, starting from `after`. A provider that cannot replay from
+   * `after` fails the iteration instead of skipping changes.
+   * @param after - source version the consumer holds.
+   * @param signal - cancellation that ends the iteration with an AbortError.
+   * @returns ordered deltas.
+   */
+  changes(after: SourceVersion, signal: AbortSignal): AsyncIterable<HistoryDeltaV1>
+  /** Release this window. Releasing a window never releases Session execution. */
+  release(): void
+
+
+  /** Opt-in: every read and delta snapshot describes the complete bounded window. */
+  readonly mode?: 'complete-window'
+  /** Synchronous acknowledgement at the official reader publication boundary. */
+  readonly publication?: {
+    validate(version: SourceVersion): void
+    accept(version: SourceVersion): void
+    discard(version: SourceVersion): void
+  }
+  /** Recover this reading region; explicit latest is a separate navigation. */
+  refresh?(budget: Budget, signal: AbortSignal): Promise<HistorySnapshotV1>
+
+}
+
+/** One Session generation's provider connection; window creation stays per Pane. */
+export interface HistorySourceV1 {
+  /**
+   * Open one releasable reading window for a view.
+   * @param viewId - stable view (Pane) identity; reopening the same id after release starts a new window.
+   * @param budget - resource envelope for the window's opening snapshot.
+   * @param signal - caller cancellation; rejects with an AbortError.
+   * @returns the opening feed, whose initial snapshot is current at opening.
+   */
+  openWindow(viewId: string, budget: Budget, signal: AbortSignal): Promise<HistoryFeedV1>
+  /** Release the connection and every window it still owns. */
+  release(): void
+}
+
+/** One history provider registered by a feature plugin. */
+export interface HistoryProviderV1 {
+  /** Stable provider identity; two registrations share one identifier. */
+  readonly id: string
+  /**
+   * Decide whether this provider owns one Session generation.
+   * @param sessionId - Session considered for the next retain.
+   * @returns whether this provider's history serves the Session.
+   */
+  matches(sessionId: SessionId): boolean
+  /**
+   * Open this Session generation's connection.
+   * @param sessionId - the matched Session.
+   * @param signal - cancellation for the opening attempt; rejects with an AbortError.
+   * @returns the generation connection.
+   */
+  open(sessionId: SessionId, signal: AbortSignal): Promise<HistorySourceV1>
+}
+
+/** Registry of feature-plugin history providers. */
+export interface HistorySourcesV1 {
+  readonly version: 1
+  /**
+   * Register one provider.
+   * @param provider - provider whose matching Sessions use its history.
+   * @returns idempotent unregistration; existing generations keep their connection, no new generation binds it.
+   */
+  register(provider: HistoryProviderV1): Stop
+}
+
+/** Read-only capability declaration; feature plugins probe it instead of private fields. */
+export interface HistorySourceCapabilitiesV1 {
+  /** Present with value 1 when this build carries the history-source extension. */
+  readonly historySource?: 1
+}
+
+/**
+ * Optional per-generation window opener carried by one Session face. Reading
+ * scopes (Panels) open their own window through this handle; sending, queueing,
+ * and approvals keep resolving the original Session.
+ */
+export interface SessionHistoryReadV1 {
+  readonly version: 1
+  /**
+   * Open or reuse the reading window for one view.
+   * @param viewId - stable view (Pane) identity inside this Session generation.
+   * @param budget - resource envelope for the opening snapshot.
+   * @param signal - caller cancellation; rejects with an AbortError.
+   * @returns the window feed; a repeated call for an open id returns the same feed.
+   */
+  openView(
+    viewId: string,
+    budget?: Budget,
+    signal?: AbortSignal,
+  ): Promise<HistoryFeedV1>
+}
+
+/**
+ * Build-time switch. Unset keeps the capability on; `off` removes the optional
+ * property so {@link historyExtension} returns undefined and every Session
+ * generation keeps the original `SessionEventStream`.
+ * @returns whether this build carries the history-source extension.
+ */
+function historySourceEnabled(): boolean {
+  // Runtime override for the composition/acceptance matrix; the build-time
+  // value keeps the default and stays authoritative when no override exists.
+  try {
+    if (Reflect.get(globalThis, '__DSH_CLIENT_HISTORY_SOURCE') === 'off') return false
+  } catch { /* non-global hosts keep the default */ }
+  return process.env.DSH_CLIENT_HISTORY_SOURCE !== 'off'
+}
+
+/** Read-only capability set announced by this package. */
+export const capabilities: Readonly<HistorySourceCapabilitiesV1> = Object.freeze(
+  historySourceEnabled() ? { historySource: 1 as const } : {},
+)
+
+/** Shared structured failure codes; cancellation rejects with an `AbortError` instead. */
+export type HistorySourceFailureCode =
+  | 'PROVIDER_CONFLICT'
+  | 'STALE_VERSION'
+  | 'INVALID_WINDOW'
+  | 'CAPACITY_EXCEEDED'
+  | 'TARGET_UNAVAILABLE'
+  | 'DISPOSED'
+
+/** Typed history-source failure with a stable code. */
+export class HistorySourceError extends Error {
+  /**
+   * @param code - structured failure code.
+   * @param message - human-readable detail for logs.
+   */
+  constructor(readonly code: HistorySourceFailureCode, message: string) {
+    super(message)
+    this.name = 'HistorySourceError'
+  }
+}
+
+/**
+ * Read the optional history-source registry from the sessions service.
+ * @param sessions - Client sessions service.
+ * @returns the registered provider registry, or undefined when this build has no extension.
+ */
+export function historyExtension(sessions: ISessions): HistorySourcesV1 | undefined {
+  return sessions.historySource
+}
+
+/** Default opening envelope for one reading window (events ≤ 5000, body ≤ 12MiB, nodes ≤ B=2000). */
+export const DEFAULT_HISTORY_BUDGET: Budget = Object.freeze({
+  events: 5_000,
+  bytes: 12 * 1024 * 1024,
+  nodes: 2_000,
+})
