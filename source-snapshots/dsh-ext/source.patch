+    const signal = new AbortController().signal
+    await expect(h.coordinator.prepare(snapshot(''), signal)).rejects.toMatchObject({ code: 'INVALID_WINDOW' })
+    await expect(h.coordinator.prepare(snapshot('v1', [entry(2), entry(1)]), signal))
+      .rejects.toMatchObject({ code: 'INVALID_WINDOW' })
+    expect(h.order).toEqual([])
+    expect(h.state.version).toBe('old')
+  })
+
+  it('capacity-enforced', async () => {
+    const h = harness()
+    const signal = new AbortController().signal
+    const oversized = Array.from({ length: DEFAULT_WINDOW_COMMIT_BUDGET.events + 1 }, (_, index) => entry(index + 1))
+    await expect(h.coordinator.prepare(snapshot('v1', oversized), signal))
+      .rejects.toMatchObject({ code: 'CAPACITY_EXCEEDED' })
+    expect(h.order).toEqual([])
+
+    // A candidate whose derived state exceeds the node envelope is discarded,
+    // never published, and the old window stays current.
+    const nodes = harness({ nodes: () => DEFAULT_WINDOW_COMMIT_BUDGET.nodes + 1 })
+    await expect(nodes.coordinator.prepare(snapshot('v1'), signal))
+      .rejects.toMatchObject({ code: 'CAPACITY_EXCEEDED' })
+    expect(nodes.order).toEqual(['build:v1', 'discard:v1'])
+    expect(nodes.state.version).toBe('old')
+  })
+
+  it('candidate-failure-keeps-old-window', async () => {
+    const h = harness({ buildError: new Error('target projection unavailable') })
+    await expect(h.coordinator.prepare(snapshot('v1'), new AbortController().signal))
+      .rejects.toMatchObject({ code: 'TARGET_UNAVAILABLE' })
+    expect(h.state.version).toBe('old')
+    expect(h.state.publishes).toBe(0)
+
+    // Publish failures are reported as unavailable and discard the candidate.
+    const failed = harness({ publishError: new Error('layout commit failed') })
+    const prepared = await failed.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    await expect(failed.coordinator.commitWindow(prepared, new AbortController().signal))
+      .rejects.toMatchObject({ code: 'TARGET_UNAVAILABLE' })
+    expect(failed.state.version).toBe('old')
+    expect(failed.discarded).toEqual(['v1'])
+  })
+
+  it('disposed-coordinator-rejected', async () => {
+    const h = harness()
+    const signal = new AbortController().signal
+    const prepared = await h.coordinator.prepare(snapshot('v1'), signal)
+    h.coordinator.dispose()
+    await expect(h.coordinator.commitWindow(prepared, signal)).rejects.toMatchObject({ code: 'DISPOSED' })
+    await expect(h.coordinator.prepare(snapshot('v2'), signal)).rejects.toMatchObject({ code: 'DISPOSED' })
+    expect(() => h.coordinator.register({ id: 'late', measure: () => measurement(), correct: () => {} }))
+      .toThrowError(WindowCommitError)
+    expect(h.state.version).toBe('old')
+  })
+
+  it('no-network-in-commit-critical-section', async () => {
+    const events: string[] = []
+    let seenByCorrection: string[] = []
+    const h = harness({ onPublish: () => { events.push('publish') } })
+    h.coordinator.register({
+      id: 'reader',
+      measure: () => {
+        events.push('measure')
+        // Stand-in for a request that would settle on a later microtask: it must
+        // stay outside the synchronous measure/publish/correct section.
+        queueMicrotask(() => { events.push('network') })
+        return measurement()
+      },
+      correct: () => {
+        seenByCorrection = [...events]
+        events.push('correct')
+      },
+    })
+    const prepared = await h.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    await h.coordinator.commitWindow(prepared, new AbortController().signal)
+    // Nothing yielded between measure, publish, and correction: a request cannot
+    // start or settle inside the section.
+    expect(seenByCorrection).toEqual(['measure', 'publish'])
+    expect(events).toEqual(['measure', 'publish', 'correct', 'network'])
+  })
+})
