+            <div
+              key={entry.key}
+              data-chat-anchor-key={entry.key}
+              data-chat-flow-key={entry.key}
+              style={{ height: '40px' }}
+            >
+              {entry.key}
+            </div>
+          )
+        : null)}
+    </div>
+  )
+}
+
+interface HarnessOptions {
+  readonly nodes: readonly ConversationNode[]
+  readonly session?: Partial<SessionSnapshot>
+  readonly scrollMemory?: ChatScrollPosition | null
+  readonly virtualFlow?: boolean
+}
+
+function makeHarness(options: HarnessOptions) {
+  const session = makeSessionSource(options.session ?? {})
+  const chatSource = makeChatSource(options.nodes)
+  const chat = createChatStore().create()
+  let savedScroll: ChatScrollPosition | null = options.scrollMemory ?? null
+  const chatScroll: ChatViewSlotProps['chatScroll'] = {
+    save: vi.fn((position: ChatScrollPosition | null) => { savedScroll = position }),
+    read: () => savedScroll,
+  }
+  const loadOlder = vi.fn()
+  const loadThrough = vi.fn<(seq: SessionSeq) => Promise<void>>().mockResolvedValue(undefined)
+  const conversation = createSnapshotStore<ConversationSnapshot>({
+    ...EMPTY_CONVERSATION_SNAPSHOT,
+    views: { ...EMPTY_CONVERSATION_SNAPSHOT.views, grouped: () => undefined },
+  })
+  const absentGroup = createSnapshotStore<unknown>(undefined)
+  const transcriptView = createSnapshotStore<TranscriptViewMode>('compact')
+  const collapseTiming = createSnapshotStore<CollapseTiming>('completion')
+  const foldedReplies = createSnapshotStore<FoldedReplies>('all')
+  const props = {
+    useContextMenu: () => ({ getTriggerProps: () => ({}) }),
+    useInteractionIds: bindSnapshotSelector(createSnapshotStore<readonly string[]>([])),
+    dispatchInteraction: () => null,
+    resolveFilePath: (path: string) => path,
+    renderFactorySlot: (() => null) as PropsRenderFactories['renderFactorySlot'],
+    usePanelInfo: (selector: (value: { readonly activePanelId: string | null }) => unknown) => selector({ activePanelId: null }),
+    sessionId: SID,
+    useSession: bindSnapshotSelector(session.source),
+    useChat: bindSnapshotSelector(chatSource.source),
+    useChatNode: bindKeyed(() => ({ getSnapshot: () => undefined, subscribe: () => () => {} })),
+    useChatNodeBottom: bindKeyed(() => createSnapshotStore<boolean>(false)),
+    useChatNodeProcess: bindKeyed(() => ({ getSnapshot: () => undefined, subscribe: () => () => {} })),
+    useChatGroup: bindKeyed(() => absentGroup as ObservableSnapshot<unknown>),
+    useConversation: bindSnapshotSelector(conversation),
+    useTrajectory: (() => { throw new Error('unused') }) as never,
+    useSessions: emptySessions(),
+    useSessionRetainInfo: () => undefined,
+    useResource,
+    useSessionStatus: bindSnapshotSelector(createSnapshotStore<SessionStatusSnapshot>(new Map())),
+    useWorkspaces: emptyWorkspaces(),
+    ...allowAllAccess,
+    useProjection: () => undefined,
+    useInput: (() => { throw new Error('unused') }) as never,
+    inputActions: {
+      captureInsertion: () => ({ start: 0, end: 0, draftRev: 0 }),
+      insertText: () => false,
+      insertQuote: () => false,
+      setDraft: () => {},
+      persistDraft: () => {},
+      addAttachments: () => true,
+      removeAttachment: () => {},
+      pruneAttachments: () => {},
+      submit: () => {},
+    },
+    useStore: bindSnapshotSelector(chat),
+    actions: chat.actions,
+    usePresentation: bindSnapshotSelector(derivePresentationPolicy(transcriptView, collapseTiming, foldedReplies)),
+    useHistoryPaging: bindSnapshotSelector(createSnapshotStore<HistoryPagingV1 | undefined>(undefined)),
+    renderSlot: ((key: string, owner: object, slotOptions?: { hookContext?: ChatFlowHookContext }) => {
+      if (key !== 'conversation.chat.flow') throw new Error(`Undeclared ChatView child: ${key}`)
+      const flowOwner = owner as ChatFlowOwnerProps
+      if (options.virtualFlow && slotOptions?.hookContext) return <VirtualChatRows
+        virtualization={slotOptions.hookContext.virtualization}
+        rows={flowOwner.entries.flatMap(entry => entry.kind !== 'node' ? [] : [{
+          key: entry.key, anchorKeys: [entry.key], turn: undefined, kind: 'user', groupPart: undefined, gapBefore: 0,
+          render: () => <ChatFlowStub entries={[entry]} />,
+        }])} />
+      return <ChatFlowStub entries={flowOwner.entries} />
+    }) as ChatViewSlotProps['renderSlot'],
+    SessionProvider: (({ children }: { children: React.ReactNode }) => <>{children}</>) as ChatViewSlotProps['SessionProvider'],
+    inspectCall: vi.fn(),
+    viewRequest: null,
+    openView: vi.fn(),
+    completeViewRequest: () => {},
+    openFile: vi.fn(() => Promise.resolve()),
+    openExternalLink: vi.fn(),
+    loadOlder,
+    loadThrough,
+    loadImage: vi.fn(() => Promise.reject(new Error('not used'))),
+    fileDrag: { prepare: vi.fn(async () => { throw new Error('not used') }), reportFailure: vi.fn() },
+    chatScroll,
+    forkAt: vi.fn(),
+    fileMentions: () => undefined,
+    t: makeTranslate(zh, commonZh),
+  }
+  return {
+    props: props as ChatViewSlotProps,
+    session, chatSource, chatScroll, loadOlder, loadThrough,
+    en: makeTranslate(en, commonEn),
+  }
+}
+
+/** Mount one Chat view and capture its delivered control. */
+function mountView(harness: ReturnType<typeof makeHarness>, extra: Pick<ChatViewSlotProps, 'onMountedChat' | 'mountedChatSource'> = {}) {
+  const delivered: (MountedChatV1 | null)[] = []
+  const elements: HTMLElement[] = []
+  const view = render(
+    <ChatView
+      {...harness.props}
+      {...extra}
+      onMountedChat={(control, element) => {
+        delivered.push(control)
+        elements.push(element)
+        extra.onMountedChat?.(control, element)
+      }}
+    />,
+  )
+  const control = delivered.find((entry): entry is MountedChatV1 => entry !== null)
+  if (control === undefined) throw new Error('ChatView delivered no mounted control')
+  return { view, delivered, control, elements }
+}
+
+describe('mounted Chat control', () => {
+  it('waits for real virtual-row batches on first opening, latest and a retained target reveal', async () => {
+    const observers: Array<{ callback: ResizeObserverCallback; pending: Set<Element> }> = []
+    class Observer implements ResizeObserver {
+      readonly pending = new Set<Element>()
+      constructor(readonly callback: ResizeObserverCallback) { observers.push(this) }
+      observe(target: Element): void { this.pending.add(target) }
+      unobserve(target: Element): void { this.pending.delete(target) }
+      disconnect(): void { this.pending.clear() }
+    }
+    vi.stubGlobal('ResizeObserver', Observer)
+    vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockImplementation(function(this: HTMLElement) {
+      return new DOMRect(0, this.hasAttribute('data-chat-virtual-row') ? Number(this.dataset.index) * 96 : 0, 800, 400)
+    })
+    vi.spyOn(HTMLElement.prototype, 'getClientRects').mockImplementation(function(this: HTMLElement) {
+      return [this.getBoundingClientRect()] as unknown as DOMRectList
+    })
+    for (const [key, value] of [['clientHeight', 400], ['clientWidth', 800], ['offsetHeight', 400], ['offsetWidth', 800], ['scrollHeight', 1200]] as const) {
+      vi.spyOn(HTMLElement.prototype, key, 'get').mockReturnValue(value)
+    }
+    const harness = makeHarness({ nodes: [userInTurn(5, 'original question', 2)], virtualFlow: true })
+    const { control, view } = mountView(harness)
+    const deliver = async (): Promise<void> => {
+      for (let pass = 0; pass < 20 && observers.some(observer => observer.pending.size); pass++) {
+        await act(async () => {
+          for (const observer of observers) {
+            const entries = [...observer.pending].map(target => {
+              const height = target.hasAttribute('data-chat-virtual-row') ? 96 : 400
+              const size = [{ inlineSize: 800, blockSize: height }]
+              return { target, borderBoxSize: size, contentBoxSize: size, devicePixelContentBoxSize: size,
+                contentRect: new DOMRectReadOnly(0, 0, 800, height) } as ResizeObserverEntry
+            })
+            observer.pending.clear()
+            if (entries.length) observer.callback(entries, {} as ResizeObserver)
+          }
+        })
+      }
+    }
+    expect(control.read().busy).toBe(true)
+    let latestSettled = false
+    const latest = control.toLatest().then(() => { latestSettled = true })
+    await act(async () => { await Promise.resolve() })
+    // A tail flag cannot settle an unmeasured initial window.
+    expect(latestSettled).toBe(false)
+    await deliver()
+    expect(latestSettled).toBe(true)
+    await latest
+    expect(control.read().busy).toBe(false)
+    const row = view.container.querySelector('[data-chat-virtual-row]')!
+    row.querySelector('[data-chat-anchor-key]')!.textContent = 'changed content at the same real height'
+    await act(async () => { await Promise.resolve() })
+    let revealSettled = false
+    const reveal = control.reveal({ key: 'fixture:user:5', seq: seq(5) }).then(() => { revealSettled = true })
+    await act(async () => { await Promise.resolve() })
+    // A retained DOM key still waits for its changed-content batch.
+    expect(revealSettled).toBe(false)
+    await deliver()
+    expect(revealSettled).toBe(true)
+    await reveal
+    expect(control.read().busy).toBe(false)
+  })
+
+  it('capability-declaration', () => {
+    expect(capabilities).toEqual({ mountedChat: 1, renderedNodes: 1, readingCheckpoint: 1 })
+    expect(Object.isFrozen(capabilities)).toBe(true)
+  })
+
+  it('mounted-owner-singleton', () => {
+    const harness = makeHarness({ nodes: [userInTurn(5, 'current question', 2), assistant(6, 'current answer', 2)] })
+    const first = mountView(harness)
+    expect(first.delivered).toHaveLength(1)
+    expect(first.delivered[0]).toBe(first.control)
+    expect(first.elements[0]).toBe(first.view.container.firstElementChild)
+
+    // A committed re-render keeps the same handle and the same single delivery.
+    act(() => { harness.session.set({ running: true }) })
+    act(() => { harness.chatSource.replace([userInTurn(5, 'current question', 2), assistant(6, 'current answer', 2)]) })
+    expect(first.delivered).toHaveLength(1)
+    expect(first.delivered[0]).toBe(first.control)
+
+    // A second mounted view owns its own handle; delivery is per mounted owner.
+    const second = mountView(harness)
+    expect(second.delivered).toHaveLength(1)
+    expect(second.control).not.toBe(first.control)
+    expect(second.elements[0]).not.toBe(first.elements[0])
+
+    first.view.unmount()
+    expect(first.delivered).toHaveLength(2)
+    expect(first.delivered.at(-1)).toBeNull()
+    expect(first.elements.at(-1)).toBe(first.elements[0])
+    second.view.unmount()
+    expect(second.delivered.at(-1)).toBeNull()
+  })
+
+  it('older-resolves-after-layout', async () => {
+    const current = [userInTurn(5, 'current question', 2), assistant(6, 'current answer', 2)]
+    const older = [userInTurn(1, 'older question', 1), assistant(2, 'older answer', 1)]
+    const harness = makeHarness({ nodes: current, session: { hasMore: true } })
+    const { control, view } = mountView(harness)
+
+    let settled = false
+    let sawCommitted = false
+    let pending!: Promise<void>
+    act(() => { pending = control.loadOlder() })
+    pending.then(() => {
+      settled = true
+      sawCommitted = view.container.querySelector('[data-chat-anchor-key="fixture:user:1"]') !== null
+    })
+    expect(harness.loadOlder).toHaveBeenCalledTimes(1)
+    expect(control.read().following).toBe(false)
+    await Promise.resolve()
+    expect(settled).toBe(false)
+
+    act(() => {
+      harness.session.set({ loadingOlder: true })
+      harness.chatSource.replace([...older, ...current])
+    })
+    await Promise.resolve()
+    expect(settled).toBe(false)
+    act(() => {
+      control.preparePageCommit?.()
+      harness.session.set({ loadingOlder: false })
+      harness.session.set({ hasMore: false })
+    })
+    await pending
+    expect(settled).toBe(true)
+    expect(sawCommitted).toBe(true)
+    expect(control.read().hasOlder).toBe(false)
+  })
+
+  it('latest-fetches-head', async () => {
+    const nodes = [userInTurn(5, 'current question', 2), assistant(6, 'current answer', 2)]
+    const harness = makeHarness({ nodes, scrollMemory: { anchorKey: 'fixture:user:5', anchorTop: 0, scrollTop: 0 } })
+    let releaseHead!: () => void
+    const readLatest = vi.fn(() => new Promise<void>((resolve) => { releaseHead = resolve }))
+    const { control } = mountView(harness, { mountedChatSource: { readLatest } })
+
+    let settled = false
+    const pending = control.toLatest()
+    pending.then(() => { settled = true })
+    await Promise.resolve()
+    expect(readLatest).toHaveBeenCalledTimes(1)
+    expect(settled).toBe(false)
+
+    releaseHead()
+    await pending
+    expect(settled).toBe(true)
+    expect(control.read().following).toBe(true)
+    expect(harness.chatScroll.save).toHaveBeenCalledWith(null)
+  })
+
+  it('a cached folded page settles through its loader promise without a changed outer node', async () => {
+    const harness = makeHarness({ nodes: [userInTurn(5, 'current question', 2)], session: { hasMore: true } })
+    let finish!: () => void
+    harness.loadOlder.mockImplementation(() => new Promise<void>(resolve => { finish = resolve }))
+    const { control } = mountView(harness)
+    let pending!: Promise<void>, settled = false
+    act(() => { pending = control.loadOlder() })
+    void pending.then(() => { settled = true })
+    await Promise.resolve()
+    expect(settled).toBe(false)
+    finish()
+    await pending
+    expect(settled).toBe(true)
+    expect(harness.loadOlder).toHaveBeenCalledTimes(1)
+    expect(control.read().following).toBe(false)
+  })
+
+  it('latest failure preserves the current window', async () => {
+    const nodes = [userInTurn(5, 'current question', 2)]
+    const harness = makeHarness({ nodes, scrollMemory: { anchorKey: 'fixture:user:5', anchorTop: 0, scrollTop: 0 } })
+    const readLatest = vi.fn(() => Promise.reject(new Error('source unavailable')))
+    const { control } = mountView(harness, { mountedChatSource: { readLatest } })
+    vi.mocked(harness.chatScroll.save).mockClear()
+    await expect(control.toLatest()).rejects.toThrow('source unavailable')
+    expect(harness.chatScroll.save).not.toHaveBeenCalledWith(null)
+  })
+
+  it('unmount-invalidates-handle', async () => {
+    const harness = makeHarness({ nodes: [userInTurn(5, 'current question', 2)] })
+    const { control, view, delivered } = mountView(harness)
+    expect(control.version).toBe(1)
+    view.unmount()
+    expect(delivered.at(-1)).toBeNull()
+
+    expect(() => control.read()).toThrowError(/no longer attached/)
+    expect(() => control.subscribe(() => {})).toThrowError(/no longer attached/)
+    await expect(control.loadOlder()).rejects.toMatchObject({ code: 'DISPOSED' })
+    await expect(control.reveal({ key: 'fixture:user:1', seq: seq(1) })).rejects.toMatchObject({ code: 'DISPOSED' })
+    await expect(control.toLatest()).rejects.toMatchObject({ code: 'DISPOSED' })
+  })
+})
