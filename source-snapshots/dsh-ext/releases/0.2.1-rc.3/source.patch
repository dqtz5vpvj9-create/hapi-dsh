index 0000000000000000000000000000000000000000..926f419b996f1f9bb776a35c61a4d651a3562afa
--- /dev/null
+++ b/ext/tests/contracts/0003-window-commit.contract.test.ts
@@ -0,0 +1,184 @@
+/**
+ * Contract tests for patch 0003-window-commit.
+ *
+ * These run the real coordinator implementation from the patched package: the
+ * five names below are fixed by the spec (section 4), and each asserts the
+ * landed behavior rather than a skeleton.
+ *
+ * Dependency: ext/patches/0.2.1-rc.3/0003-window-commit.patch
+ */
+import { describe, expect, it, vi } from 'vitest'
+import { createWindowCommitFactory } from '../../../packages/api/session-controller/src/client/sessions/window-commit.ts'
+import type {
+  HistorySnapshotV1,
+  PreparedWindowV1,
+  WindowCandidateV1,
+  WindowCommitCoordinatorV1,
+  WindowCommitHostV1,
+  WindowLayoutV1,
+  WindowReaderMeasurementV1,
+  WindowReaderParticipantV1,
+} from '../../../packages/api/session-controller/src/client/contract/window-commit.ts'
+
+const PATCH = 'ext/patches/0.2.1-rc.3/0003-window-commit.patch'
+
+const CONTRACTS = [
+  'measure-before-publish',
+  'no-intermediate-paint',
+  'cancel-before-commit',
+  'cancel-after-commit',
+  'stale-token-rejected',
+  'correction-failure-is-not-success',
+] as const
+
+interface Candidate {
+  readonly version: string
+}
+
+function snapshot(version: string): HistorySnapshotV1 {
+  return { version, entries: [], before: null, after: null, hasBefore: false, hasAfter: false }
+}
+
+function measurement(overrides: Partial<WindowReaderMeasurementV1> = {}): WindowReaderMeasurementV1 {
+  return {
+    revision: 1, anchor: null, following: false, scrollTop: 0,
+    clientHeight: 600, scrollHeight: 1_200, nodes: 0, available: true, ...overrides,
+  }
+}
+
+interface Harness {
+  readonly coordinator: WindowCommitCoordinatorV1
+  readonly order: string[]
+  readonly state: { revision: number; version: string; publishes: number }
+}
+
+function harness(onPublish?: (candidate: Candidate, layout: WindowLayoutV1) => void): Harness {
+  const order: string[] = []
+  const state = { revision: 0, version: 'old', publishes: 0 }
+  let coordinator: WindowCommitCoordinatorV1 | undefined
+  const host: WindowCommitHostV1<Candidate> = {
+    windowId: 'pane-a',
+    revision: state.revision,
+    buildCandidate: (built): WindowCandidateV1<Candidate> => {
+      order.push(`build:${built.version}`)
+      return { candidate: { version: built.version }, nodes: built.entries.length }
+    },
+    publish: (candidate, layout) => {
+      order.push(`publish:${candidate.version}`)
+      if (coordinator?.inCommitCriticalSection !== true) throw new Error('publish outside the commit critical section')
+      state.publishes += 1
+      state.version = candidate.version
+      state.revision = layout.revision
+      onPublish?.(candidate, layout)
+    },
+    discard: (candidate) => { order.push(`discard:${candidate.version}`) },
+  }
+  coordinator = createWindowCommitFactory().create(host)
+  return { coordinator, order, state }
+}
+
+/** @returns whether a rejection is a caller AbortError. */
+function isAbort(error: unknown): boolean {
+  return typeof error === 'object' && error !== null && 'name' in error && error.name === 'AbortError'
+}
+
+describe('0003-window-commit contract', () => {
+  it('keeps the spec contract names', () => {
+    expect(CONTRACTS).toHaveLength(6)
+  })
+
+  it('measure-before-publish', async () => {
+    const events: string[] = []
+    const h = harness((_candidate, layout) => { events.push(`publish:${layout.measurement.scrollTop}`) })
+    let measured = 0
+    const participant: WindowReaderParticipantV1 = {
+      id: 'reader',
+      measure: () => { measured += 1; return measurement({ revision: measured, scrollTop: 250 }) },
+      correct: () => { events.push('correct') },
+    }
+    h.coordinator.register(participant)
+    const prepared = await h.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    expect(measured).toBe(0)
+    events.push('prepared')
+    await h.coordinator.commitWindow(prepared, new AbortController().signal)
+    expect(measured).toBe(1)
+    expect(events).toEqual(['prepared', 'publish:250', 'correct'])
+  })
+
+  it('no-intermediate-paint', async () => {
+    const h = harness()
+    const prepared = await h.coordinator.prepare(snapshot('v1'), new AbortController().signal)
+    // Candidate built, published window unchanged until the commit.
+    expect(h.order).toEqual(['build:v1'])
+    expect(h.state).toEqual({ revision: 0, version: 'old', publishes: 0 })
+    await h.coordinator.commitWindow(prepared, new AbortController().signal)
+    expect(h.order).toEqual(['build:v1', 'publish:v1'])
+    expect(h.state).toEqual({ revision: 1, version: 'v1', publishes: 1 })
+  })
+
+  it('cancel-before-commit', async () => {
+    const h = harness()
+    const abort = new AbortController()
+    const prepared = await h.coordinator.prepare(snapshot('v1'), abort.signal)
+    abort.abort()
+    await expect(h.coordinator.commitWindow(prepared, abort.signal)).rejects.toSatisfy(isAbort)
+    expect(h.state.version).toBe('old')
+    expect(h.state.publishes).toBe(0)
+    expect(h.order).toContain('discard:v1')
+    await expect(h.coordinator.commitWindow(prepared, new AbortController().signal))
+      .rejects.toMatchObject({ code: 'STALE_VERSION' })
+  })
+
+  it('cancel-after-commit', async () => {
+    const h = harness()
+    const abort = new AbortController()
+    h.coordinator.register({
+      id: 'reader',
+      measure: () => { abort.abort(); return measurement() },
+      correct: vi.fn(),
+    })
+    const prepared = await h.coordinator.prepare(snapshot('v1'), abort.signal)
+    const result = await h.coordinator.commitWindow(prepared, abort.signal)
+    expect(result).toEqual({ revision: 1, committed: true, correction: 'applied' })
+    expect(abort.signal.aborted).toBe(true)
+    expect(h.state.version).toBe('v1')
+    expect(h.state.publishes).toBe(1)
+  })
+
+  it('stale-token-rejected', async () => {
+    const h = harness()
+    const signal = new AbortController().signal
+    const forged: PreparedWindowV1 = { baseRevision: 0, nextRevision: 1, token: Symbol('forged') }
+    await expect(h.coordinator.commitWindow(forged, signal)).rejects.toMatchObject({ code: 'INVALID_WINDOW' })
+    const prepared = await h.coordinator.prepare(snapshot('v1'), signal)
+    await expect(h.coordinator.commitWindow({ ...prepared }, signal)).rejects.toMatchObject({ code: 'INVALID_WINDOW' })
+    await h.coordinator.commitWindow(prepared, signal)
+    await expect(h.coordinator.commitWindow(prepared, signal)).rejects.toMatchObject({ code: 'STALE_VERSION' })
+    expect(h.state.publishes).toBe(1)
+  })
+
+  it('correction-failure-is-not-success', async () => {
+    const h = harness()
+    const failure = new Error('anchor write rejected')
+    h.coordinator.register({
+      id: 'reader',
+      measure: () => measurement({ anchor: { key: 'turn-9', top: 4 }, following: false }),
+      correct: vi.fn(() => { throw failure }),
+    })
+    const signal = new AbortController().signal
+    const prepared = await h.coordinator.prepare(snapshot('v1'), signal)
+    const result = await h.coordinator.commitWindow(prepared, signal)
+    // Published and linearized: this fact never becomes false.
+    expect(result.committed).toBe(true)
+    expect(result.revision).toBe(1)
+    expect(h.state).toEqual({ revision: 1, version: 'v1', publishes: 1 })
+    // The failed correction is reported beside the commit, not swallowed.
+    expect(result.correction).toBe('failed')
+    if (result.correction !== 'failed') throw new Error('expected a failed correction')
+    expect(result.correctionError).toBe(failure)
+  })
+
+  it('records the patch dependency', () => {
+    expect(PATCH.endsWith('0003-window-commit.patch')).toBe(true)
+  })
+})
diff --git a/ext/tests/distribution/install-idempotency.test.ts b/ext/tests/distribution/install-idempotency.test.ts
