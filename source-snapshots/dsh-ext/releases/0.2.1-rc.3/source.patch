+/** One Pane's windowed history reading scope over the official Conversation assembler. */
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type {
+  Budget,
+  HistoryDeltaV1,
+  HistoryFeedV1,
+  HistoryReadV1,
+  HistorySnapshotV1,
+  HistorySourceFailureCode,
+  SessionEventChange,
+  SessionEventLikeEntry,
+  SessionHistoryReadV1,
+  SourceVersion,
+  WindowCommitCoordinatorV1,
