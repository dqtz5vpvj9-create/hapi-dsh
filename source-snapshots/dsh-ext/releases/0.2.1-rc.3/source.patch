+  })
+
+  it('snapshot-tail-no-gap', async ({ bench }) => {
+    const b = bench()
+    await feedList(b.mock, b.svc, 's1')
+    const registry = historyExtension(b.svc)
+    if (registry === undefined) throw new Error('expected the history extension')
+    let latest = snapshot('v1', [entry(1)])
+    const feed = createFeed(snapshot('v1', [entry(1)]), () => latest)
+    const opened: string[] = []
+    const provider = createProvider('provider', () => true, createSource(feed.feed, opened))
+    registry.register(provider.provider)
+    using reference = b.svc.retain(sid('s1'), { source: 'controllerOperation' })
+    await reference.ready
+    const binding = b.svc.binding(sid('s1'))
+    if (binding === undefined) throw new Error('expected a Session binding')
+    expect(opened).toEqual(['session'])
+    // Subscription starts from initial.version before any read: no read-then-subscribe gap.
+    await vi.waitFor(() => { expect(feed.changesFrom).toEqual(['v1']) })
+    expect(feed.reads).toEqual([])
+    expect(binding.session.historyRead).toBeDefined()
+
+    feed.push({
+      base: 'v1',
+      version: 'v2',
+      changes: [{ kind: 'append', entries: [entry(2)] }],
+      headChanged: false,
+    })
+    await vi.waitFor(() => {
+      expect(binding.eventSource.getSnapshot().entries.map(item => item.event.seq)).toEqual([1, 2])
+    })
+
+    // A delta whose base the window does not hold is not appended across the gap:
+    // the window re-reads the newest snapshot and replaces itself.
+    latest = snapshot('v2', [entry(2), entry(3)], true)
+    feed.push({
+      base: 'v0',
+      version: 'v9',
+      changes: [{ kind: 'append', entries: [entry(9)] }],
+      headChanged: true,
+    })
+    await vi.waitFor(() => { expect(feed.reads).toEqual([{ kind: 'latest' }]) })
+    await vi.waitFor(() => {
+      expect(binding.eventSource.getSnapshot().entries.map(item => item.event.seq)).toEqual([2, 3])
+    })
+    expect(binding.eventSource.getSnapshot().hasMore).toBe(true)
+  })
+})
