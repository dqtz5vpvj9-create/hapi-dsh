diff --git a/ext/scripts/gates/g1-first-complete.mjs b/ext/scripts/gates/g1-first-complete.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e7a2caf57d66f853f02c1345974f6fba92952134
--- /dev/null
+++ b/ext/scripts/gates/g1-first-complete.mjs
@@ -0,0 +1,170 @@
+/**
+ * G1 — First complete usability (spec section 6).
+ *
+ * Pass only when, for 20 real cold opens of the target 236-turn session, body,
+ * editable composer and actually-scrollable older history are usable at the
+ * same instant within 1500 ms of the click that follows application load, and
+ * nothing degrades during the next 10 s. A sample whose display cache could not
+ * be cleared is not cold and does not count toward the 20.
+ */
+import { commonViolations, frameStats, isFiniteNumber } from '../lib/samples.mjs'
+import { missingSampleFailure } from '../lib/verdict.mjs'
+
+const COLD_SAMPLES = 20
+const MAX_USABLE_MS = 1500
+const OBSERVE_MS = 10_000
+
+export const metadata = {
+  id: 'G1',
+  title: '首次完整可用',
+  expectedSamples: 20,
+  sampleRequirement: '20 real cold opens; body + editable composer + working older-history scroll simultaneously ≤1500 ms after click; no degradation for the next 10 s; document load reported separately',
+  schemaPath: 'ext/scripts/fixtures/schema/g1.schema.json',
+  thresholds: { coldSamples: COLD_SAMPLES, maxClickToUsableMs: MAX_USABLE_MS, degradationObservationMs: OBSERVE_MS },
+  commands: {
+    samplerEnv: 'HAPI_DSH_EXT_G1_CMD',
+    existingDefault: 'hapi-dsh e2e/ui-cli.ts (warm synthetic acceptance; partial, see README)',
+  },
+}
+
+/**
+ * @param {Record<string, unknown>} sample
+ * @param {ReturnType<import('../lib/verdict.mjs').createCollector>} collector
+ * @param {number} index
+ * @param {{ frameSamples: unknown[] }} frames
+ */
+function judgeSample(sample, collector, index, frames) {
+  const id = typeof sample.id === 'string' ? sample.id : `sample-${index}`
+  const needNumber = (field, code) => {
+    const value = sample[field]
+    if (!isFiniteNumber(value) || value < 0) {
+      collector.fail(code, `${id}: ${field} must be a non-negative finite number, got ${JSON.stringify(value)}`, { sampleId: id, sampleIndex: index })
+      return null
+    }
+    return value
+  }
+  if (sample.cold !== true) {
+    collector.fail('NON_COLD_SAMPLE', `${id}: display cache was not cleared, so this sample is not a cold open and cannot count toward 20`, { sampleId: id })
+    return
+  }
+  const appLoadedAtMs = needNumber('appLoadedAtMs', 'MISSING_FIELD')
+  const clickAtMs = needNumber('clickAtMs', 'MISSING_FIELD')
+  const bodyAtMs = needNumber('bodyAtMs', 'MISSING_FIELD')
+  const editorAtMs = needNumber('editorAtMs', 'MISSING_FIELD')
+  const historyAtMs = needNumber('historyAtMs', 'MISSING_FIELD')
+  const allUsableAtMs = needNumber('allUsableAtMs', 'MISSING_FIELD')
+  const clickToUsableMs = needNumber('clickToUsableMs', 'MISSING_FIELD')
+  const docLoadMs = needNumber('docLoadMs', 'DOC_LOAD_MISSING')
+  if (appLoadedAtMs !== null && clickAtMs !== null && clickAtMs <= appLoadedAtMs) {
+    collector.fail('CLICK_BEFORE_LOAD', `${id}: click at ${clickAtMs}ms does not follow application load at ${appLoadedAtMs}ms`, { sampleId: id })
+  }
+  if (allUsableAtMs !== null && allUsableAtMs > MAX_USABLE_MS) {
+    collector.fail('USABLE_TOO_SLOW', `${id}: body+editor+history first simultaneously usable at ${allUsableAtMs}ms > ${MAX_USABLE_MS}ms`, { sampleId: id })
+  }
+  if (clickToUsableMs !== null && clickToUsableMs > MAX_USABLE_MS) {
+    collector.fail('USABLE_TOO_SLOW', `${id}: click-to-usable ${clickToUsableMs}ms > ${MAX_USABLE_MS}ms`, { sampleId: id })
+  }
+  if (allUsableAtMs !== null && clickToUsableMs !== null && Math.abs(allUsableAtMs - clickToUsableMs) > 2) {
+    collector.fail('INCONSISTENT_TIMING', `${id}: clickToUsableMs ${clickToUsableMs}ms and allUsableAtMs ${allUsableAtMs}ms disagree`, { sampleId: id })
+  }
+  const parts = [bodyAtMs, editorAtMs, historyAtMs].filter(value => value !== null)
+  if (allUsableAtMs !== null && parts.length === 3) {
+    const latest = Math.max(...parts)
+    if (latest > allUsableAtMs + 2) {
+      collector.fail('NOT_SIMULTANEOUS', `${id}: last prerequisite (${latest}ms) is later than simultaneous-usable time (${allUsableAtMs}ms)`, { sampleId: id })
+    }
+  }
+  if (sample.historyActuallyLoaded !== true || !isFiniteNumber(sample.olderMessageCount) || sample.olderMessageCount < 1) {
+    collector.fail('HISTORY_NOT_PROVEN', `${id}: no real older source message was reached (historyActuallyLoaded=${JSON.stringify(sample.historyActuallyLoaded)}, olderMessageCount=${JSON.stringify(sample.olderMessageCount)})`, { sampleId: id })
+  }
+  if (sample.degradedWithin10s !== false) {
+    collector.fail('DEGRADED_WITHIN_10S', `${id}: state did not stay usable for 10 s (degradedWithin10s=${JSON.stringify(sample.degradedWithin10s)})`, { sampleId: id })
+  }
+  const observationFrames = Array.isArray(sample.observationFrames) ? sample.observationFrames : []
+  if (observationFrames.length < 2) {
+    collector.fail('MISSING_FRAME_SAMPLES', `${id}: expected per-frame samples covering the 10 s observation window, got ${observationFrames.length}`, { sampleId: id })
+  } else {
+    const last = observationFrames[observationFrames.length - 1]
+    if (!isFiniteNumber(last?.atMs) || last.atMs < OBSERVE_MS) {
+      collector.fail('FRAME_WINDOW_TOO_SHORT', `${id}: frame sampling ends at ${JSON.stringify(last?.atMs)}ms, expected at least ${OBSERVE_MS}ms`, { sampleId: id })
+    }
+    const usableFrom = allUsableAtMs ?? 0
+    for (const frame of observationFrames) {
+      if (!isFiniteNumber(frame?.atMs)) {
+        collector.fail('MALFORMED_FRAME', `${id}: frame without numeric atMs`, { sampleId: id })
+        continue
+      }
+      if (frame.atMs < usableFrom) continue
+      if (frame.body !== true || frame.editor !== true || frame.history !== true) {
+        collector.fail('DEGRADED_WITHIN_10S', `${id}: at ${frame.atMs}ms body/editor/history = ${JSON.stringify({ body: frame.body, editor: frame.editor, history: frame.history })}`, { sampleId: id })
+        break
+      }
+    }
+    frames.frameSamples.push({ sampleId: id, frames: observationFrames })
+  }
+  const stats = frameStats(observationFrames.map(frame => (isFiniteNumber(frame?.atMs) ? frame.atMs : null)).filter(value => value !== null))
+  collector.check(`${id}: cold complete`, true, {
+    clickToUsableMs, allUsableAtMs, docLoadMs, frameCount: observationFrames.length, lastFrameAtMs: observationFrames.at(-1)?.atMs ?? null, frameStats: stats,
+  })
+}
+
+export function judge(dataset) {
+  const collector = makeCollector()
+  const failures = collector.failures
+  if (!dataset || typeof dataset !== 'object') {
+    failures.push({ code: 'DATASET_MISSING', message: 'G1 dataset is missing or not an object' })
+    return finish(collector, {}, [])
+  }
+  for (const failure of commonViolations(dataset, 'G1', { expected: COLD_SAMPLES })) failures.push(failure)
+  const samples = Array.isArray(dataset.samples) ? dataset.samples : []
+  const coldSamples = samples.filter(sample => sample && typeof sample === 'object' && sample.cold === true)
+  if (coldSamples.length < COLD_SAMPLES) {
+    failures.push(missingSampleFailure('G1', COLD_SAMPLES, coldSamples.length, { totalSamples: samples.length }))
+  }
+  const frameSamples = []
+  for (const [index, sample] of samples.entries()) {
+    if (!sample || typeof sample !== 'object') {
+      failures.push({ code: 'MALFORMED_SAMPLE', message: `G1 sample ${index} is not an object`, sampleIndex: index })
+      continue
+    }
+    judgeSample(sample, collector, index, { frameSamples })
+  }
+  const docLoads = coldSamples.map(sample => sample.docLoadMs).filter(isFiniteNumber)
+  const metrics = {
+    totalSamples: samples.length,
+    coldSamples: coldSamples.length,
+    nonColdSamples: samples.length - coldSamples.length,
+    docLoadMs: docLoads.length ? { min: Math.min(...docLoads), max: Math.max(...docLoads), avg: docLoads.reduce((sum, value) => sum + value, 0) / docLoads.length } : null,
+    maxClickToUsableMs: coldSamples.map(sample => sample.clickToUsableMs).filter(isFiniteNumber).reduce((max, value) => Math.max(max, value), 0),
+    budgetMs: MAX_USABLE_MS,
+  }
+  return finish(collector, metrics, frameSamples)
+}
+
+function makeCollector() {
+  /** @type {{ code: string, message: string }[]} */
+  const failures = []
+  /** @type {{ name: string, passed: boolean, detail?: unknown }[]} */
+  const checks = []
+  return {
+    failures,
+    checks,
+    fail(code, message, extra = {}) {
+      failures.push({ code, message, ...extra })
+    },
+    check(name, passed, detail) {
+      checks.push({ name, passed, detail })
+    },
+  }
+}
+
+function finish(collector, metrics, frameSamples) {
+  return {
+    gate: 'G1',
+    verdict: collector.failures.length ? 'FAIL' : 'PASS',
+    failures: collector.failures,
+    checks: collector.checks,
+    metrics,
+    frameSamples,
+  }
+}
diff --git a/ext/scripts/gates/g2-paging-reading.mjs b/ext/scripts/gates/g2-paging-reading.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..228441e5a97dd222471bfddff944153a2805f163
--- /dev/null
+++ b/ext/scripts/gates/g2-paging-reading.mjs
@@ -0,0 +1,158 @@
+/**
+ * G2 — Older-history paging and reading (spec section 6).
+ *
+ * Twenty fixed long-session samples, half of them with two panes. Each sample
+ * must show the expected older messages, keep the anchor within 1 CSS px on
+ * every frame, show zero DOM-synthesized gestures, and leave the editor
+ * instance and draft unchanged. The gate also executes desktop wheel, 360/390
+ * touch widths, return-to-latest, and six live increments (each ≤1500 ms, and a
+ * non-following reader is never pulled back).
+ */
+import { commonViolations, frameStats, isFiniteNumber } from '../lib/samples.mjs'
+import { missingSampleFailure } from '../lib/verdict.mjs'
+
+const SAMPLES = 20
+const DUAL_PANES = 10
+const MAX_ANCHOR_PX = 1
+const MAX_INCREMENT_MS = 1500
+const LIVE_INCREMENTS = 6
+
+export const metadata = {
+  id: 'G2',
+  title: '补页及阅读',
+  expectedSamples: 20,
+  sampleRequirement: '20 fixed long-session samples (10 dual-pane); expected older messages appear, anchor per-frame offset ≤1 CSS px, DOM-synthesized gestures 0, editor instance and draft unchanged; plus desktop wheel, 360/390 touch, return-latest, 6 live increments ≤1500 ms with no pull-back when not following',
+  schemaPath: 'ext/scripts/fixtures/schema/g2.schema.json',
+  thresholds: { samples: SAMPLES, dualPanes: DUAL_PANES, maxAnchorPx: MAX_ANCHOR_PX, liveIncrements: LIVE_INCREMENTS, maxIncrementMs: MAX_INCREMENT_MS },
+  commands: {
+    samplerEnv: 'HAPI_DSH_EXT_G2_CMD',
+    existingDefault: 'hapi-dsh e2e/ui-cli.ts (warm synthetic acceptance; partial, see README)',
+  },
+}
+
+function judgeFrameSeries(fail, checks, id, label, offsets) {
+  if (!Array.isArray(offsets) || offsets.length === 0) {
+    fail('MISSING_FRAME_SAMPLES', `${id}: ${label} has no per-frame anchor offsets`, { sampleId: id })
+    return null
+  }
+  const stats = frameStats(offsets)
+  let worst = null
+  for (const [frameIndex, value] of offsets.entries()) {
+    if (!isFiniteNumber(value)) {
+      fail('MALFORMED_FRAME', `${id}: ${label} frame ${frameIndex} is not a finite number`, { sampleId: id })
+      continue
+    }
+    if (Math.abs(value) > MAX_ANCHOR_PX) worst = worst ?? { frameIndex, offset: value }
+  }
+  if (worst) fail('ANCHOR_DRIFT', `${id}: ${label} frame ${worst.frameIndex} offset ${worst.offset}px exceeds ${MAX_ANCHOR_PX}px`, { sampleId: id, frameIndex: worst.frameIndex, offset: worst.offset })
+  checks.push({ name: `${id}: ${label} frames`, passed: !worst, detail: stats })
+  return stats
+}
+
+function judgeSample(sample, index, fail, checks, frameSamples) {
+  const id = typeof sample.id === 'string' ? sample.id : `sample-${index}`
+  if (sample.paneCount !== 1 && sample.paneCount !== 2) {
+    fail('PANE_COUNT', `${id}: paneCount must be 1 or 2, got ${JSON.stringify(sample.paneCount)}`, { sampleId: id })
+  }
+  if (sample.expectedOlderMessagesVisible !== true || !isFiniteNumber(sample.olderMessageCount) || sample.olderMessageCount < 1) {
+    fail('OLDER_MESSAGE_MISSING', `${id}: expected older source messages did not appear (expectedOlderMessagesVisible=${JSON.stringify(sample.expectedOlderMessagesVisible)}, olderMessageCount=${JSON.stringify(sample.olderMessageCount)})`, { sampleId: id })
+  }
+  const stats = judgeFrameSeries(fail, checks, id, 'paging anchor', sample.frameOffsets)
+  if (stats?.maxAbs !== null && isFiniteNumber(sample.anchorMaxFrameOffsetPx) && Math.abs(stats.maxAbs - sample.anchorMaxFrameOffsetPx) > 0.01) {
+    fail('ANCHOR_REPORT_MISMATCH', `${id}: reported anchorMaxFrameOffsetPx ${sample.anchorMaxFrameOffsetPx} disagrees with frame data ${stats.maxAbs}`, { sampleId: id })
+  }
+  if (sample.domSyntheticGestures !== 0) {
+    fail('SYNTHETIC_GESTURE', `${id}: DOM-synthesized gestures must be 0, got ${JSON.stringify(sample.domSyntheticGestures)}`, { sampleId: id })
+  }
+  if (sample.editorInstanceStable !== true) {
+    fail('EDITOR_CHANGED', `${id}: editor instance did not stay the same`, { sampleId: id })
+  }
+  if (sample.draftUnchanged !== true) {
+    fail('DRAFT_CHANGED', `${id}: draft text was not preserved`, { sampleId: id })
+  } else if (typeof sample.draftBefore === 'string' && typeof sample.draftAfter === 'string' && sample.draftBefore !== sample.draftAfter) {
+    fail('DRAFT_CHANGED', `${id}: draft changed from ${JSON.stringify(sample.draftBefore)} to ${JSON.stringify(sample.draftAfter)}`, { sampleId: id })
+  }
+  if (Array.isArray(sample.frameOffsets) && sample.frameOffsets.length) {
+    frameSamples.push({ sampleId: id, label: 'paging', frames: sample.frameOffsets, anchorStats: stats })
+  }
+}
+
+function judgeActions(actions, fail, checks, frameSamples) {
+  if (!actions || typeof actions !== 'object') {
+    fail('ACTION_MISSING', 'G2 actions block is missing; desktop wheel, 360/390 touch, return-latest and six live increments are required')
+    return
+  }
+  for (const [key, width] of [['desktopWheel', null], ['touch360', 360], ['touch390', 390]]) {
+    const action = actions[key]
+    if (!action || action.performed !== true) {
+      fail('ACTION_MISSING', `G2 ${key} was not executed`, { action: key })
+      continue
+    }
+    if (width !== null && action.width !== width) {
+      fail('ACTION_WIDTH', `G2 ${key} width must be ${width}px, got ${JSON.stringify(action.width)}`, { action: key })
+    }
+    const stats = judgeFrameSeries(fail, checks, `actions.${key}`, `${key} anchor`, action.frameOffsets)
+    if (Array.isArray(action.frameOffsets) && action.frameOffsets.length) {
+      frameSamples.push({ sampleId: `actions.${key}`, label: key, frames: action.frameOffsets, anchorStats: stats })
+    }
+    if (key !== 'desktopWheel' && 'loadedOlder' in action && action.loadedOlder !== true) {
+      fail('OLDER_MESSAGE_MISSING', `G2 ${key}: touch gesture did not load older content`, { action: key })
+    }
+  }
+  const returnLatest = actions.returnLatest
+  if (!returnLatest || returnLatest.performed !== true) {
+    fail('ACTION_MISSING', 'G2 returnLatest was not executed')
+  } else {
+    if (returnLatest.reachedHead !== true) fail('RETURN_LATEST', 'G2 returnLatest did not reach the live head')
+    if (!isFiniteNumber(returnLatest.ms) || returnLatest.ms < 0) fail('RETURN_LATEST', 'G2 returnLatest duration is missing')
+  }
+  const increments = actions.liveIncrements
+  if (!Array.isArray(increments) || increments.length !== LIVE_INCREMENTS) {
+    fail('LIVE_INCREMENT_MISSING', `G2 requires ${LIVE_INCREMENTS} live increments, got ${Array.isArray(increments) ? increments.length : 'none'}`)
+    return
+  }
+  for (const [index, increment] of increments.entries()) {
+    if (!increment || increment.applied !== true) {
+      fail('LIVE_INCREMENT_MISSING', `G2 live increment ${index} did not apply`, { increment: index })
+      continue
+    }
+    if (!isFiniteNumber(increment.ms) || increment.ms > MAX_INCREMENT_MS) {
+      fail('LIVE_INCREMENT_SLOW', `G2 live increment ${index} took ${JSON.stringify(increment.ms)}ms, budget ${MAX_INCREMENT_MS}ms`, { increment: index })
+    }
+    if (increment.following === false && increment.pulledBack !== false) {
+      fail('PULL_BACK_WHILE_READING', `G2 live increment ${index} pulled a non-following reader back to the tail`, { increment: index })
+    }
+  }
+  checks.push({ name: 'actions: live increments', passed: true, detail: increments.map(increment => ({ ms: increment.ms, following: increment.following, pulledBack: increment.pulledBack })) })
+}
+
+export function judge(dataset) {
+  /** @type {{ code: string, message: string }[]} */
+  const failures = []
+  /** @type {{ name: string, passed: boolean, detail?: unknown }[]} */
+  const checks = []
+  const frameSamples = []
+  const fail = (code, message, extra = {}) => failures.push({ code, message, ...extra })
+  if (!dataset || typeof dataset !== 'object') {
+    failures.push({ code: 'DATASET_MISSING', message: 'G2 dataset is missing or not an object' })
+    return { gate: 'G2', verdict: 'FAIL', failures, checks, metrics: {}, frameSamples }
+  }
+  for (const failure of commonViolations(dataset, 'G2', { expected: SAMPLES })) failures.push(failure)
+  const samples = Array.isArray(dataset.samples) ? dataset.samples.filter(sample => sample && typeof sample === 'object') : []
+  if (samples.length < SAMPLES) failures.push(missingSampleFailure('G2', SAMPLES, samples.length))
+  for (const [index, sample] of samples.entries()) judgeSample(sample, index, fail, checks, frameSamples)
+  const dualPanes = samples.filter(sample => sample.paneCount === 2).length
+  const singlePanes = samples.filter(sample => sample.paneCount === 1).length
+  if (dualPanes !== DUAL_PANES) {
+    fail('PANE_MIX', `G2 requires ${DUAL_PANES} dual-pane and ${SAMPLES - DUAL_PANES} single-pane samples, got ${dualPanes} dual and ${singlePanes} single`)
+  }
+  judgeActions(dataset.actions, fail, checks, frameSamples)
+  const metrics = {
+    totalSamples: samples.length,
+    dualPanes,
+    singlePanes,
+    maxAnchorPx: MAX_ANCHOR_PX,
+    liveIncrements: Array.isArray(dataset.actions?.liveIncrements) ? dataset.actions.liveIncrements.length : 0,
+  }
+  return { gate: 'G2', verdict: failures.length ? 'FAIL' : 'PASS', failures, checks, metrics, frameSamples }
+}
diff --git a/ext/scripts/gates/g3-bounded-derived.mjs b/ext/scripts/gates/g3-bounded-derived.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c72d9d0ad36b5c0cb96119948e5b9bc7f82c2778
--- /dev/null
+++ b/ext/scripts/gates/g3-bounded-derived.mjs
@@ -0,0 +1,132 @@
+/**
+ * G3 — Bounded derived state (spec section 6).
+ *
+ * Per-window budget B = 2000 live derived nodes. After traversing at least
+ * 20,000 history nodes, 100 consecutive window commits must each finish with
+ * ≤B live derived nodes, ≤5000 events and ≤12 MiB of body data, while the
+ * candidate construction peak stays ≤2B. Hidden nodes, groups and index
+ * residue are included in the count. A single indivisible node over budget must
+ * return a capacity error without dropping content.
+ */
+import { commonViolations, isFiniteNumber } from '../lib/samples.mjs'
+import { missingSampleFailure } from '../lib/verdict.mjs'
+
+const B = 2000
+const MAX_EVENTS = 5000
+const MAX_BODY_BYTES = 12 * 1024 * 1024
+const MIN_TRAVERSED_NODES = 20_000
+const COMMITS = 100
+const PEAK_MULTIPLIER = 2
+const DOM_NODES_MAX = 15_000
+const BODY_MARKERS_MAX = 100
+
+export const metadata = {
+  id: 'G3',
+  title: '有界派生状态',
+  expectedSamples: 100,
+  sampleRequirement: '≥20,000 traversed history nodes, then 100 consecutive commits each with ≤B=2000 live derived nodes, ≤5000 events, ≤12 MiB body data, construction peak ≤2B; DOM ≤15,000 and ≤100 body markers stay enforced',
+  schemaPath: 'ext/scripts/fixtures/schema/g3.schema.json',
+  thresholds: {
+    liveDerivedNodes: B, events: MAX_EVENTS, bodyBytes: MAX_BODY_BYTES, traversedHistoryNodes: MIN_TRAVERSED_NODES,
+    commits: COMMITS, candidatePeakNodes: B * PEAK_MULTIPLIER, domNodes: DOM_NODES_MAX, bodyMarkers: BODY_MARKERS_MAX,
+  },
+  commands: {
+    samplerEnv: 'HAPI_DSH_EXT_G3_CMD',
+    existingDefault: 'none; needs store/assembler lifecycle instrumentation, not DOM row counts',
+  },
+}
+
+export function judge(dataset) {
+  /** @type {{ code: string, message: string }[]} */
+  const failures = []
+  /** @type {{ name: string, passed: boolean, detail?: unknown }[]} */
+  const checks = []
+  const fail = (code, message, extra = {}) => failures.push({ code, message, ...extra })
+  if (!dataset || typeof dataset !== 'object') {
+    failures.push({ code: 'DATASET_MISSING', message: 'G3 dataset is missing or not an object' })
+    return { gate: 'G3', verdict: 'FAIL', failures, checks, metrics: {}, frameSamples: [] }
+  }
+  for (const failure of commonViolations(dataset, 'G3')) failures.push(failure)
+  if (dataset.windowBudgetB !== B) {
+    fail('WRONG_BUDGET', `G3 windowBudgetB must be the spec value ${B}, got ${JSON.stringify(dataset.windowBudgetB)}`)
+  }
+  if (!isFiniteNumber(dataset.traversedHistoryNodes) || dataset.traversedHistoryNodes < MIN_TRAVERSED_NODES) {
+    fail('TRAVERSAL_TOO_SMALL', `G3 must traverse at least ${MIN_TRAVERSED_NODES} history nodes, got ${JSON.stringify(dataset.traversedHistoryNodes)}`)
+  }
+  const commits = Array.isArray(dataset.commits) ? dataset.commits : []
+  if (commits.length !== COMMITS) {
+    failures.push(missingSampleFailure('G3', COMMITS, commits.length, { unit: 'consecutive commits' }))
+  }
+  for (const [index, commit] of commits.entries()) {
+    if (!commit || typeof commit !== 'object') {
+      fail('MALFORMED_COMMIT', `G3 commit ${index} is not an object`, { commitIndex: index })
+      continue
+    }
+    if (commit.index !== index) {
+      fail('COMMIT_ORDER', `G3 commit ${index} reports index ${JSON.stringify(commit.index)}; commits must be consecutive from 0`, { commitIndex: index })
+    }
+    const live = commit.liveDerivedNodes
+    const events = commit.events
+    const bytes = commit.bodyBytes
+    const peak = commit.candidatePeakNodes
+    for (const [field, value] of [['liveDerivedNodes', live], ['events', events], ['bodyBytes', bytes], ['candidatePeakNodes', peak]]) {
+      if (!isFiniteNumber(value) || value < 0) fail('MISSING_METRIC', `G3 commit ${index}: ${field} must be a non-negative finite number, got ${JSON.stringify(value)}`, { commitIndex: index })
+    }
+    if (isFiniteNumber(live) && live > B) fail('LIVE_NODES_OVER_BUDGET', `G3 commit ${index}: ${live} live derived nodes > B=${B}`, { commitIndex: index, metric: 'liveDerivedNodes', value: live, budget: B })
+    if (isFiniteNumber(events) && events > MAX_EVENTS) fail('EVENTS_OVER_BUDGET', `G3 commit ${index}: ${events} events > ${MAX_EVENTS}`, { commitIndex: index, metric: 'events', value: events, budget: MAX_EVENTS })
+    if (isFiniteNumber(bytes) && bytes > MAX_BODY_BYTES) fail('BODY_BYTES_OVER_BUDGET', `G3 commit ${index}: ${bytes} body bytes > ${MAX_BODY_BYTES}`, { commitIndex: index, metric: 'bodyBytes', value: bytes, budget: MAX_BODY_BYTES })
+    if (isFiniteNumber(peak) && peak > B * PEAK_MULTIPLIER) fail('PEAK_OVER_BUDGET', `G3 commit ${index}: candidate peak ${peak} nodes > 2B=${B * PEAK_MULTIPLIER}`, { commitIndex: index, metric: 'candidatePeakNodes', value: peak, budget: B * PEAK_MULTIPLIER })
+  }
+  const windowMetrics = dataset.windowMetrics
+  if (!windowMetrics || typeof windowMetrics !== 'object') {
+    fail('WINDOW_METRICS_MISSING', 'G3 windowMetrics (DOM nodes, body markers) is missing; the UI capacity thresholds stay enforced')
+  } else {
+    if (!isFiniteNumber(windowMetrics.domNodes) || windowMetrics.domNodes > DOM_NODES_MAX) {
+      fail('DOM_NODES_OVER_LIMIT', `G3 DOM nodes ${JSON.stringify(windowMetrics.domNodes)} > ${DOM_NODES_MAX}`)
+    }
+    if (!isFiniteNumber(windowMetrics.bodyMarkers) || windowMetrics.bodyMarkers > BODY_MARKERS_MAX) {
+      fail('BODY_MARKERS_OVER_LIMIT', `G3 body markers ${JSON.stringify(windowMetrics.bodyMarkers)} > ${BODY_MARKERS_MAX}`)
+    }
+  }
+  const fourPane = Array.isArray(dataset.fourPane) ? dataset.fourPane : null
+  if (fourPane) {
+    let sum = 0
+    for (const pane of fourPane) {
+      if (!pane || !isFiniteNumber(pane.liveDerivedNodes)) {
+        fail('MALFORMED_PANE', 'G3 fourPane entry without liveDerivedNodes')
+        continue
+      }
+      if (pane.liveDerivedNodes > B) fail('LIVE_NODES_OVER_BUDGET', `G3 pane ${JSON.stringify(pane.paneId ?? pane.pane)}: ${pane.liveDerivedNodes} > B=${B}`)
+      sum += pane.liveDerivedNodes
+    }
+    if (sum > fourPane.length * B) fail('FOUR_PANE_OVER_BUDGET', `G3 four-pane total ${sum} > ${fourPane.length} × B`)
+    if (dataset.fourPaneTotal !== undefined && !isFiniteNumber(dataset.fourPaneTotal)) {
+      fail('MISSING_METRIC', 'G3 fourPaneTotal is not a finite number')
+    } else if (isFiniteNumber(dataset.fourPaneTotal) && dataset.fourPaneTotal !== sum) {
+      fail('FOUR_PANE_TOTAL_MISMATCH', `G3 fourPaneTotal ${dataset.fourPaneTotal} does not equal the per-pane sum ${sum}; hidden full copies are not allowed`)
+    }
+    checks.push({ name: 'four panes: per-window sum', passed: sum <= fourPane.length * B, detail: { panes: fourPane.length, sum, budget: fourPane.length * B } })
+  }
+  if (dataset.oversizeNode !== undefined) {
+    const oversize = dataset.oversizeNode
+    if (!oversize || typeof oversize !== 'object') fail('MALFORMED_OVERSIZE_CASE', 'G3 oversizeNode must be an object')
+    else {
+      if (oversize.code !== 'CAPACITY_EXCEEDED') fail('OVERSIZE_NOT_REPORTED', `G3 indivisible oversize node must return CAPACITY_EXCEEDED, got ${JSON.stringify(oversize.code)}`)
+      if (oversize.contentLost !== false) fail('OVERSIZE_CONTENT_LOST', 'G3 indivisible oversize node must not drop content')
+    }
+  }
+  const liveValues = commits.map(commit => commit?.liveDerivedNodes).filter(isFiniteNumber)
+  const peakValues = commits.map(commit => commit?.candidatePeakNodes).filter(isFiniteNumber)
+  const metrics = {
+    budgetB: B,
+    traversedHistoryNodes: dataset.traversedHistoryNodes ?? null,
+    commits: commits.length,
+    maxLiveDerivedNodes: liveValues.length ? Math.max(...liveValues) : null,
+    maxCandidatePeakNodes: peakValues.length ? Math.max(...peakValues) : null,
+    maxEvents: commits.map(commit => commit?.events).filter(isFiniteNumber).reduce((max, value) => Math.max(max, value), 0),
+    maxBodyBytes: commits.map(commit => commit?.bodyBytes).filter(isFiniteNumber).reduce((max, value) => Math.max(max, value), 0),
+    domNodes: windowMetrics?.domNodes ?? null,
+    bodyMarkers: windowMetrics?.bodyMarkers ?? null,
+  }
+  return { gate: 'G3', verdict: failures.length ? 'FAIL' : 'PASS', failures, checks, metrics, frameSamples: [] }
+}
diff --git a/ext/scripts/gates/g4-default-path.mjs b/ext/scripts/gates/g4-default-path.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3825a1e37c3b388039f2de77128dc51992c07604
--- /dev/null
+++ b/ext/scripts/gates/g4-default-path.mjs
@@ -0,0 +1,142 @@
+/**
+ * G4 — Default path consistency (spec section 6).
+ *
+ * Original rc.3 versus the extension with all eight feature-switch
+ * combinations, each running the 12 synthetic scenarios three times. Source
+ * events, call counts/order and the final semantic state are normalized and
+ * compared: the difference must be zero. With no provider registered, provider
+ * registrations and new windows must both be zero.
+ */
+import { commonViolations } from '../lib/samples.mjs'
+import { diffObservations, normalizedObservation } from '../lib/normalize.mjs'
+import { missingSampleFailure } from '../lib/verdict.mjs'
+
+const SCENARIOS = [
+  'open', 'page-older', 'page-newer', 'send', 'queue', 'approval', 'reconnect', 'close', 'draft', 'live-update', 'split-pane', 'restore',
+]
+const ROUNDS = 3
+const SWITCH_KEYS = ['historySource', 'mountedChat', 'windowCommit']
+const ORIGINAL = 'original'
+
+export const metadata = {
+  id: 'G4',
+  title: '默认路径一致',
+  expectedSamples: 324,
+  sampleRequirement: 'original rc.3 + 8 feature-switch combinations × 12 scenarios × 3 rounds = 324 normalized comparisons; source events, call counts and final semantic state must differ by 0; no provider → 0 registrations and 0 new windows',
+  schemaPath: 'ext/scripts/fixtures/schema/g4.schema.json',
+  thresholds: { variants: 9, scenarios: 12, rounds: 3, normalizedDiffs: 0, providerRegistrationsWithoutProvider: 0 },
+  scenarios: SCENARIOS,
+  commands: {
+    samplerEnv: 'HAPI_DSH_EXT_G4_CMD',
+    existingDefault: 'none; the matrix needs the official-package synthetic runner from the distribution/profile work',
+  },
+}
+
+/** @returns {string[]} */
+export function allCombinations() {
+  const combinations = []
+  for (let mask = 0; mask < 8; mask += 1) {
+    combinations.push({
+      variant: `ext:${(mask & 4 ? '1' : '0')}${(mask & 2 ? '1' : '0')}${(mask & 1 ? '1' : '0')}`,
+      switches: { historySource: mask & 4 ? 1 : 0, mountedChat: mask & 2 ? 1 : 0, windowCommit: mask & 1 ? 1 : 0 },
+    })
+  }
+  return combinations
+}
+
+function switchId(switches) {
+  return `${switches.historySource ? '1' : '0'}${switches.mountedChat ? '1' : '0'}${switches.windowCommit ? '1' : '0'}`
+}
+
+function validateVariantSet(cases, fail) {
+  const originalCases = cases.filter(entry => entry.variant === ORIGINAL)
+  if (!originalCases.length) fail('MISSING_VARIANT', 'G4 dataset has no original (rc.3) baseline cases')
+  const expected = allCombinations()
+  for (const { variant, switches } of expected) {
+    const matching = cases.filter(entry => entry.variant === variant)
+    if (!matching.length) {
+      fail('MISSING_VARIANT', `G4 dataset is missing extension switch combination ${SWITCH_KEYS.map(key => `${key}=${switches[key]}`).join(',')}`)
+      continue
+    }
+    for (const entry of matching) {
+      if (!entry.switches || switchId(entry.switches) !== switchId(switches)) {
+        fail('SWITCH_MISMATCH', `G4 case ${variant} declares switches ${JSON.stringify(entry.switches)}`)
+      }
+    }
+  }
+  return originalCases
+}
+
+export function judge(dataset) {
+  /** @type {{ code: string, message: string }[]} */
+  const failures = []
+  /** @type {{ name: string, passed: boolean, detail?: unknown }[]} */
+  const checks = []
+  const fail = (code, message, extra = {}) => failures.push({ code, message, ...extra })
+  if (!dataset || typeof dataset !== 'object') {
+    failures.push({ code: 'DATASET_MISSING', message: 'G4 dataset is missing or not an object' })
+    return { gate: 'G4', verdict: 'FAIL', failures, checks, metrics: {}, frameSamples: [] }
+  }
+  for (const failure of commonViolations(dataset, 'G4')) failures.push(failure)
+  const cases = Array.isArray(dataset.cases) ? dataset.cases.filter(entry => entry && typeof entry === 'object') : []
+  const expectedCases = 9 * SCENARIOS.length * ROUNDS
+  if (cases.length < expectedCases) {
+    failures.push(missingSampleFailure('G4', expectedCases, cases.length, { unit: 'variant × scenario × round cases' }))
+  }
+  const originalCases = validateVariantSet(cases, fail)
+  const index = new Map()
+  for (const entry of cases) {
+    const key = `${entry.variant}|${entry.scenario}|${entry.round}`
+    if (index.has(key)) fail('DUPLICATE_CASE', `G4 case ${key} is duplicated`)
+    index.set(key, entry)
+  }
+  let comparisons = 0
+  let maxDiffs = 0
+  const diffSummaries = []
+  for (const { variant } of allCombinations()) {
+    for (const scenario of SCENARIOS) {
+      for (let round = 1; round <= ROUNDS; round += 1) {
+        const baseline = index.get(`${ORIGINAL}|${scenario}|${round}`)
+        const extended = index.get(`${variant}|${scenario}|${round}`)
+        if (!baseline) {
+          fail('MISSING_CASE', `G4 baseline case original|${scenario}|${round} is missing`)
+          continue
+        }
+        if (!extended) {
+          fail('MISSING_CASE', `G4 extension case ${variant}|${scenario}|${round} is missing`)
+          continue
+        }
+        const diffs = diffObservations(normalizedObservation(baseline.observation ?? {}), normalizedObservation(extended.observation ?? {}))
+        comparisons += 1
+        maxDiffs = Math.max(maxDiffs, diffs.length)
+        if (diffs.length) {
+          diffSummaries.push({ variant, scenario, round, diffs: diffs.slice(0, 5), diffCount: diffs.length })
+          fail('DEFAULT_PATH_DIFF', `G4 ${variant}/${scenario}/round ${round}: normalized difference ${diffs.length}`, { variant, scenario, round, diffs: diffs.slice(0, 5) })
+        }
+      }
+    }
+  }
+  for (const entry of cases) {
+    if (entry.variant === ORIGINAL || (entry.switches && switchId(entry.switches) === '000')) {
+      if (entry.observation?.providerRegistrations !== 0) {
+        fail('PROVIDER_REGISTRATION_NOT_ZERO', `G4 ${entry.variant}/${entry.scenario}/${entry.round}: provider registrations must be 0 without a provider, got ${JSON.stringify(entry.observation?.providerRegistrations)}`, { variant: entry.variant, scenario: entry.scenario, round: entry.round })
+      }
+      if (entry.observation?.newWindows !== 0) {
+        fail('NEW_WINDOW_NOT_ZERO', `G4 ${entry.variant}/${entry.scenario}/${entry.round}: new windows must be 0 without a provider, got ${JSON.stringify(entry.observation?.newWindows)}`, { variant: entry.variant, scenario: entry.scenario, round: entry.round })
+      }
+    }
+  }
+  checks.push({ name: 'nine variants × twelve scenarios × three rounds', passed: comparisons === 8 * SCENARIOS.length * ROUNDS, detail: { comparisons, expected: 8 * SCENARIOS.length * ROUNDS } })
+  checks.push({ name: 'normalized differences', passed: maxDiffs === 0, detail: { maxDiffs } })
+  const metrics = {
+    cases: cases.length,
+    expectedCases,
+    comparisons,
+    scenarioCount: SCENARIOS.length,
+    rounds: ROUNDS,
+    maxDiffs,
+    diffSummaries: diffSummaries.slice(0, 10),
+    originalCases: originalCases.length,
+  }
+  return { gate: 'G4', verdict: failures.length ? 'FAIL' : 'PASS', failures, checks, metrics, frameSamples: [] }
+}
