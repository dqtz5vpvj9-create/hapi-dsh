index 0000000000000000000000000000000000000000..63e5e6cc466489af5adf2f81ec3df9b842e7f5b6
--- /dev/null
+++ b/ext/scripts/fixtures/README.md
@@ -0,0 +1,68 @@
+# Gate input contracts and self-check fixtures
+
+`schema/g1.schema.json` … `schema/g6.schema.json` are the input contracts a real
+sampler must emit. The judge, not the schema, is the authority: the schema
+documents required fields, while the judge enforces sample counts, thresholds,
+normalization and failure definitions. There is no schema validation step that
+can turn an incomplete dataset into a PASS.
+
+## Units per gate
+
+| gate | comparison unit | required count |
+|---|---|---|
+| G1 | cold-open sample | 20 cold (non-cold samples excluded) |
+| G2 | paging sample, plus an actions block | 20 samples (exactly 10 dual-pane), wheel/360/390/return-latest/6 increments |
+| G3 | window commit | 100 consecutive commits after ≥20,000 traversed nodes |
+| G4 | variant × scenario × round case | 324 (original + 8 switch combinations × 12 scenarios × 3 rounds) |
+| G5 | install run / node / tamper / pre-activation case | 3 installs, Host+2 Runners, 8 tampered fields, 3 pre-activation cases |
+| G6 | upgrade round / injected failure | 3 rounds, 3 injection points |
+
+## Real datasets
+
+Record a sampler result as JSON and judge it without re-running the browser:
+
+```sh
+node ext/scripts/accept-ext.mjs --gate G1 --fixture /path/to/g1-dataset.json
+```
+
+A live sampler prints the JSON dataset on stdout, or prints the path of a JSON
+file as its last stdout line (existing hapi-dsh probes print their report path
+this way). `HAPI_DSH_EXT_<G>_CMD` selects the command. The runner gives the
+sampler exactly one attempt; a timeout or nonzero exit is preserved as a failure
+and is never retried.
+
+## Self-check fixtures
+
+`build.mjs` builds deterministic synthetic datasets:
+
+- one pass fixture per gate, conforming to the spec numbers;
+- one fail fixture per enforced rule (each changes exactly one rule);
+- the runner mutates the pass fixture to prove the sample guards: duplicated id,
+  `attempt: 2`, one missing sample, gate mismatch;
+- the runner applies the failure rules to the pass fixture: not executed,
+  timeout, nonzero exit, unreadable payload, missing dataset.
+
+`--self-check` requires every pass fixture to be `PASS` and every fail case to be
+`FAIL`. A `SELF-CHECK-PASS` is evidence about the judge only.
+
+`emit.mjs G1..G6` prints a pass fixture so the live spawn/parse path can be
+validated without a browser or store:
+
+```sh
+HAPI_DSH_EXT_G3_CMD="node ext/scripts/fixtures/emit.mjs G3" \
+  node ext/scripts/accept-ext.mjs --gate G3
+```
+
+An artifact produced this way has `source: "self-check fixture"`; it is plumbing
+evidence, never product evidence.
+
+## Data provenance rules
+
+- `cold: false` means the display cache was not cleared; G1 excludes it from the
+  twenty and the artifact records it explicitly.
+- Frame arrays are per-frame, not per-event summaries. G1 uses
+  `observationFrames` with `{atMs, body, editor, history}`; G2 uses
+  `frameOffsets` in CSS px.
+- No source message text, credentials or production ids belong in these
+  datasets beyond what a scenario needs; existing hapi-dsh probes already
+  redact request credentials.
diff --git a/ext/scripts/fixtures/build.mjs b/ext/scripts/fixtures/build.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..741b8e6d44e026d8f44c94b8737c713cc9659059
--- /dev/null
+++ b/ext/scripts/fixtures/build.mjs
@@ -0,0 +1,434 @@
+/**
+ * Deterministic synthetic fixtures for the --self-check path.
+ *
+ * These fixtures exercise the verdict functions, not the product: a PASS fixture
+ * proves the judge accepts a spec-conforming dataset, and each fail fixture
+ * changes exactly one rule so a broken judge is caught. The same shape is the
+ * input schema the real samplers must emit.
+ */
+
+const HEX64_A = 'a'.repeat(64)
+const HEX64_B = 'b'.repeat(64)
+const UPSTREAM_COMMIT = '1f81c047fc48fa190a683e469daa699857e9afe8'
+const SCENARIOS = ['open', 'page-older', 'page-newer', 'send', 'queue', 'approval', 'reconnect', 'close', 'draft', 'live-update', 'split-pane', 'restore']
+
+const clone = value => structuredClone(value)
+const maxAbs = values => values.reduce((max, value) => Math.max(max, Math.abs(value)), 0)
+
+/** @param {number} length */
+function frameSeries(length) {
+  return Array.from({ length }, (_, index) => Number((Math.sin(index) * 0.4).toFixed(2)))
+}
+
+export function buildPassFixture(gateId) {
+  switch (gateId) {
+    case 'G1': return { dataset: g1Pass() }
+    case 'G2': return { dataset: g2Pass() }
+    case 'G3': return { dataset: g3Pass() }
+    case 'G4': return { dataset: g4Pass() }
+    case 'G5': return { dataset: g5Pass() }
+    case 'G6': return { dataset: g6Pass() }
+    default: throw new Error(`Unknown gate ${gateId}`)
+  }
+}
+
+/** @param {string} gateId @returns {{name: string, dataset: Record<string, unknown>}[]} */
+export function buildFailFixtures(gateId) {
+  switch (gateId) {
+    case 'G1': return g1Failures()
+    case 'G2': return g2Failures()
+    case 'G3': return g3Failures()
+    case 'G4': return g4Failures()
+    case 'G5': return g5Failures()
+    case 'G6': return g6Failures()
+    default: throw new Error(`Unknown gate ${gateId}`)
+  }
+}
+
+// ---------------------------------------------------------------- G1
+
+function g1Sample(index) {
+  const bodyAtMs = 500 + (index % 5) * 10
+  const editorAtMs = 600 + (index % 4) * 10
+  const historyAtMs = 720 + (index % 6) * 15
+  const allUsableAtMs = Math.max(bodyAtMs, editorAtMs, historyAtMs)
+  const observationFrames = []
+  for (let atMs = 0; atMs <= 10_000; atMs += 250) {
+    observationFrames.push({ atMs, body: atMs >= bodyAtMs, editor: atMs >= editorAtMs, history: atMs >= historyAtMs })
+  }
+  return {
+    id: `g1-cold-${index}`,
+    attempt: 1,
+    cold: true,
+    appLoadedAtMs: 900,
+    clickAtMs: 1_000,
+    bodyAtMs,
+    editorAtMs,
+    historyAtMs,
+    allUsableAtMs,
+    clickToUsableMs: allUsableAtMs,
+    docLoadMs: 700 + index * 5,
+    historyActuallyLoaded: true,
+    olderMessageCount: 24 + index,
+    degradedWithin10s: false,
+    observationFrames,
+  }
+}
+
+function g1Pass() {
+  return { gate: 'G1', source: 'self-check fixture', samples: Array.from({ length: 20 }, (_, index) => g1Sample(index)) }
+}
+
+function g1Failures() {
+  const base = g1Pass()
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = clone(base)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  add('non-cold-20', dataset => { for (const sample of dataset.samples) sample.cold = false })
+  add('slow-first', dataset => {
+    const sample = dataset.samples[5]
+    sample.allUsableAtMs = 1_600
+    sample.clickToUsableMs = 1_600
+    sample.historyAtMs = 1_600
+    for (const frame of sample.observationFrames) if (frame.atMs >= 1_600) frame.history = true
+  })
+  add('degraded-after-display', dataset => {
+    const sample = dataset.samples[3]
+    sample.degradedWithin10s = true
+    for (const frame of sample.observationFrames) if (frame.atMs >= 6_000) frame.body = false
+  })
+  add('history-not-loaded', dataset => {
+    const sample = dataset.samples[7]
+    sample.historyActuallyLoaded = false
+    sample.olderMessageCount = 0
+    sample.historyAtMs = 0
+  })
+  add('nineteen-cold-samples', dataset => { dataset.samples = dataset.samples.slice(0, 19) })
+  add('retry-overwrite', dataset => {
+    dataset.samples[1].attempt = 2
+    dataset.samples.push(clone(dataset.samples[0]))
+  })
+  add('missing-frame-samples', dataset => { dataset.samples[2].observationFrames = [] })
+  add('doc-load-not-reported', dataset => { delete dataset.samples[9].docLoadMs })
+  return variants
+}
+
+// ---------------------------------------------------------------- G2
+
+function g2Sample(index) {
+  const offsets = frameSeries(6).map(value => Number((value + (index % 3) * 0.02).toFixed(3)))
+  return {
+    id: `g2-page-${index}`,
+    attempt: 1,
+    paneCount: index < 10 ? 2 : 1,
+    anchorKey: `anchor-${index}`,
+    frameOffsets: offsets,
+    anchorMaxFrameOffsetPx: maxAbs(offsets),
+    domSyntheticGestures: 0,
+    editorInstanceStable: true,
+    draftUnchanged: true,
+    draftBefore: 'unsent draft',
+    draftAfter: 'unsent draft',
+    expectedOlderMessagesVisible: true,
+    olderMessageCount: 20 + index,
+  }
+}
+
+function g2Pass() {
+  const wheelOffsets = frameSeries(5)
+  const touch360 = frameSeries(4).map(value => Number((value + 0.12).toFixed(3)))
+  const touch390 = frameSeries(4).map(value => Number((value - 0.1).toFixed(3)))
+  return {
+    gate: 'G2',
+    source: 'self-check fixture',
+    samples: Array.from({ length: 20 }, (_, index) => g2Sample(index)),
+    actions: {
+      desktopWheel: { performed: true, loadedOlder: true, frameOffsets: wheelOffsets, anchorMaxFrameOffsetPx: maxAbs(wheelOffsets) },
+      touch360: { performed: true, width: 360, loadedOlder: true, frameOffsets: touch360, anchorMaxFrameOffsetPx: maxAbs(touch360) },
+      touch390: { performed: true, width: 390, loadedOlder: true, frameOffsets: touch390, anchorMaxFrameOffsetPx: maxAbs(touch390) },
+      returnLatest: { performed: true, reachedHead: true, ms: 850 },
+      liveIncrements: Array.from({ length: 6 }, (_, index) => ({ index, ms: 300 + index * 120, following: index % 2 === 0, pulledBack: false, applied: true })),
+    },
+  }
+}
+
+function g2Failures() {
+  const base = g2Pass()
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = clone(base)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  add('anchor-drift', dataset => {
+    const sample = dataset.samples[4]
+    sample.frameOffsets = [0.2, -0.3, 1.4, 0.1]
+    sample.anchorMaxFrameOffsetPx = 1.4
+  })
+  add('dom-synthetic-gesture', dataset => { dataset.samples[0].domSyntheticGestures = 1 })
+  add('draft-changed', dataset => { dataset.samples[2].draftUnchanged = false })
+  add('pane-mix-not-half', dataset => { for (const sample of dataset.samples) sample.paneCount = 1 })
+  add('missing-touch-390', dataset => { delete dataset.actions.touch390 })
+  add('five-live-increments', dataset => { dataset.actions.liveIncrements = dataset.actions.liveIncrements.slice(0, 5) })
+  add('pull-back-while-reading', dataset => {
+    dataset.actions.liveIncrements[3].following = false
+    dataset.actions.liveIncrements[3].pulledBack = true
+  })
+  add('slow-live-increment', dataset => { dataset.actions.liveIncrements[2].ms = 1_700 })
+  add('nineteen-samples', dataset => { dataset.samples = dataset.samples.slice(0, 19) })
+  return variants
+}
+
+// ---------------------------------------------------------------- G3
+
+function g3Commits() {
+  return Array.from({ length: 100 }, (_, index) => ({
+    index,
+    liveDerivedNodes: 1_200 + (index % 10) * 40,
+    events: 2_000 + (index % 7) * 50,
+    bodyBytes: 5 * 1024 * 1024 + index * 1_000,
+    candidatePeakNodes: 2_200 + (index % 5) * 80,
+  }))
+}
+
+function g3Pass() {
+  const fourPane = [
+    { paneId: 'pane-a', liveDerivedNodes: 1_500 },
+    { paneId: 'pane-b', liveDerivedNodes: 1_450 },
+    { paneId: 'pane-c', liveDerivedNodes: 1_520 },
+    { paneId: 'pane-d', liveDerivedNodes: 1_480 },
+  ]
+  return {
+    gate: 'G3',
+    source: 'self-check fixture',
+    windowBudgetB: 2_000,
+    traversedHistoryNodes: 25_000,
+    commits: g3Commits(),
+    windowMetrics: { domNodes: 4_200, bodyMarkers: 60, jsHeapBytes: 180 * 1024 * 1024, processRssBytes: 900 * 1024 * 1024 },
+    fourPane,
+    fourPaneTotal: fourPane.reduce((sum, pane) => sum + pane.liveDerivedNodes, 0),
+    oversizeNode: { code: 'CAPACITY_EXCEEDED', contentLost: false, nodeCount: 2_200 },
+  }
+}
+
+function g3Failures() {
+  const base = g3Pass()
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = clone(base)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  add('live-nodes-over-b', dataset => { dataset.commits[57].liveDerivedNodes = 2_001 })
+  add('events-over-budget', dataset => { dataset.commits[10].events = 5_001 })
+  add('body-bytes-over-budget', dataset => { dataset.commits[20].bodyBytes = 12 * 1024 * 1024 + 1 })
+  add('peak-over-2b', dataset => { dataset.commits[30].candidatePeakNodes = 4_001 })
+  add('short-traversal', dataset => { dataset.traversedHistoryNodes = 19_999 })
+  add('not-100-commits', dataset => { dataset.commits = dataset.commits.slice(0, 99) })
+  add('dom-over-limit', dataset => { dataset.windowMetrics.domNodes = 15_001 })
+  add('oversize-content-lost', dataset => { dataset.oversizeNode.contentLost = true })
+  add('wrong-window-budget', dataset => { dataset.windowBudgetB = 1_500 })
+  return variants
+}
+
+// ---------------------------------------------------------------- G4
+
+function g4Observation(scenario, volatileIndex) {
+  return {
+    sourceEvents: [
+      { type: 'session.attach', seq: 1, sessionId: `session-${volatileIndex}`, text: 'attached' },
+      { type: 'message.head', seq: 2, messageId: `message-${volatileIndex}`, text: `head for ${scenario}` },
+      { type: 'message.tail', seq: 3, messageId: `tail-${volatileIndex}`, text: `tail for ${scenario}` },
+    ],
+    calls: {
+      counts: { sessionLoad: 1, sourceRead: scenario.includes('page') ? 2 : 1, send: scenario === 'send' ? 1 : 0, approval: scenario === 'approval' ? 1 : 0 },
+      sequence: ['sessionLoad', 'sourceRead', scenario === 'send' ? 'send' : 'idle'],
+    },
+    semanticState: {
+      phase: 'navigation-ready',
+      messageCount: 30,
+      following: scenario !== 'page-older',
+      draft: scenario === 'draft' ? 'kept' : '',
+      paneCount: scenario === 'split-pane' ? 2 : 1,
+      requestId: `request-${volatileIndex}`,
+      timestamp: 1_760_000_000_000 + volatileIndex,
+      revision: volatileIndex,
+    },
+  }
+}
+
+function g4Pass() {
+  const combinations = []
+  for (let mask = 0; mask < 8; mask += 1) {
+    combinations.push({ variant: `ext:${(mask & 4 ? '1' : '0')}${(mask & 2 ? '1' : '0')}${(mask & 1 ? '1' : '0')}`, switches: { historySource: mask & 4 ? 1 : 0, mountedChat: mask & 2 ? 1 : 0, windowCommit: mask & 1 ? 1 : 0 } })
+  }
+  const cases = []
+  let volatileIndex = 0
+  for (const scenario of SCENARIOS) {
+    for (let round = 1; round <= 3; round += 1) {
+      volatileIndex += 1
+      cases.push({ variant: 'original', scenario, round, observation: { ...g4Observation(scenario, volatileIndex), providerRegistrations: 0, newWindows: 0 } })
+      for (const combination of combinations) {
+        volatileIndex += 1
+        const historySource = combination.switches.historySource === 1
+        cases.push({
+          variant: combination.variant,
+          switches: combination.switches,
+          scenario,
+          round,
+          observation: { ...g4Observation(scenario, volatileIndex), providerRegistrations: historySource ? 1 : 0, newWindows: historySource ? 1 : 0 },
+        })
+      }
+    }
+  }
+  return { gate: 'G4', source: 'self-check fixture', cases }
+}
+
+function g4Failures() {
+  const base = g4Pass()
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = clone(base)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  const find = (dataset, variant, scenario, round) => dataset.cases.find(entry => entry.variant === variant && entry.scenario === scenario && entry.round === round)
+  add('extra-send-call', dataset => { find(dataset, 'ext:101', 'send', 2).observation.calls.counts.send = 2 })
+  add('source-event-order', dataset => {
+    const events = find(dataset, 'ext:011', 'page-older', 1).observation.sourceEvents
+    events.reverse()
+  })
+  add('semantic-state-diff', dataset => { find(dataset, 'ext:110', 'open', 3).observation.semanticState.phase = 'body-ready' })
+  add('missing-switch-combination', dataset => { dataset.cases = dataset.cases.filter(entry => entry.variant !== 'ext:111') })
+  add('missing-third-round', dataset => { dataset.cases = dataset.cases.filter(entry => !(entry.variant === 'ext:001' && entry.round === 3)) })
+  add('provider-registration-not-zero', dataset => { dataset.cases.find(entry => entry.variant === 'original' && entry.scenario === 'open' && entry.round === 1).observation.providerRegistrations = 1 })
+  add('new-window-not-zero', dataset => { dataset.cases.find(entry => entry.variant === 'ext:000' && entry.scenario === 'open' && entry.round === 1).observation.newWindows = 1 })
+  return variants
+}
+
+// ---------------------------------------------------------------- G5
+
+function identity() {
+  return {
+    upstreamVersion: '0.2.1-rc.3',
+    upstreamCommit: UPSTREAM_COMMIT,
+    extRelease: '0.2.1-rc.3.ext.1',
+    patchSetSha256: HEX64_A,
+    packageSetSha256: HEX64_B,
+    capabilities: { historySource: 1, mountedChat: 1, windowCommit: 1 },
+    compositionVersion: '1.0.0',
+    protocol: 2,
+  }
+}
+
+function g5Pass() {
+  return {
+    gate: 'G5',
+    source: 'self-check fixture',
+    expectedIdentity: identity(),
+    installRuns: [
+      { run: 1, kind: 'clean', ok: true, exitCode: 0 },
+      { run: 2, kind: 'repeat', ok: true, exitCode: 0, diff: '' },
+      { run: 3, kind: 'repeat', ok: true, exitCode: 0, diff: '' },
+    ],
+    nodes: [
+      { role: 'host', id: 'host-a', matched: true, identity: identity() },
+      { role: 'runner', id: 'runner-1', matched: true, identity: identity() },
+      { role: 'runner', id: 'runner-2', matched: true, identity: identity() },
+    ],
+    tampers: [
+      { field: 'upstreamVersion', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'upstreamCommit', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'extRelease', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'patchSetSha256', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'packageSetSha256', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'capabilities', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'compositionVersion', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+      { field: 'protocol', mode: 'tampered', handshakeDiagnosed: true, businessForwarded: 0 },
+    ],
+    preActivationFailures: [
+      { case: 'missing-ext-package', failedBeforeActivation: true },
+      { case: 'bad-checksum', failedBeforeActivation: true },
+      { case: 'original-mixed-load', failedBeforeActivation: true },
+    ],
+  }
+}
+
+function g5Failures() {
+  const base = g5Pass()
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = clone(base)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  add('repeat-install-diff', dataset => { dataset.installRuns[1].diff = 'M profiles/ext/package.json' })
+  add('install-failed', dataset => { dataset.installRuns[0].ok = false; dataset.installRuns[0].exitCode = 1 })
+  add('missing-runner', dataset => { dataset.nodes = dataset.nodes.slice(0, 2) })
+  add('capability-mismatch', dataset => { dataset.nodes[1].identity.capabilities.mountedChat = 0 })
+  add('tamper-forwarded', dataset => { dataset.tampers.find(entry => entry.field === 'packageSetSha256').businessForwarded = 1 })
+  add('missing-tamper-field', dataset => { dataset.tampers = dataset.tampers.filter(entry => entry.field !== 'protocol') })
+  add('missing-pre-activation-case', dataset => { dataset.preActivationFailures = dataset.preActivationFailures.filter(entry => entry.case !== 'bad-checksum') })
+  add('node-identity-divergence', dataset => { dataset.nodes[2].identity.compositionVersion = '2.0.0' })
+  return variants
+}
+
+// ---------------------------------------------------------------- G6
+
+function g6Step(from, to, round) {
+  return {
+    from,
+    to,
+    activeVersion: to,
+    healthy: true,
+    healthCheckMs: 12_000 + round * 100,
+    releaseManifestMatches: true,
+    oldProcessExitProtected: true,
+    nativeLogsOverwritten: false,
+    queueActions: 0,
+    approvalActions: 0,
+    draftsPreserved: true,
+    readableHistoryPreserved: true,
+    reconnectDraftPreserved: true,
+    oldReleasesRetained: 2,
+  }
+}
+
+function g6Pass() {
+  return {
+    gate: 'G6',
+    source: 'self-check fixture',
+    rounds: [1, 2, 3].map(round => ({ round, steps: [g6Step('e1', 'e2', round), g6Step('e2', 'e1', round)] })),
+    injections: [
+      { point: 'staging', failed: true, activeAfter: 'e1', oldReleaseIntact: true, nativeLogsOverwritten: false },
+      { point: 'switch', failed: true, activeAfter: 'e1', oldReleaseIntact: true, nativeLogsOverwritten: false },
+      { point: 'health-check', failed: true, activeAfter: 'e1', oldReleaseIntact: true, nativeLogsOverwritten: false, rolledBack: true, rollbackWithinMs: 28_000 },
+    ],
+    onlineVersion: { version: 'e1', releaseManifestMatches: true },
+  }
+}
+
+function g6Failures() {
+  const base = g6Pass()
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = clone(base)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  add('two-rounds', dataset => { dataset.rounds = dataset.rounds.slice(0, 2) })
+  add('missing-health-injection', dataset => { dataset.injections = dataset.injections.filter(entry => entry.point !== 'health-check') })
+  add('slow-rollback', dataset => { dataset.injections.find(entry => entry.point === 'health-check').rollbackWithinMs = 31_000 })
+  add('duplicated-queue-action', dataset => { dataset.rounds[1].steps[0].queueActions = 1 })
+  add('only-one-retained-release', dataset => { for (const round of dataset.rounds) for (const step of round.steps) step.oldReleasesRetained = 1 })
+  add('bad-version-sequence', dataset => { dataset.rounds[0].steps[1].to = 'e3'; dataset.rounds[0].steps[1].activeVersion = 'e3' })
+  add('online-version-mismatch', dataset => { dataset.onlineVersion.version = 'e2' })
+  add('injection-left-new-active', dataset => { dataset.injections.find(entry => entry.point === 'switch').activeAfter = 'e2' })
+  add('draft-lost', dataset => { dataset.rounds[2].steps[1].draftsPreserved = false })
+  add('unhealthy-upgrade', dataset => { dataset.rounds[1].steps[0].healthy = false })
+  add('native-log-overwritten', dataset => { dataset.rounds[0].steps[0].nativeLogsOverwritten = true })
+  return variants
+}
diff --git a/ext/scripts/fixtures/emit.mjs b/ext/scripts/fixtures/emit.mjs
