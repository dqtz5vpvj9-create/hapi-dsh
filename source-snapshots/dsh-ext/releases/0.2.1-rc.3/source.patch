+/**
+ * Feature-switch profile matrix skeleton (spec sections 4 and 6, G5 profile).
+ *
+ * All eight combinations of historySource / mountedChat / windowCommit must be
+ * exercised; testing only the all-off profile is not enough. The pure profile
+ * loads no hapi-dsh plugin and registers no provider; every profile uses the
+ * real package built from source and the same synthetic session script as rc.3.
+ *
+ * Dependencies:
+ *   ext/patches/0.2.1-rc.3/0001-history-source.patch
+ *   ext/patches/0.2.1-rc.3/0002-mounted-chat.patch
+ *   ext/patches/0.2.1-rc.3/0003-window-commit.patch
+ *   hapi-dsh bundle installer + `dsh plugin --profile <p> add ...`
+ */
+import { describe, expect, it } from 'vitest'
+
+const CAPABILITIES = ['historySource', 'mountedChat', 'windowCommit'] as const
+
+interface Combination {
+  readonly id: string
+  readonly capabilities: { readonly historySource: 0 | 1; readonly mountedChat: 0 | 1; readonly windowCommit: 0 | 1 }
+}
+
+const COMBINATIONS: readonly Combination[] = (() => {
+  const combinations: Combination[] = []
+  for (let mask = 0; mask < 8; mask += 1) {
+    const capabilities = {
+      historySource: (mask & 4 ? 1 : 0) as 0 | 1,
+      mountedChat: (mask & 2 ? 1 : 0) as 0 | 1,
+      windowCommit: (mask & 1 ? 1 : 0) as 0 | 1,
+    }
+    combinations.push({ id: `${capabilities.historySource}${capabilities.mountedChat}${capabilities.windowCommit}`, capabilities })
+  }
+  return combinations
+})()
+
+const PROFILE_FIXTURE = 'ext/tests/profile/fixtures/synthetic-session-script.json'
+const DEPENDS = 'patches 0001-history-source + 0002-mounted-chat + 0003-window-commit and the ext bundle installer'
+
+describe('feature-switch profile matrix', () => {
+  it('enumerates all eight capability combinations', () => {
+    expect(COMBINATIONS).toHaveLength(8)
+    expect(new Set(COMBINATIONS.map(combination => combination.id)).size).toBe(8)
+    expect(COMBINATIONS.map(combination => combination.id)).toEqual([
+      '000', '001', '010', '011', '100', '101', '110', '111',
+    ])
+  })
+
+  // Depends on 0001-0003 and the bundle installer. Each run boots the installed
+  // profile, replays the synthetic session script, and records provider
+  // registrations, new windows and the semantic transcript for comparison.
+  for (const combination of COMBINATIONS) {
+    it.skip(`profile ${combination.id}: ${CAPABILITIES.map(key => `${key}=${combination.capabilities[key]}`).join(' ')}`, () => {})
+  }
+
+  // Depends on the ext bundle. The pure profile must not load hapi-dsh and must
+  // not register any provider; a half-new chain in a pure profile is a failure.
+  it.skip('pure profile loads no hapi-dsh and registers no provider', () => {})
+
+  it('names the fixture and dependency for the skipped profile runs', () => {
+    expect(PROFILE_FIXTURE.endsWith('synthetic-session-script.json')).toBe(true)
+    expect(DEPENDS).toContain('0003-window-commit')
+  })
+})
