+#!/usr/bin/env node
+/**
+ * Unified acceptance entry point for the ext delivery (spec section 6).
+ *
+ *   node ext/scripts/accept-ext.mjs --help
+ *   node ext/scripts/accept-ext.mjs --gate G4 --self-check
+ *   node ext/scripts/accept-ext.mjs --all --plan
+ *   node ext/scripts/accept-ext.mjs --gate G1 --fixture <recorded-dataset.json>
+ *
+ * Modes:
+ *   live        spawn the configured sampler command (or the existing hapi-dsh
+ *               command where one produces usable evidence), parse its JSON and
+ *               judge it. No sampler -> NOT_EXECUTED -> FAIL.
+ *   fixture     judge a recorded dataset file.
+ *   self-check  judge generated pass/fail fixtures to prove the verdict
+ *               functions (and the runner's failure rules) work.
+ *   plan        print the measurement plan and sampler interface, no judging.
+ *
+ * One attempt per gate. A timeout, a nonzero exit, an unreadable payload, a
+ * missing sample or a reused sample id all end in FAIL. There is no retry path
+ * that could replace a failed sample.
+ */
+import { existsSync, readFileSync } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import { randomBytes } from 'node:crypto'
+import { dirname, resolve } from 'node:path'
+import { USAGE, UsageError, gateHelp, parseArgs } from './lib/args.mjs'
+import { loadConfig, samplerLabel } from './lib/config.mjs'
+import { GATES, gateById } from './gates/index.mjs'
+import { buildArtifact, defaultArtifactPath, formatSummary, writeJsonFile, writeLogFile } from './lib/artifact.mjs'
+import { judgeDataset } from './lib/verdict.mjs'
+import { runCommand } from './lib/exec.mjs'
+import { datasetFromRun } from './adapters/hapi-dsh.mjs'
+import { buildFailFixtures, buildPassFixture } from './fixtures/build.mjs'
+
+const RUNNER_RULES = [
+  { name: 'not-executed', run: { notExecuted: true, reason: 'synthetic self-check' } },
+  { name: 'sampler-timeout', run: { timedOut: true, reason: 'synthetic self-check' } },
+  { name: 'sampler-nonzero-exit', run: { exitCode: 1, reason: 'synthetic self-check' } },
+  { name: 'sampler-bad-payload', run: { badPayload: true, reason: 'synthetic self-check' } },
+]
+
+function formatNow() {
+  return new Date().toISOString()
+}
+
+function datasetUnitCount(dataset) {
+  if (!dataset || typeof dataset !== 'object') return 0
+  for (const key of ['samples', 'cases', 'commits', 'installRuns', 'rounds']) {
+    if (Array.isArray(dataset[key])) return dataset[key].length
+  }
+  return 0
+}
+
+function environmentInfo(config) {
+  let extVersion = null
+  const packageFile = resolve(config.repoRoot, 'package.json')
+  if (existsSync(packageFile)) {
+    try {
+      extVersion = JSON.parse(readFileSync(packageFile, 'utf8')).version ?? null
+    } catch {
+      extVersion = null
+    }
+  }
+  return {
+    node: process.version,
+    platform: process.platform,
+    arch: process.arch,
+    cwd: process.cwd(),
+    extRoot: config.extRoot,
+    hapiDshRoot: config.hapiDshRoot,
+    hapiDshRootExists: existsSync(config.hapiDshRoot),
+    testRoot: config.testRoot,
+    dshExtVersion: extVersion,
+    rc: config.rc,
+  }
+}
+
+function planForGate(gate, config) {
+  const sampler = config.samplers[gate.metadata.id]
+  return {
+    gate: gate.metadata.id,
+    title: gate.metadata.title,
+    sampleRequirement: gate.metadata.sampleRequirement,
+    inputSchema: gate.metadata.schemaPath,
+    thresholds: gate.metadata.thresholds,
+    sampler: sampler
+      ? { configured: true, ...samplerLabel(sampler) }
+      : { configured: false, configureWith: gate.metadata.commands.samplerEnv, existingDefault: gate.metadata.commands.existingDefault },
+    samplerContract: {
+      stdout: 'one JSON object matching inputSchema, or the path of a JSON file printed as the last stdout line',
+      gateField: gate.metadata.id,
+      attemptRule: 'every sample id must be unique and attempt must be 1; the runner never retries',
+      frameRule: gate.metadata.id === 'G1' || gate.metadata.id === 'G2' ? 'per-frame anchor/observation samples are required and written to the artifact' : 'not applicable for this gate',
+    },
+    relatedExistingCommand: gate.metadata.commands.existingDefault,
+  }
+}
+
+function planArtifact(config, gateIds) {
+  return {
+    schema: 'accept-ext-plan/1',
+    generatedAt: formatNow(),
+    rc: config.rc,
+    hapiDshRoot: config.hapiDshRoot,
+    testRoot: config.testRoot,
+    samplerEnvironment: config.samplerEnv,
+    gates: gateIds.map(id => planForGate(gateById(id), config)),
+  }
+}
+
+async function writePlan(config, gateIds) {
+  const plan = planArtifact(config, gateIds)
+  const stamp = formatNow().replace(/[:.]/g, '-')
+  const path = resolve(config.releasesRoot, config.rc.replace(/[^A-Za-z0-9._+-]/g, '_'), `plan-${stamp}.json`)
+  await writeJsonFile(path, plan)
+  return { plan, path }
+}
+
+function check(name, expected, judgement) {
+  const actual = judgement.verdict
+  return { name, expected, actual, ok: actual === expected, failures: (judgement.failures ?? []).map(failure => ({ code: failure.code, message: failure.message })) }
+}
+
+function commonDatasetFailures(gateId) {
+  const pass = buildPassFixture(gateId).dataset
+  if (!Array.isArray(pass.samples)) return []
+  const variants = []
+  const add = (name, mutate) => {
+    const dataset = structuredClone(pass)
+    mutate(dataset)
+    variants.push({ name, dataset })
+  }
+  add('duplicate-sample-id', dataset => { dataset.samples[1].id = dataset.samples[0].id })
+  add('sample-attempt-two', dataset => { dataset.samples[0].attempt = 2 })
+  add('missing-one-sample', dataset => { dataset.samples = dataset.samples.slice(0, -1) })
+  add('gate-mismatch', dataset => { dataset.gate = 'G9' })
+  return variants
+}
+
+function runSelfCheck(gate, config) {
+  const startedAt = formatNow()
+  const startedAtMs = Date.now()
+  const checks = []
+  const passFixture = buildPassFixture(gate.metadata.id)
+  const passJudged = judgeDataset(gate, passFixture.dataset)
+  checks.push(check('pass-fixture', 'PASS', passJudged))
+  for (const fixture of buildFailFixtures(gate.metadata.id)) {
+    checks.push(check(`fail-fixture:${fixture.name}`, 'FAIL', judgeDataset(gate, fixture.dataset)))
+  }
+  for (const mutation of commonDatasetFailures(gate.metadata.id)) {
+    checks.push(check(`guard:${mutation.name}`, 'FAIL', judgeDataset(gate, mutation.dataset)))
+  }
+  for (const rule of RUNNER_RULES) {
+    checks.push(check(`runner:${rule.name}`, 'FAIL', judgeDataset(gate, passFixture.dataset, rule.run)))
+  }
+  checks.push(check('runner:dataset-missing', 'FAIL', judgeDataset(gate, null)))
+  const failures = checks.filter(entry => !entry.ok).map(entry => ({
+    code: 'SELF_CHECK_FAILED',
+    message: `${entry.name}: expected ${entry.expected}, got ${entry.actual}`,
+    detail: entry.failures,
+  }))
+  return {
+    gate: gate.metadata.id,
+    title: gate.metadata.title,
+    verdict: failures.length ? 'SELF-CHECK-FAIL' : 'SELF-CHECK-PASS',
+    expectedSamples: gate.metadata.expectedSamples ?? null,
+    sampleCount: datasetUnitCount(passFixture.dataset),
+    failures,
+    checks,
+    metrics: { passFixtureMetrics: passJudged.metrics },
+    frameSamples: passJudged.frameSamples,
+    raw: { passFixture: passFixture.dataset, failFixtureNames: buildFailFixtures(gate.metadata.id).map(fixture => fixture.name) },
+    timing: { startedAt, durationMs: Date.now() - startedAtMs },
+  }
+}
+
+async function runFixture(gate, path) {
+  const startedAt = formatNow()
+  const startedAtMs = Date.now()
+  let dataset
+  try {
+    dataset = JSON.parse(await readFile(path, 'utf8'))
+  } catch (error) {
+    return {
+      gate: gate.metadata.id,
+      title: gate.metadata.title,
+      verdict: 'FAIL',
+      expectedSamples: gate.metadata.expectedSamples ?? null,
+      sampleCount: 0,
+      failures: [{ code: 'FIXTURE_UNREADABLE', message: `Could not read fixture ${path}: ${error instanceof Error ? error.message : String(error)}` }],
+      checks: [],
+      metrics: {},
+      frameSamples: [],
+      raw: { fixturePath: path },
+      timing: { startedAt, durationMs: Date.now() - startedAtMs },
+    }
+  }
+  const judged = judgeDataset(gate, dataset)
+  return {
+    gate: gate.metadata.id,
+    title: gate.metadata.title,
+    ...judged,
+    expectedSamples: gate.metadata.expectedSamples ?? null,
+    sampleCount: datasetUnitCount(dataset),
+    raw: { fixturePath: path, dataset },
+    timing: { startedAt, durationMs: Date.now() - startedAtMs },
+  }
+}
+
+async function runLive(gate, config, artifactPath) {
+  const startedAt = formatNow()
+  const startedAtMs = Date.now()
+  const sampler = config.samplers[gate.metadata.id]
+  const base = { gate: gate.metadata.id, title: gate.metadata.title, expectedSamples: gate.metadata.expectedSamples ?? null, timing: { startedAt } }
+  if (!sampler) {
+    const judged = judgeDataset(gate, null, {
+      notExecuted: true,
+      reason: `No sampler configured. Set ${gate.metadata.commands.samplerEnv} or use --fixture / --plan.`,
+    })
+    return { ...base, ...judged, sampleCount: 0, raw: { notExecuted: true }, timing: { startedAt, durationMs: Date.now() - startedAtMs } }
+  }
+  process.stderr.write(`[accept-ext] ${gate.metadata.id} sampling: ${[sampler.cmd, ...sampler.args].join(' ')} (${sampler.adapter ?? 'json'})\n`)
+  const run = await runCommand({ cmd: sampler.cmd, args: sampler.args, cwd: sampler.cwd, timeoutMs: config.timeoutMs, env: { HAPI_DSH_TEST_ROOT: config.testRoot, HAPI_DSH_EXT_RC: config.rc } })
+  const artifactDir = dirname(artifactPath)
+  const runId = `${gate.metadata.id}-${formatNow().replace(/[:.]/g, '-')}`
+  const logFiles = {}
+  if (run.stdout.trim()) logFiles.stdout = await writeLogFile(resolve(artifactDir, `${runId}-stdout.log`), run.stdout)
+  if (run.stderr.trim()) logFiles.stderr = await writeLogFile(resolve(artifactDir, `${runId}-stderr.log`), run.stderr)
+  let dataset = null
+  let badPayload = false
+  let reason
+  if (run.timedOut) {
+    reason = `Sampler exceeded ${config.timeoutMs}ms`
+  } else if (run.spawnError) {
+    badPayload = true
+    reason = run.spawnError
+  } else {
+    try {
+      const parsed = await datasetFromRun(sampler.adapter, gate.metadata.id, run, config)
+      dataset = parsed.dataset
+    } catch (error) {
+      badPayload = true
+      reason = error instanceof Error ? error.message : String(error)
+    }
+  }
+  const judged = judgeDataset(gate, dataset, {
+    timedOut: run.timedOut,
+    exitCode: run.timedOut || run.spawnError ? undefined : run.exitCode,
+    badPayload,
+    reason,
+    command: samplerLabel(sampler),
+    logFiles,
+    durationMs: run.durationMs,
+  })
+  return {
+    ...base,
+    ...judged,
+    sampleCount: datasetUnitCount(dataset),
+    raw: {
+      command: samplerLabel(sampler),
+      exitCode: run.exitCode,
+      timedOut: run.timedOut,
+      durationMs: run.durationMs,
+      stdoutTruncated: run.stdoutTruncated,
+      stderrTruncated: run.stderrTruncated,
+      logFiles,
+      dataset,
+    },
+    timing: { startedAt, durationMs: Date.now() - startedAtMs },
+  }
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2))
+  if (options.help) {
+    process.stdout.write(`${USAGE}\n${gateHelp(GATES)}\n`)
+    return 0
+  }
+  if (!options.gates.length) throw new UsageError('Select at least one gate with --gate or --all (try --help)')
+  if (options.plan && options.selfCheck) throw new UsageError('Use either --plan or --self-check, not both')
+  if (options.selfCheck && (options.fixture !== undefined || options.results !== undefined)) {
+    throw new UsageError('Use either --self-check or --fixture, not both')
+  }
+  const config = loadConfig(options)
+  const startedAt = formatNow()
+  const runId = `${startedAt.replace(/[:.]/g, '-')}-${randomBytes(3).toString('hex')}`
+  const environment = environmentInfo(config)
+
+  if (options.plan) {
+    const { plan, path } = await writePlan(config, options.gates)
+    process.stdout.write(`${JSON.stringify(plan, null, 2)}\n`)
+    process.stderr.write(`[accept-ext] plan written to ${path}\n`)
+    return 0
+  }
+
+  const artifactPath = options.out ? resolve(options.out) : defaultArtifactPath(config)
+  const gateResults = []
+  if (options.selfCheck) {
+    if (!options.quiet) process.stderr.write('[accept-ext] self-check: judging synthetic pass/fail fixtures\n')
+    for (const id of options.gates) {
+      const result = runSelfCheck(gateById(id), config)
+      gateResults.push(result)
+      if (!options.quiet) process.stderr.write(`[accept-ext] ${id}: ${result.verdict} (${result.checks.filter(entry => entry.ok).length}/${result.checks.length} checks)\n`)
+    }
+  } else if (options.fixture !== undefined || options.results !== undefined) {
+    const path = options.fixture ?? options.results
+    const gate = gateById(options.gates[0])
+    const result = await runFixture(gate, path)
+    gateResults.push(result)
+    if (!options.quiet) process.stderr.write(`[accept-ext] ${gate.metadata.id}: ${result.verdict} from fixture ${path}\n`)
+  } else {
+    for (const id of options.gates) {
+      if (!options.quiet) process.stderr.write(`[accept-ext] ${id}: starting (serial, single attempt)\n`)
+      const result = await runLive(gateById(id), config, artifactPath)
+      gateResults.push(result)
+      if (!options.quiet) process.stderr.write(`[accept-ext] ${id}: ${result.verdict} (samples=${result.sampleCount})\n`)
+    }
+  }
+
+  const artifact = buildArtifact({
+    mode: options.selfCheck ? 'self-check' : options.fixture !== undefined || options.results !== undefined ? 'fixture' : 'live',
+    config,
+    startedAt,
+    finishedAt: formatNow(),
+    gateResults,
+    environment,
+    runId,
+  })
+  await writeJsonFile(artifactPath, artifact)
+  if (options.json) {
+    process.stdout.write(`${JSON.stringify({
+      schema: artifact.schema,
+      runId,
+      mode: artifact.mode,
+      rc: artifact.rc,
+      verdict: artifact.summary.verdict,
+      summary: artifact.summary,
+      artifactPath,
+      gates: artifact.gates.map(gate => ({ gate: gate.gate, verdict: gate.verdict, failures: (gate.failures ?? []).length })),
+    }, null, 2)}\n`)
+  } else {
+    process.stdout.write(`${formatSummary(artifact)}\nartifact: ${artifactPath}\n`)
+  }
+  return artifact.summary.verdict === 'PASS' || artifact.summary.verdict === 'SELF-CHECK-PASS' ? 0 : 1
+}
+
+main()
+  .then(code => {
+    process.exitCode = code
+  })
+  .catch(error => {
+    if (error instanceof UsageError) {
+      process.stderr.write(`accept-ext: ${error.message}\n\n${USAGE}\n`)
+      process.exitCode = 2
+      return
+    }
+    process.stderr.write(`accept-ext: ${error instanceof Error ? error.stack ?? error.message : String(error)}\n`)
+    process.exitCode = 1
+  })
diff --git a/ext/scripts/adapters/hapi-dsh.mjs b/ext/scripts/adapters/hapi-dsh.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d8244a47e04a8275bc651cdf833885bfdb7405e2
--- /dev/null
+++ b/ext/scripts/adapters/hapi-dsh.mjs
@@ -0,0 +1,179 @@
+/**
+ * Adapters from existing hapi-dsh artifacts to the ext gate dataset schema.
+ *
+ * These adapters are PARTIAL by construction. hapi-dsh currently has a warm
+ * synthetic UI acceptance command and a legacy clean-tarball smoke, neither of
+ * which produces the spec's 20-sample batching matrices or the Host+2 Runner
+ * identity matrix. The adapter records exactly what it could map and marks the
+ * dataset partial; the gate judge then fails on the missing samples/fields. It
+ * cannot manufacture a PASS from partial evidence.
+ */
+import { existsSync } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import { isAbsolute, join, resolve } from 'node:path'
+
+/**
+ * Accepts full-stdout JSON, a JSON object on the last stdout line, or a path to
+ * a JSON file printed as the last line (hapi-dsh probes print the report path).
+ * @param {string} stdout
+ * @param {string} [cwd]
+ */
+export async function parseJsonPayload(stdout, cwd) {
+  const text = stdout.trim()
+  if (!text) return null
+  try {
+    const parsed = JSON.parse(text)
+    if (parsed && typeof parsed === 'object') return parsed
+  } catch {
+    // Fall through to line scanning; samplers may print progress lines first.
+  }
+  const lines = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean).reverse()
+  for (const line of lines) {
+    if (!line.startsWith('{') && !line.startsWith('[')) continue
+    try {
+      const parsed = JSON.parse(line)
+      if (parsed && typeof parsed === 'object') return parsed
+    } catch {
+      // Not a JSON line.
+    }
+  }
+  const last = lines[0]
+  if (last && !last.startsWith('{')) {
+    const candidate = isAbsolute(last) ? last : resolve(cwd ?? process.cwd(), last)
+    if (existsSync(candidate)) return JSON.parse(await readFile(candidate, 'utf8'))
+  }
+  return null
+}
+
+const MISSING_UI_EVIDENCE = [
+  'no 20x cold-open production matrix (real 236-turn target, cleared display cache per run)',
+  'no per-open proof that older history was actually scrolled while the editor stayed usable for 10 s',
+]
+
+/**
+ * @param {Record<string, unknown>} report
+ * @param {'G1'|'G2'} gateId
+ */
+export function fromUiAcceptance(report, gateId) {
+  const openingSamples = Array.isArray(report.openingSamples) ? report.openingSamples : []
+  const scrollSamples = Array.isArray(report.scrollSamples) ? report.scrollSamples : []
+  const base = {
+    gate: gateId,
+    partial: true,
+    source: 'hapi-dsh/e2e/ui-cli.ts (warm official DSH runtime with synthetic HAPI wire)',
+    sourceEnvironment: report.environment ?? null,
+    notes: [...MISSING_UI_EVIDENCE],
+  }
+  if (gateId === 'G1') {
+    const samples = openingSamples.map((sample, index) => {
+      const bodyMs = typeof sample?.bodyMs === 'number' ? sample.bodyMs : null
+      const composerMs = typeof sample?.composerMs === 'number' ? sample.composerMs : null
+      const usable = bodyMs !== null && composerMs !== null ? Math.max(bodyMs, composerMs) : null
+      return {
+        id: `ui-acceptance-open-${index}`,
+        attempt: 1,
+        // The acceptance command does not clear the display cache per opening,
+        // so these open samples are warm and must not be counted as the 20 cold opens.
+        cold: false,
+        appLoadedAtMs: null,
+        clickAtMs: null,
+        bodyAtMs: bodyMs,
+        editorAtMs: composerMs,
+        historyAtMs: null,
+        allUsableAtMs: usable,
+        clickToUsableMs: usable,
+        historyActuallyLoaded: null,
+        olderMessageCount: null,
+        degradedWithin10s: null,
+        observationFrames: [],
+        docLoadMs: null,
+        sourceSample: sample,
+      }
+    })
+    return { ...base, samples }
+  }
+  const samples = scrollSamples.map((sample, index) => {
+    const offsets = Array.isArray(sample?.anchorOffsets) ? sample.anchorOffsets : []
+    const maxAbs = offsets.reduce((max, value) => (typeof value === 'number' ? Math.max(max, Math.abs(value)) : max), 0)
+    return {
+      id: `ui-acceptance-scroll-${index}`,
+      attempt: 1,
+      paneCount: 1,
+      anchorKey: null,
+      frameOffsets: offsets,
+      anchorMaxFrameOffsetPx: offsets.length ? maxAbs : null,
+      domSyntheticGestures: null,
+      editorInstanceStable: null,
+      draftUnchanged: null,
+      expectedOlderMessagesVisible: null,
+      olderMessageCount: null,
+      sourceSample: sample,
+    }
+  })
+  const actions = {}
+  if (scrollSamples.length) {
+    const offsets = Array.isArray(scrollSamples[0]?.anchorOffsets) ? scrollSamples[0].anchorOffsets : []
+    actions.desktopWheel = {
+      performed: true,
+      loadedOlder: null,
+      frameOffsets: offsets,
+      anchorMaxFrameOffsetPx: offsets.reduce((max, value) => (typeof value === 'number' ? Math.max(max, Math.abs(value)) : max), 0),
+    }
+  }
+  return { ...base, samples, actions }
+}
+
+/**
+ * @param {{exitCode: number|null, timedOut: boolean, stderr: string}} run
+ */
+export function fromDistributionSmoke(run) {
+  return {
+    gate: 'G5',
+    partial: true,
+    source: 'hapi-dsh/scripts/distribution-smoke.mjs (legacy clean-tarball npm install smoke)',
+    notes: [
+      'no ext bundle payload/installer',
+      'no repeat install twice with empty diff proof',
+      'no Host + 2 Runner RuntimeIdentityV1 match matrix',
+      'no handshake-field tamper matrix with business-forward counts',
+    ],
+    installRuns: [{ run: 1, kind: 'clean', ok: run.exitCode === 0 && !run.timedOut, exitCode: run.exitCode, timedOut: run.timedOut, stderrTail: String(run.stderr).slice(-2000) }],
+    nodes: [],
+    tampers: [],
+    preActivationFailures: [],
+  }
+}
+
+/**
+ * @param {string|undefined} adapter
+ * @param {string} gateId
+ * @param {{stdout:string, stderr:string, exitCode:number|null, timedOut:boolean, cwd?:string}} run
+ * @param {{testRoot:string, hapiDshRoot:string}} config
+ * @returns {Promise<{dataset: unknown, note?: string}>}
+ */
+export async function datasetFromRun(adapter, gateId, run, config) {
+  if (adapter === 'ui-acceptance') {
+    if (gateId !== 'G1' && gateId !== 'G2') throw new Error(`adapter ui-acceptance cannot feed ${gateId}`)
+    const summary = await parseJsonPayload(run.stdout, run.cwd ?? config.hapiDshRoot)
+    let report = summary
+    if (summary && typeof summary.reportPath === 'string') report = JSON.parse(await readFile(summary.reportPath, 'utf8'))
+    if (!report || typeof report !== 'object') throw new Error('ui-acceptance command did not print a report or reportPath')
+    return { dataset: fromUiAcceptance(report, gateId), note: 'partial warm-synthetic acceptance evidence' }
+  }
+  if (adapter === 'distribution-smoke') {
+    if (gateId !== 'G5') throw new Error(`adapter distribution-smoke cannot feed ${gateId}`)
+    return { dataset: fromDistributionSmoke(run), note: 'partial legacy clean-install evidence' }
+  }
+  const payload = await parseJsonPayload(run.stdout, run.cwd ?? config.hapiDshRoot)
+  if (!payload) throw new Error('sampler stdout did not contain a JSON dataset')
+  return { dataset: payload, note: undefined }
+}
+
+/** The newest ui-acceptance report under the test root, for --results convenience. */
+export async function newestUiAcceptanceReport(testRoot) {
+  const { readdir } = await import('node:fs/promises')
+  const entries = await readdir(testRoot).catch(() => [])
+  const reports = entries.filter(name => /^hapi-ui-acceptance-.*\.json$/.test(name)).sort()
+  if (!reports.length) return null
+  return join(testRoot, reports[reports.length - 1])
+}
