+/** Bracket virtual DOM mutations so the viewport can preserve its own reading seat. */
+class VirtualLayoutCommit extends Component<{ before: () => void; after: () => void; children: ReactNode }> {
+  override getSnapshotBeforeUpdate(): null { this.props.before(); return null }
+  override componentDidUpdate(): void { this.props.after() }
+  override render(): ReactNode { return this.props.children }
+}
+
+/** Publish viewport-owned scroll landings before the browser's scroll event arrives. */
+function createProgrammaticScrollObserver() {
+  let activeInstance: Parameters<OffsetObserver>[0] | null = null
+  let activeRect: object | null = null
+  let publishLanding: ((offset: number) => void) | null = null
+  const observeOffset: OffsetObserver = (instance, callback) => {
+    let latestOffset: number | undefined
+    const publish = (offset: number, scrolling: boolean) => {
+      latestOffset = offset
+      callback(offset, scrolling)
+    }
+    const landing = (offset: number) => {
+      if (offset !== latestOffset) publish(offset, false)
+    }
+    activeInstance = instance
+    publishLanding = landing
+    const cleanup = observeElementOffset(instance, publish)
+    return () => {
+      if (publishLanding === landing) { publishLanding = null; activeInstance = null }
+      cleanup?.()
+    }
+  }
+  const observeRect: RectObserver = (instance, callback) => {
+    const token = {}
+    activeRect = token
+    let visible: boolean | undefined
+    const cleanup = observeElementRect(instance, rect => {
+      if (activeRect !== token) return
+      const nextVisible = rect.width > 0 && rect.height > 0
+      if (visible === false && nextVisible && activeInstance === instance && instance.scrollElement) {
+        publishLanding?.(instance.scrollElement.scrollTop)
+      }
+      visible = nextVisible
+      callback(rect)
+    })
+    return () => {
+      if (activeRect === token) activeRect = null
+      cleanup?.()
+    }
+  }
+  return {
+    observeOffset,
+    observeRect,
+    observeLanding: (offset: number) => publishLanding?.(offset),
+  }
