+  "description": "Release manifest for one ext build. It records the real upstream version and full commit, the patch-set and package-set digests, the three capability flags, the composition version and wire protocol. Old releases are immutable: a new build gets a new extRelease and a new directory, never an overwritten manifest.",
+  "type": "object",
+  "required": [
+    "extRelease", "upstreamVersion", "upstreamCommit", "patchSetSha256", "packageSetSha256",
+    "capabilities", "compositionVersion", "protocol"
