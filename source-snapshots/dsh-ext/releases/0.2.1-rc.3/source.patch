+/**
+ * Contract-test skeleton for patch 0001-history-source.
+ *
+ * The six contract names are fixed by the L2 spec (section 4). Behavioural
+ * tests are skipped until the patch exists; each skipped test names the patch it
+ * depends on. Do not rename a test to make a missing capability disappear.
+ * Dependency: ext/patches/0.2.1-rc.3/0001-history-source.patch
+ */
+import { describe, expect, it } from 'vitest'
+
+const CONTRACTS = [
+  'default-provider-unchanged',
+  'provider-conflict',
+  'snapshot-tail-no-gap',
+  'two-views-independent',
+  'replace-releases-nodes',
+  'release-keeps-execution',
+] as const
+
+const PATCH = 'ext/patches/0.2.1-rc.3/0001-history-source.patch'
+
+describe('0001-history-source contract', () => {
+  it('keeps the six spec contract names', () => {
+    expect(CONTRACTS).toHaveLength(6)
+  })
+
+  // Depends on 0001: historyExtension() is the optional public accessor; with no
+  // provider registered the original SessionEventStream path is used unchanged.
+  it.skip('default-provider-unchanged', () => {})
+
+  // Depends on 0001: two matching providers reject with PROVIDER_CONFLICT before
+  // any real history read starts; no default-then-swap read is allowed.
+  it.skip('provider-conflict', () => {})
+
+  // Depends on 0001: snapshots and deltas join on SourceVersion from
+  // initial.version, so "read then subscribe" loses no message at the tail.
+  it.skip('snapshot-tail-no-gap', () => {})
+
+  // Depends on 0001: two reading views on the same Session generation get
+  // independent windows and cannot force one bounded contiguous window.
+  it.skip('two-views-independent', () => {})
+
+  // Depends on 0001: replacing a window releases the previous assembler context
+  // and its derived nodes; no arbitrary incremental node withdrawal is opened.
+  it.skip('replace-releases-nodes', () => {})
+
+  // Depends on 0001: releasing a reading window must not release the Session
+  // execution identity (no native cancel on pane close).
+  it.skip('release-keeps-execution', () => {})
+
+  it('records the patch dependency for every skipped contract', () => {
+    expect(PATCH.endsWith('0001-history-source.patch')).toBe(true)
+  })
+})
