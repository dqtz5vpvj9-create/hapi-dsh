@@ -0,0 +1,131 @@
+/**
+ * G6 — Upgrade and rollback (spec section 6).
+ *
+ * Three e1→e2→e1 rounds on the same rc, plus injected failures at staging,
+ * switch (activating) and health check. Each failure keeps the old release
+ * active; health-check failure rolls back within 30 s. Native logs are not
+ * overwritten by rollback, queue/approval actions are not duplicated, drafts and
+ * readable history survive reconnect, and the online version matches the
+ * release manifest. At least two old releases are retained.
+ */
+import { commonViolations, isFiniteNumber } from '../lib/samples.mjs'
+import { missingSampleFailure } from '../lib/verdict.mjs'
+
+const ROUNDS = 3
+const INJECTION_POINTS = ['staging', 'switch', 'health-check']
+const HEALTH_CHECK_MS = 30_000
+const MIN_RETAINED_RELEASES = 2
+
+export const metadata = {
+  id: 'G6',
+  title: '升级回滚',
+  expectedSamples: 3,
+  sampleRequirement: 'e1→e2→e1 × 3 rounds; injected failures at staging, switch and health check (health rollback ≤30 s); old release active on failure, native logs preserved, no duplicated queue/approval actions, drafts/readable history survive, online version equals manifest, ≥2 old releases retained',
+  schemaPath: 'ext/scripts/fixtures/schema/g6.schema.json',
+  thresholds: { rounds: ROUNDS, injectionPoints: INJECTION_POINTS.length, healthRollbackMs: HEALTH_CHECK_MS, retainedReleases: MIN_RETAINED_RELEASES },
+  commands: {
+    samplerEnv: 'HAPI_DSH_EXT_G6_CMD',
+    existingDefault: 'none; upgrade/rollback harness is owned by the bundle/doctor work',
+  },
+}
+
+function judgeStep(roundNumber, stepIndex, step, fail) {
+  const label = `round ${roundNumber} step ${stepIndex}`
+  if (typeof step.from !== 'string' || typeof step.to !== 'string' || step.from === step.to) {
+    fail('BAD_UPGRADE_STEP', `G6 ${label}: from/to must be distinct version ids, got ${JSON.stringify({ from: step.from, to: step.to })}`)
+  }
+  if (step.activeVersion !== step.to) fail('MANIFEST_MISMATCH', `G6 ${label}: active version ${JSON.stringify(step.activeVersion)} does not match target ${JSON.stringify(step.to)}`)
+  if (!isFiniteNumber(step.healthCheckMs) || step.healthCheckMs > HEALTH_CHECK_MS) {
+    fail('HEALTH_CHECK', `G6 ${label}: health check ${JSON.stringify(step.healthCheckMs)}ms must be ≤${HEALTH_CHECK_MS}ms or rollback`)
+  }
+  if (step.healthy !== true) fail('HEALTH_CHECK_FAILED', `G6 ${label}: upgraded release was not healthy`)
+  if (step.releaseManifestMatches !== true) fail('MANIFEST_MISMATCH', `G6 ${label}: online version does not match the release manifest`)
+  if (step.oldProcessExitProtected !== true) fail('PROCESS_EXIT', `G6 ${label}: old/new process exits were not protected`)
+  if (step.nativeLogsOverwritten !== false) fail('NATIVE_LOG_OVERWRITE', `G6 ${label}: rollback/upgrade overwrote native logs`)
+  if (step.queueActions !== 0) fail('DUPLICATE_ACTION', `G6 ${label}: queue replayed ${JSON.stringify(step.queueActions)} actions`)
+  if (step.approvalActions !== 0) fail('DUPLICATE_ACTION', `G6 ${label}: approval replayed ${JSON.stringify(step.approvalActions)} actions`)
+  if (step.draftsPreserved !== true) fail('DRAFT_LOST', `G6 ${label}: drafts were not preserved`)
+  if (step.readableHistoryPreserved !== true) fail('HISTORY_LOST', `G6 ${label}: readable history was not preserved`)
+  if (step.reconnectDraftPreserved !== true) fail('DRAFT_LOST', `G6 ${label}: draft did not survive reconnect`)
+  if (!isFiniteNumber(step.oldReleasesRetained) || step.oldReleasesRetained < MIN_RETAINED_RELEASES) {
+    fail('RETAINED_RELEASES', `G6 ${label}: ${JSON.stringify(step.oldReleasesRetained)} old releases retained, need at least ${MIN_RETAINED_RELEASES}`)
+  }
+}
+
+export function judge(dataset) {
+  /** @type {{ code: string, message: string }[]} */
+  const failures = []
+  /** @type {{ name: string, passed: boolean, detail?: unknown }[]} */
+  const checks = []
+  const fail = (code, message, extra = {}) => failures.push({ code, message, ...extra })
+  if (!dataset || typeof dataset !== 'object') {
+    failures.push({ code: 'DATASET_MISSING', message: 'G6 dataset is missing or not an object' })
+    return { gate: 'G6', verdict: 'FAIL', failures, checks, metrics: {}, frameSamples: [] }
+  }
+  for (const failure of commonViolations(dataset, 'G6')) failures.push(failure)
+
+  const rounds = Array.isArray(dataset.rounds) ? dataset.rounds.filter(entry => entry && typeof entry === 'object') : []
+  if (rounds.length !== ROUNDS) failures.push(missingSampleFailure('G6', ROUNDS, rounds.length, { unit: 'e1→e2→e1 rounds' }))
+  let lastActiveVersion = null
+  for (const [index, round] of rounds.entries()) {
+    if (round.round !== index + 1) fail('ROUND_ORDER', `G6 round ${index} reports round ${JSON.stringify(round.round)}; rounds must be 1..${ROUNDS}`)
+    const steps = Array.isArray(round.steps) ? round.steps.filter(step => step && typeof step === 'object') : []
+    if (steps.length < 2) {
+      fail('BAD_ROUND', `G6 round ${index + 1}: expected e1→e2→e1, got ${steps.length} steps`)
+      continue
+    }
+    if (steps[0].from !== 'e1') fail('BAD_ROUND', `G6 round ${index + 1}: first step must start from e1, got ${JSON.stringify(steps[0].from)}`)
+    for (const [stepIndex, step] of steps.entries()) {
+      judgeStep(index + 1, stepIndex, step, fail)
+      if (stepIndex > 0 && steps[stepIndex - 1].to !== step.from) {
+        fail('BAD_ROUND', `G6 round ${index + 1}: step ${stepIndex} starts from ${JSON.stringify(step.from)} but previous step ended at ${JSON.stringify(steps[stepIndex - 1].to)}`)
+      }
+    }
+    const versions = [steps[0].from, ...steps.map(step => step.to)]
+    const expected = ['e1', 'e2', 'e1']
+    if (versions.length < 3 || versions[0] !== expected[0] || versions[1] !== expected[1] || versions.at(-1) !== expected[2]) {
+      fail('BAD_ROUND', `G6 round ${index + 1}: version sequence ${JSON.stringify(versions)} is not e1→e2→e1`)
+    }
+    lastActiveVersion = steps.at(-1)?.activeVersion ?? null
+  }
+
+  const injections = Array.isArray(dataset.injections) ? dataset.injections.filter(entry => entry && typeof entry === 'object') : []
+  const injectedPoints = new Set(injections.map(entry => entry.point))
+  for (const point of INJECTION_POINTS) {
+    if (!injectedPoints.has(point)) fail('INJECTION_MISSING', `G6 has no injected failure for ${point}`)
+  }
+  for (const injection of injections) {
+    if (injection.failed !== true) fail('INJECTION_NOT_FAILED', `G6 ${String(injection.point)} failure injection did not fail`)
+    if (injection.activeAfter !== 'e1') fail('OLD_RELEASE_NOT_ACTIVE', `G6 ${String(injection.point)} failure left active version ${JSON.stringify(injection.activeAfter)}, expected e1`)
+    if (injection.oldReleaseIntact !== true) fail('OLD_RELEASE_DAMAGED', `G6 ${String(injection.point)} failure damaged the old release`)
+    if (injection.nativeLogsOverwritten !== false) fail('NATIVE_LOG_OVERWRITE', `G6 ${String(injection.point)} failure overwrote native logs`)
+    if (injection.point === 'health-check') {
+      if (injection.rolledBack !== true) fail('NO_ROLLBACK', 'G6 health-check failure did not roll back')
+      if (!isFiniteNumber(injection.rollbackWithinMs) || injection.rollbackWithinMs > HEALTH_CHECK_MS) {
+        fail('ROLLBACK_TOO_SLOW', `G6 health-check rollback took ${JSON.stringify(injection.rollbackWithinMs)}ms, budget ${HEALTH_CHECK_MS}ms`)
+      }
+    }
+  }
+
+  const online = dataset.onlineVersion
+  if (!online || typeof online !== 'object') {
+    fail('ONLINE_VERSION_MISSING', 'G6 onlineVersion report is missing')
+  } else {
+    if (lastActiveVersion !== null && online.version !== lastActiveVersion) {
+      fail('ONLINE_VERSION_MISMATCH', `G6 online version ${JSON.stringify(online.version)} does not match release manifest active version ${JSON.stringify(lastActiveVersion)}`)
+    }
+    if (online.releaseManifestMatches !== true) fail('MANIFEST_MISMATCH', 'G6 online version does not match the release manifest')
+  }
+
+  const retained = Math.max(0, ...rounds.flatMap(round => (Array.isArray(round.steps) ? round.steps : []).map(step => (isFiniteNumber(step.oldReleasesRetained) ? step.oldReleasesRetained : 0))))
+  if (retained < MIN_RETAINED_RELEASES) fail('RETAINED_RELEASES', `G6 retains ${retained} old releases, need at least ${MIN_RETAINED_RELEASES}`)
+  checks.push({ name: 'upgrade/rollback rounds', passed: rounds.length === ROUNDS, detail: { rounds: rounds.length, versions: rounds.map(round => (Array.isArray(round.steps) ? [round.steps[0]?.from, ...round.steps.map(step => step.to)] : [])) } })
+  const metrics = {
+    rounds: rounds.length,
+    injectionPoints: [...injectedPoints].sort(),
+    expectedInjectionPoints: INJECTION_POINTS,
+    retainedReleases: retained,
+    onlineVersion: online?.version ?? null,
+  }
+  return { gate: 'G6', verdict: failures.length ? 'FAIL' : 'PASS', failures, checks, metrics, frameSamples: [] }
+}
diff --git a/ext/scripts/gates/index.mjs b/ext/scripts/gates/index.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..45ca5c7143badc4f62f65230b84e1809ffa2f346
--- /dev/null
+++ b/ext/scripts/gates/index.mjs
@@ -0,0 +1,20 @@
+/** Gate registry. Order is the spec's G1..G6 order; the runner is serial. */
+import * as g1 from './g1-first-complete.mjs'
+import * as g2 from './g2-paging-reading.mjs'
+import * as g3 from './g3-bounded-derived.mjs'
+import * as g4 from './g4-default-path.mjs'
+import * as g5 from './g5-install-consistency.mjs'
+import * as g6 from './g6-upgrade-rollback.mjs'
+
+export const GATE_MODULES = [g1, g2, g3, g4, g5, g6]
+
+export const GATES = GATE_MODULES.map(module => ({ metadata: module.metadata, judge: module.judge }))
+
+export const GATE_IDS = GATES.map(gate => gate.metadata.id)
+
+/** @param {string} id */
+export function gateById(id) {
+  const gate = GATES.find(entry => entry.metadata.id === id)
+  if (!gate) throw new Error(`Unknown gate ${id}`)
+  return gate
+}
diff --git a/ext/scripts/pack.mjs b/ext/scripts/pack.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..64dc377ed1112760c5d413afbb8c003e3540b4cb
--- /dev/null
+++ b/ext/scripts/pack.mjs
@@ -0,0 +1,115 @@
+#!/usr/bin/env node
+/**
+ * Pack the ext overlay packages for the pinned upstream revision.
+ *
+ * Every tarball keeps its upstream package name (so pnpm overrides resolve all
+ * consumers to one instance) and carries the `-ext.N` version suffix. The
+ * dependency specifiers are copied from the pinned registry package because the
+ * source tree uses workspace protocols that cannot be installed elsewhere.
+ */
+import { createHash } from 'node:crypto';
+import { cp, mkdir, readFile, readdir, rename, rm, stat, writeFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { spawnSync } from 'node:child_process';
+
+const root = resolve(new URL('../..', import.meta.url).pathname);
+const registryRoot = '/mnt/cache/src/hapi-dsh/node_modules';
+const packages = [
+  'packages/client/ui-chat',
+  'packages/api/session-controller',
+  'packages/client/ui-conversation',
+];
+const suffix = process.argv[2] ?? '1';
+const upstreamCommit = '1f81c047fc48fa190a683e469daa699857e9afe8';
+const seriesDir = join(root, 'ext/patches/0.2.1-rc.3');
+const outDir = join(root, 'ext/releases/0.2.1-rc.3', `ext.${suffix}`);
+const sha = (data) => createHash('sha256').update(data).digest('hex');
+
+function run(command, args, options = {}) {
+  const result = spawnSync(command, args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], ...options });
+  if (result.status !== 0) {
+    throw new Error(`${command} ${args.join(' ')} failed (${result.status}): ${(result.stderr || result.stdout).trim()}`);
+  }
+  return result.stdout;
+}
+
+await mkdir(outDir, { recursive: true });
+const npmEnv = { ...process.env, npm_config_cache: join(root, '.npm-cache'), npm_config_logs_dir: join(root, '.npm-logs') };
+await mkdir(npmEnv.npm_config_cache, { recursive: true });
+await mkdir(npmEnv.npm_config_logs_dir, { recursive: true });
+const series = (await readFile(join(seriesDir, 'series'), 'utf8'))
+  .split('\n').map(line => line.trim()).filter(line => line && !line.startsWith('#'));
+const patchHashes = [];
+for (const patch of series) patchHashes.push(`${patch}:${sha(await readFile(join(seriesDir, patch)))}`);
+
+const manifestPackages = [];
+for (const relative of packages) {
+  const directory = join(root, relative);
+  const source = JSON.parse(await readFile(join(directory, 'package.json'), 'utf8'));
+  const registryFile = join(registryRoot, source.name, 'package.json');
+  let registry;
+  try { registry = JSON.parse(await readFile(registryFile, 'utf8')); } catch { registry = undefined; }
+  const version = `${source.version}-ext.${suffix}`;
+  const { devDependencies: _devDependencies, ...runtimeSource } = source;
+  const packed = {
+    ...runtimeSource,
+    version,
+    ...(registry?.dependencies ? { dependencies: registry.dependencies } : {}),
+    ...(registry?.peerDependencies ? { peerDependencies: registry.peerDependencies } : {}),
+    ...(registry?.peerDependenciesMeta ? { peerDependenciesMeta: registry.peerDependenciesMeta } : {}),
+    ...(registry?.optionalDependencies ? { optionalDependencies: registry.optionalDependencies } : {}),
+  };
+  const backup = join(directory, '.package.json.ext-backup');
+  await cp(join(directory, 'package.json'), backup);
+  try {
+    await writeFile(join(directory, 'package.json'), `${JSON.stringify(packed, null, 2)}\n`);
+    run('npm', ['pack', '--ignore-scripts', '--pack-destination', outDir], { cwd: directory, env: npmEnv });
+  } finally {
+    await rename(backup, join(directory, 'package.json'));
+  }
+  const files = (await readdir(outDir)).filter(name => name.endsWith('.tgz'));
+  const tarball = files.find(name => name.includes(source.name.replace('@', '').replace('/', '-'))
+    || name.includes(source.name.split('/')[1]));
+  if (!tarball) throw new Error(`npm pack produced no tarball for ${source.name}: ${files.join(', ')}`);
+  const bytes = await readFile(join(outDir, tarball));
+  manifestPackages.push({
+    name: source.name,
+    version,
+    upstreamVersion: source.version,
+    tarball,
+    sha256: sha(bytes),
+    bytes: (await stat(join(outDir, tarball))).size,
+  });
+}
+
+const manifest = {
+  schema: 'hapi-dsh/ext-manifest/v1',
+  createdAt: new Date().toISOString(),
+  upstreamVersion: '0.2.1-rc.3',
+  upstreamCommit,
+  extRelease: `${suffix}`,
+  compositionVersion: `0.2.1-rc.3+ext.${suffix}`,
+  protocol: 2,
+  capabilities: { historySource: 1, mountedChat: 1, windowCommit: 1 },
+  patchSetSha256: sha(patchHashes.join('\n')),
+  patchSeries: series,
+  packageSetSha256: sha(manifestPackages.map(entry => `${entry.name}@${entry.version}:${entry.sha256}`).join('\n')),
+  packages: manifestPackages,
+};
+await writeFile(join(outDir, 'manifest.json'), `${JSON.stringify(manifest, null, 2)}\n`);
+// hapi-dsh's bundle pipeline consumes this shape; keep one source of truth.
+const release = {
+  upstreamVersion: manifest.upstreamVersion,
+  upstreamCommit,
+  extRelease: manifest.extRelease,
+  patchSetSha256: manifest.patchSetSha256,
+  compositionVersion: manifest.compositionVersion,
+  protocol: manifest.protocol,
+  capabilities: manifest.capabilities,
+  packages: manifestPackages.map(entry => ({ name: entry.name, version: entry.version, tarball: entry.tarball })),
+  sourceOffer: [],
+  licenses: [],
+};
+await writeFile(join(outDir, 'release.json'), `${JSON.stringify(release, null, 2)}\n`);
+console.log(JSON.stringify({ outDir, patchSetSha256: manifest.patchSetSha256, packageSetSha256: manifest.packageSetSha256,
+  packages: manifestPackages.map(entry => `${entry.name}@${entry.version}`) }, null, 2));
