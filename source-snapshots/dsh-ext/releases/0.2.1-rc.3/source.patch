+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://dsh-ext.local/schema/g1.schema.json",
+  "title": "G1 first-complete-usability dataset",
+  "description": "Input contract for gate G1. A sampler must provide 20 real cold opens: body, editable composer and actually-scrollable older history simultaneously usable within 1500 ms of the click after application load, with no degradation during the following 10 s. A sample whose display cache could not be cleared is non-cold and is excluded by the judge, so it does not count toward the 20. The judge is the authority; this schema documents the contract.",
+  "type": "object",
+  "required": ["gate", "samples"],
+  "properties": {
+    "gate": { "const": "G1" },
+    "source": { "type": "string", "description": "Sampler identity, e.g. hapi-dsh production probe or a synthetic fixture." },
+    "notes": { "type": "array", "items": { "type": "string" } },
+    "samples": {
+      "type": "array",
+      "minItems": 20,
+      "items": { "$ref": "#/$defs/sample" }
+    }
+  },
+  "$defs": {
+    "sample": {
+      "type": "object",
+      "required": [
+        "id", "attempt", "cold", "appLoadedAtMs", "clickAtMs", "bodyAtMs", "editorAtMs", "historyAtMs",
+        "allUsableAtMs", "clickToUsableMs", "docLoadMs", "historyActuallyLoaded", "olderMessageCount",
+        "degradedWithin10s", "observationFrames"
+      ],
+      "properties": {
+        "id": { "type": "string", "minLength": 1, "description": "Unique per attempt; reuse means a retry overwrote a failed sample and fails the gate." },
+        "attempt": { "const": 1 },
+        "cold": { "type": "boolean", "description": "true only when the display cache for this session was cleared before the open." },
+        "appLoadedAtMs": { "type": "number", "minimum": 0 },
+        "clickAtMs": { "type": "number", "minimum": 0, "description": "Must be after appLoadedAtMs." },
+        "bodyAtMs": { "type": "number", "minimum": 0 },
+        "editorAtMs": { "type": "number", "minimum": 0 },
+        "historyAtMs": { "type": "number", "minimum": 0 },
+        "allUsableAtMs": { "type": "number", "minimum": 0 },
+        "clickToUsableMs": { "type": "number", "minimum": 0 },
+        "docLoadMs": { "type": "number", "minimum": 0, "description": "Reported separately from the 1500 ms budget." },
+        "historyActuallyLoaded": { "type": "boolean" },
+        "olderMessageCount": { "type": "integer", "minimum": 0 },
+        "degradedWithin10s": { "type": "boolean" },
+        "degradation": { "type": ["object", "null"], "description": "Optional first degradation record." },
+        "observationFrames": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/frame" } },
+        "sourceSample": { "description": "Optional raw sampler record kept in the artifact." }
+      },
+      "additionalProperties": true
+    },
+    "frame": {
+      "type": "object",
+      "required": ["atMs", "body", "editor", "history"],
+      "properties": {
+        "atMs": { "type": "number", "minimum": 0 },
+        "body": { "type": "boolean" },
+        "editor": { "type": "boolean" },
+        "history": { "type": "boolean" }
+      },
+      "additionalProperties": true
+    }
+  }
+}
