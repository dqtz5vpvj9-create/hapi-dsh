+  private correctionError: string | null = null
+
+  /**
+   * @param viewId - stable Pane identity inside the Session generation.
+   * @param historyRead - generation connection carrying window opens.
+   * @param assembler - private official assembler for this window.
+   * @param closed - release notification for the binding's refcount.
+   * @param coordinator - window commit coordinator, or null on the original publish path.
+   */
+  constructor(
+    readonly viewId: string,
+    private readonly historyRead: SessionHistoryReadV1,
+    private readonly assembler: ConversationNodeAssembler,
+    private readonly closed: () => void,
+    private readonly coordinator: WindowCommitCoordinatorV1 | null = null,
+  ) {
+    this.snapshot = createSnapshotStore(this.currentSnapshot())
+    this.opening = this.start()
+  }
+
+  /** Official assembler read face for this window's derived views. */
+  get reads(): ConversationViewSnapshotStore {
+    return this.assembler
+  }
+
+  /** @inheritdoc */
+  async read(request: HistoryReadV1, signal?: AbortSignal): Promise<HistoryViewSnapshotV1> {
+    this.assertLive()
+    signal?.throwIfAborted()
+    await this.opening
+    if (this.pending !== null && sameRead(this.pending.request, request)) return this.pending.promise
+    if (this.inFlight === null) return this.trackPage(request)
+    if (this.pending === null) {
+      const deferred = Promise.withResolvers<HistoryViewSnapshotV1>()
+      this.pending = {
+        request,
+        promise: deferred.promise,
+        resolve: deferred.resolve,
+        reject: deferred.reject,
+      }
+    } else {
+      // One pending navigation: the newest request replaces the queued target and
+      // every waiter settles on the resulting window.
+      this.pending.request = request
+    }
+    return this.pending.promise
+  }
+
+  /** @inheritdoc */
+  async refresh(signal?: AbortSignal): Promise<HistoryViewSnapshotV1> {
+    this.assertLive()
+    signal?.throwIfAborted()
+    await this.opening
+    return this.resync()
+  }
+
+  /** @inheritdoc */
+  release(): void {
+    if (this.released) return
+    this.released = true
+    this.abort.abort()
+    this.followAbort?.abort()
+    this.followAbort = undefined
+    const feed = this.feed
+    this.feed = undefined
+    try {
+      feed?.release()
+    } finally {
+      // Clearing the assembler releases every derived Context and node of this window.
+      this.assembler.replaceWindow([], false)
+      this.entries = []
+      this.phase = 'closed'
+      this.busy = false
+      this.publish()
+      this.closed()
+    }
+  }
+
+  private async start(): Promise<void> {
+    try {
+      const feed = await this.historyRead.openView(this.viewId, HISTORY_VIEW_BUDGET, this.abort.signal)
+      if (this.released) {
+        feed.release()
+        return
+      }
+      this.feed = feed
+      await this.commitSnapshot(feed.initial, this.abort.signal)
+      this.phase = 'ready'
+      this.publish()
+      this.startFollow(feed.initial.version)
+    } catch (error) {
+      if (this.released) return
+      this.phase = 'error'
+      this.failure = failureCodeOf(error)
+      this.publish()
+    }
+  }
+
+  private trackPage(request: HistoryReadV1): Promise<HistoryViewSnapshotV1> {
+    const promise = this.startPage(request)
+    this.inFlight = promise
+    void promise.then(() => { this.finishPage() }, () => { this.finishPage() })
+    return promise
+  }
+
+  private finishPage(): void {
+    this.inFlight = null
+    const pending = this.pending
+    if (pending === null || this.released) return
+    this.pending = null
+    void this.trackPage(pending.request).then(pending.resolve, pending.reject)
+  }
+
+  private async startPage(request: HistoryReadV1): Promise<HistoryViewSnapshotV1> {
+    const feed = this.feed
+    if (feed === undefined) throw this.failure === null
+      ? new Error('history window is not open')
+      : new Error(`history window failed: ${this.failure}`)
+    this.busy = true
+    this.publish()
+    try {
+      const snapshot = await feed.read(request, HISTORY_VIEW_BUDGET, this.abort.signal)
+      await this.applyPage(request, snapshot)
+      return this.currentSnapshot()
+    } catch (error) {
+      if (!isAbort(error)) {
+        this.phase = 'error'
+        this.failure = failureCodeOf(error)
+        this.publish()
+      }
+      throw error
+    } finally {
+      this.busy = false
+      this.publish()
+    }
+  }
+
+  /** Apply one page read without disturbing the live version when the page is not newest. */
+  private async applyPage(request: HistoryReadV1, snapshot: HistorySnapshotV1): Promise<void> {
+    if (request.kind === 'latest' || request.kind === 'around') {
+      await this.commitSnapshot(snapshot, this.abort.signal)
+    } else if (request.kind === 'before') {
+      this.hasBefore = snapshot.hasBefore
+      this.prependWindow(snapshot.entries)
+    } else {
+      this.hasAfter = snapshot.hasAfter
+      this.appendWindow(snapshot.entries)
+    }
+    if (request.kind !== 'before' && request.kind !== 'after') this.startFollow(snapshot.version)
+    this.publish()
+  }
+
+  /**
+   * Prepare one snapshot as a candidate and publish it through the window commit.
+   * @param snapshot - provider snapshot to publish.
+   * @param signal - caller cancellation before the commit checkpoint.
+   */
+  private async commitSnapshot(snapshot: HistorySnapshotV1, signal: AbortSignal): Promise<void> {
+    const coordinator = this.coordinator
+    if (coordinator === null) {
+      this.publishWindow(snapshot.entries, snapshot.hasBefore, snapshot.hasAfter, snapshot.version)
+      return
+    }
+    const prepared = await coordinator.prepare(snapshot, signal)
+    let result: WindowCommitResultV1
+    try {
+      result = await coordinator.commitWindow(prepared, signal)
+    } catch (error) {
+      coordinator.discard(prepared)
+      throw error
+    }
+    // The window is linearized here even when the reader correction failed; the
+    // failure is published as its own fact instead of being folded into success.
+    if (result.correction === 'failed') {
+      this.correction = 'failed'
+      this.correctionError = result.correctionError.message
+      this.publish()
+      return
+    }
+    this.correction = 'applied'
+    this.correctionError = null
+  }
+
+  /**
+   * Publish one prepared candidate through the official assembler replacement.
+   * @param candidate - candidate built and validated by the window owner.
+   */
+  publishCandidate(candidate: HistoryWindowCandidateV1): void {
+    this.publishWindow(candidate.entries, candidate.hasBefore, candidate.hasAfter, candidate.version)
+  }
+
+  /** Publish one replacement through the official assembler (clear and rebuild). */
+  private publishWindow(
+    entries: readonly SessionEventLikeEntry[],
+    hasBefore: boolean,
+    hasAfter: boolean,
+    version: SourceVersion,
+  ): void {
+    const publication = this.assembler.replaceWindow(entries, hasBefore)
+    this.entries = [...entries]
+    this.hasBefore = hasBefore
+    this.hasAfter = hasAfter
+    this.headChanged = false
+    this.versionCursor = version
+    this.bufferedChanges = 0
+    this.bufferedBytes = 0
+    this.publicationScheduled = false
+    if (publication !== 'none') this.assembler.flush()
+  }
+
+  private prependWindow(entries: readonly SessionEventLikeEntry[]): void {
+    if (entries.length === 0) return
+    const publication = this.assembler.prepend(entries, this.hasBefore)
+    this.entries = [...entries, ...this.entries]
+    if (publication !== 'none') this.assembler.flush()
+  }
+
+  private appendWindow(entries: readonly SessionEventLikeEntry[]): void {
+    if (entries.length === 0) return
+    let publication: ReturnType<ConversationNodeAssembler['append']> = 'none'
+    for (const entry of entries) {
+      const next = this.assembler.append(entry)
+      if (next === 'immediate' || publication === 'none') publication = next
+    }
+    this.entries = [...this.entries, ...entries]
+    if (publication !== 'none') this.assembler.flush()
+  }
+
+  private startFollow(after: SourceVersion): void {
+    this.followAbort?.abort()
+    const abort = new AbortController()
+    this.followAbort = abort
+    void this.consume(after, abort.signal)
+  }
+
+  private async consume(after: SourceVersion, signal: AbortSignal): Promise<void> {
+    const feed = this.feed
+    if (feed === undefined) return
+    try {
+      for await (const delta of feed.changes(after, signal)) {
+        if (signal.aborted || this.released) return
+        if (delta.base !== this.versionCursor) {
+          await this.resync()
+          return
+        }
+        const overflow = await this.applyDelta(delta)
+        if (overflow) {
+          await this.resync()
+          return
+        }
+      }
+    } catch (error) {
+      if (signal.aborted || this.released || isAbort(error)) return
+      this.phase = 'error'
+      this.failure = failureCodeOf(error)
+      this.publish()
+    }
+  }
+
+  /**
+   * Apply one delta and report whether the publication backlog exceeded its bound.
+   * A delta that would append a tail across a gap keeps the window detached and
+   * only publishes the head hint.
+   */
+  private async applyDelta(delta: HistoryDeltaV1): Promise<boolean> {
+    if (delta.headChanged) this.headChanged = true
+    for (const change of delta.changes) {
+      switch (change.kind) {
+        case 'replace':
+          await this.commitSnapshot({
+            version: delta.version,
+            entries: change.entries,
+            before: null,
+            after: null,
+            hasBefore: this.hasBefore,
+            hasAfter: false,
+          }, this.abort.signal)
+          break
+        case 'prepend':
+          this.prependWindow(change.entries)
+          break
+        case 'append':
+          if (this.hasAfter) {
+            this.headChanged = true
+          } else {
+            this.appendWindow(change.entries)
+          }
+          break
+        case 'settle-assistant':
+          this.assembler.settleAssistant(change.attemptId, change.entry)
+          break
+      }
+      this.bufferedChanges += 1
+    }
+    this.bufferedBytes += deltaBytes(delta.changes)
+    this.versionCursor = delta.version
+    if (this.bufferedChanges >= HISTORY_VIEW_MAX_CHANGES || this.bufferedBytes >= HISTORY_VIEW_MAX_BYTES) {
+      return true
+    }
+    this.schedulePublication()
+    return false
+  }
+
+  /** Publish at most once per frame; the buffer bound counts changes applied before that frame. */
+  private schedulePublication(): void {
+    if (this.publicationScheduled) return
+    this.publicationScheduled = true
+    const flush = (): void => {
+      this.publicationScheduled = false
+      this.bufferedChanges = 0
+      this.bufferedBytes = 0
+      this.publish()
+    }
+    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(flush)
+    else queueMicrotask(flush)
+  }
+
+  /** Re-read the newest window after a version gap or publication overflow. */
+  private async resync(): Promise<HistoryViewSnapshotV1> {
+    const inFlight = this.refreshInFlight
+    if (inFlight !== null) return inFlight
+    const feed = this.feed
+    if (feed === undefined) throw new Error('history window is not open')
+    const operation = (async (): Promise<HistoryViewSnapshotV1> => {
+      this.busy = true
+      this.publish()
+      try {
+        this.followAbort?.abort()
+        const snapshot = await feed.read({ kind: 'latest' }, HISTORY_VIEW_BUDGET, this.abort.signal)
+        if (this.released) return this.currentSnapshot()
+        await this.commitSnapshot(snapshot, this.abort.signal)
+        this.startFollow(snapshot.version)
+        return this.currentSnapshot()
+      } finally {
+        this.busy = false
+        this.publish()
+      }
+    })()
+    this.refreshInFlight = operation
+    try {
+      return await operation
+    } finally {
+      this.refreshInFlight = null
+    }
+  }
+
+  private assertLive(): void {
+    if (this.released) throw new Error('history view is released')
+  }
+
+  private publish(): void {
+    this.revision += 1
+    this.snapshot.set(this.currentSnapshot())
+  }
