+++ b/ext/scripts/fixtures/emit.mjs
@@ -0,0 +1,20 @@
+#!/usr/bin/env node
+/**
+ * Synthetic dataset emitter, for exercising the live-spawn plumbing only.
+ *
+ * It prints the self-check pass fixture for a gate, so `HAPI_DSH_EXT_<G>_CMD`
+ * can be validated end to end without a browser or a store. It is NOT product
+ * evidence: an artifact produced through this emitter has `source` set to
+ * "self-check fixture". Never cite it as a passed gate.
+ *
+ *   node ext/scripts/fixtures/emit.mjs G3
+ */
+import { buildPassFixture } from './build.mjs'
+
+const gateId = process.argv[2]?.toUpperCase()
+if (!gateId || !/^G[1-6]$/.test(gateId)) {
+  process.stderr.write('usage: node ext/scripts/fixtures/emit.mjs G1..G6\n')
+  process.exit(2)
+}
+const fixture = buildPassFixture(gateId).dataset
+process.stdout.write(`${JSON.stringify(fixture)}\n`)
