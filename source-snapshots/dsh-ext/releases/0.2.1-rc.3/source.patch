+++ b/ext/scripts/gates/g5-install-consistency.mjs
@@ -0,0 +1,139 @@
+/**
+ * G5 — Install and cross-node consistency (spec section 6).
+ *
+ * One clean install plus two repeat installs (the same manifest must produce no
+ * diff), then Host plus two Runners must match the same RuntimeIdentityV1 before
+ * business forwarding opens. Every handshake field is tampered with one at a
+ * time; each case must be diagnosed at handshake time with zero business
+ * forwards. Missing extension package, bad checksum and original-package mixed
+ * load must fail before activation.
+ */
+import { commonViolations, isFiniteNumber } from '../lib/samples.mjs'
+import { missingSampleFailure } from '../lib/verdict.mjs'
+
+const INSTALL_RUNS = 3
+const RUNNER_NODES = 2
+const IDENTITY_FIELDS = [
+  'upstreamVersion', 'upstreamCommit', 'extRelease', 'patchSetSha256', 'packageSetSha256', 'capabilities', 'compositionVersion', 'protocol',
+]
+const PRE_ACTIVATION_CASES = ['missing-ext-package', 'bad-checksum', 'original-mixed-load']
+const IDENTIFIER_PATTERN = /^[a-f0-9]{64}$/
+const COMMIT_PATTERN = /^[a-f0-9]{40}$/
+const CAPABILITY_KEYS = ['historySource', 'mountedChat', 'windowCommit']
+
+export const metadata = {
+  id: 'G5',
+  title: '安装及一致性',
+  expectedSamples: 3,
+  sampleRequirement: 'clean install once + repeat install twice with no diff; Host + 2 Runners identity match; each of the 8 handshake fields tampered with → 0 business forwards; missing ext package / bad checksum / original mixed load fail before activation',
+  schemaPath: 'ext/scripts/fixtures/schema/g5.schema.json',
+  thresholds: { installRuns: INSTALL_RUNS, runners: RUNNER_NODES, identityFields: IDENTITY_FIELDS.length, businessForwards: 0, protocol: 2 },
+  commands: {
+    samplerEnv: 'HAPI_DSH_EXT_G5_CMD',
+    existingDefault: 'hapi-dsh scripts/distribution-smoke.mjs (legacy partial evidence only, see README)',
+  },
+}
+
+function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`
+  }
+  return JSON.stringify(value)
+}
+
+function validIdentity(identity) {
+  const problems = []
+  for (const field of ['upstreamVersion', 'upstreamCommit', 'extRelease', 'patchSetSha256', 'packageSetSha256', 'compositionVersion']) {
+    if (typeof identity?.[field] !== 'string' || !identity[field].trim()) problems.push(`${field} must be a non-empty string`)
+  }
+  if (typeof identity?.upstreamCommit === 'string' && identity.upstreamCommit && !COMMIT_PATTERN.test(identity.upstreamCommit)) problems.push('upstreamCommit must be a 40-hex commit')
+  for (const field of ['patchSetSha256', 'packageSetSha256']) {
+    if (typeof identity?.[field] === 'string' && identity[field] && !IDENTIFIER_PATTERN.test(identity[field])) problems.push(`${field} must be a 64-hex digest`)
+  }
+  if (identity?.protocol !== 2) problems.push(`protocol must be 2, got ${JSON.stringify(identity?.protocol)}`)
+  for (const key of CAPABILITY_KEYS) {
+    if (!isFiniteNumber(identity?.capabilities?.[key]) || identity.capabilities[key] !== 1) problems.push(`capabilities.${key} must be 1, got ${JSON.stringify(identity?.capabilities?.[key])}`)
+  }
+  return problems
+}
+
+export function judge(dataset) {
+  /** @type {{ code: string, message: string }[]} */
+  const failures = []
+  /** @type {{ name: string, passed: boolean, detail?: unknown }[]} */
+  const checks = []
+  const fail = (code, message, extra = {}) => failures.push({ code, message, ...extra })
+  if (!dataset || typeof dataset !== 'object') {
+    failures.push({ code: 'DATASET_MISSING', message: 'G5 dataset is missing or not an object' })
+    return { gate: 'G5', verdict: 'FAIL', failures, checks, metrics: {}, frameSamples: [] }
+  }
+  for (const failure of commonViolations(dataset, 'G5')) failures.push(failure)
+
+  const installRuns = Array.isArray(dataset.installRuns) ? dataset.installRuns.filter(entry => entry && typeof entry === 'object') : []
+  if (installRuns.length !== INSTALL_RUNS) failures.push(missingSampleFailure('G5', INSTALL_RUNS, installRuns.length, { unit: 'install runs' }))
+  for (const [index, run] of installRuns.entries()) {
+    if (run.run !== index + 1) fail('INSTALL_RUN_ORDER', `G5 install run ${index} reports run ${JSON.stringify(run.run)}; runs must be 1..${INSTALL_RUNS}`)
+    if (run.ok !== true || run.exitCode !== 0) fail('INSTALL_FAILED', `G5 install run ${index + 1} (${run.kind ?? 'unknown'}) failed: ok=${JSON.stringify(run.ok)} exitCode=${JSON.stringify(run.exitCode)}`, { run: index + 1 })
+    if (index === 0 && run.kind !== 'clean') fail('INSTALL_KIND', `G5 install run 1 must be the clean install, got ${JSON.stringify(run.kind)}`)
+    if (index > 0) {
+      if (run.kind !== 'repeat') fail('INSTALL_KIND', `G5 install run ${index + 1} must be a repeat install, got ${JSON.stringify(run.kind)}`)
+      if (typeof run.diff !== 'string') fail('IDEMPOTENCY_NOT_PROVEN', `G5 repeat install ${index + 1} did not report a diff; "no diff" must be measured, not assumed`)
+      else if (run.diff.trim() !== '') fail('INSTALL_DIFF', `G5 repeat install ${index + 1} changed the profile: ${run.diff.slice(0, 500)}`)
+    }
+  }
+
+  const nodes = Array.isArray(dataset.nodes) ? dataset.nodes.filter(entry => entry && typeof entry === 'object') : []
+  const hosts = nodes.filter(node => node.role === 'host')
+  const runners = nodes.filter(node => node.role === 'runner')
+  if (nodes.length !== 1 + RUNNER_NODES) fail('NODE_SET', `G5 requires exactly one Host plus ${RUNNER_NODES} Runner nodes, got ${nodes.length} nodes (${hosts.length} host, ${runners.length} runner)`)
+  if (hosts.length !== 1) fail('NODE_SET', `G5 requires exactly one Host node, got ${hosts.length}`)
+  if (runners.length !== RUNNER_NODES) failures.push(missingSampleFailure('G5', RUNNER_NODES, runners.length, { unit: 'runner identity matches' }))
+  const identities = []
+  for (const [index, node] of nodes.entries()) {
+    if (node.matched !== true) fail('IDENTITY_MISMATCH', `G5 ${node.role ?? 'node'} ${index} did not match the Host identity`)
+    const problems = validIdentity(node.identity)
+    if (problems.length) fail('INVALID_IDENTITY', `G5 ${node.role ?? 'node'} ${index}: ${problems.join('; ')}`, { problems })
+    identities.push(canonical(node.identity))
+  }
+  if (identities.length > 1) {
+    const first = identities[0]
+    for (const [index, identity] of identities.entries()) {
+      if (identity !== first) fail('NODE_IDENTITY_DIVERGENCE', `G5 node ${index} identity differs from node 0`)
+    }
+  }
+  if (dataset.expectedIdentity && nodes.length) {
+    for (const [index, node] of nodes.entries()) {
+      if (canonical(node.identity) !== canonical(dataset.expectedIdentity)) fail('RELEASE_IDENTITY_MISMATCH', `G5 node ${index} identity does not match the release manifest`)
+    }
+  }
+
+  const tampers = Array.isArray(dataset.tampers) ? dataset.tampers.filter(entry => entry && typeof entry === 'object') : []
+  const tamperedFields = new Set(tampers.map(entry => entry.field))
+  for (const field of IDENTITY_FIELDS) {
+    if (!tamperedFields.has(field)) fail('TAMPER_CASE_MISSING', `G5 has no handshake tamper case for ${field}`)
+  }
+  for (const tamper of tampers) {
+    if (tamper.handshakeDiagnosed !== true) fail('TAMPER_NOT_DIAGNOSED', `G5 tampered ${tamper.field} was not rejected during handshake`, { field: tamper.field })
+    if (tamper.businessForwarded !== 0) fail('TAMPER_FORWARDED', `G5 tampered ${tamper.field} still forwarded ${JSON.stringify(tamper.businessForwarded)} business messages`, { field: tamper.field })
+  }
+
+  const preActivation = Array.isArray(dataset.preActivationFailures) ? dataset.preActivationFailures.filter(entry => entry && typeof entry === 'object') : []
+  const preActivationCases = new Set(preActivation.map(entry => entry.case))
+  for (const expected of PRE_ACTIVATION_CASES) {
+    if (!preActivationCases.has(expected)) fail('PRE_ACTIVATION_CASE_MISSING', `G5 has no pre-activation failure case for ${expected}`)
+  }
+  for (const entry of preActivation) {
+    if (entry.failedBeforeActivation !== true) fail('PRE_ACTIVATION_NOT_FAILED', `G5 case ${entry.case} did not fail before activation`)
+  }
+
+  const metrics = {
+    installRuns: installRuns.length,
+    hostNodes: hosts.length,
+    runnerNodes: runners.length,
+    tamperedFields: [...tamperedFields].sort(),
+    expectedTamperFields: IDENTITY_FIELDS,
+    preActivationCases: [...preActivationCases].sort(),
+  }
+  return { gate: 'G5', verdict: failures.length ? 'FAIL' : 'PASS', failures, checks, metrics, frameSamples: [] }
+}
