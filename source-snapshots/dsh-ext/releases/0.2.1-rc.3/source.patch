+  it('provider-conflict', async ({ bench }) => {
+    const b = bench()
+    await feedList(b.mock, b.svc, 's1')
+    const registry = historyExtension(b.svc)
+    if (registry === undefined) throw new Error('expected the history extension')
+    const feed = createFeed(snapshot('v1', [entry(1)]), () => snapshot('v1', [entry(1)]))
+    const opened: string[] = []
+    const first = createProvider('first', () => true, createSource(feed.feed, opened))
+    const second = createProvider('second', () => true, createSource(feed.feed, opened))
+    const stopFirst = registry.register(first.provider)
+    registry.register(second.provider)
+
+    let failure: unknown
+    try {
+      b.svc.retain(sid('s1'), { source: 'controllerOperation' }).release()
+    } catch (error) {
+      failure = error
+    }
+    expect(failure).toBeInstanceOf(HistorySourceError)
+    expect((failure as HistorySourceError).code).toBe('PROVIDER_CONFLICT')
+    // Rejected before any history read or provider window opening.
+    expect(first.open).not.toHaveBeenCalled()
+    expect(second.open).not.toHaveBeenCalled()
+    expect(b.mock.remote.session.follow).not.toHaveBeenCalled()
+
+    // Unregistration refuses new bindings but leaves exactly one owner.
+    stopFirst()
+    using reference = b.svc.retain(sid('s1'), { source: 'controllerOperation' })
+    await reference.ready
