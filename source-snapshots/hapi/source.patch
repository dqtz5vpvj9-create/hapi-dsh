diff --git a/cli/src/agent/backends/acp/AcpConnection.test.ts b/cli/src/agent/backends/acp/AcpConnection.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6fdcfca451a12320a978dfec7dee5c616be0dc73
--- /dev/null
+++ b/cli/src/agent/backends/acp/AcpConnection.test.ts
@@ -0,0 +1,428 @@
+import { EventEmitter } from 'node:events';
+import { PassThrough, Writable } from 'node:stream';
+import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { AgentMessage, PermissionRequest } from '@/agent/types';
+import { killProcessByChildProcess } from '@/utils/process';
+import { AcpConnection } from './AcpConnection';
+import { AcpSdkBackend } from './AcpSdkBackend';
+import { AcpStdioTransport, isAcpIndeterminateError } from './AcpStdioTransport';
+
+vi.mock('node:child_process', () => ({ spawn: vi.fn() }));
+vi.mock('@/utils/process', () => ({ killProcessByChildProcess: vi.fn(async () => {}) }));
+vi.mock('@/ui/logger', () => ({ logger: { debug: vi.fn() } }));
+
+type Frame = { id?: number; method?: string; params?: Record<string, unknown>; result?: unknown; error?: unknown };
+
+function deferred<T>() {
+    let resolve!: (value: T) => void;
+    const promise = new Promise<T>(done => { resolve = done; });
+    return { promise, resolve };
+}
+
+const cleanup: Array<() => Promise<void>> = [];
+afterEach(async () => {
+    for (const close of cleanup.splice(0).reverse()) await close();
+    vi.restoreAllMocks();
+    vi.clearAllMocks();
+});
+
+/** Real AcpStdioTransport, fake OS child: no model, sockets or external runtime. */
+function fixture() {
+    const child = new EventEmitter() as EventEmitter & {
+        stdin: Writable; stdout: PassThrough; stderr: PassThrough;
+    };
+    child.stdout = new PassThrough();
+    child.stderr = new PassThrough();
+    const calls: Frame[] = [];
+    const notifications: Frame[] = [];
+    const replies = new Map<number, (frame: Frame) => void>();
+    let nextSession = 1;
+    let nextIncoming = 1000;
+    let intercept: ((frame: Frame) => boolean) | undefined;
+    const send = (frame: Frame) => child.stdout.write(JSON.stringify({ jsonrpc: '2.0', ...frame }) + '\n');
+    const respond = (frame: Frame, result: unknown) => send({ id: frame.id, result });
+    const capabilities = {
+        protocolVersion: 1,
+        agentCapabilities: { loadSession: true, sessionCapabilities: { resume: {}, close: {} } }
+    };
+    child.stdin = new Writable({
+        write(chunk, _encoding, done) {
+            for (const line of chunk.toString().trim().split('\n')) {
+                const frame = JSON.parse(line) as Frame;
+                if (!frame.method) {
+                    replies.get(frame.id!)?.(frame);
+                    replies.delete(frame.id!);
+                } else if (frame.id === undefined) {
+                    notifications.push(frame);
+                } else {
+                    calls.push(frame);
+                    if (intercept?.(frame)) continue;
+                    if (frame.method === 'initialize') respond(frame, capabilities);
+                    else if (frame.method === 'session/new') respond(frame, { sessionId: `session-${nextSession++}` });
+                    else if (frame.method !== 'session/prompt') respond(frame, {});
+                }
+            }
+            done();
+        }
+    });
+    vi.mocked(spawn).mockReturnValue(child as unknown as ChildProcessWithoutNullStreams);
+    const connection = new AcpConnection({ command: 'mock-acp' });
+    cleanup.push(() => connection.close());
+    const backend = () => {
+        const backend = new AcpSdkBackend({ command: 'unused', connection, retrySessionActivation: false });
+        cleanup.push(() => backend.disconnect());
+        return backend;
+    };
+    return {
+        child, calls, notifications, connection, backend, send, respond, capabilities,
+        intercept: (handler: typeof intercept) => { intercept = handler; },
+        update: (sessionId: string, title: string) => send({ method: 'session/update', params: {
+            sessionId, update: { sessionUpdate: 'session_info_update', title }
+        } }),
+        permission: (sessionId?: string) => {
+            const id = nextIncoming++;
+            const reply = new Promise<Frame>(resolve => replies.set(id, resolve));
+            send({ id, method: 'session/request_permission', params: {
+                sessionId, toolCall: { toolCallId: 'same-tool-id', title: 'Read file' },
+                options: [{ optionId: 'allow', name: 'Allow', kind: 'allow_once' }]
+            } });
+            return reply.then(frame => frame.result);
+        }
+    };
+}
+
+const config = { cwd: '/workspace', mcpServers: [] };
+
+async function twoBackends(f: ReturnType<typeof fixture>) {
+    const a = f.backend();
+    const b = f.backend();
+    await Promise.all([a.initialize(), b.initialize()]);
+    const [aId, bId] = await Promise.all([a.newSession(config), b.newSession(config)]);
+    return { a, b, aId, bId };
+}
+
+describe('shared ACP connection', () => {
+    it('shares one spawn and one handshake across concurrent and later backend initialization', async () => {
+        const f = fixture();
+        f.intercept(frame => frame.method === 'initialize');
+        const a = f.backend();
+        const b = f.backend();
+        let initialized = 0;
+        const starts = [a.initialize(), a.initialize(), b.initialize()].map(p => p.then(() => { initialized++; }));
+        await vi.waitFor(() => expect(f.calls).toHaveLength(1));
+        expect(initialized).toBe(0);
+        f.respond(f.calls[0], f.capabilities);
+        await Promise.all(starts);
+        const later = f.backend();
+        await later.initialize();
+        expect(spawn).toHaveBeenCalledExactlyOnceWith('mock-acp', [], expect.any(Object));
+        expect(f.calls.map(call => call.method)).toEqual(['initialize']);
+        expect(a.supportsResumeSession()).toBe(true);
+        expect(b.supportsCloseSession()).toBe(true);
+        await expect(a.newSession(config)).resolves.toBe('session-1');
+        await expect(b.newSession(config)).resolves.toBe('session-2');
+    });
+
+    it('routes updates and identical permission tool IDs only to their owning backend', async () => {
+        const f = fixture();
+        const { a, b, aId, bId } = await twoBackends(f);
+        const aUpdates = vi.fn();
+        const bUpdates = vi.fn();
+        const aPermissions = vi.fn<(request: PermissionRequest) => void>();
+        const bPermissions = vi.fn<(request: PermissionRequest) => void>();
+        a.setSessionInfoUpdateListener(aUpdates);
+        b.setSessionInfoUpdateListener(bUpdates);
+        a.onPermissionRequest(aPermissions);
+        b.onPermissionRequest(bPermissions);
+        f.update(aId, 'A');
+        f.update(bId, 'B');
+        f.update('unowned-child', 'Child');
+        f.send({ method: 'session/update', params: { update: { sessionUpdate: 'session_info_update', title: 'Missing ID' } } });
+        expect(aUpdates).toHaveBeenCalledExactlyOnceWith({ sessionId: aId, title: 'A' });
+        expect(bUpdates).toHaveBeenCalledExactlyOnceWith({ sessionId: bId, title: 'B' });
+
+        const aReply = f.permission(aId);
+        const bReply = f.permission(bId);
+        await expect(f.permission('unowned-child')).resolves.toEqual({ outcome: { outcome: 'cancelled' } });
+        await expect(f.permission()).resolves.toEqual({ outcome: { outcome: 'cancelled' } });
+        expect(aPermissions).toHaveBeenCalledOnce();
+        expect(bPermissions).toHaveBeenCalledOnce();
+        await a.disconnect();
+        await expect(aReply).resolves.toEqual({ outcome: { outcome: 'cancelled' } });
+        await b.respondToPermission(bId, bPermissions.mock.calls[0][0], { outcome: 'selected', optionId: 'allow' });
+        await expect(bReply).resolves.toEqual({ outcome: { outcome: 'selected', optionId: 'allow' } });
+        f.update(aId, 'Detached');
+        f.update(bId, 'Still live');
+        expect(aUpdates).toHaveBeenCalledOnce();
+        expect(bUpdates).toHaveBeenLastCalledWith({ sessionId: bId, title: 'Still live' });
+        expect(killProcessByChildProcess).not.toHaveBeenCalled();
+    });
+
+    it('aborts and closes one backend while the other prompt keeps streaming', async () => {
+        const f = fixture();
+        const { a, b, aId, bId } = await twoBackends(f);
+        const aMessages: AgentMessage[] = [];
+        const bMessages: AgentMessage[] = [];
+        const aPrompt = a.prompt(aId, [{ type: 'text', text: 'A' }], message => aMessages.push(message));
+        const aFailure = expect(aPrompt).rejects.toThrow('consumer closed');
+        const bPrompt = b.prompt(bId, [{ type: 'text', text: 'B' }], message => bMessages.push(message));
+        await vi.waitFor(() => expect(f.calls.filter(call => call.method === 'session/prompt')).toHaveLength(2));
+        await a.cancelPrompt(aId);
+        a.abortSoftSteers();
+        expect(f.notifications).toEqual([{ jsonrpc: '2.0', method: 'session/cancel', params: { sessionId: aId } }]);
+        await a.closeSession(aId);
+        expect(f.calls.filter(call => call.method === 'session/close').map(call => call.params)).toEqual([{ sessionId: aId }]);
+        await Promise.all([a.disconnect(), a.disconnect()]);
+        await aFailure;
+        expect(killProcessByChildProcess).not.toHaveBeenCalled();
+        expect(b.processingMessage).toBe(true);
+        f.send({ method: 'session/update', params: { sessionId: bId, update: {
+            sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'B continues' }
+        } } });
+        const requests = f.calls.filter(call => call.method === 'session/prompt');
+        // A late response to the detached request must not settle B's request.
+        f.respond(requests.find(call => call.params?.sessionId === aId)!, { stopReason: 'cancelled' });
+        expect(b.processingMessage).toBe(true);
+        f.respond(requests.find(call => call.params?.sessionId === bId)!, { stopReason: 'end_turn' });
+        await bPrompt;
+        expect(bMessages).toContainEqual(expect.objectContaining({ type: 'text', text: 'B continues' }));
+        expect(aMessages).not.toContainEqual(expect.objectContaining({ text: 'B continues' }));
+        await Promise.all([b.disconnect(), b.disconnect(), f.connection.close()]);
+        expect(killProcessByChildProcess).toHaveBeenCalledOnce();
+    });
+
+    it('closes the transport only when the last consumer detaches', async () => {
+        const f = fixture();
+        const { a, b } = await twoBackends(f);
+        await a.disconnect();
+        expect(killProcessByChildProcess).not.toHaveBeenCalled();
+        await b.disconnect();
+        expect(killProcessByChildProcess).toHaveBeenCalledOnce();
+        await Promise.all([a.disconnect(), b.disconnect(), f.connection.close()]);
+        expect(killProcessByChildProcess).toHaveBeenCalledOnce();
+        expect(() => f.connection.attach()).toThrow('closed');
+    });
+
+    it('buffers new-session updates until each out-of-order response establishes its owner', async () => {
+        const f = fixture();
+        const a = f.backend();
+        const b = f.backend();
+        await Promise.all([a.initialize(), b.initialize()]);
+        f.intercept(frame => frame.method === 'session/new');
+        const aUpdates = vi.fn();
+        const bUpdates = vi.fn();
+        a.setSessionInfoUpdateListener(aUpdates);
+        b.setSessionInfoUpdateListener(bUpdates);
+        const aNew = a.newSession(config);
+        const bNew = b.newSession(config);
+        const requests = f.calls.filter(call => call.method === 'session/new');
+        f.update('a', 'A before response');
+        f.update('b', 'B before response');
+        expect(aUpdates).not.toHaveBeenCalled();
+        expect(bUpdates).not.toHaveBeenCalled();
+        f.respond(requests[1], { sessionId: 'b' });
+        f.update('b', 'B after response, before promise continuation');
+        f.respond(requests[0], { sessionId: 'a' });
+        await Promise.all([aNew, bNew]);
+        expect(aUpdates.mock.calls).toEqual([[{ sessionId: 'a', title: 'A before response' }]]);
+        expect(bUpdates.mock.calls).toEqual([
+            [{ sessionId: 'b', title: 'B before response' }],
+            [{ sessionId: 'b', title: 'B after response, before promise continuation' }]
+        ]);
+    });
+
+    it.each(['session/resume', 'session/load'])('owns %s before replay and rejects another consumer claiming it', async method => {
+        const f = fixture();
+        const a = f.backend();
+        const b = f.backend();
+        await Promise.all([a.initialize(), b.initialize()]);
+        const updates = vi.fn();
+        a.setSessionInfoUpdateListener(updates);
+        f.intercept(frame => {
+            if (frame.method !== method) return false;
+            f.update('saved', 'Replay');
+            f.respond(frame, {});
+            return true;
+        });
+        const resume = (backend: AcpSdkBackend) => method === 'session/resume'
+            ? backend.resumeSession({ ...config, sessionId: 'saved' })
+            : backend.loadSession({ ...config, sessionId: 'saved' });
+        await resume(a);
+        expect(updates).toHaveBeenCalledExactlyOnceWith({ sessionId: 'saved', title: 'Replay' });
+        // resume avoids the legacy load retry delay for this ownership check.
+        await expect(b.resumeSession({ ...config, sessionId: 'saved' })).rejects.toThrow('already owned');
+        await expect(b.cancelPrompt('saved')).rejects.toThrow('not owned');
+        expect(f.notifications).toEqual([]);
+        await a.closeSession('saved');
+        await b.resumeSession({ ...config, sessionId: 'saved' });
+    });
+
+    it('detaches during initialize without cancelling another consumer initialization', async () => {
+        const f = fixture();
+        f.intercept(frame => frame.method === 'initialize');
+        const a = f.backend();
+        const b = f.backend();
+        const aStart = expect(a.initialize()).rejects.toThrow('consumer closed');
+        const bStart = b.initialize();
+        await vi.waitFor(() => expect(f.calls).toHaveLength(1));
+        await a.disconnect();
+        await aStart;
+        expect(killProcessByChildProcess).not.toHaveBeenCalled();
+        f.respond(f.calls[0], f.capabilities);
+        await bStart;
+        expect(a.supportsCloseSession()).toBe(false);
+        expect(b.supportsCloseSession()).toBe(true);
+        expect(f.calls).toHaveLength(1);
+    });
+
+    it('reserves activation ownership, releases rejected claims, and keeps indeterminate claims owned', async () => {
+        const f = fixture();
+        const a = f.connection.attach();
+        const b = f.connection.attach();
+        await Promise.all([a.initialize(), b.initialize()]);
+        f.intercept(frame => frame.method === 'session/resume');
+        const resume = a.sendRequest('session/resume', { sessionId: 'saved' });
+        const rejected = expect(resume).rejects.toThrow('Resume rejected');
+        await expect(a.sendRequest('session/resume', { sessionId: 'saved' })).rejects.toThrow('already in progress');
+        await expect(b.sendRequest('session/resume', { sessionId: 'saved' })).rejects.toThrow('already owned');
+        f.send({ id: f.calls.at(-1)!.id, error: { code: -32603, message: 'Resume rejected' } });
+        await rejected;
+        await expect(b.sendRequest('session/resume', { sessionId: 'saved' }, { timeoutMs: 10 })).rejects.toThrow('timed out');
+        await expect(a.sendRequest('session/resume', { sessionId: 'saved' })).rejects.toThrow('already owned');
+        await b.close();
+        f.intercept(undefined);
+        await expect(a.sendRequest('session/resume', { sessionId: 'saved' })).resolves.toEqual({});
+        expect(killProcessByChildProcess).not.toHaveBeenCalled();
+    });
+
+    it('cancels permission requests arriving while session/close is still draining', async () => {
+        const f = fixture();
+        const { a, b, aId, bId } = await twoBackends(f);
+        const aPermission = vi.fn();
+        const bPermission = vi.fn<(request: PermissionRequest) => void>();
+        a.onPermissionRequest(aPermission);
+        b.onPermissionRequest(bPermission);
+        f.intercept(frame => frame.method === 'session/close');
+        const close = a.closeSession(aId);
+        await expect(f.permission(aId)).resolves.toEqual({ outcome: { outcome: 'cancelled' } });
+        expect(aPermission).not.toHaveBeenCalled();
+        const other = f.permission(bId);
+        await b.respondToPermission(bId, bPermission.mock.calls[0][0], { outcome: 'selected', optionId: 'allow' });
+        await expect(other).resolves.toEqual({ outcome: { outcome: 'selected', optionId: 'allow' } });
+        f.respond(f.calls.find(call => call.method === 'session/close')!, {});
+        await close;
+    });
+
+    it('routes session extension notifications and isolates global notification callbacks', async () => {
+        const f = fixture();
+        const a = f.connection.attach();
+        const b = f.connection.attach();
+        await Promise.all([a.initialize(), b.initialize()]);
+        await a.sendRequest('session/resume', { sessionId: 'a' });
+        await b.sendRequest('session/resume', { sessionId: 'b' });
+        const aUpdate = vi.fn(() => { throw new Error('consumer callback failed'); });
+        const bUpdate = vi.fn();
+        a.onNotification(aUpdate);
+        b.onNotification(bUpdate);
+        f.send({ method: '_extension/update', params: { sessionId: 'a' } });
+        expect(aUpdate).toHaveBeenCalledOnce();
+        expect(bUpdate).not.toHaveBeenCalled();
+        f.send({ method: '_global/update', params: { setting: true } });
+        expect(aUpdate).toHaveBeenCalledTimes(2);
+        expect(bUpdate).toHaveBeenCalledExactlyOnceWith('_global/update', { setting: true });
+        await a.close();
+        f.send({ method: '_global/update', params: { setting: false } });
+        expect(aUpdate).toHaveBeenCalledTimes(2);
+        expect(bUpdate).toHaveBeenCalledTimes(2);
+    });
+
+    it('closes a child created after the last consumer detached, without initializing it', async () => {
+        const f = fixture();
+        const gate = deferred<void>();
+        const create = AcpStdioTransport.create.bind(AcpStdioTransport);
+        vi.spyOn(AcpStdioTransport, 'create').mockImplementationOnce(async options => {
+            await gate.promise;
+            return create(options);
+        });
+        const a = f.backend();
+        const start = expect(a.initialize()).rejects.toThrow('consumer closed');
+        const close = a.disconnect();
+        gate.resolve();
+        await Promise.all([start, close]);
+        expect(f.calls).toEqual([]);
+        expect(killProcessByChildProcess).toHaveBeenCalledOnce();
+    });
+
+    it('does not retry a failed shared initialize or leave the child attached', async () => {
+        const f = fixture();
+        f.intercept(frame => {
+            if (frame.method !== 'initialize') return false;
+            f.respond(frame, { invalid: true });
+            return true;
+        });
+        const results = await Promise.allSettled([f.backend().initialize(), f.backend().initialize()]);
+        expect(results.every(result => result.status === 'rejected')).toBe(true);
+        expect(f.calls).toHaveLength(1);
+        expect(killProcessByChildProcess).toHaveBeenCalledOnce();
+        await expect(f.connection.initialize()).rejects.toThrow('Invalid initialize');
+    });
+
+    it('fans out stderr and drained exit once, isolates throwing callbacks, and rejects all pending work', async () => {
+        const f = fixture();
+        const a = f.connection.attach();
