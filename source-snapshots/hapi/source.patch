+        expect(page.messages).toHaveLength(20);
+        expect(bodyCalls(source)).toHaveLength(2);
+        expect(bodyCalls(source).map(call => call.count)).toEqual([1, 20]);
+        expect(typeof bodyCalls(source)[1].params.cursor).toBe('string');
+        expect(page.messages[0].id).toContain('turn-10-question');
+        expect(page.messages.at(-1)!.id).toContain('turn-29-question');
+    });
+
+    it('keeps both projections of a tool when an odd message limit splits its native item', async () => {
+        const { source, reader } = fixture();
+        const turn = source.addTurn('tools', 'inProgress', true);
+        for (let i = 0; i < 30; i++) source.addItem(turn, `tool-${i}`, i + 2, {
+            id: `tool-${i}`, type: 'commandExecution', command: `echo ${i}`, cwd: source.home,
+            status: 'completed', aggregatedOutput: `RESULT ${i}`, exitCode: 0, durationMs: 1,
+        });
+        const complete = await reader.read({ limit: 200 }) as MessagesResponse;
+        expect(complete.messages).toHaveLength(60);
+        let page = await reader.read({ limit: 21 }) as MessagesResponse;
+        const collected = [...page.messages];
+        while (page.page.hasMore) {
+            const before = page.page.nextBeforeSeq!;
+            page = await reader.read({ limit: 21, epoch: page.page.epoch,
+                beforeAt: page.page.nextBeforeAt!, beforeSeq: before }) as MessagesResponse;
+            expect(page.page.nextBeforeSeq!).toBeLessThan(before);
+            collected.unshift(...page.messages);
+        }
+        expect(collected).toEqual(complete.messages);
+        const forward = await reader.read({ limit: 21, epoch: complete.page.epoch,
+            afterAt: complete.messages[0].invokedAt!, afterSeq: complete.messages[0].seq! }) as MessagesResponse;
+        expect(forward.messages).toEqual(complete.messages.slice(1, 22));
+        expect(bodyCalls(source).every(call => Number(call.params.limit) <= 31)).toBe(true);
+    });
+});
