+import { describe, expect, it } from 'vitest';
+import { AbnormalRateLimitResetDetector } from './rateLimitReset';
+
+function snapshot(weeklyUsed: number, shortUsed: number | null = 1, weeklyPrimary = false, resetsAt = 2_000) {
+    const weekly = { usedPercent: weeklyUsed, resetsAt, windowDurationMins: 10_080 };
+    const short = shortUsed === null ? null : { usedPercent: shortUsed, resetsAt: 1_500, windowDurationMins: 300 };
+    return { limitId: 'codex', primary: weeklyPrimary ? weekly : short, secondary: weeklyPrimary ? short : weekly };
+}
+
+function read(weeklyUsed: number, shortUsed: number | null = 1, options: { accountId?: string; weeklyPrimary?: boolean; resetsAt?: number } = {}) {
+    const limits = snapshot(weeklyUsed, shortUsed, options.weeklyPrimary, options.resetsAt);
+    return { accountId: options.accountId ?? 'account-a', rateLimits: limits, rateLimitsByLimitId: { codex: limits } };
+}
+
+describe('abnormal Codex quota resets', () => {
+    it.each([false, true])('detects a weekly reset with both windows above 90%% remaining regardless of primary position (%s)', weeklyPrimary => {
+        const detector = new AbnormalRateLimitResetDetector();
+        expect(detector.observe(read(68, 20, { weeklyPrimary }), 1_000)).toBeUndefined();
+        expect(detector.observe(read(0, 1, { weeklyPrimary }), 1_100)).toEqual({
+            accountId: 'account-a', limitId: 'codex', previousWeeklyRemainingPercent: 32,
+            weeklyRemainingPercent: 100, shortRemainingPercent: 99, previousWeeklyResetsAt: 2_000,
+        });
+        expect(detector.observe(read(0, 1, { weeklyPrimary }), 1_101)).toBeUndefined();
+    });
+
+    it.each([
+        { before: 68, after: 69, short: 1, trigger: false },
+        { before: 69, after: 68, short: 1, trigger: false },
+        { before: 68, after: 10, short: 1, trigger: false },
+        { before: 68, after: 9, short: 10, trigger: false },
+        { before: 68, after: 9, short: 11, trigger: false },
+        { before: 68, after: 9.99, short: 9.99, trigger: true },
+        { before: 10, after: 9, short: 1, trigger: true },
+        { before: 10, after: 9.5, short: 1, trigger: false },
+        { before: 9, after: 0, short: 1, trigger: false },
+    ])('checks the weekly crossing and both thresholds ($before -> $after used, short $short)', ({ before, after, short, trigger }) => {
+        const detector = new AbnormalRateLimitResetDetector();
+        expect(detector.observe(read(before), 1_000)).toBeUndefined();
+        expect(Boolean(detector.observe(read(after, short), 1_100))).toBe(trigger);
+    });
+
+    it('does not infer a reset from the real Pro weekly-only 69 -> 68 update or a missing short window', () => {
+        const detector = new AbnormalRateLimitResetDetector();
+        expect(detector.observe(read(69, null, { weeklyPrimary: true }), 1_000)).toBeUndefined();
+        expect(detector.observe(read(68, null, { weeklyPrimary: true }), 1_100)).toBeUndefined();
+        expect(detector.observe(read(0, null, { weeklyPrimary: true }), 1_200)).toBeUndefined();
+        expect(detector.observe(read(0, 1, { weeklyPrimary: true }), 1_201)).toBeUndefined();
+    });
+
+    it('does not trigger from a short-window reset while weekly usage is unchanged', () => {
+        const detector = new AbnormalRateLimitResetDetector();
+        detector.observe(read(5, 68), 1_000);
+        expect(detector.observe(read(5, 0), 1_100)).toBeUndefined();
+    });
+
+    it.each([2_000, 2_001])('does not classify natural rollover at or after the old reset deadline (%s)', now => {
+        const detector = new AbnormalRateLimitResetDetector();
+        detector.observe(read(68), 1_000);
