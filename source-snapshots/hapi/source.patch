+import { describe, expect, it } from 'bun:test'
+import { which } from 'bun'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+
+const powershell = which('pwsh') ?? which('pwsh.exe')
+
+describe.skipIf(!powershell)('Windows native routing acceptance', () => {
+    it('checks lifecycle transitions, exact-version repairs, and rollback of a failed repair', () => {
+        const script = fileURLToPath(new URL('../windows/tests/desktop-maintenance.ps1', import.meta.url))
+        const result = spawnSync(powershell!, ['-NoLogo', '-NoProfile', '-NonInteractive', '-File', script], { encoding: 'utf8' })
+        expect(result.status, result.stderr).toBe(0)
+        expect(JSON.parse(result.stdout)).toEqual({ passed: 20, repairsRequireExactVersion: true, rollbackVerified: true })
+    })
+    it('accepts the original secure relay without changing configuration and rejects retargeted launches', () => {
+        const script = fileURLToPath(new URL('../windows/tests/native-routing-config.ps1', import.meta.url))
+        const result = spawnSync(powershell!, ['-NoLogo', '-NoProfile', '-NonInteractive', '-File', script], { encoding: 'utf8' })
+        expect(result.status, result.stderr).toBe(0)
+        expect(JSON.parse(result.stdout)).toEqual({ passed: 5, topology: 'legacy-direct', configurationUnchanged: true })
+    })
+})
