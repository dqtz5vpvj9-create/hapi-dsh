+import createHttpsProxyAgent from 'https-proxy-agent'
+import { getProxyForUrl } from 'proxy-from-env'
+
+/** Socket.IO's Node WebSocket transport does not inherit HTTP proxy variables. */
+export function buildHubSocketProxyOptions(url: string) {
+    const proxy = getProxyForUrl(url)
+    return proxy ? { transportOptions: { websocket: { agent: createHttpsProxyAgent(proxy) } } } : {}
+}
