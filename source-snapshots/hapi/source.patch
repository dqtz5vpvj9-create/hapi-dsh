index 0000000000000000000000000000000000000000..bd387ba05c3613ab80218b13d3b12c467d100495
--- /dev/null
+++ b/scripts/windows/tests/desktop-maintenance.ps1
@@ -0,0 +1,62 @@
+param([string]$ScratchRoot = '/mnt/cache/data-cache')
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+. (Join-Path $PSScriptRoot '..\desktop-maintenance-core.ps1')
+$root = Join-Path $ScratchRoot ('hapi-maintenance-test-' + [Guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $root | Out-Null
+$checks = 0
+function Assert($Value, $Message) {
+    if (!$Value) { throw $Message }
+    $script:checks++
+}
+try {
+    $now = [DateTimeOffset]::UtcNow
+    $previous = [pscustomobject]@{generation='old'; nextProbeAt=$now.AddMinutes(4).ToString('o')}
+    Assert (Get-HapiMaintenanceProbeDue -Previous $previous -Generation 'new' -Now $now) 'A changed desktop/backend must be checked immediately'
+    Assert (!(Get-HapiMaintenanceProbeDue -Previous $previous -Generation 'old' -Now $now)) 'An unchanged healthy runtime should not be probed every tick'
+    Assert (Get-HapiMaintenanceProbeDue -Previous $previous -Generation 'old' -Now $now.AddMinutes(5)) 'Periodic verification must eventually run'
+    Assert ((Get-HapiMaintenanceRetrySeconds -Passed $false -Failures 20) -eq 900) 'Repeated failures must back off'
+    $decision = @{Present=$true; Ready=$false; Busy=$false; AgeSeconds=200; Attempts=0; NextAttempt=$now.AddMinutes(-1); Now=$now}
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'refresh-desktop') 'An initialized but disconnected idle desktop can recover'
+    $decision.Present=$false
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'waiting-for-desktop') 'Never reopen an intentionally closed or logged-out desktop'
+    $decision.Present=$true; $decision.AgeSeconds=30
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'initializing') 'Allow startup to complete before recovery'
+    $decision.AgeSeconds=200; $decision.Busy=$true
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'waiting-for-idle') 'Never restart a desktop during an active turn'
+    $decision.Busy=$false; $decision.NextAttempt=$now.AddMinutes(1)
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'recovery-backoff') 'A recovery must not loop every scheduler tick'
+    $decision.Attempts=2
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'recovery-exhausted') 'Stop after two unsuccessful context rebuilds'
+    $decision.Ready=$true
+    Assert ((Get-HapiDesktopRecoveryDecision @decision) -eq 'context-ready') 'Recognize manual recovery even after retry exhaustion'
+    $directory = Join-Path $root 'compat\codex\0.165.0-alpha.1.2'
+    New-Item -ItemType Directory -Path $directory -Force | Out-Null
+    $candidate = Join-Path $directory 'codex-command-runner.exe'
+    Set-Content -LiteralPath $candidate -Value 'candidate'
+    @{engineVersion='0.165.0-alpha.1.2'; repair='current-window-station-v1'} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $directory 'repair.json')
+    Assert ($null -eq (Get-HapiSandboxRepair -Root $root -EngineVersion '0.166.0')) 'Never apply a helper to another engine version'
+    Assert ($null -eq (Get-HapiSandboxRepair -Root $root -EngineVersion '../0.165.0-alpha.1.2')) 'Only version identifiers are bundle keys'
+    $repair = Get-HapiSandboxRepair -Root $root -EngineVersion '0.165.0-alpha.1.2'
+    Assert ($null -ne $repair) 'An exact matching deployed bundle should be found'
+    $rejected=$false
+    try { Invoke-HapiSandboxRepair -Root $root -EnginePath (Join-Path $root 'official-cache\codex.exe') -Repair $repair -Probe {throw 'Must not probe'} | Out-Null }
+    catch { $rejected=$true }
+    Assert $rejected 'Never modify a runtime cache owned by the official desktop'
+    $engineDir = Join-Path $root 'runtimes\codex\test\bin'
+    New-Item -ItemType Directory -Path $engineDir -Force | Out-Null
+    $runner = Join-Path $engineDir 'codex-command-runner.exe'
+    Set-Content -LiteralPath $runner -Value 'original'
+    $result = Invoke-HapiSandboxRepair -Root $root -EnginePath (Join-Path $engineDir 'codex.exe') -Repair $repair -Probe {
+        Assert ((Get-Content -LiteralPath $runner -Raw).Trim() -eq 'candidate') 'Verify the installed candidate, not the original'
+        [pscustomobject]@{passed=$false}
+    }
+    Assert (!$result.passed) 'A failed repair must not be marked ready'
+    Assert ((Get-Content -LiteralPath $runner -Raw).Trim() -eq 'original') 'Restore the original helper after a failed check'
+    $result = Invoke-HapiSandboxRepair -Root $root -EnginePath (Join-Path $engineDir 'codex.exe') -Repair $repair -Probe { [pscustomobject]@{passed=$true} }
+    Assert ($result.passed -and (Get-Content -LiteralPath $runner -Raw).Trim() -eq 'candidate') 'Retain a candidate only after execution acceptance'
+    Assert ((Get-Content -LiteralPath (Join-Path $result.backup 'codex-command-runner.exe') -Raw).Trim() -eq 'original') 'Keep a rollback copy'
+    [ordered]@{passed=$checks; repairsRequireExactVersion=$true; rollbackVerified=$true} | ConvertTo-Json -Compress
+} finally {
+    Remove-Item -LiteralPath $root -Recurse -Force
+}
diff --git a/scripts/windows/tests/native-routing-config.ps1 b/scripts/windows/tests/native-routing-config.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f3267904ba3c168bb40bcf7503a197d395329858
--- /dev/null
+++ b/scripts/windows/tests/native-routing-config.ps1
@@ -0,0 +1,30 @@
+param([string]$RoutingScriptPath = (Join-Path $PSScriptRoot 'native-routing.ps1'))
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+$tokens = $null
+$parseErrors = $null
+$ast = [Management.Automation.Language.Parser]::ParseFile($RoutingScriptPath, [ref]$tokens, [ref]$parseErrors)
+if ($parseErrors.Count) { throw ($parseErrors | Out-String) }
+$definition = $ast.Find({ param($node)
+    $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -eq 'Assert-HapiNativeRelayConfig'
+}, $false)
+if (!$definition) { throw 'Native routing assertion is missing' }
+. ([scriptblock]::Create($definition.Extent.Text))
+$fixture = '{"pipeName":"hapi-native-preview-20261004","roles":{"native":{"arguments":["codex","--native-daemon","ws+unix://localhost/\\./pipe/hapi-native-preview-20261004:/rpc","--debug"],"environment":{"KEEP":"native"}}}}'
+$direct = $fixture | ConvertFrom-Json
+$before = $direct | ConvertTo-Json -Depth 10 -Compress
+Assert-HapiNativeRelayConfig -Config $direct
+if (($direct | ConvertTo-Json -Depth 10 -Compress) -cne $before) { throw 'Routing check changed the existing configuration' }
+foreach ($failure in @('private-pipe', 'wrong-upstream', 'missing-endpoint', 'gateway-override')) {
+    $config = $fixture | ConvertFrom-Json
+    switch ($failure) {
+        'private-pipe' { $config.pipeName = 'hapi-native-engine-20261028' }
+        'wrong-upstream' { $config.roles.native.arguments[2] = 'ws://127.0.0.1:9000' }
+        'missing-endpoint' { $config.roles.native.arguments = @('codex', '--native-daemon') }
+        'gateway-override' { $config.roles.native.environment | Add-Member -NotePropertyName HAPI_CODEX_GATEWAY_PIPE_PATH -NotePropertyValue '\\.\pipe\another-gateway' }
+    }
+    $rejected = $false
+    try { Assert-HapiNativeRelayConfig -Config $config } catch { $rejected = $true }
+    if (!$rejected) { throw "Unexpected routing was accepted: $failure" }
+}
+[ordered]@{ passed=5; topology='legacy-direct'; configurationUnchanged=$true } | ConvertTo-Json -Compress
diff --git a/scripts/windows/tests/native-routing.ps1 b/scripts/windows/tests/native-routing.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f7569d3034e69276eee22dd435639816fbc824b1
--- /dev/null
+++ b/scripts/windows/tests/native-routing.ps1
@@ -0,0 +1,60 @@
+param([string]$Root = 'D:\hapi')
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+
+function Assert-HapiNativeRelayConfig {
+    param([Parameter(Mandatory)][psobject]$Config)
+    $nativeArguments = [string[]]@($Config.roles.native.arguments)
+    $endpointIndex = [Array]::IndexOf($nativeArguments, '--native-daemon') + 1
+    if ($Config.pipeName -ne 'hapi-native-preview-20261004' -or
+        $endpointIndex -eq 0 -or $endpointIndex -ge $nativeArguments.Count -or
+        $nativeArguments[$endpointIndex] -ne 'ws+unix://localhost/\./pipe/hapi-native-preview-20261004:/rpc' -or
+        $Config.roles.native.environment.HAPI_CODEX_GATEWAY_PIPE_PATH) {
+        throw 'Windows host configuration does not preserve the secure direct desktop relay'
+    }
+}
+$config = Get-Content -LiteralPath (Join-Path $Root 'config\windows-host.json') -Raw | ConvertFrom-Json
+Assert-HapiNativeRelayConfig -Config $config
+$state = Get-Content -LiteralPath (Join-Path $Root 'state\supervisor.json') -Raw | ConvertFrom-Json
+if (!$state.pid -or !$state.roles.native.pid -or !$state.nativeReady) {
+    throw 'Windows native roles have not published their current process IDs'
+}
+
+if (!('HapiNativePipeOwnership' -as [type])) {
+    Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+using Microsoft.Win32.SafeHandles;
+public static class HapiNativePipeOwnership {
+    [DllImport("kernel32.dll", SetLastError=true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    public static extern bool GetNamedPipeServerProcessId(SafePipeHandle pipe, out uint processId);
+}
+'@
+}
+
+function Get-PipeServerPid {
+    param([Parameter(Mandatory)][string]$Name)
+    $client = [IO.Pipes.NamedPipeClientStream]::new('.', $Name, [IO.Pipes.PipeDirection]::InOut)
+    try {
+        $client.Connect(1500)
+        [uint32]$serverPid = 0
+        if (![HapiNativePipeOwnership]::GetNamedPipeServerProcessId($client.SafePipeHandle, [ref]$serverPid)) {
+            throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())
+        }
+        return $serverPid
+    } finally { $client.Dispose() }
+}
+
+$relayPipePid = Get-PipeServerPid -Name 'hapi-native-preview-20261004'
+if ($relayPipePid -ne [uint32]$state.pid) {
+    throw 'Desktop relay pipe is not owned by the current Rust supervisor'
+}
+[ordered]@{
+    version = 1
+    checkedAt = [DateTime]::UtcNow.ToString('o')
+    topology = 'legacy-direct'
+    desktopRelayPipePid = $relayPipePid
+    routingVerified = $true
+    functionalAcceptance = 'separate-required'
+} | ConvertTo-Json -Compress
