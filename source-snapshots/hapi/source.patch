new file mode 100644
index 0000000000000000000000000000000000000000..5e30140f25a444a0c89bc1a9a79b0c3eca82bf24
--- /dev/null
+++ b/scripts/windows/DesktopContext.cs
@@ -0,0 +1,34 @@
+// Presence-only diagnostics. Authorization values never leave Inspect.
+using System;
+using System.Collections.Generic;
+using System.Runtime.InteropServices;
+using System.Text;
+public static class HapiDesktopContext {
+ [DllImport("kernel32.dll",SetLastError=true)] static extern IntPtr OpenProcess(uint access,bool inherit,uint processId);
+ [DllImport("kernel32.dll")] static extern bool CloseHandle(IntPtr handle);
+ [DllImport("ntdll.dll")] static extern int NtQueryInformationProcess(IntPtr h,int c,byte[] b,int n,out int r);
+ [DllImport("kernel32.dll",SetLastError=true)] static extern bool ReadProcessMemory(IntPtr h,IntPtr a,byte[] b,int n,out IntPtr count);
+ static byte[] Read(IntPtr h,long a,int n) {var b=new byte[n]; if(!ReadProcessMemory(h,new IntPtr(a),b,n,out var got)||got.ToInt64()!=n)throw new Exception("process context unreadable"); return b;}
+ static Dictionary<string,string> ReadSelected(uint processId,string[] keys) {
+  var h=OpenProcess(0x410,false,processId); if(h==IntPtr.Zero)throw new Exception("process unavailable");
+  try {var p=new byte[48];if(NtQueryInformationProcess(h,0,p,p.Length,out var r)!=0)throw new Exception("process query failed");
+   var peb=BitConverter.ToInt64(p,8);var pars=BitConverter.ToInt64(Read(h,peb+0x20,8),0);var ptr=BitConverter.ToInt64(Read(h,pars+0x80,8),0);
+   var content=new List<byte>();bool priorZero=false;for(int offset=0;offset<1048576;offset+=2){var unit=Read(h,ptr+offset,2);bool zero=unit[0]==0&&unit[1]==0;if(zero&&priorZero)break;content.AddRange(unit);priorZero=zero;}
+   var selected=new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase);var wanted=new HashSet<string>(keys,StringComparer.OrdinalIgnoreCase);
+   foreach(var entry in Encoding.Unicode.GetString(content.ToArray()).Split('\0')){var i=entry.IndexOf('=');if(i>0&&wanted.Contains(entry.Substring(0,i)))selected[entry.Substring(0,i)]=entry.Substring(i+1);}
+   return selected;
+  }finally{CloseHandle(h);}
+ }
+
+ public static Dictionary<string, bool> Inspect(uint processId, string expectedCli) {
+  var env = ReadSelected(processId, new[] {"CODEX_CLI_PATH", "BROWSER_USE_ACCESS_EXECUTOR_ID", "BROWSER_USE_ACCESS_PIPE_PATH", "BROWSER_USE_ACCESS_VERIFYING_IDENTITY"});
