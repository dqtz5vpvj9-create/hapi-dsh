+        expect(first.entries.every(entry => entry.label.startsWith('QUESTION'))).toBe(true);
+        const second = await reader.read({ operation: 'outline', limit: 100, epoch: first.page.epoch,
+            beforeAt: first.page.beforeCursor!.at, beforeSeq: first.page.beforeCursor!.seq }) as MessageOutlineResponse;
+        expect(second.entries).toHaveLength(10);
+        expect(bodyCalls(source)).toHaveLength(110);
+        expect(second.page.hasMore).toBe(false);
+    });
+
+    it.each([20, 80, 200])('returns %i projected messages without reading and discarding an older native prefix', async limit => {
+        const { source, reader } = fixture(); dense(source, 250, 'agentMessage');
+        const first = await reader.read({ limit }) as MessagesResponse;
+        expect(first.messages).toHaveLength(limit);
+        expect(first.page.hasMore).toBe(true);
+        expect(bodyCalls(source)).toHaveLength(Math.ceil(limit / 31));
+        expect(bodyCalls(source).reduce((sum, call) => sum + call.count, 0)).toBe(limit);
+        const second = await reader.read({ limit, epoch: first.page.epoch,
+            beforeAt: first.page.nextBeforeAt!, beforeSeq: first.page.nextBeforeSeq! }) as MessagesResponse;
+        const expected = Math.min(limit, 250 - limit);
+        expect(second.messages).toHaveLength(expected);
+        expect(new Set([...second.messages, ...first.messages].map(message => message.id)).size).toBe(limit + expected);
+        expect(bodyCalls(source).reduce((sum, call) => sum + call.count, 0)).toBe(limit + expected);
+        expect(bodyCalls(source).every(call => Number(call.params.limit) <= 31)).toBe(true);
+        expect(second.page.epoch).toBe(first.page.epoch);
