index 0000000000000000000000000000000000000000..8426cc17381cbf4a519b902a44c7cb3209fc1e95
--- /dev/null
+++ b/scripts/windows/tests/desktop-compatibility.ps1
@@ -0,0 +1,107 @@
+param(
+    [string]$Root = 'D:\hapi',
+    [switch]$RequireDesktopLaunch
+)
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
+
+$rootPath = [IO.Path]::GetFullPath($Root)
+$scriptsPath = Join-Path $rootPath 'scripts'
+. (Join-Path $scriptsPath 'desktop-environment.ps1')
+. (Join-Path $scriptsPath 'codex-runtime.ps1')
+$managed=Get-HapiManagedCodex -Root $rootPath
+
+$package = Get-AppxPackage -Name 'OpenAI.Codex'
+if (!$package) { throw 'OpenAI.Codex is not installed for the HAPI desktop user' }
+$resources = Join-Path $package.InstallLocation 'app\resources'
+$cuaManifestPath = Join-Path $resources 'cua_node\manifest.json'
+$cuaPackagePath = Join-Path $resources 'cua_node\bin\node_modules\@oai\cua\package.json'
+$replPackagePath = Join-Path $resources 'cua_node\bin\node_modules\@oai\cua-repl\package.json'
+$browserPackagePath = Join-Path $resources 'cua_node\bin\node_modules\@oai\browser-desktop\package.json'
+$pluginManifestPath = Join-Path $resources 'plugins\openai-bundled\plugins\unified-computer-use\.codex-plugin\plugin.json'
+$requiredFiles = @($cuaManifestPath, $cuaPackagePath, $replPackagePath, $browserPackagePath, $pluginManifestPath)
+foreach ($path in $requiredFiles) {
+    if (!(Test-Path -LiteralPath $path -PathType Leaf)) { throw "Required desktop runtime metadata is missing: $path" }
+}
+$cuaManifest = Get-Content -LiteralPath $cuaManifestPath -Raw | ConvertFrom-Json
+$cuaPackage = Get-Content -LiteralPath $cuaPackagePath -Raw | ConvertFrom-Json
+$replPackage = Get-Content -LiteralPath $replPackagePath -Raw | ConvertFrom-Json
+$browserPackage = Get-Content -LiteralPath $browserPackagePath -Raw | ConvertFrom-Json
+$pluginManifest = Get-Content -LiteralPath $pluginManifestPath -Raw | ConvertFrom-Json
+
+$parseFiles = @(
+    'desktop-environment.ps1', 'launch-app.ps1', 'persist-startup.ps1',
+    'prepare-deploy.ps1', 'deploy-release.ps1', 'tests\desktop-compatibility.ps1'
+)
+foreach ($relative in $parseFiles) {
+    $path = Join-Path $scriptsPath $relative
+    [void][scriptblock]::Create((Get-Content -LiteralPath $path -Raw))
+}
+$environment = Get-HapiCodexDesktopEnvironmentState
+$task = Get-ScheduledTask -TaskName 'HAPI-desktop' -ErrorAction SilentlyContinue
+$launchStatePath = Join-Path $rootPath 'state\desktop-launch.json'
+$launchState = if (Test-Path -LiteralPath $launchStatePath -PathType Leaf) {
+    Get-Content -LiteralPath $launchStatePath -Raw | ConvertFrom-Json
+} else { $null }
+$refreshPending = Test-Path -LiteralPath (Join-Path $rootPath 'state\desktop-refresh-request.json') -PathType Leaf
+$desktopRunning = @(Get-CimInstance Win32_Process | Where-Object {
+    $_.Name -eq 'ChatGPT.exe' -and $_.ExecutablePath -and
+    $_.ExecutablePath.StartsWith($package.InstallLocation, [StringComparison]::OrdinalIgnoreCase)
+}).Count -gt 0
+
+Add-Type -Path (Join-Path $scriptsPath 'DesktopContext.cs')
+$desktopProcesses=@(Get-CimInstance Win32_Process | Where-Object {$_.Name -eq 'ChatGPT.exe' -and $_.SessionId -ne 0 -and $_.ExecutablePath -and $_.ExecutablePath.StartsWith($package.InstallLocation,[StringComparison]::OrdinalIgnoreCase)})
+$desktopIds=@($desktopProcesses.ProcessId)
+$desktopMain=@($desktopProcesses | Where-Object ParentProcessId -NotIn $desktopIds)
+$contextReady=$false
+if ($desktopMain.Count -eq 1 -and $managed) {
+    $presence=[HapiDesktopContext]::Inspect($desktopMain[0].ProcessId,$managed.executable)
+    $contextReady=$presence.cliMatches -and $presence.executorPresent -and $presence.identityPresent -and $presence.pipeExists
+}
+$checks = [ordered]@{
+    desktopContextReady = $contextReady
+    managedRuntimeSelected = $null -ne $managed
+    managedCliConfigured = $managed -and [Environment]::GetEnvironmentVariable('CODEX_CLI_PATH','User') -ieq $managed.executable
+    scriptsParsed = $parseFiles.Count
+    endpointConfigured = [bool]$environment.endpointConfigured
+    localDaemonConfigured = [bool]$environment.localDaemonConfigured
+    dynamicUserFieldsAbsent = $environment.dynamicUserFieldCount -eq 0
+    taskRegistered = $null -ne $task
+    taskInteractive = $task -and [string]$task.Principal.LogonType -eq 'Interactive'
+    desktopRunning = $desktopRunning
+    refreshPending = $refreshPending
+    launchStateCurrent = $launchState -and $launchState.revision -eq $script:HapiCodexDesktopCompatibilityRevision -and
+        $launchState.endpointPresent -and $launchState.localDaemonPresent
+}
+if (!$checks.managedRuntimeSelected -or !$checks.managedCliConfigured -or !$checks.endpointConfigured -or !$checks.localDaemonConfigured -or !$checks.dynamicUserFieldsAbsent -or !$checks.taskRegistered -or !$checks.taskInteractive) {
+    throw 'Desktop compatibility configuration is incomplete'
+}
+if ($RequireDesktopLaunch -and (!$checks.desktopContextReady -or !$checks.desktopRunning -or !$checks.launchStateCurrent -or $checks.refreshPending)) {
+    throw 'The interactive desktop has not confirmed the current compatibility launch'
+}
+
+$result = [ordered]@{
+    version = 1
+    checkedAt = [DateTime]::UtcNow.ToString('o')
+    account = [Security.Principal.WindowsIdentity]::GetCurrent().Name
+    sessionId = (Get-Process -Id $PID).SessionId
+    compatibilityRevision = $script:HapiCodexDesktopCompatibilityRevision
+    versions = [ordered]@{
+        desktopPackage = [string]$package.Version
+        plugin = [string]$pluginManifest.version
+        cuaRuntime = [string]$cuaManifest.runtime_archive_version
+        cuaNode = [string]$cuaManifest.node_version
+        cua = [string]$cuaPackage.version
+        cuaRepl = [string]$replPackage.version
+        browserDesktop = [string]$browserPackage.version
+    }
+    checks = $checks
+    functionalAcceptance = [ordered]@{
+        status = 'separate-required'
+        reason = 'Process, configuration and version checks do not prove Edge or computer-control operations.'
+    }
+}
+$resultPath = Join-Path $rootPath 'state\desktop-compatibility-acceptance.json'
+$result | ConvertTo-Json -Depth 7 | Set-Content -LiteralPath $resultPath -Encoding utf8NoBOM
+$result | ConvertTo-Json -Depth 7 -Compress
diff --git a/scripts/windows/tests/desktop-fixture.mjs b/scripts/windows/tests/desktop-fixture.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..bad96bf441bf7a31884ef067ccf9dad7817a33a4
--- /dev/null
+++ b/scripts/windows/tests/desktop-fixture.mjs
@@ -0,0 +1,15 @@
+import { createServer } from 'node:http'
+
+// A fixed local fixture; external example sites can change independently of HAPI.
+const pages = {
+    '/start': '<!doctype html><title>HAPI browser acceptance</title><h1>HAPI browser acceptance</h1><a href="/finish">Verify navigation</a>',
+    '/finish': '<!doctype html><title>HAPI navigation verified</title><h1>HAPI navigation verified</h1><p>Browser read and click succeeded.</p>',
+}
+const server = createServer((request, response) => {
+    const page = pages[request.url]
+    response.writeHead(page ? 200 : 404, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' })
+    response.end(page ?? 'Not found')
+})
+server.listen(19437, '127.0.0.1', () => console.log('HAPI desktop fixture listening on 127.0.0.1:19437'))
+const timeout = setTimeout(() => server.close(), 10 * 60_000)
+server.on('close', () => clearTimeout(timeout))
diff --git a/scripts/windows/tests/desktop-lifecycle.ps1 b/scripts/windows/tests/desktop-lifecycle.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..253b75634ae2113e3722198b83082081243e2427
--- /dev/null
+++ b/scripts/windows/tests/desktop-lifecycle.ps1
@@ -0,0 +1,97 @@
+param(
+    [Parameter(Mandatory)][ValidateSet('Arm','Verify','Status','Disarm')][string]$Mode,
+    [ValidateSet('Logon','Reboot')][string]$ExpectedTransition = 'Logon',
+    [ValidatePattern('^[0-9A-Za-z._-]+$')][string]$ReleaseLabel = 'manual',
+    [string]$Root = 'D:\hapi'
+)
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
+
+$rootPath = [IO.Path]::GetFullPath($Root)
+$statePath = Join-Path $rootPath 'state\desktop-lifecycle-armed.json'
+$reportPath = Join-Path $rootPath 'state\desktop-lifecycle-acceptance.json'
+$taskName = 'HAPI-desktop-lifecycle-acceptance'
+$scriptPath = Join-Path $rootPath 'scripts\tests\desktop-lifecycle.ps1'
+
+if ($Mode -eq 'Disarm') {
+    Unregister-ScheduledTask -TaskName $taskName -Confirm:$false -ErrorAction SilentlyContinue
+    [ordered]@{ version=1; disarmedAt=[DateTime]::UtcNow.ToString('o') } | ConvertTo-Json -Compress
+    exit 0
+}
+
+if ($Mode -eq 'Status') {
+    [ordered]@{
+        version=1
+        armed=Test-Path -LiteralPath $statePath -PathType Leaf
+        taskRegistered=$null -ne (Get-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue)
+        report=if (Test-Path -LiteralPath $reportPath -PathType Leaf) { Get-Content -LiteralPath $reportPath -Raw | ConvertFrom-Json } else { $null }
+    } | ConvertTo-Json -Depth 8 -Compress
+    exit 0
+}
+
+if ($Mode -eq 'Arm') {
+    $sessionId = (Get-Process -Id $PID).SessionId
+    if ($sessionId -eq 0) { throw 'Arm must run in the interactive desktop session that will be logged off or rebooted' }
+    $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name
+    $bootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().ToString('o')
+    [ordered]@{
+        version=1
+        release=$ReleaseLabel
+        expectedTransition=$ExpectedTransition
+        armedAt=[DateTime]::UtcNow.ToString('o')
+        bootTime=$bootTime
+        desktopSession=$sessionId
+        user=$user
+    } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $statePath -Encoding utf8NoBOM
+    $principal=New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited
+    $settings=New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Minutes 5) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable
+    $trigger=New-ScheduledTaskTrigger -AtLogOn -User $user
+    $arguments="-NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -File `"$scriptPath`" -Mode Verify -ExpectedTransition $ExpectedTransition -ReleaseLabel $ReleaseLabel -Root `"$rootPath`""
+    $action=New-ScheduledTaskAction -Execute (Get-Command pwsh.exe).Source -Argument $arguments -WorkingDirectory $rootPath
+    Register-ScheduledTask -TaskName $taskName -Action $action -Principal $principal -Settings $settings -Trigger $trigger -Force | Out-Null
+    [ordered]@{ version=1; armed=$true; release=$ReleaseLabel; expectedTransition=$ExpectedTransition; desktopSession=$sessionId } | ConvertTo-Json -Compress
+    exit 0
+}
+
+if (!(Test-Path -LiteralPath $statePath -PathType Leaf)) { throw 'Lifecycle acceptance was not armed before the transition' }
+$armed = Get-Content -LiteralPath $statePath -Raw | ConvertFrom-Json
+$deadline = [DateTime]::UtcNow.AddMinutes(3)
+$compatibility = $null
+$backend = $null
+do {
+    Start-Sleep -Seconds 2
+    try {
+        $backend = Get-Content -LiteralPath (Join-Path $rootPath 'state\supervisor.json') -Raw | ConvertFrom-Json
+        $compatibility = & (Join-Path $rootPath 'scripts\tests\desktop-compatibility.ps1') -RequireDesktopLaunch | ConvertFrom-Json
+    } catch {
+        $compatibility = $null
+    }
+} until (($backend -and $backend.nativeReady -and $compatibility) -or [DateTime]::UtcNow -ge $deadline)
+$currentBootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().ToString('o')
+$currentSession = (Get-Process -Id $PID).SessionId
+$transitionObserved = if ($armed.expectedTransition -eq 'Reboot') {
+    $currentBootTime -ne [string]$armed.bootTime
+} else {
+    $currentSession -ne [int]$armed.desktopSession
+}
+$passed = [bool]($transitionObserved -and $backend -and $backend.nativeReady -and $compatibility)
+$result = [ordered]@{
+    version=1
+    release=[string]$armed.release
+    checkedAt=[DateTime]::UtcNow.ToString('o')
+    expectedTransition=[string]$armed.expectedTransition
+    transitionObserved=$transitionObserved
+    previousDesktopSession=[int]$armed.desktopSession
+    desktopSession=$currentSession
+    backendReady=[bool]($backend -and $backend.nativeReady)
+    desktopLaunchConfirmed=$null -ne $compatibility
+    passed=$passed
+}
+$result | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $reportPath -Encoding utf8NoBOM
+if ($passed) {
+    Unregister-ScheduledTask -TaskName $taskName -Confirm:$false -ErrorAction SilentlyContinue
+    Remove-Item -LiteralPath $statePath -Force
+}
+$result | ConvertTo-Json -Depth 6 -Compress
+if (!$passed) { exit 1 }
diff --git a/scripts/windows/tests/desktop-maintenance.ps1 b/scripts/windows/tests/desktop-maintenance.ps1
