+   ["executorPresent"] = Present("BROWSER_USE_ACCESS_EXECUTOR_ID"),
+   ["identityPresent"] = Present("BROWSER_USE_ACCESS_VERIFYING_IDENTITY"),
+   ["pipePresent"] = Present("BROWSER_USE_ACCESS_PIPE_PATH"),
+   ["pipeExists"] = env.TryGetValue("BROWSER_USE_ACCESS_PIPE_PATH", out var pipe) && System.IO.File.Exists(pipe)
+  };
+ }
+}
