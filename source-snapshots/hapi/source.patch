diff --git a/web/src/lib/codexPluginSuggestions.ts b/web/src/lib/codexPluginSuggestions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7fdd80526fb361a6bab79c9d40972078b96808a2
--- /dev/null
+++ b/web/src/lib/codexPluginSuggestions.ts
@@ -0,0 +1,38 @@
+import type { CodexPluginSummary } from '@hapi/protocol/apiTypes'
+import type { Suggestion } from '@/hooks/useActiveSuggestions'
+
+function pluginMention(label: string, path: string): string {
+    return `[@${label.replace(/[\\[\]]/g, '\\$&')}](${path})`
+}
+
+export function codexPluginSuggestions(plugins: readonly CodexPluginSummary[], query: string): Suggestion[] {
+    const slash = query.startsWith('/')
+    const search = query.slice(1).toLocaleLowerCase()
+    const suggestions: Suggestion[] = []
+    for (const plugin of plugins) {
+        const path = `plugin://${plugin.id}`
+        if (!slash) {
+            const label = plugin.name === 'computer-use' ? 'Computer' : plugin.displayName
+            if (`${plugin.name} ${label}`.toLocaleLowerCase().includes(search)) {
+                suggestions.push({ key: path, text: pluginMention(label, path), label: `@${label}`, description: plugin.description, source: 'plugin' })
+            }
+        }
+        // Official desktop browser-family references use the installed Browser
+        // plugin ID. These are browser targets, not connectivity/health claims.
+        if (plugin.name === 'browser') {
+            for (const family of ['edge', 'chrome'] as const) {
+                const label = family === 'edge' ? 'Edge' : 'Chrome'
+                if (!family.includes(search)) continue
+                const target = `${path}?browserFamily=${family}`
+                suggestions.push({
+                    key: target,
+                    text: pluginMention(label, target),
+                    label: `${slash ? '/' : '@'}${slash ? family : label}`,
+                    description: `${plugin.displayName} · ${label}`,
+                    source: 'plugin',
+                })
+            }
+        }
+    }
+    return suggestions
+}
