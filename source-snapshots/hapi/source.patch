diff --git a/scripts/windows/maintain-desktop.ps1 b/scripts/windows/maintain-desktop.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..a9016283898df337987478f96f1fb1b94495cf1a
--- /dev/null
+++ b/scripts/windows/maintain-desktop.ps1
@@ -0,0 +1,160 @@
+param([string]$Root = 'D:\hapi', [switch]$ForceProbe)
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+. (Join-Path $PSScriptRoot 'desktop-environment.ps1')
+. (Join-Path $PSScriptRoot 'desktop-maintenance-core.ps1')
+. (Join-Path $PSScriptRoot 'codex-runtime.ps1')
+Add-Type -Path (Join-Path $PSScriptRoot 'NativeRpc.cs')
+Add-Type -Path (Join-Path $PSScriptRoot 'DesktopContext.cs')
+
+$rootPath = [IO.Path]::GetFullPath($Root)
+$statePath = Join-Path $rootPath 'state\desktop-maintenance.json'
+# A manual check may race the scheduled check; share one repair transaction.
+try { $lease = [IO.File]::Open((Join-Path $rootPath 'state\desktop-maintenance.lock'), 'OpenOrCreate', 'ReadWrite', 'None') }
+catch [IO.IOException] { exit 0 }
+try {
+$previous = if (Test-Path -LiteralPath $statePath) { Get-Content -LiteralPath $statePath -Raw | ConvertFrom-Json } else { $null }
+$state = [ordered]@{version=1; checkedAt=[DateTimeOffset]::UtcNow.ToString('o'); stage='discover'; sandboxVerified=$false; desktopStatus='waiting-for-desktop'; functionalAcceptance='not-verified'; failures=0}
+$client = $null
+try {
+    $configuration = Get-HapiCodexDesktopEnvironmentState
+    $managed = Get-HapiManagedCodex -Root $rootPath
+    if (!$configuration.endpointConfigured -or !$configuration.localDaemonConfigured -or $configuration.dynamicUserFieldCount -or
+        ($managed -and [Environment]::GetEnvironmentVariable('CODEX_CLI_PATH', 'User') -ine $managed.executable)) {
+        Set-HapiCodexDesktopUserEnvironment
+    }
+    $backend = Get-Content -LiteralPath (Join-Path $rootPath 'state\supervisor.json') -Raw | ConvertFrom-Json
+    $processes = @(Get-CimInstance Win32_Process)
+    $engine = $processes | Where-Object ProcessId -eq $backend.roles.engine.pid | Select-Object -First 1
+    if (!$engine -or !$backend.nativeReady) { throw 'backend-unavailable' }
+    $package = Get-AppxPackage -Name 'OpenAI.Codex'
+    $desktop = @($processes | Where-Object {
+        $_.Name -eq 'ChatGPT.exe' -and $_.SessionId -ne 0 -and $_.ExecutablePath -and $package -and
+        $_.ExecutablePath.StartsWith($package.InstallLocation, [StringComparison]::OrdinalIgnoreCase)
+    })
+    $desktopIds = @($desktop.ProcessId)
+    $desktopMain = @($desktop | Where-Object ParentProcessId -NotIn $desktopIds | Sort-Object ProcessId)
+    $state.enginePid = $engine.ProcessId
+    $state.desktopPids = @($desktopMain.ProcessId)
+    $state.desktopSessions = @($desktopMain.SessionId)
+    $state.packageVersion = if ($package) { [string]$package.Version } else { $null }
+    $state.runtimeOwnership = if ($managed) { 'hapi' } else { 'migration-required' }
+    $state.packageCompatibility = if ($managed -and $managed.packageVersion -eq $state.packageVersion) { 'matched' } else { 'upgrade-verification-required' }
+    if ($managed -and $package -and $state.packageCompatibility -ne 'matched') {
+        $updatePath=Join-Path $rootPath 'state\desktop-runtime-update.json'
+        $update=if(Test-Path -LiteralPath $updatePath){Get-Content -LiteralPath $updatePath -Raw|ConvertFrom-Json}else{$null}
+        if ($update -and $update.packageVersion -eq $state.packageVersion -and $update.status -in @('rejected-rolled-back','activation-failed-rollback-unconfirmed','activating')) {
+            $state.packageCompatibility=$update.status
+        } else {
+            @{version=1;packageVersion=$state.packageVersion}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $rootPath 'state\desktop-runtime-update-request.json') -Encoding utf8NoBOM
+            Start-ScheduledTask -TaskName 'HAPI-desktop-runtime-update'
+            $state.packageCompatibility='migration-queued-until-idle'
+        }
+    }
+    if ($package) {
+        $resources = Join-Path $package.InstallLocation 'app\resources'
+        $runtimeManifest = Join-Path $resources 'cua_node\manifest.json'
+        $pluginManifest = Join-Path $resources 'plugins\openai-bundled\plugins\unified-computer-use\.codex-plugin\plugin.json'
+        $state.cuaRuntimeVersion = if (Test-Path -LiteralPath $runtimeManifest) { (Get-Content -LiteralPath $runtimeManifest -Raw | ConvertFrom-Json).runtime_archive_version } else { $null }
+        $state.pluginVersion = if (Test-Path -LiteralPath $pluginManifest) { (Get-Content -LiteralPath $pluginManifest -Raw | ConvertFrom-Json).version } else { $null }
+    }
+    if ($desktopMain.Count) { $state.desktopStatus = 'awaiting-functional-verification' }
+    $enginePath = $engine.ExecutablePath
+    $versionText = & $enginePath --version
+    if ($LASTEXITCODE -ne 0 -or $versionText -notmatch '^codex-cli (\S+)$') { throw 'engine-version-unavailable' }
+    $state.engineVersion = $Matches[1]
+    $runner = Get-Item -LiteralPath (Join-Path (Split-Path $enginePath) 'codex-command-runner.exe')
+    $generationParts = @($engine.ProcessId, $engine.CreationDate.ToUniversalTime().ToString('o'), $enginePath,
+        $state.engineVersion, $state.packageVersion, $state.cuaRuntimeVersion, $state.pluginVersion, ($desktopMain.ProcessId -join ','),
+        (($desktopMain | ForEach-Object {$_.CreationDate.ToUniversalTime().ToString('o')}) -join ','),
+        $runner.Length, $runner.LastWriteTimeUtc.Ticks)
+    $state.generation = $generationParts -join '|'
+    $state.stage = 'sandbox-probe'
+    if (!$ForceProbe -and !(Get-HapiMaintenanceProbeDue -Previous $previous -Generation $state.generation)) {
+        $state.sandboxVerified = [bool]$previous.sandboxVerified
+        $state.nextProbeAt = $previous.nextProbeAt
+        $state.failures = $previous.failures
+        $state.stage = $previous.stage
+        $state.repairAttempted = $previous.repairAttempted
+    } else {
+        $client = [HapiNativeRpc]::Connect('hapi-native-preview-20261004').GetAwaiter().GetResult()
+        $probe = Get-HapiSandboxProbe -Client $client -Root $rootPath
+        $alreadyAttempted = $previous -and $previous.generation -ceq $state.generation -and $previous.repairAttempted
+        $repair = Get-HapiSandboxRepair -Root $rootPath -EngineVersion $state.engineVersion
+        $state.repairAttempted = [bool]$alreadyAttempted
+        if (!$probe.passed -and $probe.failure -eq 'desktop-initialization' -and $repair -and !$alreadyAttempted) {
+            $state.repairAttempted = $true
+            $result = Invoke-HapiSandboxRepair -Root $rootPath -EnginePath $enginePath -Repair $repair -Probe {
+                Get-HapiSandboxProbe -Client $client -Root $rootPath
+            }
+            $state.repair = $result
+            $state.repairAttempted = $result.attempted
+            $probe.passed = $result.passed
+            # The helper changed (or was restored); cache the actual installed generation.
+            $runner = Get-Item -LiteralPath $runner.FullName
+            $generationParts[-2] = $runner.Length
+            $generationParts[-1] = $runner.LastWriteTimeUtc.Ticks
+            $state.generation = $generationParts -join '|'
+        }
+        $state.sandboxVerified = [bool]$probe.passed
+        $state.stage = if ($probe.passed) { 'sandbox-verified' } else { $probe.failure }
+        $state.failures = if ($probe.passed) { 0 } elseif ($previous -and $previous.generation -ceq $state.generation) { [int]$previous.failures + 1 } else { 1 }
+        $state.nextProbeAt = [DateTimeOffset]::UtcNow.AddSeconds((Get-HapiMaintenanceRetrySeconds -Passed $probe.passed -Failures $state.failures)).ToString('o')
+    }
+    # Inspect only the current official desktop's context. Never save its auth
+    # values or inject them into the engine. A relaunch uses official setup again.
+    $state.desktopRecoveryAttempts = if ($previous) { [int]$previous.desktopRecoveryAttempts } else { 0 }
+    $state.desktopNextRecoveryAt = if ($previous.desktopNextRecoveryAt) { $previous.desktopNextRecoveryAt } else { [DateTimeOffset]::MinValue.ToString('o') }
+    if ($desktopMain.Count -eq 1 -and $managed -and $state.sandboxVerified) {
+        $presence = [HapiDesktopContext]::Inspect($desktopMain[0].ProcessId, $managed.executable)
+        $state.desktopContext = $presence
+        $contextReady = $presence.cliMatches -and $presence.executorPresent -and $presence.identityPresent -and $presence.pipeExists
+        $age = ([DateTime]::UtcNow - $desktopMain[0].CreationDate.ToUniversalTime()).TotalSeconds
+        $busy = $true
+        if (!$contextReady -and $age -ge 120) {
+            if (!$client) { $client = [HapiNativeRpc]::Connect('hapi-native-preview-20261004').GetAwaiter().GetResult() }
+            $loaded = $client.Request('thread/loaded/list', '{}').GetAwaiter().GetResult() | ConvertFrom-Json
+            $busy = $false
+            foreach ($id in $loaded.data) {
+                $thread = $client.Request('thread/read', (@{threadId=$id; includeTurns=$false} | ConvertTo-Json -Compress)).GetAwaiter().GetResult() | ConvertFrom-Json
+                if ($thread.thread.status.type -eq 'active') { $busy = $true; break }
+            }
+        }
+        $state.desktopStatus = Get-HapiDesktopRecoveryDecision -Present $true -Ready $contextReady -Busy $busy -AgeSeconds $age -Attempts $state.desktopRecoveryAttempts -NextAttempt ([DateTimeOffset]::Parse($state.desktopNextRecoveryAt))
+        if ($contextReady) { $state.desktopRecoveryAttempts = 0 }
+        if ($state.desktopStatus -eq 'refresh-desktop') {
+            $state.desktopRecoveryAttempts++
+            $state.desktopNextRecoveryAt = [DateTimeOffset]::UtcNow.AddMinutes(5).ToString('o')
+            @{version=1; reason='desktop-context-unavailable'; requestedAt=[DateTimeOffset]::UtcNow.ToString('o')} |
+                ConvertTo-Json | Set-Content -LiteralPath (Join-Path $rootPath 'state\desktop-refresh-request.json') -Encoding utf8NoBOM
+            Start-ScheduledTask -TaskName 'HAPI-desktop'
+            $state.desktopStatus = 'refresh-requested'
+        }
+    }
+    # A process/pipe check is not browser acceptance. Only a functional receipt
+    # for this exact desktop/backend generation can mark the browser verified.
+    $receiptPath = Join-Path $rootPath 'state\desktop-functional-current.json'
+    if (Test-Path -LiteralPath $receiptPath) {
+        $receipt = Get-Content -LiteralPath $receiptPath -Raw | ConvertFrom-Json
+        if ($state.sandboxVerified -and $contextReady -and $receipt.passed -and $receipt.generation -ceq $state.generation) {
+            $state.functionalAcceptance = 'verified'
+            $state.desktopStatus = 'verified'
+        }
+    }
+} catch {
+    $state.failedStage = $state.stage
+    $state.errorType = $_.Exception.GetType().Name
+    $state.stage = 'maintenance-check-unavailable'
+    $state.failures = 1
+    $state.nextProbeAt = [DateTimeOffset]::UtcNow.AddMinutes(1).ToString('o')
+} finally {
+    if ($client) { $client.Dispose() }
+}
+# One bounded state file, no polling log or credentials. The scheduler uses
+# IgnoreNew so probes and repair transactions cannot overlap.
+$next = "$statePath.next"
+$state | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $next -Encoding utf8NoBOM
+Move-Item -LiteralPath $next -Destination $statePath -Force
+$state | ConvertTo-Json -Depth 8 -Compress
+if (!$state.sandboxVerified) { exit 1 }
+} finally { $lease.Dispose() }
