diff --git a/scripts/windows/update-desktop-runtime.ps1 b/scripts/windows/update-desktop-runtime.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..335ef80297c93978208916904032d704180d08ea
--- /dev/null
+++ b/scripts/windows/update-desktop-runtime.ps1
@@ -0,0 +1,62 @@
+param([string]$Root = 'D:\hapi')
+$ErrorActionPreference = 'Stop'
+$PSStyle.OutputRendering = 'PlainText'
+function Save-UpdateState($State, $Path) {
+    $State|ConvertTo-Json|Set-Content -LiteralPath "$Path.next" -Encoding utf8NoBOM
+    Move-Item -LiteralPath "$Path.next" -Destination $Path -Force
+}
+$statePath = Join-Path $Root 'state\desktop-runtime-update.json'
+$requestPath = Join-Path $Root 'state\desktop-runtime-update-request.json'
+if (!(Test-Path -LiteralPath $requestPath)) { exit 0 }
+try { $lease=[IO.File]::Open((Join-Path $Root 'state\desktop-runtime-update.lock'),'OpenOrCreate','ReadWrite','None') }
+catch [IO.IOException] { exit 0 }
+$client=$null
+try {
+    $request=Get-Content -LiteralPath $requestPath -Raw|ConvertFrom-Json
+    $package=Get-AppxPackage -Name OpenAI.Codex
+    if (!$package -or [string]$package.Version -cne $request.packageVersion) { throw 'Installed package changed before migration' }
+    Add-Type -Path (Join-Path $PSScriptRoot 'NativeRpc.cs')
+    $client=[HapiNativeRpc]::Connect('hapi-native-preview-20261004').GetAwaiter().GetResult()
+    $loaded=$client.Request('thread/loaded/list','{}').GetAwaiter().GetResult()|ConvertFrom-Json
+    foreach($id in $loaded.data) {
+        $thread=$client.Request('thread/read',(@{threadId=$id;includeTurns=$false}|ConvertTo-Json -Compress)).GetAwaiter().GetResult()|ConvertFrom-Json
+        if ($thread.thread.status.type -eq 'active') { exit 0 }
+    }
+    $client.Dispose();$client=$null
+    $network=& (Join-Path $PSScriptRoot 'tests\hub-connectivity.ps1')|ConvertFrom-Json
+    if (!$network.passed) { throw 'Runner network preflight failed' }
+    $label='desktop-runtime-'+([DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ'))
+    $staging=Join-Path $Root ('state\staging\'+$label)
+    New-Item -ItemType Directory -Path $staging -Force|Out-Null
+    # Use the same versioned activation/rollback path as a normal HAPI upgrade.
+    foreach($file in @(Get-ChildItem -LiteralPath $PSScriptRoot -File)) { Copy-Item -LiteralPath $file.FullName -Destination $staging }
+    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'tests') -Destination $staging -Recurse
+    Copy-Item -LiteralPath (Join-Path $Root 'compat\codex') -Destination (Join-Path $staging 'compat') -Recurse
+    $state=[ordered]@{version=1;packageVersion=[string]$package.Version;release=$label;attemptedAt=[DateTimeOffset]::UtcNow.ToString('o');status='activating'}
+    Save-UpdateState $state $statePath
+    Stop-ScheduledTask -TaskName 'HAPI-desktop-maintenance' -ErrorAction SilentlyContinue
+    $config=Get-Content -LiteralPath (Join-Path $Root 'config\windows-host.json') -Raw|ConvertFrom-Json
+    try {
+        & (Join-Path $staging 'deploy-release.ps1') -Root $Root -ReleaseLabel $label -CandidatePath $config.roles.native.executable -DesktopBundlePath $staging -UpdateNative | Out-Null
+        $state.status='activated-awaiting-functional-verification'
+    } catch {
+        # deploy-release restores the previous runtime selection, scripts and
+        # environment. Do not retry a rejected package on every scheduler tick.
+        $state.status=if ($_.Exception.Data['HapiRollbackSucceeded'] -eq $true) {
+            'rejected-rolled-back'
+        } else {
+            'activation-failed-rollback-unconfirmed'
+        }
+        $state.errorType=$_.Exception.GetType().Name
+        if ($_.Exception.Data['HapiRollbackErrorType']) {
+            $state.rollbackErrorType=$_.Exception.Data['HapiRollbackErrorType']
+        }
+    }
+    $state.completedAt=[DateTimeOffset]::UtcNow.ToString('o')
+    Save-UpdateState $state $statePath
+    Remove-Item -LiteralPath $requestPath
+    $state|ConvertTo-Json -Compress
+} finally {
+    if($client){$client.Dispose()}
+    $lease.Dispose()
+}
