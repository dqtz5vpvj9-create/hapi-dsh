+import { describe, expect, it } from 'vitest'
+import { codexPluginSuggestions } from './codexPluginSuggestions'
+
+describe('Codex plugin suggestions', () => {
+    const browser = { id: 'browser@openai-bundled', name: 'browser', displayName: 'Browser' }
+    it('inserts the official browser family reference for @Edge and /edge', () => {
+        for (const query of ['@Edge', '/edge']) {
+            expect(codexPluginSuggestions([browser], query)).toEqual([expect.objectContaining({
