@@ -0,0 +1,31 @@
+import { z } from 'zod';
+import type { CodexPluginSummary } from '@hapi/protocol/apiTypes';
+
+const PluginListSchema = z.object({
+    marketplaces: z.array(z.object({
+        plugins: z.array(z.object({
+            id: z.string().min(1),
+            name: z.string().min(1),
+            installed: z.boolean(),
+            enabled: z.boolean(),
+            availability: z.string(),
+            disabledReason: z.string().nullish(),
+            interface: z.object({
+                displayName: z.string().nullish(),
+                shortDescription: z.string().nullish(),
+            }).nullish(),
+        })),
+    })),
+});
+
+export function installedCodexPlugins(response: unknown): CodexPluginSummary[] {
+    const { marketplaces } = PluginListSchema.parse(response);
+    return marketplaces.flatMap(marketplace => marketplace.plugins)
+        .filter(plugin => plugin.installed && plugin.enabled && plugin.availability === 'AVAILABLE' && !plugin.disabledReason)
+        .map(plugin => ({
+            id: plugin.id,
+            name: plugin.name,
+            displayName: plugin.interface?.displayName || plugin.name,
+            description: plugin.interface?.shortDescription ?? undefined,
+        }));
+}
