--- /dev/null
+++ b/cli/src/codex/shared/rateLimitReset.ts
@@ -0,0 +1,64 @@
+import { record, string } from './gateway';
+
+type WindowState = { remainingPercent: number; resetsAt: number | null };
+
+export type AbnormalRateLimitResetEvent = {
+    accountId: string;
+    limitId: string;
+    previousWeeklyRemainingPercent: number;
+    weeklyRemainingPercent: number;
+    shortRemainingPercent: number;
+    previousWeeklyResetsAt: number;
+};
+
+function windowState(snapshot: Record<string, unknown>, durationMins: number): WindowState | undefined {
+    for (const name of ['primary', 'secondary'] as const) {
+        const candidate = record(snapshot[name]);
+        if (candidate.windowDurationMins === durationMins && typeof candidate.usedPercent === 'number') {
+            return { remainingPercent: 100 - candidate.usedPercent, resetsAt: typeof candidate.resetsAt === 'number' ? candidate.resetsAt : null };
+        }
+    }
+    return undefined;
+}
+
+/**
+ * Compare complete account/rateLimits/read responses. Rolling notifications can
+ * contain older per-thread usage and must only prompt a fresh account read.
+ */
+export class AbnormalRateLimitResetDetector {
+    private accountId: string | undefined;
+    private readonly windows = new Map<string, WindowState>();
+
+    observe(response: unknown, nowSeconds = Date.now() / 1000): AbnormalRateLimitResetEvent | undefined {
+        const account = record(response);
+        const accountId = string(account.accountId);
+        if (accountId !== this.accountId) {
+            this.windows.clear();
+            this.accountId = accountId;
+        }
+        if (!accountId) return undefined;
+
+        const buckets = Object.entries(record(account.rateLimitsByLimitId));
+        if (buckets.length === 0) buckets.push(['default', account.rateLimits]);
+        let event: AbnormalRateLimitResetEvent | undefined;
+        for (const [bucketId, value] of buckets) {
+            const snapshot = record(value);
+            const weekly = windowState(snapshot, 10_080);
+            if (!weekly) continue;
+            const short = windowState(snapshot, 300);
+            const limitId = string(snapshot.limitId) ?? bucketId;
+            const key = JSON.stringify([accountId, limitId]);
+            const previous = this.windows.get(key);
+            this.windows.set(key, weekly);
+            if (previous && previous.resetsAt !== null && nowSeconds < previous.resetsAt
+                && previous.remainingPercent <= 90 && weekly.remainingPercent > 90
+                && weekly.remainingPercent >= previous.remainingPercent + 1
+                && short && short.remainingPercent > 90) {
+                event ??= { accountId, limitId, previousWeeklyRemainingPercent: previous.remainingPercent,
+                    weeklyRemainingPercent: weekly.remainingPercent, shortRemainingPercent: short.remainingPercent,
+                    previousWeeklyResetsAt: previous.resetsAt };
+            }
+        }
+        return event;
+    }
+}
