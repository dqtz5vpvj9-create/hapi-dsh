@@ -0,0 +1,103 @@
+$ErrorActionPreference = 'Stop'
+
+function Get-HapiSandboxProbe {
+    param([Parameter(Mandatory)]$Client, [Parameter(Mandatory)][string]$Root)
+    $writeProbe = Join-Path $Root ('temp\sandbox-denied-' + [Guid]::NewGuid().ToString('N') + '.txt')
+    $parameters = @{
+        command = @((Get-Command pwsh.exe).Source, '-NoLogo', '-NoProfile', '-NonInteractive',
+            '-File', (Join-Path $Root 'scripts\tests\sandbox-probe.ps1'), '-WriteProbePath', $writeProbe)
+        cwd = $Root
+        timeoutMs = 15000
+        sandboxPolicy = @{ type='readOnly'; networkAccess=$false }
+    }
+    try {
+        $response = $Client.RequestWithTimeout('command/exec', ($parameters | ConvertTo-Json -Depth 6 -Compress), 45).GetAwaiter().GetResult() | ConvertFrom-Json
+        $proof = $null
+        if ($response.exitCode -eq 0) {
+            try { $proof = $response.stdout.Trim() | ConvertFrom-Json } catch {}
+        }
+        return [pscustomobject]@{
+            passed = [bool]($proof -and $proof.marker -eq 'HAPI_SANDBOX_VERIFIED' -and $proof.session -eq 0 -and $proof.writeDenied)
+            failure = if ($response.exitCode -eq -1073741502) { 'desktop-initialization' } else { 'sandbox-execution' }
+            exitCode = $response.exitCode
+        }
+    } catch {
+        # Keep RPC payloads, environment values and command output out of maintenance state.
+        return [pscustomobject]@{passed=$false; failure='sandbox-rpc'; exitCode=$null}
+    }
+}
+
+function Get-HapiMaintenanceProbeDue {
+    param($Previous, [string]$Generation, [DateTimeOffset]$Now = [DateTimeOffset]::UtcNow)
+    if (!$Previous -or $Previous.generation -cne $Generation) { return $true }
+    return $Now -ge [DateTimeOffset]::Parse($Previous.nextProbeAt)
+}
+
+function Get-HapiMaintenanceRetrySeconds {
+    param([bool]$Passed, [int]$Failures)
+    if ($Passed) { return 300 }
+    return [Math]::Min(900, 60 * [Math]::Pow(2, [Math]::Min(4, [Math]::Max(0, $Failures - 1))))
+}
+
+function Get-HapiDesktopRecoveryDecision {
+    param([bool]$Present, [bool]$Ready, [bool]$Busy, [double]$AgeSeconds,
+        [int]$Attempts, [DateTimeOffset]$NextAttempt, [DateTimeOffset]$Now = [DateTimeOffset]::UtcNow)
+    if (!$Present) { return 'waiting-for-desktop' }
+    if ($Ready) { return 'context-ready' }
+    if ($AgeSeconds -lt 120) { return 'initializing' }
+    if ($Busy) { return 'waiting-for-idle' }
+    if ($Attempts -ge 2) { return 'recovery-exhausted' }
+    if ($Now -lt $NextAttempt) { return 'recovery-backoff' }
+    return 'refresh-desktop'
+}
+
+function Get-HapiSandboxRepair {
+    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$EngineVersion)
+    # Only a locally deployed, exact-version bundle is eligible. Never reuse an
+    # older helper for a new Codex protocol or download executable code at runtime.
+    if ($EngineVersion -notmatch '^\d+\.\d+\.\d+(?:-[0-9A-Za-z.]+)?$') { return $null }
+    $directory = Join-Path $Root ('compat\codex\' + $EngineVersion)
+    $manifestPath = Join-Path $directory 'repair.json'
+    if (!(Test-Path -LiteralPath $manifestPath -PathType Leaf)) { return $null }
+    $manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json
+    $executable = Join-Path $directory 'codex-command-runner.exe'
+    if ($manifest.engineVersion -cne $EngineVersion -or $manifest.repair -cne 'current-window-station-v1' -or
+        !(Test-Path -LiteralPath $executable -PathType Leaf)) { return $null }
+    return [pscustomobject]@{executable=$executable; revision=$manifest.repair}
+}
+
+function Invoke-HapiSandboxRepair {
+    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$EnginePath,
+        [Parameter(Mandatory)]$Repair, [Parameter(Mandatory)][scriptblock]$Probe)
+    $managedRoot = [IO.Path]::GetFullPath((Join-Path $Root 'runtimes\codex'))
+    if (![IO.Path]::GetFullPath($EnginePath).StartsWith($managedRoot + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
+        throw 'Never modify the official desktop runtime cache'
+    }
+    $runner = Join-Path (Split-Path $EnginePath) 'codex-command-runner.exe'
+    $backup = Join-Path $Root ('state\rollback\sandbox-' + [Guid]::NewGuid().ToString('N'))
+    New-Item -ItemType Directory -Path $backup -Force | Out-Null
+    $original = Join-Path $backup 'codex-command-runner.exe'
+    Copy-Item -LiteralPath $runner -Destination $original
+    $next = "$runner.hapi-next"
+    $installed = $false
+    try {
+        # Overwriting an in-use image fails; never kill a running tool to replace it.
+        Copy-Item -LiteralPath $Repair.executable -Destination $next -Force
+        [IO.File]::Replace($next, $runner, [System.Management.Automation.Language.NullString]::Value)
+        $installed = $true
+        $proof = & $Probe
+        if (!$proof.passed) { throw 'Sandbox repair failed its execution check' }
+        return [pscustomobject]@{passed=$true; attempted=$true; backup=$backup; revision=$Repair.revision}
+    } catch {
+        if ($installed) {
+            Copy-Item -LiteralPath $original -Destination $next -Force
+            [IO.File]::Replace($next, $runner, [System.Management.Automation.Language.NullString]::Value)
+        } else {
+            Remove-Item -LiteralPath $original -Force
+            Remove-Item -LiteralPath $backup
+        }
+        return [pscustomobject]@{passed=$false; attempted=$installed; backup=if($installed){$backup}else{$null}; revision=$Repair.revision}
+    } finally {
+        if (Test-Path -LiteralPath $next) { Remove-Item -LiteralPath $next -Force }
+    }
+}
